+func TestStaticMemberErrors_8b23ff(t *testing.T) {
+	smError(t, "bar.xgo", map[string]string{"bar.xgo": `
+type T struct{}
+
+const U.x = 1 // ERROR
+`})
+	smError(t, "bar.xgo", map[string]string{"bar.xgo": `
+var V int
+
+var V.x = 1 // ERROR
+`})
+	smError(t, "bar.xgo", map[string]string{"bar.xgo": `
+type T int
+
+func (T) Size() int { return 1 }
+
+var T.Size int // ERROR
+`})
+	smError(t, "bar.xgo", map[string]string{"bar.xgo": `
+type T int
+
+const T.k = 1
+
+T.k = 2 // ERROR
+`})
+	smError(t, "Rect.gox", map[string]string{
