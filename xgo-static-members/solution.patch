+
+package cl
+
+import (
+	"go/types"
+	"strings"
+
+	"github.com/goplus/xgo/ast"
+	"github.com/goplus/xgo/token"
+)
+
+// A staticValue is a static constant or variable declared as `T.name` (or
+// `.name` in a classfile). It is implemented by the package-level object
+// staticMethod(tname, name), which gogen registers as a static member of T.
+type staticValue struct {
+	id    *ast.Ident // declared name, renamed to the implementing object
+	tname string
+	name  string
+}
+
+// typeMembers records, for each type declared in this package, the names of
+// its methods (instance and static) and of its static values.
+type typeMembers struct {
+	methods map[string]bool
+	statics map[string]bool // static methods and static values
+}
+
+func (p *pkgCtx) members(tname string) *typeMembers {
+	if p.tmembers == nil {
+		p.tmembers = make(map[string]*typeMembers)
+	}
+	m, ok := p.tmembers[tname]
+	if !ok {
+		m = &typeMembers{methods: make(map[string]bool), statics: make(map[string]bool)}
+		p.tmembers[tname] = m
+	}
+	return m
+}
+
+// isStaticMember reports whether name (or name with its first letter in upper
+// case) is a static member of the type tname declared in this package.
+func (p *pkgCtx) isStaticMember(tname, name string) bool {
+	m, ok := p.tmembers[tname]
+	if !ok {
+		return false
+	}
+	return m.statics[name] || m.statics[strings.ToUpper(name[:1])+name[1:]]
+}
+
+// staticObject returns the package-level object that implements the static
+// member tname.name declared in this package, or nil. It doesn't depend on
+// the static member being registered on the type yet, so it also works while
+// the package is still being loaded.
+func staticObject(ctx *blockCtx, tname, name string) types.Object {
+	if !ctx.isStaticMember(tname, name) {
+		return nil
+	}
+	scope := ctx.pkg.Types.Scope()
+	for _, n := range []string{name, strings.ToUpper(name[:1]) + name[1:]} {
+		lname := staticMethod(tname, n)
+		ctx.loadSymbol(lname)
+		if o := scope.Lookup(lname); o != nil {
+			return o
+		}
+	}
+	return nil
+}
+
+// staticSelector returns the object implementing the static member x.sel if x
+// names a type of this package that has such a static member.
+func staticSelector(ctx *blockCtx, x, sel *ast.Ident) types.Object {
+	if at, o := ctx.cb.Scope().LookupParent(x.Name, token.NoPos); o != nil {
+		if at != ctx.pkg.Types.Scope() { // local object
+			return nil
+		}
+		if _, ok := o.(*types.TypeName); !ok {
+			return nil
+		}
+	}
+	return staticObject(ctx, x.Name, sel.Name)
+}
+
+// compileStaticObject compiles a reference to a static member implemented by o.
+func compileStaticObject(ctx *blockCtx, o types.Object, src ast.Node, lhs bool) {
+	if !lhs {
+		ctx.cb.Val(o, src)
+		return
+	}
+	if _, ok := o.(*types.Var); !ok {
+		code := ctx.LoadExpr(src)
+		panic(ctx.newCodeErrorf(src.Pos(), src.End(), "cannot assign to %s (neither addressable nor a map index expression)", code))
+	}
+	ctx.cb.VarRef(o, src)
+}
+
+func classTypeName(ctx *blockCtx) string {
+	if recv := ctx.classRecv; recv != nil {
+		return recv.List[0].Type.(*ast.StarExpr).X.(*ast.Ident).Name
+	}
+	return ""
+}
+
+func isStaticName(id *ast.Ident) bool {
+	return strings.IndexByte(id.Name, '.') >= 0
+}
+
+// lowerStaticNames renames the static names (`T.name` or `.name`) declared by
+// spec to the names of the package-level objects that implement them.
+func lowerStaticNames(ctx *blockCtx, spec *ast.ValueSpec) (statics []staticValue) {
+	if !spec.HasStatic {
+		return nil
+	}
+	for _, id := range spec.Names {
+		if !isStaticName(id) {
+			continue
+		}
+		pos := strings.IndexByte(id.Name, '.')
+		tname, name := id.Name[:pos], id.Name[pos+1:]
+		if tname == "" { // classfile shorthand: .name
+			tname = classTypeName(ctx)
+		}
+		ctx.members(tname).statics[name] = true
+		id.Name = staticMethod(tname, name)
+		statics = append(statics, staticValue{id: id, tname: tname, name: name})
+		ctx.lbinames = append(ctx.lbinames, &ast.Ident{Name: tname}, id.Name)
+	}
+	return
+}
+
+// checkStaticValues checks, before the static values are declared, that each
+// of them belongs to a named type of this package and doesn't collide with a
+// method of it. A static value that fails the check is declared as `_`.
+func checkStaticValues(ctx *blockCtx, statics []staticValue) {
+	scope := ctx.pkg.Types.Scope()
+	for _, v := range statics {
+		id := v.id
+		pos, end := id.Pos(), id.Pos()+token.Pos(len(v.tname)+1+len(v.name))
+		ctx.loadSymbol(v.tname)
+		o := scope.Lookup(v.tname)
+		if o == nil {
+			ctx.handleErrorf(pos, end, "undefined: %s", v.tname)
+		} else if tn, ok := o.(*types.TypeName); !ok || tn.IsAlias() {
+			ctx.handleErrorf(pos, end, "%s is not a defined type", v.tname)
+		} else if _, ok := tn.Type().(*types.Named); !ok {
+			ctx.handleErrorf(pos, end, "%s is not a defined type", v.tname)
+		} else if ctx.members(v.tname).methods[v.name] {
+			ctx.handleErrorf(pos, end, "%s.%s redeclared: %s already has a method named %s", v.tname, v.name, v.tname, v.name)
+		} else {
+			continue
+		}
+		id.Name = "_"
+	}
+}
+
+// splitStaticSpec splits a classfile field spec into its instance fields and
+// its static variables. It returns nil for a part that has no names.
+func splitStaticSpec(ctx *blockCtx, spec *ast.ValueSpec) (fields, statics *ast.ValueSpec) {
+	if !spec.HasStatic {
+		return spec, nil
+	}
+	nv := len(spec.Values)
+	if nv != 0 && nv != len(spec.Names) {
+		ctx.handleErrorf(spec.Pos(), spec.End(), "cannot mix static variables and class fields in a multi-value declaration")
+	}
+	fields = &ast.ValueSpec{Doc: spec.Doc, Type: spec.Type, Tag: spec.Tag, Comment: spec.Comment}
+	statics = &ast.ValueSpec{Doc: spec.Doc, Type: spec.Type, Comment: spec.Comment, HasStatic: true}
+	for i, id := range spec.Names {
+		part := fields
+		if isStaticName(id) {
+			part = statics
+		}
+		part.Names = append(part.Names, id)
+		if nv == len(spec.Names) {
+			part.Values = append(part.Values, spec.Values[i])
+		}
+	}
+	if len(fields.Names) == 0 {
+		fields = nil
+	}
+	return
+}
