+// parseIndexOpName parses the name of an index operator method, `[]` (getter)
+// or `[]=` (setter), which follows the receiver of a method declaration.
+// Otherwise `[` starts the result type of a function literal: `[]T` is parsed
+// and returned as typ, and the `[` of `[N]T` is left for the caller.
+func (p *parser) parseIndexOpName() (ident *ast.Ident, typ ast.Expr) {
+	lbrack := p.pos
+	p.next()
+	if p.tok != token.RBRACK {
+		p.unget(lbrack, token.LBRACK, "")
+		return
+	}
+	p.next()
+	switch p.tok {
+	case token.LPAREN:
+		return &ast.Ident{NamePos: lbrack, Name: "[]"}, nil
+	case token.ASSIGN:
+		p.next()
+		return &ast.Ident{NamePos: lbrack, Name: "[]="}, nil
+	}
+	typ = &ast.ArrayType{Lbrack: lbrack, Elt: p.parseType()}
+	p.resolve(typ)
+	return
+}
