+
+package cl
+
+import (
+	goast "go/ast"
+	gotoken "go/token"
+	"go/types"
+	"strconv"
+
+	"github.com/goplus/gogen"
+	"github.com/goplus/xgo/ast"
+	"github.com/goplus/xgo/token"
+)
+
+// Index operator methods:
+//
+//	func (m *Matrix) [](i, j int) float64       // XGo_Index: x = m[i, j]
+//	func (m *Matrix) []=(i, j int, v float64)   // XGo_IndexSet: m[i, j] = v
+const (
+	indexGetter = "XGo_Index"
+	indexSetter = "XGo_IndexSet"
+)
+
+var indexXGoNames = map[string]string{
+	"[]":  indexGetter,
+	"[]=": indexSetter,
+}
+
+func numFields(list *ast.FieldList) (n int) {
+	if list == nil {
+		return
+	}
+	for _, f := range list.List {
+		if len(f.Names) == 0 {
+			n++
+		} else {
+			n += len(f.Names)
+		}
+	}
+	return
+}
+
+// checkIndexOpSig checks the signature of an index getter (`[]`) or setter
+// (`[]=`) declaration.
+func checkIndexOpSig(ctx *blockCtx, d *ast.FuncDecl) bool {
+	nparams, nresults := numFields(d.Type.Params), numFields(d.Type.Results)
+	switch d.Name.Name {
+	case "[]":
+		if nparams < 1 || nresults != 1 {
+			ctx.handleErrorf(d.Name.Pos(), d.Name.End(),
+				"index getter [] must have at least one parameter and exactly one result")
+			return false
+		}
+	case "[]=":
+		if nparams < 2 || nresults != 0 {
+			ctx.handleErrorf(d.Name.Pos(), d.Name.End(),
+				"index setter []= must have at least two parameters and no results")
+			return false
+		}
+	}
+	return true
+}
+
+// indexOp returns the method name (XGo_Index or XGo_IndexSet) of the operand
+// on the top of the stack, or nil if the operand has no such method.
+func indexOp(ctx *blockCtx, name string) *types.Func {
+	typ := ctx.cb.Get(-1).Type
+	switch types.Unalias(typ).(type) {
+	case *types.Named, *types.Pointer, *types.TypeParam, *types.Interface:
+	default:
+		return nil
+	}
+	loadMethods(ctx, typ, make(map[*types.Named]bool))
+	obj, _, _ := types.LookupFieldOrMethod(typ, true, ctx.pkg.Types, name)
+	fn, _ := obj.(*types.Func)
+	return fn
+}
+
+// loadMethods makes sure that the methods of typ declared in this package,
+// including the ones promoted through embedded fields, are loaded.
+func loadMethods(ctx *blockCtx, typ types.Type, visited map[*types.Named]bool) {
+	if t, ok := types.Unalias(typ).(*types.Pointer); ok {
+		typ = t.Elem()
+	}
+	t, ok := types.Unalias(typ).(*types.Named)
+	if !ok || visited[t] {
+		return
+	}
+	visited[t] = true
+	if o := t.Obj(); o.Pkg() == ctx.pkg.Types {
+		ctx.loadType(o.Name())
+	}
+	if st, ok := t.Underlying().(*types.Struct); ok {
+		for i := 0; i < st.NumFields(); i++ {
+			if f := st.Field(i); f.Embedded() {
+				loadMethods(ctx, f.Type(), visited)
+			}
+		}
+	}
+}
+
+// paramType returns the type of the i-th argument of a call to fn.
+func paramType(fn *types.Func, i int) types.Type {
+	sig := fn.Type().(*types.Signature)
+	params := sig.Params()
+	n := params.Len()
+	if sig.Variadic() && i >= n-1 {
+		return params.At(n - 1).Type().(*types.Slice).Elem()
+	}
+	if i < n {
+		return params.At(i).Type()
+	}
+	return nil
+}
+
+// checkIndexCount checks that the index operator fn of lhs, called with the
+// indices of lhs and nextra more arguments, gets the right number of them.
+func checkIndexCount(ctx *blockCtx, lhs ast.Expr, fn *types.Func, nidx, nextra int) {
+	sig := fn.Type().(*types.Signature)
+	if sig.Variadic() {
+		return
+	}
+	if want := sig.Params().Len() - nextra; nidx != want {
+		panic(ctx.newCodeErrorf(lhs.Pos(), lhs.End(),
+			"wrong number of indices in %s: have %d, want %d", ctx.LoadExpr(lhs), nidx, want))
+	}
+}
+
+func indicesOf(x ast.Expr) []ast.Expr {
+	switch v := x.(type) {
+	case *ast.IndexExpr:
+		return []ast.Expr{v.Index}
+	case *ast.IndexListExpr:
+		return v.Indices
+	}
+	return nil
+}
+
+// compileIndexGet compiles x[indices] as a call of the index getter of x, the
+// operand on the top of the stack. It returns false if x has no index getter.
+func compileIndexGet(ctx *blockCtx, lhs int, v ast.Expr, indices []ast.Expr) bool {
+	if indexOp(ctx, indexGetter) == nil {
+		return false
+	}
+	cb := ctx.cb
+	cb.MemberVal(indexGetter, 0, v)
+	for _, idx := range indices {
+		compileExpr(ctx, 1, idx)
+	}
+	cb.CallWith(len(indices), lhs, 0, v)
+	return true
+}
+
+// isIndexGetCall reports whether x is a call of an index getter.
+func isIndexGetCall(x *gogen.Element) bool {
+	if call, ok := x.Val.(*goast.CallExpr); ok {
+		if sel, ok := call.Fun.(*goast.SelectorExpr); ok {
+			return sel.Sel.Name == indexGetter
+		}
+	}
+	return false
+}
+
+// lhsOperand is the compiled operand x of a left-hand side x[i, ...].
+type lhsOperand struct {
+	x      *gogen.Element
+	setter *types.Func
+}
+
+// compileLHSOperands compiles the operands of the index expressions in lhs,
+// from left to right, and reports whether any of them has an index setter.
+func compileLHSOperands(ctx *blockCtx, lhs []ast.Expr) (ops []*lhsOperand, hasSetter bool) {
+	for i, e := range lhs {
+		var x ast.Expr
+		switch v := unparen(e).(type) {
+		case *ast.IndexExpr:
+			x = v.X
+		case *ast.IndexListExpr:
+			x = v.X
+		default:
+			continue
+		}
+		if ops == nil {
+			ops = make([]*lhsOperand, len(lhs))
+		}
+		compileExpr(ctx, 1, x)
+		setter := indexOp(ctx, indexSetter)
+		ops[i] = &lhsOperand{x: ctx.cb.InternalStack().Pop(), setter: setter}
+		if setter != nil {
+			hasSetter = true
+		}
+	}
+	return
+}
+
+// compileLHS compiles the left-hand side expr, whose operand was compiled by
+// compileLHSOperands when op is not nil.
+func compileLHS(ctx *blockCtx, expr ast.Expr, op *lhsOperand) {
+	if op == nil {
+		compileExprLHS(ctx, expr)
+		return
+	}
+	ctx.cb.InternalStack().Push(op.x)
+	switch v := unparen(expr).(type) {
+	case *ast.IndexExpr:
+		compileExpr(ctx, 1, v.Index)
+		ctx.cb.IndexRef(1, v)
+	case *ast.IndexListExpr:
+		panic(ctx.newCodeErrorf(v.Pos(), v.End(), "invalid operation: more than one index"))
+	}
+	if rec := ctx.recorder(); rec != nil {
+		rec.recordExpr(ctx, expr, true)
+	}
+}
+
+// compileIndexSet compiles `x[indices] = rhs` as a call of the index setter.
+func compileIndexSet(ctx *blockCtx, lhs ast.Expr, op *lhsOperand, rhs ast.Expr, src ast.Node) {
+	cb := ctx.cb
+	indices := indicesOf(unparen(lhs))
+	cb.InternalStack().Push(op.x)
+	cb.MemberVal(indexSetter, 0, lhs)
+	for _, idx := range indices {
+		compileExpr(ctx, 1, idx)
+	}
+	compileAssignValue(ctx, rhs, paramType(op.setter, len(indices)), lhs)
+	cb.CallWith(len(indices)+1, 0, 0, src)
+}
+
+// compileAssignValue compiles the value rhs assigned to lhs of type typ.
+func compileAssignValue(ctx *blockCtx, rhs ast.Expr, typ types.Type, lhs ast.Expr) {
+	switch e := unparen(rhs).(type) {
+	case *ast.ArrowExpr, *ast.LambdaExpr:
+		if typ != nil {
+			sig, err := checkLambdaFuncType(ctx, e, typ, clLambaAssign, lhs)
+			if err != nil {
+				panic(err)
+			}
+			compileLambda(ctx, e, sig)
+			return
+		}
+	case *ast.SliceLit:
+		compileSliceLit(ctx, e, typ)
+		return
+	case *ast.CompositeLit:
+		compileCompositeLit(ctx, e, typ, false)
+		return
+	}
+	compileExpr(ctx, 1, rhs)
+}
+
+// needAddr reports whether calling the methods fns on x requires its address.
+func needAddr(x *gogen.Element, fns ...*types.Func) bool {
+	switch x.Type.Underlying().(type) {
+	case *types.Pointer, *types.Interface:
+		return false
+	}
+	for _, fn := range fns {
+		if obj, _, indirect := types.LookupFieldOrMethod(x.Type, false, fn.Pkg(), fn.Name()); obj == nil && indirect {
+			return true
+		}
+	}
+	return false
+}
+
+// tempBlock starts a block holding the temporary variables of a lowered
+// assignment. Where a simple statement is required, it is a function literal
+// that is called at once. The returned function ends the block.
+func tempBlock(ctx *blockCtx) func() {
+	cb := ctx.cb
+	closure := ctx.simpleStmt
+	if closure {
+		ctx.simpleStmt = false
+		sig := types.NewSignatureType(nil, nil, nil, nil, nil, false)
+		cb.NewClosureWith(sig).BodyStart(ctx.pkg)
+	} else {
+		cb.Block()
+	}
+	return func() {
+		if enableRecover {
+			if e := recover(); e != nil {
+				cb.ResetStmt()
+				cb.End()
+				ctx.simpleStmt = closure
+				panic(e)
+			}
+		}
+		cb.End()
+		if closure {
+			cb.CallWith(0, 0, 0).EndStmt()
+			ctx.simpleStmt = true
+		}
+	}
+}
+
+// newTemp declares a temporary variable name of type typ (inferred if nil)
+// initialized with the value that init pushes.
+func newTemp(ctx *blockCtx, name string, typ types.Type, init func()) {
+	ctx.cb.NewVarStart(typ, name)
+	initTemps(ctx, init)
+}
+
+// defineTemps defines temporary variables names initialized with the values
+// of the expression that init pushes.
+func defineTemps(ctx *blockCtx, pos token.Pos, names []string, init func()) {
+	ctx.cb.DefineVarStart(pos, names...)
+	initTemps(ctx, init)
+}
+
+func initTemps(ctx *blockCtx, init func()) {
+	cb := ctx.cb
+	if enableRecover {
+		defer func() {
+			if e := recover(); e != nil {
+				cb.ResetInit()
+				panic(e)
+			}
+		}()
+	}
+	init()
+	cb.EndInit(1)
+}
+
+// newOperandTemp declares a temporary variable name holding the operand x, or
+// its address if calling fns on it requires one.
+func newOperandTemp(ctx *blockCtx, name string, x *gogen.Element, fns ...*types.Func) {
+	newTemp(ctx, name, nil, func() {
+		ctx.cb.InternalStack().Push(x)
+		if needAddr(x, fns...) {
+			ctx.cb.UnaryOp(gotoken.AND)
+		}
+	})
+}
+
+// compileIndexOpAssignOp compiles `x[indices] op= rhs`, `x[indices]++` and
+// `x[indices]--`, where x has an index setter:
+//
+//	{
+//		_xgo_x := x // or &x
+//		var _xgo_i0 T0 = i0
+//		...
+//		_xgo_v := _xgo_x.XGo_Index(_xgo_i0, ...)
+//		_xgo_v op= rhs
+//		_xgo_x.XGo_IndexSet(_xgo_i0, ..., _xgo_v)
+//	}
+func compileIndexOpAssignOp(ctx *blockCtx, lhs ast.Expr, op *lhsOperand, tok token.Token, rhs ast.Expr, src ast.Node) {
+	cb := ctx.cb
+	stk := cb.InternalStack()
+	stk.Push(op.x)
+	getter := indexOp(ctx, indexGetter)
+	stk.Pop()
+	if getter == nil {
+		panic(ctx.newCodeErrorf(lhs.Pos(), lhs.End(),
+			"invalid operation: %s (type %v has no index getter)", ctx.LoadExpr(lhs), op.x.Type))
+	}
+	indices := indicesOf(unparen(lhs))
+	checkIndexCount(ctx, lhs, getter, len(indices), 0)
+	checkIndexCount(ctx, lhs, op.setter, len(indices), 1)
+	const (
+		nameX = "_xgo_x"
+		nameV = "_xgo_v"
+	)
+	defer tempBlock(ctx)()
+	newOperandTemp(ctx, nameX, op.x, getter, op.setter)
+	names := make([]string, len(indices))
+	for i, idx := range indices {
+		names[i] = "_xgo_i" + strconv.Itoa(i)
+		newTemp(ctx, names[i], paramType(getter, i), func() {
+			compileExpr(ctx, 1, idx)
+		})
+	}
+	newTemp(ctx, nameV, nil, func() {
+		cb.VarVal(nameX).MemberVal(indexGetter, 0, lhs)
+		for _, name := range names {
+			cb.VarVal(name)
+		}
+		cb.CallWith(len(names), 1, 0, lhs)
+	})
+	cb.VarRef(nameV)
+	if tok == token.INC || tok == token.DEC {
+		cb.IncDec(gotoken.Token(tok), src)
+	} else {
+		compileExpr(ctx, 1, rhs)
+		cb.AssignOp(gotoken.Token(tok), src)
+	}
+	cb.VarVal(nameX).MemberVal(indexSetter, 0, lhs)
+	for _, name := range names {
+		cb.VarVal(name)
+	}
+	cb.VarVal(nameV).CallWith(len(names)+1, 0, 0, src).EndStmt()
+}
+
+const (
+	targetBlank  = iota // _
+	targetVar           // variable
+	targetSetter        // x[i, ...] with an index setter
+	targetIndex         // a[i] of an array, slice or map
+	targetField         // x.f
+	targetElem          // *p
+)
+
+// assignTarget is a left-hand side of an assignment with several targets.
+type assignTarget struct {
+	expr    ast.Expr
+	kind    int
+	x       string   // temporary holding the operand
+	indices []string // temporaries holding the indices
+	val     string   // temporary holding the assigned value
+	sel     string
+	typ     types.Type // type of the assigned value, nil if unknown
+}
+
+// compileIndexOpMultiAssign compiles an assignment with several targets where
+// at least one is an index expression with an index setter. The operands and
+// indices of all targets and then all values are evaluated into temporaries,
+// from left to right; after that the assignments are carried out in order.
+func compileIndexOpMultiAssign(ctx *blockCtx, expr *ast.AssignStmt, ops []*lhsOperand) {
+	cb := ctx.cb
+	stk := cb.InternalStack()
+	nl, nr := len(expr.Lhs), len(expr.Rhs)
+	if nr != 1 && nr != nl {
+		panic(ctx.newCodeErrorf(expr.Pos(), expr.End(), "assignment mismatch: %d variables but %d values", nl, nr))
+	}
+	defer tempBlock(ctx)()
+	targets := make([]assignTarget, nl)
+	for i, lhs := range expr.Lhs {
+		t := &targets[i]
+		prefix := "_xgo_" + strconv.Itoa(i)
+		t.expr, t.x, t.val = lhs, prefix+"x", prefix+"v"
+		switch v := unparen(lhs).(type) {
+		case *ast.Ident:
+			if v.Name == "_" {
+				t.kind = targetBlank
+				break
+			}
+			t.kind = targetVar
+			compileExprLHS(ctx, v)
+			t.typ, _ = gogen.DerefType(stk.Pop().Type)
+		case *ast.IndexExpr, *ast.IndexListExpr:
+			op := ops[i]
+			indices := indicesOf(v)
+			if op.setter != nil {
+				checkIndexCount(ctx, lhs, op.setter, len(indices), 1)
+				t.kind = targetSetter
+				newOperandTemp(ctx, t.x, op.x, op.setter)
+				for j, idx := range indices {
+					name := prefix + "i" + strconv.Itoa(j)
+					newTemp(ctx, name, paramType(op.setter, j), func() {
+						compileExpr(ctx, 1, idx)
+					})
+					t.indices = append(t.indices, name)
+				}
+				t.typ = paramType(op.setter, len(indices))
+				break
+			}
+			if len(indices) != 1 {
+				panic(ctx.newCodeErrorf(v.Pos(), v.End(), "invalid operation: more than one index"))
+			}
+			var keyType types.Type
+			addr := false
+			switch u := op.x.Type.Underlying().(type) {
+			case *types.Array:
+				addr, t.typ = true, u.Elem()
+			case *types.Slice:
+				t.typ = u.Elem()
+			case *types.Map:
+				keyType, t.typ = u.Key(), u.Elem()
+			case *types.Pointer:
+				if a, ok := u.Elem().Underlying().(*types.Array); ok {
+					t.typ = a.Elem()
+				}
+			}
+			if t.typ == nil {
+				panic(ctx.newCodeErrorf(v.Pos(), v.End(), "cannot assign to %s", ctx.LoadExpr(v)))
+			}
+			t.kind = targetIndex
+			newTemp(ctx, t.x, nil, func() {
+				stk.Push(op.x)
+				if addr {
+					cb.UnaryOp(gotoken.AND)
+				}
+			})
+			name := prefix + "i0"
+			newTemp(ctx, name, keyType, func() {
+				compileExpr(ctx, 1, indices[0])
+			})
+			t.indices = []string{name}
+		case *ast.SelectorExpr:
+			if id, ok := v.X.(*ast.Ident); ok {
+				if _, kind := compileIdent(ctx, 1, id, clIdentLHS|clIdentSelectorExpr); kind != objNormal {
+					t.kind = targetVar // pkg.Var
+					compileExprLHS(ctx, v)
+					t.typ, _ = gogen.DerefType(stk.Pop().Type)
+					break
+				}
+			} else {
+				compileExpr(ctx, 1, v.X)
+			}
+			x := stk.Pop()
+			if _, ok := x.Type.(*gogen.TypeType); ok { // T.staticVar
+				t.kind = targetVar
+				compileExprLHS(ctx, v)
+				t.typ, _ = gogen.DerefType(stk.Pop().Type)
+				break
+			}
