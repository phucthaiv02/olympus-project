+			compileExprLHS(ctx, unparen(t.expr))
+		case targetIndex:
+			cb.VarVal(t.x).VarVal(t.indices[0]).IndexRef(1, t.expr)
+		case targetField:
+			cb.VarVal(t.x).MemberRef(t.sel, t.expr)
+		case targetElem:
+			cb.VarVal(t.x).ElemRef()
+		}
+		cb.VarVal(t.val).AssignWith(1, 1, t.expr)
+	}
+}
