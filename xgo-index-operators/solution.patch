+			t.typ, _ = gogen.DerefType(stk.Pop().Type)
+		default:
+			panic(ctx.newCodeErrorf(lhs.Pos(), lhs.End(), "cannot assign to %s", ctx.LoadExpr(lhs)))
+		}
+	}
+	if nr == nl {
+		for i, rhs := range expr.Rhs {
+			t := &targets[i]
+			if t.kind == targetBlank {
+				cb.VarRef(nil)
+				compileExpr(ctx, 1, rhs)
+				cb.AssignWith(1, 1, rhs)
+				continue
+			}
+			newTemp(ctx, t.val, t.typ, func() {
+				compileAssignValue(ctx, rhs, t.typ, t.expr)
+			})
+		}
+	} else {
+		names := make([]string, nl)
+		for i := range targets {
+			if targets[i].kind == targetBlank {
+				names[i] = "_"
+			} else {
+				names[i] = targets[i].val
+			}
+		}
+		defineTemps(ctx, expr.Pos(), names, func() {
+			compileExpr(ctx, nl, expr.Rhs[0])
+		})
+	}
+	for i := range targets {
+		t := &targets[i]
+		switch t.kind {
+		case targetBlank:
+			continue
+		case targetSetter:
+			cb.VarVal(t.x).MemberVal(indexSetter, 0, t.expr)
+			for _, name := range t.indices {
+				cb.VarVal(name)
+			}
+			cb.VarVal(t.val).CallWith(len(t.indices)+1, 0, 0, t.expr).EndStmt()
+			continue
