+)
+
+// -----------------------------------------------------------------------------
+// go expression (https://github.com/goplus/xgo/issues/2558)
+//
+//	go f(args)
+//
+// is compiled into
+//
+//	func(f F, a0 A0, ...) chan R {
+//		c := make(chan R, 1)
+//		go func() {
+//			c <- f(a0, ...)
+//		}()
+//		return c
+//	}(f, args...)
+//
+// so that the function value and the arguments are evaluated by the calling
+// goroutine, just like in a go statement. R is the result type of f, the tuple
+// of its results if it has more than one, or struct{} if it has none.
+
+const (
+	goExprFunc   = "_xgo_fn"
+	goExprArg    = "_xgo_arg"
+	goExprChan   = "_xgo_ch"
+	goExprResult = "_xgo_ret"
+)
+
+// goExprResultType returns the element type of the channel returned by a go
+// expression whose function has the specified results.
+func goExprResultType(pkg *gogen.Package, results *types.Tuple) types.Type {
+	switch n := results.Len(); n {
+	case 0:
+		return types.NewStruct(nil, nil)
+	case 1:
+		return results.At(0).Type()
+	default:
+		flds := make([]*types.Var, n)
+		for i := 0; i < n; i++ {
+			flds[i] = types.NewField(token.NoPos, pkg.Types, "", results.At(i).Type(), false)
+		}
+		return pkg.NewTuple(false, flds...)
+	}
+}
+
+// goExprCallee returns the signature of the function called by a go expression
+// if it can be evaluated as a function value (that is not generic).
+func goExprCallee(ctx *blockCtx, call *ast.CallExpr) *types.Signature {
+	fn := unparen(call.Fun)
+	switch v := fn.(type) {
+	case *ast.Ident:
+		if o := lookupFuncObj(ctx, v.Name); o != nil {
+			if _, ok := o.(*types.Var); !ok {
+				return nil // a declared function: no need to evaluate it first
+			}
+		}
+	case *ast.SelectorExpr:
+		if id, ok := v.X.(*ast.Ident); ok {
+			if o := lookupFuncObj(ctx, id.Name); o != nil {
+				if _, ok := o.(*types.PkgName); ok {
+					return nil // pkg.Func
+				}
+			} else if _, ok := ctx.findImport(id.Name); ok {
+				return nil // pkg.Func
+			}
+		}
+	}
+	stk := ctx.cb.InternalStack()
+	base := stk.Len()
+	defer stk.SetLen(base)
+	if err := tryCompileExpr(ctx, fn); err != nil {
+		return nil
+	}
+	if stk.Len() != base+1 {
+		return nil
+	}
+	sig, ok := types.Unalias(stk.Get(-1).Type).(*types.Signature)
+	if !ok || sig.TypeParams() != nil {
+		return nil
+	}
+	if sig.Recv() != nil { // method value
+		sig = types.NewSignatureType(nil, nil, nil, sig.Params(), sig.Results(), sig.Variadic())
+	}
+	return sig
+}
+
+func lookupFuncObj(ctx *blockCtx, name string) types.Object {
+	_, o := ctx.cb.Scope().LookupParent(name, gotoken.NoPos)
+	return o
+}
+
+func tryCompileExpr(ctx *blockCtx, expr ast.Expr) (err error) {
+	defer func() {
+		if e := recover(); e != nil {
+			if e2, ok := e.(error); ok {
+				err = e2
+			} else {
+				err = ctx.newCodeErrorf(expr.Pos(), expr.End(), "%v", e)
+			}
+		}
+	}()
+	compileExpr(ctx, 1, expr, clInCallExpr)
+	return nil
+}
+
+// isInlineArg reports whether an argument of a go expression can be evaluated
+// in the new goroutine without any observable difference.
+func isInlineArg(ctx *blockCtx, arg ast.Expr) bool {
+	switch v := unparen(arg).(type) {
+	case *ast.BasicLit, *ast.FuncLit, *ast.ArrowExpr, *ast.LambdaExpr:
+		return true
+	case *ast.CompositeLit:
+		return v.Type == nil
+	case *ast.SliceLit:
+		return true
+	case *ast.Ident:
+		if o := lookupFuncObj(ctx, v.Name); o != nil {
+			switch o.(type) {
+			case *types.Const, *types.Nil, *types.Func:
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func compileArgOf(ctx *blockCtx, arg ast.Expr, typ types.Type) {
+	switch e := unparen(arg).(type) {
+	case *ast.ArrowExpr, *ast.LambdaExpr:
+		sig, err := checkLambdaFuncType(ctx, e, typ, clLambaArgument, arg)
+		if err != nil {
+			panic(err)
+		}
+		compileLambda(ctx, e, sig)
+	case *ast.SliceLit:
+		compileSliceLit(ctx, e, typ)
+	case *ast.CompositeLit:
+		compileCompositeLit(ctx, e, typ, false)
+	default:
+		compileExpr(ctx, 1, arg)
+	}
+}
+
+func checkGoExprCall(ctx *blockCtx, v *ast.GoExpr) {
+	call := v.Call
+	if len(call.Kwargs) > 0 {
+		panic(ctx.newCodeErrorf(v.Pos(), v.End(), "keyword arguments are not supported in go expression"))
+	}
+	if id, ok := unparen(call.Fun).(*ast.Ident); ok {
+		if o := lookupFuncObj(ctx, id.Name); o != nil {
+			switch o.(type) {
+			case *types.Builtin:
+				panic(ctx.newCodeErrorf(v.Pos(), v.End(), "go expression requires function call, not built-in %s", id.Name))
+			case *types.TypeName:
+				panic(ctx.newCodeErrorf(v.Pos(), v.End(), "go expression requires function call, not conversion"))
+			}
+		}
+	}
+}
+
+// compileGoExpr compiles `go f(args)`.
+func compileGoExpr(ctx *blockCtx, v *ast.GoExpr) {
+	checkGoExprCall(ctx, v)
+	if sig := goExprCallee(ctx, v.Call); sig != nil {
+		compileGoExprWithFunc(ctx, v, sig)
+		return
+	}
+	compileGoExprWithCall(ctx, v)
+}
+
+func goExprArgTypes(ctx *blockCtx, v *ast.GoExpr, sig *types.Signature) []types.Type {
+	call := v.Call
+	params := sig.Params()
+	n, ellipsis := params.Len(), call.Ellipsis != token.NoPos
+	ret := make([]types.Type, len(call.Args))
+	for i := range call.Args {
+		switch {
+		case i < n-1 || (i == n-1 && (!sig.Variadic() || ellipsis)):
+			ret[i] = params.At(i).Type()
+		case sig.Variadic() && n > 0:
+			ret[i] = params.At(n - 1).Type().(*types.Slice).Elem()
+		default:
+			panic(ctx.newCodeErrorf(v.Pos(), v.End(),
+				"too many arguments in call to %s", ctx.LoadExpr(call.Fun)))
+		}
+	}
+	if len(call.Args) < n && !(sig.Variadic() && !ellipsis && len(call.Args) == n-1) {
+		panic(ctx.newCodeErrorf(v.Pos(), v.End(),
+			"not enough arguments in call to %s", ctx.LoadExpr(call.Fun)))
+	}
+	if ellipsis && !sig.Variadic() {
+		panic(ctx.newCodeErrorf(v.Pos(), v.End(),
+			"have (...) arguments in call to non-variadic %s", ctx.LoadExpr(call.Fun)))
+	}
+	return ret
+}
+
+// compileGoExprWithFunc compiles a go expression whose function is evaluated as
+// a function value before the goroutine starts.
+func compileGoExprWithFunc(ctx *blockCtx, v *ast.GoExpr, sig *types.Signature) {
+	cb, pkg := ctx.cb, ctx.pkg
+	call := v.Call
+	argTypes := goExprArgTypes(ctx, v, sig)
+	params := make([]*types.Var, 0, len(argTypes)+1)
+	params = append(params, types.NewParam(token.NoPos, pkg.Types, goExprFunc, sig))
+	for i, t := range argTypes {
+		params = append(params, types.NewParam(token.NoPos, pkg.Types, goExprArg+strconv.Itoa(i), t))
+	}
+	elem := goExprResultType(pkg, sig.Results())
+	chanType := types.NewChan(types.SendRecv, elem)
+	results := types.NewTuple(types.NewParam(token.NoPos, pkg.Types, "", chanType))
+	cb.NewClosure(types.NewTuple(params...), results, false).BodyStart(pkg, v)
+	goExprBody(ctx, v, elem, sig.Results().Len(), func() {
+		cb.VarVal(goExprFunc)
+		for i := range argTypes {
+			cb.VarVal(goExprArg + strconv.Itoa(i))
+		}
+		var flags gogen.InstrFlags
+		if call.Ellipsis != token.NoPos {
+			flags = gogen.InstrFlagEllipsis
+		}
+		cb.CallWith(len(argTypes), sig.Results().Len(), flags, call)
+	})
+	cb.End(v)
+	compileExpr(ctx, 1, call.Fun, clInCallExpr)
+	for i, arg := range call.Args {
+		compileArgOf(ctx, arg, argTypes[i])
+	}
+	cb.CallWith(len(params), 1, 0, v)
+}
+
+// compileGoExprWithCall compiles a go expression that calls a declared function
+// (possibly overloaded or generic). The arguments are evaluated before the
+// goroutine starts and the call itself is compiled in the goroutine.
+func compileGoExprWithCall(ctx *blockCtx, v *ast.GoExpr) {
+	cb, pkg := ctx.cb, ctx.pkg
+	call := v.Call
+	stk := cb.InternalStack()
+
+	// result types of the call
+	base := stk.Len()
+	compileCallExpr(ctx, -1, call, 0)
+	var resTuple *types.Tuple
+	if stk.Len() == base+1 {
+		switch t := stk.Get(-1).Type.(type) {
+		case *types.Tuple:
+			resTuple = t
+		default:
+			if t == nil || isVoidType(t) {
+				resTuple = types.NewTuple()
+			} else {
+				resTuple = types.NewTuple(types.NewParam(token.NoPos, nil, "", t))
+			}
+		}
+	} else {
+		resTuple = types.NewTuple()
+	}
+	stk.SetLen(base)
+
+	// arguments evaluated before the goroutine starts
+	newArgs := make([]ast.Expr, len(call.Args))
+	var params []*types.Var
+	var hoisted []ast.Expr
+	for i, arg := range call.Args {
+		if isInlineArg(ctx, arg) {
+			newArgs[i] = arg
+			continue
+		}
+		compileExpr(ctx, 1, arg)
+		t := types.Default(stk.Get(-1).Type)
+		stk.Pop()
+		name := goExprArg + strconv.Itoa(i)
+		params = append(params, types.NewParam(token.NoPos, pkg.Types, name, t))
+		hoisted = append(hoisted, arg)
+		newArgs[i] = &ast.Ident{NamePos: arg.Pos(), Name: name}
+	}
+	newCall := *call
+	newCall.Args = newArgs
+
+	elem := goExprResultType(pkg, resTuple)
+	chanType := types.NewChan(types.SendRecv, elem)
+	results := types.NewTuple(types.NewParam(token.NoPos, pkg.Types, "", chanType))
+	cb.NewClosure(types.NewTuple(params...), results, false).BodyStart(pkg, v)
+	goExprBody(ctx, v, elem, resTuple.Len(), func() {
+		compileCallExpr(ctx, resTuple.Len(), &newCall, 0)
+	})
+	cb.End(v)
+	for _, arg := range hoisted {
+		compileExpr(ctx, 1, arg)
+	}
+	cb.CallWith(len(params), 1, 0, v)
+}
+
+func isVoidType(t types.Type) bool {
+	tup, ok := t.(*types.Tuple)
+	return ok && tup.Len() == 0
+}
+
+// goExprBody generates the body of the closure of a go expression:
+//
+//	c := make(chan R, 1)
+//	go func() { c <- call() }()
+//	return c
+func goExprBody(ctx *blockCtx, v *ast.GoExpr, elem types.Type, nres int, call func()) {
+	cb, pkg := ctx.cb, ctx.pkg
+	chanType := types.NewChan(types.SendRecv, elem)
+	cb.DefineVarStart(token.NoPos, goExprChan).
+		Val(pkg.Builtin().Ref("make")).Typ(chanType).Val(1).CallWith(2, 1, 0).
+		EndInit(1)
+	cb.NewClosure(nil, nil, false).BodyStart(pkg)
+	switch nres {
+	case 0:
+		call()
+		cb.EndStmt()
+		cb.VarVal(goExprChan).StructLit(elem, 0, false).Send()
+	case 1:
+		cb.VarVal(goExprChan)
+		call()
+		cb.Send()
+	default:
+		names := make([]string, nres)
+		for i := range names {
+			names[i] = goExprResult + strconv.Itoa(i)
+		}
+		cb.DefineVarStart(token.NoPos, names...)
+		call()
+		cb.EndInit(1)
+		cb.VarVal(goExprChan)
+		for _, name := range names {
+			cb.VarVal(name)
+		}
+		cb.TupleLit(elem, nres).Send()
+	}
+	cb.End()
+	cb.CallWith(0, 0, 0).Go()
+	cb.VarVal(goExprChan).Return(1)
+}
+
+// -----------------------------------------------------------------------------
+
+// isVoidGoExpr reports whether x is a go expression whose function has no
+// results.
+func isVoidGoExpr(ctx *blockCtx, x ast.Expr) bool {
+	g, ok := unparen(x).(*ast.GoExpr)
+	if !ok {
+		return false
+	}
+	stk := ctx.cb.InternalStack()
+	base := stk.Len()
+	defer stk.SetLen(base)
+	compileGoExpr(ctx, g)
+	ch, ok := types.Unalias(stk.Get(-1).Type).(*types.Chan)
+	if !ok {
+		return false
+	}
+	st, ok := ch.Elem().(*types.Struct)
+	return ok && st.NumFields() == 0 && types.Identical(ch.Elem(), types.NewStruct(nil, nil))
+}
+
+// tupleChanElem returns the tuple element type of the channel typ if it has n
+// fields.
+func tupleChanElem(cb *gogen.CodeBuilder, typ types.Type, n int) *types.Struct {
+	ch, ok := types.Unalias(typ).Underlying().(*types.Chan)
+	if !ok || n < 2 || !cb.IsTupleType(ch.Elem()) {
+		return nil
+	}
+	st := ch.Elem().Underlying().(*types.Struct)
+	if st.NumFields() != n {
+		return nil
+	}
+	return st
+}
+
+// compileTupleRecv compiles <-ch as n values when ch carries tuples of n fields.
+// The channel is on the stack:
+//
+//	func(c chan T) (T0, T1, ...) { t := <-c; return t.X_0, t.X_1, ... }(ch)
+func compileTupleRecv(ctx *blockCtx, st *types.Struct, v ast.Node) {
+	cb, pkg := ctx.cb, ctx.pkg
+	stk := cb.InternalStack()
+	ch := stk.Pop()
+	n := st.NumFields()
+	param := types.NewParam(token.NoPos, pkg.Types, goExprChan, ch.Type)
+	rets := make([]*types.Var, n)
+	for i := 0; i < n; i++ {
+		rets[i] = types.NewParam(token.NoPos, pkg.Types, "", st.Field(i).Type())
+	}
+	cb.NewClosure(types.NewTuple(param), types.NewTuple(rets...), false).BodyStart(pkg)
+	cb.DefineVarStart(token.NoPos, goExprResult).VarVal(goExprChan).UnaryOp(gotoken.ARROW).EndInit(1)
+	for i := 0; i < n; i++ {
+		cb.VarVal(goExprResult).MemberVal(st.Field(i).Name(), 0)
+	}
+	cb.Return(n).End()
+	stk.Push(ch)
+	cb.CallWith(1, n, 0, v)
+}
+
+// selectTupleRecv rewrites a select case `case a, b := <-ch` (or `a, b = <-ch`)
+// receiving tuples into `case t := <-ch` and returns the statement that unpacks
+// t, or nil if the case doesn't receive tuples.
+func selectTupleRecv(ctx *blockCtx, comm ast.Stmt) (ast.Stmt, ast.Stmt) {
+	as, ok := comm.(*ast.AssignStmt)
+	if !ok || len(as.Lhs) < 2 || len(as.Rhs) != 1 {
+		return comm, nil
+	}
+	ue, ok := unparen(as.Rhs[0]).(*ast.UnaryExpr)
+	if !ok || ue.Op != token.ARROW {
+		return comm, nil
+	}
+	stk := ctx.cb.InternalStack()
+	base := stk.Len()
+	compileExpr(ctx, 1, ue.X)
+	st := tupleChanElem(ctx.cb, stk.Get(-1).Type, len(as.Lhs))
+	stk.SetLen(base)
+	if st == nil {
+		return comm, nil
+	}
+	tmp := &ast.Ident{NamePos: as.Pos(), Name: goExprResult}
+	recv := &ast.AssignStmt{Lhs: []ast.Expr{tmp}, TokPos: as.TokPos, Tok: token.DEFINE, Rhs: as.Rhs}
+	rhs := make([]ast.Expr, len(as.Lhs))
+	for i := range rhs {
+		rhs[i] = &ast.SelectorExpr{
+			X:   &ast.Ident{NamePos: as.Pos(), Name: goExprResult},
+			Sel: &ast.Ident{NamePos: as.Pos(), Name: st.Field(i).Name()},
+		}
+	}
+	unpack := &ast.AssignStmt{Lhs: as.Lhs, TokPos: as.TokPos, Tok: as.Tok, Rhs: rhs}
+	return recv, unpack
+}
+
