+}
+
+c := make(chan int)
+fut := go waitFor(c)
+c <- 41
+println <-fut
+in, out := make(chan int), make(chan int)
+done := go relay(in, out)
+in <- 5
+println <-out
+<-done
+println "done"
+`, `42
+50
+done
+`)
+}
+
+func TestArgumentsEvaluatedFirst_39ed2d(t *testing.T) {
+	geRun(t, geFuncs+`
+var calls []string
+
