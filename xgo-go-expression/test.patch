+//go:build !genjs
+
+package cl_test
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/goplus/xgo/cl"
+	"github.com/goplus/xgo/cl/cltest"
+	"github.com/goplus/xgo/format"
+	"github.com/goplus/xgo/parser"
+	"github.com/goplus/xgo/parser/fsx/memfs"
+)
+
+func geGen(src string) (code []byte, err error) {
+	defer func() {
+		if e := recover(); e != nil {
+			err = fmt.Errorf("panic: %v", e)
+		}
+	}()
+	fs := memfs.SingleFile("/foo", "bar.xgo", src)
+	pkgs, err := parser.ParseFSDir(cltest.Conf.Fset, fs, "/foo", parser.Config{Mode: parser.ParseComments})
+	if err != nil {
+		return nil, fmt.Errorf("parse: %w", err)
+	}
+	pkg, err := cl.NewPackage("", pkgs["main"], cltest.Conf)
+	if err != nil {
+		return nil, err
+	}
+	var b bytes.Buffer
+	if err = pkg.WriteTo(&b); err != nil {
+		return nil, err
+	}
+	return b.Bytes(), nil
+}
+
+func geGoRun(code []byte) (string, error) {
+	dir, err := os.MkdirTemp(tmpDir, "ge")
+	if err != nil {
+		return "", err
+	}
+	defer os.RemoveAll(dir)
+	infile := filepath.Join(dir, "main.go")
+	if err = os.WriteFile(infile, code, 0666); err != nil {
+		return "", err
+	}
+	var stdout, stderr bytes.Buffer
+	cmd := exec.Command("go", "run", infile)
+	cmd.Dir = tmpDir
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	if err = cmd.Run(); err != nil {
+		return "", fmt.Errorf("%v\n%s", err, stderr.String())
+	}
+	return stdout.String(), nil
+}
+
+// geRun compiles src, runs the generated program and compares its output.
+func geRun(t *testing.T, src, expected string) {
+	t.Helper()
+	code, err := geGen(src)
+	if err != nil {
+		t.Fatalf("compile failed: %v", err)
+	}
+	result, err := geGoRun(code)
+	if err != nil {
+		t.Fatalf("running the generated code failed: %v\n%s", err, code)
+	}
+	if result != expected {
+		t.Fatalf("=> Result:\n%s\n=> Expected:\n%s\n=> Generated:\n%s", result, expected, code)
+	}
+}
+
+func geErrorLine(src string) int {
+	for i, l := range strings.Split(src, "\n") {
+		if strings.Contains(l, "// ERROR") {
+			return i + 1
+		}
+	}
+	return 0
+}
+
+// geError checks that compiling src fails with a compile (not syntax) error
+// reported on the line marked with `// ERROR`.
+func geError(t *testing.T, src string) {
+	t.Helper()
+	line := geErrorLine(src)
+	if line == 0 {
+		t.Fatal("no // ERROR marker in test source")
+	}
+	_, err := geGen(src)
+	if err == nil {
+		t.Fatalf("compiling succeeded, want an error on line %d:\n%s", line, src)
+	}
+	msg := err.Error()
+	if strings.HasPrefix(msg, "panic: ") || strings.HasPrefix(msg, "parse: ") {
+		t.Fatalf("want a compile error on line %d, got: %v", line, err)
+	}
+	if want := fmt.Sprintf("bar.xgo:%d:", line); !strings.Contains(msg, want) {
+		t.Fatalf("want an error reported on line %d (%s), got: %v", line, want, err)
+	}
+}
+
+// geSyntaxError checks that parsing src fails on the line marked with
+// `// ERROR`.
+func geSyntaxError(t *testing.T, src string) {
+	t.Helper()
+	line := geErrorLine(src)
+	if line == 0 {
+		t.Fatal("no // ERROR marker in test source")
+	}
+	fs := memfs.SingleFile("/foo", "bar.xgo", src)
+	_, err := parser.ParseFSDir(cltest.Conf.Fset, fs, "/foo", parser.Config{})
+	if err == nil {
+		t.Fatalf("parsing succeeded, want a syntax error on line %d:\n%s", line, src)
+	}
+	if want := fmt.Sprintf("bar.xgo:%d:", line); !strings.Contains(err.Error(), want) {
+		t.Fatalf("want a syntax error on line %d (%s), got: %v", line, want, err)
+	}
+}
+
+func geOK(t *testing.T, src string) {
+	t.Helper()
+	if _, err := geGen(src); err != nil {
+		t.Fatalf("unexpected error: %v\n%s", err, src)
+	}
+}
+
+const geFuncs = `
+import (
+	"errors"
+	"slices"
+	"strconv"
+)
+
+func sq(x int) int {
+	return x * x
+}
+
+func split(s string) (int, string, error) {
+	n, err := strconv.Atoi(s)
+	return n, "<" + s + ">", err
+}
+
+func pair(a, b string) (string, string) {
+	return b, a
+}
+
+func sum(xs ...int) int {
+	s := 0
+	for _, x := range xs {
+		s += x
+	}
+	return s
+}
+
+var _ = errors.New
+var _ = slices.Max[[]int]
+`
+
+func TestSingleResult_39ed2d(t *testing.T) {
+	geRun(t, geFuncs+`
+fut := go sq(3)
+printf "%T %d\n", fut, cap(fut)
+println <-fut
+x := <-go sq(4)
+println x
+var c chan int = go sq(5)
+println <-c
+`, `chan int 1
+9
+16
+25
+`)
+}
+
+func TestResultIsBuffered_39ed2d(t *testing.T) {
+	geRun(t, strings.Replace(geFuncs, "import (", "import (\n\t\"time\"", 1)+`
+func store(done chan bool, v int) int {
+	done <- true
+	return v
+}
+
+done := make(chan bool)
+fut := go store(done, 7)
+<-done
+deadline := time.Now().Add(10 * time.Second)
+for len(fut) == 0 && time.Now().Before(deadline) {
+	time.Sleep(time.Millisecond)
+}
+println len(fut), cap(fut)
+println <-fut
+`, `1 1
+7
+`)
+}
+
+func TestMultipleResults_39ed2d(t *testing.T) {
+	geRun(t, geFuncs+`
+a, b, err := <-go split("12")
+println a, b, err
+r := <-go split("z")
+println r.0, r.1, r.2 != nil
+var fut chan (int, string, error) = go split("7")
+n, s, e := <-fut
+println n, s, e
+p, q := <-go pair("x", "y")
+println p, q
+`, `12 <12> <nil>
+0 <z> true
+7 <7> <nil>
+y x
+`)
+}
+
+func TestNoResult_39ed2d(t *testing.T) {
+	geRun(t, geFuncs+`
