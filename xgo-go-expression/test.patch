+func TestFormat_39ed2d(t *testing.T) {
+	for _, src := range []string{
+		"fut := go sq(3)\nprintln <-fut\n",
+		"x := <-go obj.Method(a, b...)\n",
+		"println(<-go f(), wait(go g(1)))\n",
+		"select {\ncase a, b, c := <-go split(s):\n\tprintln a, b, c\ncase <-go noop():\n}\n",
+		"go worker(1)\nfutures := []chan int{go sq(1), go sq(2)}\n",
+	} {
+		out, err := format.Source([]byte(src), nil)
+		if err != nil {
+			t.Fatalf("format %q: %v", src, err)
+		}
+		if string(out) != src {
+			t.Fatalf("format %q:\ngot  %q\nwant %q", src, out, src)
+		}
+	}
