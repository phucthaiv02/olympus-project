+func (i *interpreter) evaluateChain(top ast.Node, tc tailCallStatus) (value, error) {
+	var steps []ast.Node
+	var base ast.Node
+	curr := top
+	for {
+		switch n := curr.(type) {
+		case *ast.Index:
+			steps = append(steps, n)
+			curr = n.Target
+		case *ast.Apply:
+			steps = append(steps, n)
+			curr = n.Target
+		case *ast.Slice:
+			steps = append(steps, n)
+			curr = n.Target
+		default:
+			base = curr
+			goto done
+		}
+	}
+done:
+	for l, r := 0, len(steps)-1; l < r; l, r = l+1, r-1 {
+		steps[l], steps[r] = steps[r], steps[l]
+	}
+
+	var currVal value
+	if superNode, ok := base.(*ast.SuperIndex); ok {
+		val, failed, err := i.evalSuperIndexStep(superNode)
+		if err != nil {
+			return nil, err
+		}
+		if failed {
+			return makeValueNull(), nil
+		}
+		currVal = val
+	} else {
+		var err error
+		currVal, err = i.evaluate(base, nonTailCall)
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	for idx, stepNode := range steps {
+		isLast := (idx == len(steps)-1)
+		stepTc := nonTailCall
+		if isLast && tc == tailCall {
+			stepTc = tailCall
+		}
+
+		trace := traceElement{
+			loc:     stepNode.Loc(),
+			context: stepNode.Context(),
+		}
+		oldTrace := i.stack.currentTrace
+		i.stack.clearCurrentTrace()
+		i.stack.setCurrentTrace(trace)
+
+		var nextVal value
+		var failed bool
+		var err error
+
+		switch step := stepNode.(type) {
+		case *ast.Index:
+			nextVal, failed, err = i.evalIndexStep(step, currVal)
+		case *ast.Apply:
+			nextVal, err = i.evalApplyStep(step, currVal, stepTc)
+		case *ast.Slice:
+			nextVal, err = i.evalSliceStep(step, currVal)
+		default:
+			panic(fmt.Sprintf("Unexpected step in chain: %T", stepNode))
+		}
+
+		i.stack.clearCurrentTrace()
+		i.stack.setCurrentTrace(oldTrace)
+
+		if err != nil {
+			return nil, err
+		}
+		if failed {
+			return makeValueNull(), nil
+		}
+		currVal = nextVal
+	}
+
+	return currVal, nil
+}
