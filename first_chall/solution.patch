+
+// InNullSafeChain reports whether node ends an access chain that contains a
+// null-safe step.
+func InNullSafeChain(node ast.Node) bool {
+	for {
+		switch n := node.(type) {
+		case *ast.Index:
+			if n.NullSafe {
+				return true
+			}
+			node = n.Target
+		case *ast.Apply:
+			node = n.Target
+		case *ast.Slice:
+			node = n.Target
+		case *ast.SuperIndex:
+			return n.NullSafe
+		default:
+			return false
+		}
+	}
+}
