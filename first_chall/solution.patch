+		if sb.self == nil || sb.superDepth >= sb.self.uncached.inheritanceSize() {
+			return makeValueNull(), true, nil
+		}
+		err := checkAssertions(i, sb.self)
+		if err != nil {
+			return nil, false, err
+		}
+		var fieldName string
+		if node.Id != nil {
+			fieldName = string(*node.Id)
+		} else {
+			idxVal, err := i.evaluate(node.Index, nonTailCall)
+			if err != nil {
+				return nil, false, err
+			}
+			strVal, err := i.getString(idxVal)
+			if err != nil {
+				return nil, false, err
+			}
+			fieldName = strVal.getGoString()
+		}
+		if !objectHasField(sb, fieldName) {
+			return makeValueNull(), true, nil
+		}
+		val, err := objectIndex(i, sb, fieldName)
+		if err != nil {
+			return nil, false, err
+		}
+		return val, false, nil
+	}
+
+	var fieldName string
+	if node.Id != nil {
+		fieldName = string(*node.Id)
+	} else {
+		index, err := i.evaluate(node.Index, nonTailCall)
+		if err != nil {
+			return nil, false, err
+		}
+		indexStr, err := i.getString(index)
+		if err != nil {
+			return nil, false, err
+		}
+		fieldName = indexStr.getGoString()
+	}
+	val, err := objectIndex(i, i.stack.getSelfBinding().super(), fieldName)
+	if err != nil {
+		return nil, false, err
+	}
+	return val, false, nil
+}
+
+func (i *interpreter) evalIndexStep(node *ast.Index, targetVal value) (value, bool, error) {
+	if node.NullSafe {
+		if _, isNull := targetVal.(*valueNull); isNull {
+			return makeValueNull(), true, nil
+		}
+		var indexVal value
+		if node.Id != nil {
+			indexVal = makeValueString(string(*node.Id))
+		} else {
+			var err error
+			indexVal, err = i.evaluate(node.Index, nonTailCall)
+			if err != nil {
+				return nil, false, err
+			}
+		}
+
+		// Only a missing field or an out-of-range index yields null; every
+		// other mismatch raises the same error as an ordinary access.
+		switch target := targetVal.(type) {
+		case *valueObject:
+			indexString, err := i.getString(indexVal)
+			if err != nil {
+				return nil, false, err
+			}
+			fieldName := indexString.getGoString()
+			if err := checkAssertions(i, target); err != nil {
+				return nil, false, err
+			}
+			if !objectHasField(objectBinding(target), fieldName) {
+				return makeValueNull(), true, nil
+			}
+			val, err := target.index(i, fieldName)
+			if err != nil {
+				return nil, false, err
+			}
+			return val, false, nil
+
+		case *valueArray:
+			indexNum, err := i.getNumber(indexVal)
+			if err != nil {
+				return nil, false, err
+			}
+			if indexNum.value < 0 || indexNum.value >= float64(target.length()) {
+				return makeValueNull(), true, nil
+			}
+			idx := int(indexNum.value)
+			val, err := target.index(i, idx)
+			if err != nil {
+				return nil, false, err
+			}
+			return val, false, nil
+
+		case valueString:
+			indexNum, err := i.getNumber(indexVal)
+			if err != nil {
+				return nil, false, err
+			}
+			if indexNum.value < 0 || indexNum.value >= float64(target.length()) {
+				return makeValueNull(), true, nil
+			}
+			idx := int(indexNum.value)
+			val, err := target.index(i, idx)
+			if err != nil {
+				return nil, false, err
+			}
+			return val, false, nil
+		}
+
+		return nil, false, i.Error(fmt.Sprintf("Value non indexable: %v", reflect.TypeOf(targetVal)))
+	}
+
+	var indexVal value
+	if node.Id != nil {
+		indexVal = makeValueString(string(*node.Id))
+	} else {
+		var err error
+		indexVal, err = i.evaluate(node.Index, nonTailCall)
+		if err != nil {
+			return nil, false, err
+		}
+	}
+
+	switch target := targetVal.(type) {
+	case *valueObject:
+		indexString, err := i.getString(indexVal)
+		if err != nil {
+			return nil, false, err
+		}
+		val, err := target.index(i, indexString.getGoString())
+		if err != nil {
+			return nil, false, err
+		}
+		return val, false, nil
+
+	case *valueArray:
+		indexInt, err := i.getNumber(indexVal)
+		if err != nil {
+			return nil, false, err
+		}
+		val, err := target.index(i, int(indexInt.value))
+		if err != nil {
+			return nil, false, err
+		}
+		return val, false, nil
+
+	case valueString:
+		indexInt, err := i.getNumber(indexVal)
+		if err != nil {
+			return nil, false, err
+		}
+		val, err := target.index(i, int(indexInt.value))
+		if err != nil {
+			return nil, false, err
+		}
+		return val, false, nil
+	}
+
+	return nil, false, i.Error(fmt.Sprintf("Value non indexable: %v", reflect.TypeOf(targetVal)))
+}
+
+func (i *interpreter) evalApplyStep(node *ast.Apply, targetVal value, tc tailCallStatus) (value, error) {
+	function, err := i.getFunction(targetVal)
+	if err != nil {
+		return nil, err
+	}
+	argEnv := i.stack.getCurrentEnv(node)
+	arguments := callArguments{
+		positional: make([]*cachedThunk, len(node.Arguments.Positional)),
+		named:      make([]namedCallArgument, len(node.Arguments.Named)),
+		tailstrict: node.TailStrict,
+	}
+	for idx, arg := range node.Arguments.Positional {
+		arguments.positional[idx] = &cachedThunk{env: &argEnv, body: arg.Expr}
+	}
+	for idx, arg := range node.Arguments.Named {
+		arguments.named[idx] = namedCallArgument{name: arg.Name, pv: &cachedThunk{env: &argEnv, body: arg.Arg}}
+	}
+	return i.evaluateTailCall(function, arguments, tc)
+}
+
+func (i *interpreter) evalSliceStep(node *ast.Slice, targetVal value) (value, error) {
+	slice, err := i.baseStd.index(i, "slice")
+	if err != nil {
+		return nil, err
+	}
+	function, err := i.getFunction(slice)
+	if err != nil {
+		return nil, err
+	}
+	argEnv := i.stack.getCurrentEnv(node)
+	arguments := callArguments{
+		positional: []*cachedThunk{
+			readyThunk(targetVal),
+			{env: &argEnv, body: node.BeginIndex},
+			{env: &argEnv, body: node.EndIndex},
+			{env: &argEnv, body: node.Step},
+		},
+	}
+	return function.call(i, arguments)
+}
