@@ -0,0 +1,492 @@
+package jsonnet
+
+import (
+	"bytes"
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/google/go-jsonnet/ast"
+)
+
+type nullOpCase struct {
+	src  string
+	want string
+}
+
+func checkNullOpCases(t *testing.T, cases []nullOpCase) {
+	t.Helper()
+	for _, c := range cases {
+		out, err := MakeVM().EvaluateAnonymousSnippet("snippet.jsonnet", c.src)
+		if err != nil {
+			t.Errorf("%s: unexpected error: %v", c.src, err)
+			continue
+		}
+		var got, want interface{}
+		if err := json.NewDecoder(strings.NewReader(out)).Decode(&got); err != nil {
+			t.Errorf("%s: invalid output %q: %v", c.src, out, err)
+			continue
+		}
+		if err := json.NewDecoder(strings.NewReader(c.want)).Decode(&want); err != nil {
+			t.Fatalf("%s: invalid expectation %q: %v", c.src, c.want, err)
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("%s: got %s, want %s", c.src, out, c.want)
+		}
+	}
+}
+
+func checkNullOpRuntimeErrors(t *testing.T, srcs []string) {
+	t.Helper()
+	for _, src := range srcs {
+		out, err := MakeVM().EvaluateAnonymousSnippet("snippet.jsonnet", src)
+		if err == nil {
+			t.Errorf("%s: expected an error, got %s", src, out)
+		}
+	}
+}
+
+func TestNullCoalescingValues_d17b50(t *testing.T) {
+	checkNullOpCases(t, []nullOpCase{
+		{`null ?? 1`, `1`},
+		{`2 ?? 1`, `2`},
+		{`false ?? true`, `false`},
+		{`0 ?? 1`, `0`},
+		{`"" ?? "x"`, `""`},
+		{`[] ?? [1]`, `[]`},
+		{`{} ?? {a: 1}`, `{}`},
+		{`null ?? null`, `null`},
+		{`null ?? null ?? 3`, `3`},
+		{`null ?? 4 ?? 5`, `4`},
+		{`local x = null; x ?? {a: 1}`, `{"a": 1}`},
+		{`local f(x) = x ?? "default"; [f(null), f("v")]`, `["default", "v"]`},
+		{`{a: null, b: self.a ?? "d", c: self.b ?? "e"}`, `{"a": null, "b": "d", "c": "d"}`},
+		{`[x ?? 0 for x in [1, null, 3]]`, `[1, 0, 3]`},
+		{`std.length(null ?? [1, 2])`, `2`},
+	})
+}
+
+func TestNullCoalescingIsLazy_d17b50(t *testing.T) {
+	checkNullOpCases(t, []nullOpCase{
+		{`1 ?? error "unreachable"`, `1`},
+		{`false ?? error "unreachable"`, `false`},
+		{`null ?? 1 ?? error "unreachable"`, `1`},
+		{`local f() = error "unreachable"; [] ?? f()`, `[]`},
+		{`{a: 1 ?? error "unreachable"}`, `{"a": 1}`},
+	})
+	checkNullOpRuntimeErrors(t, []string{
+		`null ?? error "reached"`,
+		`(error "left") ?? 1`,
+	})
+}
+
+func TestNullCoalescingPrecedence_d17b50(t *testing.T) {
+	checkNullOpCases(t, []nullOpCase{
+		{`5 ?? 1 + 2`, `5`},
+		{`null ?? 1 + 2`, `3`},
+		{`1 + 2 ?? 5`, `3`},
+		{`1 ?? 2 == 3`, `1`},
+		{`false ?? true || true`, `false`},
+		{`null ?? true && false`, `false`},
+		{`true ?? false && false`, `true`},
+		{`null ?? 1 < 2`, `true`},
+		{`2 ?? 3 * 4`, `2`},
+		{`(null ?? 1) + 2`, `3`},
+		{`(5 ?? 1) + 2`, `7`},
+		{`if null ?? true then "yes" else "no"`, `"yes"`},
+		{`local x = null ?? 2; x * 10`, `20`},
+		{`[null ?? 1, 2 ?? null]`, `[1, 2]`},
+		{`null ?? "a" in {a: 1}`, `true`},
+	})
+}
+
+func TestNullSafeFieldAccess_d17b50(t *testing.T) {
+	checkNullOpCases(t, []nullOpCase{
+		{`null?.a`, `null`},
+		{`{a: 1}?.a`, `1`},
+		{`{a: 1}?.b`, `null`},
+		{`{a: null}?.a`, `null`},
+		{`{a: {b: 2}}?.a?.b`, `2`},
+		{`{a: {b: 2}}.a?.c`, `null`},
+		{`{a:: 3}?.a`, `3`},
+		{`{a::: 4}?.a`, `4`},
+		{`local o = {a: 1}; [o?.a, o?.b]`, `[1, null]`},
+		{`local o = null; o?.a`, `null`},
+		{`{a: {b: null}, c: self.a?.b?.c}`, `{"a": {"b": null}, "c": null}`},
+		{`{x: 1, y: self?.x, z: self?.w}`, `{"x": 1, "y": 1, "z": null}`},
+		{`local o = {} + {a: 5}; o?.a`, `5`},
+		{`[x?.v for x in [{v: 1}, null, {}]]`, `[1, null, null]`},
+	})
+}
+
+func TestNullSafeIndexAccess_d17b50(t *testing.T) {
+	checkNullOpCases(t, []nullOpCase{
+		{`null?.["a"]`, `null`},
+		{`null?.[0]`, `null`},
+		{`{a: 1}?.["a"]`, `1`},
+		{`{a: 1}?.["b"]`, `null`},
+		{`local k = "a"; {a: 7}?.[k]`, `7`},
+		{`[10, 20]?.[0]`, `10`},
+		{`[10, 20]?.[1]`, `20`},
+		{`[10, 20]?.[2]`, `null`},
+		{`[10, 20]?.[-1]`, `null`},
+		{`[10, 20]?.[-0.5]`, `null`},
+		{`[10, 20]?.[0.5]`, `10`},
+		{`[10, 20]?.[1.5]`, `20`},
+		{`"éa"?.[0.5]`, `"é"`},
+		{`"é"?.[1]`, `null`},
+		{`"éa"?.[1]`, `"a"`},
+		{`"日本"?.[2]`, `null`},
+		{`[1]?.[1e100]`, `null`},
+		{`"x"?.[1e100]`, `null`},
+		{`[1, 2]?.[1e15]`, `null`},
+		{`[1]?.[-1e100]`, `null`},
+		{`"x"?.[-1e100]`, `null`},
+		{`[]?.[0]`, `null`},
+		{`"ab"?.[1]`, `"b"`},
+		{`"ab"?.[2]`, `null`},
+		{`""?.[0]`, `null`},
+		{`[[1, 2], [3]]?.[1]?.[1]`, `null`},
+		{`[[1, 2], [3]]?.[0]?.[1]`, `2`},
+		{`{a: [1]}?.a?.[0]`, `1`},
+		{`[{a: 1}]?.[0]?.a`, `1`},
+	})
+}
+
+func TestNullSafeShortCircuitsChain_d17b50(t *testing.T) {
+	checkNullOpCases(t, []nullOpCase{
+		{`local o = null; o?.a.b.c`, `null`},
+		{`local o = null; o?.a[0].b`, `null`},
+		{`local o = null; o?.["a"]["b"][3]`, `null`},
+		{`local o = {}; o?.a.b.c`, `null`},
+		{`local o = {}; o?.a[0]`, `null`},
+		{`local o = [1]; o?.[5].x[0]`, `null`},
+		{`local o = [1]; o?.[1e100].x[0]`, `null`},
+		{`local o = "x"; o?.[1e100][error "unreachable"]`, `null`},
+		{`local o = {a: {b: {c: 1}}}; o?.a.b.c`, `1`},
+		{`local o = {a: {}}; o.a?.b.c.d`, `null`},
+		{`local o = null; o?.f(1)`, `null`},
+		{`local o = null; o?.f(1)(2).g`, `null`},
+		{`local o = {}; o?.f(1)`, `null`},
+		{`local o = {f(x): x + 1}; o?.f(1)`, `2`},
+		{`local o = {f(x): {g: x * 2}}; o?.f(3).g`, `6`},
+		{`local o = {f(): null}; o?.f()?.g`, `null`},
+		{`local f() = null; f()?.a.b`, `null`},
+		{`local f() = {a: {b: 9}}; f()?.a.b`, `9`},
+		{`local o = null; [o?.a.b, 1]`, `[null, 1]`},
+		{`local o = null; o?.a[1:]`, `null`},
+		{`local o = {}; o?.a[1:][0].b`, `null`},
+		{`local o = {a: [1, 2, 3]}; o?.a[1:]`, `[2, 3]`},
+		{`local o = {a: "hello"}; o?.a[1:3]`, `"el"`},
+		{`local s = 2; local o = {a: [1, 2, 3, 4]}; o?.a[::s]`, `[1, 3]`},
+	})
+}
+
+func TestNullSafeSkipsEvaluation_d17b50(t *testing.T) {
+	checkNullOpCases(t, []nullOpCase{
+		{`null?.[error "unreachable"]`, `null`},
+		{`local o = null; o?.a[error "unreachable"]`, `null`},
+		{`local o = null; o?.f(error "unreachable")`, `null`},
+		{`local o = {}; o?.f(error "unreachable")`, `null`},
+		{`local o = {}; o?.a.f(error "a", error "b")[error "c"]`, `null`},
+		{`local o = [1]; o?.[4][error "unreachable"]`, `null`},
+		{`local o = null; o?.f(x=error "unreachable")`, `null`},
+		{`local o = null; o?.a[error "a":error "b":error "c"]`, `null`},
+		{`{b: super?.[error "unreachable"]}`, `{"b": null}`},
+	})
+}
+
+func TestNullSafeChainEnds_d17b50(t *testing.T) {
+	checkNullOpCases(t, []nullOpCase{
+		{`local o = null; (o?.a) ?? 3`, `3`},
+		{`local o = null; o?.a ?? 3`, `3`},
+		{`local o = {a: 0}; o?.a ?? 3`, `0`},
+		{`local cfg = {}; cfg?.server?.port ?? 8080`, `8080`},
+		{`local cfg = {server: {port: 80}}; cfg?.server?.port ?? 8080`, `80`},
+		{`local cfg = null; cfg?.server.port ?? 8080`, `8080`},
+		{`local o = null; o?.a == null`, `true`},
+		{`local o = null; std.type(o?.a)`, `"null"`},
+		{`local o = {a: 2}; o?.a + 1`, `3`},
+	})
+	checkNullOpRuntimeErrors(t, []string{
+		`local o = null; (o?.a).b`,
+		`local o = null; (o?.a)[0]`,
+		`local o = {}; (o?.f)(1)`,
+		`local o = null; o?.a + 1`,
+	})
+}
+
+func TestNullSafeOnlyAtOperator_d17b50(t *testing.T) {
+	checkNullOpCases(t, []nullOpCase{
+		{`{a: {b: 1}}?.a.b`, `1`},
+	})
+	checkNullOpRuntimeErrors(t, []string{
+		`local o = {a: null}; o?.a.b`,
+		`local o = {a: {}}; o?.a.b`,
+		`local o = {a: [1]}; o?.a[3]`,
+		`local o = {f(): null}; o?.f().g`,
+		`local o = {a: null}; o.a?.b.c + o.a.d`,
+		`local o = {a: null}; o?.a[1:]`,
+		`local o = null; (o?.a)[1:]`,
+	})
+}
+
+func TestOrdinaryAccessBeforeNullSafeFails_d17b50(t *testing.T) {
+	checkNullOpCases(t, []nullOpCase{
+		{`{a: {}}.a?.b`, `null`},
+	})
+	checkNullOpRuntimeErrors(t, []string{
+		`{}.a?.b`,
+		`null.a?.b`,
+		`[1][9]?.b`,
+		`{}.f()?.a`,
+		`{}["a"]?.[0]`,
+		`local o = null; o.a?.b`,
+		`local o = {}; o.a?.b ?? 1`,
+	})
+}
+
+func TestNullSafeWrongTypes_d17b50(t *testing.T) {
+	checkNullOpCases(t, []nullOpCase{
+		{`{a: 1}?.a`, `1`},
+	})
+	checkNullOpRuntimeErrors(t, []string{
+		`1?.a`,
+		`true?.a`,
+		`"str"?.a`,
+		`[1]?.a`,
+		`[1]?.["a"]`,
+		`{a: 1}?.[0]`,
+		`"ab"?.["x"]`,
+		`local f() = 1; f?.a`,
+	})
+}
+
+func TestNullSafeDownstreamCallErrorsAreNotSuppressed_d17b50(t *testing.T) {
+	checkNullOpCases(t, []nullOpCase{
+		{`{f(): 3}?.f()`, `3`},
+	})
+	checkNullOpRuntimeErrors(t, []string{
+		`{f(): error "body"}?.f()`,
+		`{f(x): x}?.f(error "argument")`,
+		`{f: 1}?.f()`,
+	})
+}
+
+func TestNullSafeBaseErrorsAreNotSuppressed_d17b50(t *testing.T) {
+	checkNullOpCases(t, []nullOpCase{
+		{`({a: 1})?.a`, `1`},
+		{`(null)?.[0]`, `null`},
+	})
+	checkNullOpRuntimeErrors(t, []string{
+		`(error "base field")?.a`,
+		`(error "base index")?.[error "index must not replace base error"]`,
+	})
+}
+
+func TestNullSafeFieldValueIsEvaluated_d17b50(t *testing.T) {
+	checkNullOpCases(t, []nullOpCase{
+		{`{a: 1, b: error "unrelated"}?.a`, `1`},
+		{`{assert true, a: 1}?.b`, `null`},
+	})
+	checkNullOpRuntimeErrors(t, []string{
+		`{a: error "field"}?.a`,
+		`[error "elem"]?.[0]`,
+		`{assert false : "boom", a: 1}?.b`,
+		`{assert false : "boom", a: 1}?.["b"]`,
+	})
+}
+
+func TestNullSafeSuper_d17b50(t *testing.T) {
+	checkNullOpCases(t, []nullOpCase{
+		{`{a: 1} + {b: super?.a}`, `{"a": 1, "b": 1}`},
+		{`{a: 1} + {b: super?.z}`, `{"a": 1, "b": null}`},
+		{`{a: 1} + {b: super?.["a"], c: super?.["z"]}`, `{"a": 1, "b": 1, "c": null}`},
+		{`{a: {x: 1}} + {a+: {y: super?.x}}`, `{"a": {"x": 1, "y": 1}}`},
+		{`{a: 1} + {b: super?.z.y.x}`, `{"a": 1, "b": null}`},
+		{`{a: 1} + {b: super?.z ?? "none"}`, `{"a": 1, "b": "none"}`},
