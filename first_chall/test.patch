+func TestNullOperatorsEvaluateOperandsOnce_d17b50(t *testing.T) {
+	cases := []struct {
+		src    string
+		want   string
+		calls  int
+		traces int
+	}{
+		{`std.native("tick")(1) ?? 2`, `1`, 1, 0},
+		{`std.native("tick")(false) ?? true`, `false`, 1, 0},
+		{`null ?? std.native("tick")(2)`, `2`, 1, 0},
+		{`std.native("tick")(null) ?? std.native("tick")(3)`, `3`, 2, 0},
+		{`std.trace("left", 1) ?? 2`, `1`, 0, 1},
+		{`null ?? std.trace("right", 2)`, `2`, 0, 1},
+		{`std.native("tick")({a: 1})?.a`, `1`, 1, 0},
+		{`std.native("tick")({a: {b: [4, 5]}})?.a?.b?.[1]`, `5`, 1, 0},
+		{`std.native("tick")(null)?.a.b`, `null`, 1, 0},
+		{`std.native("tick")([7, 8])?.[1]`, `8`, 1, 0},
+		{`std.native("tick")("xy")?.[1]`, `"y"`, 1, 0},
+		{`(std.native("tick")({a: 1}))?.a`, `1`, 1, 0},
+		{`(std.native("tick")([1, 2]))?.[0]`, `1`, 1, 0},
+		{`({a: 1} + std.native("tick")({b: 2}))?.b`, `2`, 1, 0},
+		{`(std.trace("receiver", {a: {b: 3}}))?.a.b`, `3`, 0, 1},
+		{`std.trace("receiver", {a: 1})?.a`, `1`, 0, 1},
+		{`std.trace("receiver", {f(x): x + 1})?.f(1)`, `2`, 0, 1},
+		{`std.trace("receiver", {a: [1, 2, 3]})?.a[1:]`, `[2, 3]`, 0, 1},
+		{`{a: 1}?.[std.native("tick")("a")]`, `1`, 1, 0},
+		{`{a: 1}?.[std.native("tick")("b")]`, `null`, 1, 0},
+		{`[5, 6]?.[std.native("tick")(1)]`, `6`, 1, 0},
+		{`[5, 6]?.[std.native("tick")(2)]`, `null`, 1, 0},
+		{`"ab"?.[std.trace("selector", 0)]`, `"a"`, 0, 1},
+		{`{a: {b: 2}}?.a[std.native("tick")("b")]`, `2`, 1, 0},
+		{`{a: 1} + {b: super?.[std.native("tick")("a")]}`, `{"a": 1, "b": 1}`, 1, 0},
+		{`{a: 1} + {b: super?.[std.trace("selector", "z")]}`, `{"a": 1, "b": null}`, 0, 1},
+		{`std.native("tick")({a: null})?.a ?? std.native("tick")(4)`, `4`, 2, 0},
+		{`std.native("tick")({a: 0})?.a ?? std.native("tick")(4)`, `0`, 1, 0},
+	}
+	for _, c := range cases {
+		out, calls, traces := evaluateCountingCalls(t, c.src)
+		var got, want interface{}
+		if err := json.Unmarshal([]byte(out), &got); err != nil {
+			t.Errorf("%s: invalid output %q: %v", c.src, out, err)
+			continue
+		}
+		if err := json.Unmarshal([]byte(c.want), &want); err != nil {
+			t.Fatalf("%s: invalid expectation %q: %v", c.src, c.want, err)
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("%s: got %s, want %s", c.src, out, c.want)
+		}
+		if calls != c.calls {
+			t.Errorf("%s: native function called %d times, want %d", c.src, calls, c.calls)
+		}
+		if traces != c.traces {
+			t.Errorf("%s: traced %d times, want %d", c.src, traces, c.traces)
+		}
+	}
+}
