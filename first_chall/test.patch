+func TestNullSafeSliceStepImports_d17b50(t *testing.T) {
+	vm := MakeVM()
+	vm.Importer(&MemoryImporter{Data: map[string]Contents{
+		"main.jsonnet": MakeContents(`
+local o = {a: [1, 2, 3, 4, 5]};
+[
+  o?.a[::import "step.libsonnet"],
+  o?.a[::std.length(importstr "step.txt")],
+  o?.a[::std.length(importbin "step.bin")],
+]
+`),
+		"step.libsonnet":   MakeContents(`(import "nested.libsonnet") + 1`),
+		"nested.libsonnet": MakeContents(`1`),
+		"step.txt":         MakeContents(`abc`),
+		"step.bin":         MakeContentsRaw([]byte{1, 2, 3, 4}),
+	}})
+
+	out, err := vm.EvaluateFile("main.jsonnet")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got interface{}
+	if err := json.Unmarshal([]byte(out), &got); err != nil {
+		t.Fatalf("invalid output %q: %v", out, err)
+	}
+	want := []interface{}{
+		[]interface{}{1.0, 3.0, 5.0},
+		[]interface{}{1.0, 4.0},
+		[]interface{}{1.0, 5.0},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("got %s, want %v", out, want)
+	}
+
+	deps, err := vm.FindDependencies("", []string{"main.jsonnet"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	wantDeps := []string{"nested.libsonnet", "step.bin", "step.libsonnet", "step.txt"}
+	if !reflect.DeepEqual(deps, wantDeps) {
+		t.Errorf("got dependencies %v, want %v", deps, wantDeps)
+	}
+}
diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..edfe41c
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,73 @@
+#!/usr/bin/env bash
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+#   base  run the existing test suites of every package.
+#   new   run the tests for the null-coalescing and null-safe access operators.
+set -uo pipefail
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  if [ -z "${2:-}" ]; then
+    echo "--output_path requires a value" >&2
+    exit 2
+  fi
+  case "$2" in
+    /*) OUTPUT_PATH="$2" ;;
+    *) OUTPUT_PATH="$PWD/$2" ;;
+  esac
+  shift 2
+fi
+
+MODE="${1:-new}"
+
+cd /app || exit 1
+
+TEST_LOG="$(mktemp)"
+trap 'rm -f "$TEST_LOG"' EXIT
+STATUS=0
+
+run_tests() {
+  go test -count=1 -v "$@" 2>&1 | tee -a "$TEST_LOG"
+  local status=${PIPESTATUS[0]}
+  if [ "$status" -ne 0 ]; then
+    STATUS=$status
+  fi
+}
+
+case "$MODE" in
+  base)
+    if ! pkgs=$(go list ./...); then
+      echo "failed to list packages" >&2
+      exit 1
+    fi
+    for pkg in $pkgs; do
+      if ! listing=$(go test -list '.*' "$pkg" 2>&1); then
+        printf '%s\n' "$listing" | tee -a "$TEST_LOG"
+        echo "failed to discover tests in $pkg" >&2
+        STATUS=1
+        continue
+      fi
+      names=$(printf '%s\n' "$listing" | grep -E '^(Test|Example|Fuzz)' | grep -v '_d17b50$' | paste -sd'|' -)
+      if [ -n "$names" ]; then
+        run_tests -run "^(${names})\$" "$pkg"
+      fi
+    done
+    ;;
+  new)
+    run_tests -run '_d17b50$' . ./formatter/ ./linter/
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  if ! mkdir -p "$(dirname "$OUTPUT_PATH")" || ! go-junit-report < "$TEST_LOG" > "$OUTPUT_PATH" || [ ! -s "$OUTPUT_PATH" ]; then
+    echo "failed to write JUnit report to $OUTPUT_PATH" >&2
+    exit 1
+  fi
+fi
+
+exit "$STATUS"
