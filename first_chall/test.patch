+package linter
+
+import (
+	"strings"
+	"testing"
+
+	jsonnet "github.com/google/go-jsonnet"
+)
+
+func TestLintNullOperators_d17b50(t *testing.T) {
+	snippets := []string{
+		"local o = { a: 1 };\no?.a ?? 2\n",
+		"local d = 5;\nnull ?? d\n",
+		"local o = null;\no?.f(1)\n",
+		"local o = null;\no?.a.b ?? 3\n",
+		"local o = { a: 1 };\no?.b\n",
+		"local o = { a: 1 };\no?.b.c.d\n",
+		"local o = null;\no?.['a']\n",
+		"local o = [1];\nlocal i = 2;\no?.[i] ?? 0\n",
+		"local f(x) = x?.y ?? 0;\nf({ y: 1 }) + f(null)\n",
+		"{ a: 1 } + { b: super?.a ?? 0, c: super?.z }\n",
+		"local cfg = { server: { port: 80 } };\ncfg?.server?.port ?? 8080\n",
+		"local o = null;\no?.a[1:]\n",
+		"local o = { a: [1, 2] };\no?.a[1:][0] ?? 0\n",
+		"{ b: super?.['a'] ?? 0 }\n",
+		"local o = null;\no?.a[error 'unreachable']\n",
+		"local o = {};\no?.a[error 'unreachable']\n",
+		"local o = [1];\no?.[5][error 'unreachable']\n",
+		"local o = null;\no?.f(1)[error 'unreachable']\n",
+		"local o = null;\no?.a.b(1, 2, 3).c[error 'a'][error 'b']\n",
+		"local o = null;\no?.a[error 'unreachable'] ?? 0\n",
+		"{ b: super?.a[error 'unreachable'] }\n",
+		"local s = 2;\nlocal o = { a: [1, 2, 3] };\no?.a[::s]\n",
+		"local o = { a: [1, 2, 3] };\nlocal f(s) = o?.a[::s];\nf(2)\n",
+		"local s = 2;\nlocal o = null;\no?.a[1:][::s]\n",
+	}
+	for _, code := range snippets {
+		var out strings.Builder
+		found := LintSnippet(jsonnet.MakeVM(), &out, []Snippet{{FileName: "snippet.jsonnet", Code: code}})
+		if found || out.Len() > 0 {
+			t.Errorf("%q: unexpected problems reported:\n%s", code, out.String())
+		}
+	}
+}
+
+func TestLintNullSafeSliceStepImports_d17b50(t *testing.T) {
+	vm := jsonnet.MakeVM()
+	vm.Importer(&jsonnet.MemoryImporter{Data: map[string]jsonnet.Contents{
+		"lib.libsonnet": jsonnet.MakeContents("{ step: 2 }\n"),
+		"step.txt":      jsonnet.MakeContents("ab"),
+	}})
+	snippets := []string{
+		"local lib = import 'lib.libsonnet';\nlocal o = { a: [1, 2, 3] };\no?.a[::lib.step]\n",
+		"local s = importstr 'step.txt';\nlocal o = null;\no?.a[::std.length(s)]\n",
+	}
+	for _, code := range snippets {
+		var out strings.Builder
+		found := LintSnippet(vm, &out, []Snippet{{FileName: "snippet.jsonnet", Code: code}})
+		if found || out.Len() > 0 {
+			t.Errorf("%q: unexpected problems reported:\n%s", code, out.String())
+		}
+	}
+}
+
+func TestLintStillReportsOutsideSkippedChain_d17b50(t *testing.T) {
+	cases := []struct {
+		code string
+		want string
+	}{
+		{"local o = { a: 1 };\no.b?.c\n", `Indexed object has no field "b"`},
+		{"{}.a?.b\n", `Indexed object has no field "a"`},
+		{"local o = { a: { b: 1 } };\no.a.c?.d\n", `Indexed object has no field "c"`},
+		{"local o = { f(x): x };\no.f(1, 2)?.a\n", "Too many arguments"},
+		{"local o = { a: 1 };\n(o?.a)[{}]\n", "Index is neither a number"},
+	}
+	for _, c := range cases {
+		var out strings.Builder
+		found := LintSnippet(jsonnet.MakeVM(), &out, []Snippet{{FileName: "snippet.jsonnet", Code: c.code}})
+		if !found || !strings.Contains(out.String(), c.want) {
+			t.Errorf("%q: expected a problem containing %q, got:\n%s", c.code, c.want, out.String())
+		}
+	}
+}
