+package formatter
+
+import (
+	"testing"
+)
+
+func TestFormatNullOperators_d17b50(t *testing.T) {
+	cases := []struct {
+		input string
+		want  string
+	}{
+		{"null??1\n", "null ?? 1\n"},
+		{"null   ??   1\n", "null ?? 1\n"},
+		{"null ?? null ?? 1\n", "null ?? null ?? 1\n"},
+		{"(null ?? 1) + 2\n", "(null ?? 1) + 2\n"},
+		{"local o = null;\no?.a.b ?? 2\n", "local o = null;\no?.a.b ?? 2\n"},
+		{"local o = null;\no?.a?.[0]?.b\n", "local o = null;\no?.a?.[0]?.b\n"},
+		{"local o = {};\no?.[0]?.f(1, 2)\n", "local o = {};\no?.[0]?.f(1, 2)\n"},
+		{"local o = {a: 1};\no?.[1]\n", "local o = { a: 1 };\no?.[1]\n"},
+		{"local o = null;\no?.a[1:]\n", "local o = null;\no?.a[1:]\n"},
+		{"{a: 1} + {b: super?.a ?? 0}\n", "{ a: 1 } + { b: super?.a ?? 0 }\n"},
+		{"local f(x) = x?.y ?? 0;\nf(null)\n", "local f(x) = x?.y ?? 0;\nf(null)\n"},
+		{"local x = null;\n{\n  a: x?.b,\n  c: x ?? 2,\n}\n", "local x = null;\n{\n  a: x?.b,\n  c: x ?? 2,\n}\n"},
+		{"local o = { f(x, y): x };\no?.f(1,\n2)\n", "local o = { f(x, y): x };\no?.f(1,\n     2)\n"},
+		{"local o = [1];\no?.[0 +\n0]\n", "local o = [1];\no?.[0 +\n    0]\n"},
+		{"{ f(x, y): x } + { b: super?.f(1,\n2) }\n", "{ f(x, y): x } + { b: super?.f(1,\n                               2) }\n"},
+		{"{ a: 1 } + { b: super?.['a' +\n''] }\n", "{ a: 1 } + { b: super?.['a' +\n                        ''] }\n"},
+	}
+	for _, c := range cases {
+		got, err := Format("snippet.jsonnet", c.input, DefaultOptions())
+		if err != nil {
+			t.Errorf("%q: unexpected error: %v", c.input, err)
+			continue
+		}
+		if got != c.want {
+			t.Errorf("%q: got %q, want %q", c.input, got, c.want)
+		}
+	}
+}
+
+func TestFormatNullSafeSuperIndex_d17b50(t *testing.T) {
+	const input = "{ b: super?.[ 'a' ] }\n"
+	const want = "{ b: super?.['a'] }\n"
+	got, err := Format("snippet.jsonnet", input, DefaultOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
