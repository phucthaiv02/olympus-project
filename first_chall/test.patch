+		{`{a: 1} + {a: 2} + {b: super?.a}`, `{"a": 2, "b": 2}`},
+		{`{a:: 1} + {b: super?.a}`, `{"b": 1}`},
+		{`{b: super?.a}`, `{"b": null}`},
+		{`{b: super?.a.c[0]}`, `{"b": null}`},
+		{`{a: [1, 2]} + {b: super?.a[1:]}`, `{"a": [1, 2], "b": [2]}`},
