+            "page_rst.rst": RST_SAME_LEVEL,
+        },
+        "text",
+    )
+    content = text(app, "page")
+    assert content == text(app, "page_rst")
+    assert "Peer Hidden" in content
+    assert "Child Of Peer" in content
+    assert "Peer Shown" not in content
