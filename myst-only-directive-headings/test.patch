+MD_SAME_LEVEL = """
+    # Doc
+
+    ## Sec One
+
+    one body
+
+    ```{only} not html
+    ## Peer Hidden
+
+    peer body
+
+    ### Child Of Peer
+
+    child body
+    ```
+
+    after only in one
+
+    ## Sec Two
+
+    ```{only} html
+    ## Peer Shown
+
+    shown body
+    ```
+
+    after only in two
+    """
+
+RST_SAME_LEVEL = """
+    Doc
+    ===
+
+    Sec One
+    -------
+
+    one body
+
+    .. only:: not html
+
+       Peer Hidden
+       -----------
+
+       peer body
+
+       Child Of Peer
+       ~~~~~~~~~~~~~
+
+       child body
+
+    after only in one
+
+    Sec Two
+    -------
+
+    .. only:: html
+
+       Peer Shown
+       ----------
+
+       shown body
+
+    after only in two
+    """
+
