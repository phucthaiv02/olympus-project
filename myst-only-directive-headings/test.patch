+def test_only_higher_level_heading_matches_rst(tmp_path):
+    md = """
+        # Doc
+
+        ## Part A
+
+        a body
+
+        ### Part A1
+
+        a1 body
+
+        ```{only} not html
+        ## Part B
+
+        b body
+
+        ### Part B1
+
+        b1 body
+        ```
+
+        still in a1
+
+        ## Part C
+
+        c body
+        """
+    rst = """
+        Doc
+        ===
+
+        Part A
+        ------
+
+        a body
+
+        Part A1
+        ~~~~~~~
+
+        a1 body
+
+        .. only:: not html
+
+           Part B
+           ------
+
+           b body
+
+           Part B1
+           ~~~~~~~
+
+           b1 body
+
+        still in a1
+
+        Part C
+        ------
+
+        c body
+        """
+    app = build(
+        tmp_path,
+        {"index.rst": DOCS_WITH_TOCTREE, "page.md": md, "page_rst.rst": rst},
+    )
+    expected = [
+        (
+            "section",
+            "Doc",
+            [
+                (
+                    "section",
+                    "Part A",
+                    [
+                        ("p", "a body"),
+                        (
+                            "section",
+                            "Part A1",
+                            [("p", "a1 body"), ("p", "still in a1")],
+                        ),
+                    ],
+                ),
+                (
+                    "only",
+                    "not html",
+                    [
+                        (
+                            "section",
+                            "Part B",
+                            [
+                                ("p", "b body"),
+                                ("section", "Part B1", [("p", "b1 body")]),
+                            ],
+                        )
+                    ],
+                ),
+                ("section", "Part C", [("p", "c body")]),
+            ],
+        )
+    ]
+    assert doc_outline(app, "page_rst") == expected
+    assert doc_outline(app, "page") == expected
+    content = html(app, "page")
+    for marker in ("Part B", "b body", "Part B1", "b1 body"):
+        assert marker not in content
+    assert "still in a1" in content
