+def test_only_same_level_heading_matches_rst(tmp_path):
+    app = build(
+        tmp_path,
+        {
+            "index.rst": DOCS_WITH_TOCTREE,
+            "page.md": MD_SAME_LEVEL,
+            "page_rst.rst": RST_SAME_LEVEL,
+        },
+    )
+    expected = [
+        (
+            "section",
+            "Doc",
+            [
+                (
+                    "section",
+                    "Sec One",
+                    [("p", "one body"), ("p", "after only in one")],
+                ),
+                (
+                    "only",
+                    "not html",
+                    [
+                        (
+                            "section",
+                            "Peer Hidden",
+                            [
+                                ("p", "peer body"),
+                                ("section", "Child Of Peer", [("p", "child body")]),
+                            ],
+                        )
+                    ],
+                ),
+                ("section", "Sec Two", [("p", "after only in two")]),
+                (
+                    "only",
+                    "html",
+                    [("section", "Peer Shown", [("p", "shown body")])],
+                ),
+            ],
+        )
+    ]
+    assert doc_outline(app, "page_rst") == expected
+    assert doc_outline(app, "page") == expected
+
+
+def test_only_same_level_heading_text_output(tmp_path):
