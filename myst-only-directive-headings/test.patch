+
+                still in first
+
+                ## Second
+
+                second body
+                """
+        },
+    )
+    assert doc_outline(app, "index") == [
+        (
+            "section",
+            "Title",
+            [
+                (
+                    "section",
+                    "First",
+                    [
+                        (
+                            "only",
+                            "not html",
+                            [("section", "Inner", [("p", "inner body")])],
+                        ),
+                        ("p", "still in first"),
+                    ],
+                ),
+                ("section", "Second", [("p", "second body")]),
+            ],
