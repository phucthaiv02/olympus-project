+
+            ### Level three
+
+            three body
+
+            #### Level four
+
+            four body
+
+            ### Another three
+
+            another body
+            ```
+            """
+    }
+    app = build(tmp_path, files)
+    assert doc_outline(app, "index") == [
+        (
+            "section",
+            "Title",
+            [
+                (
+                    "section",
+                    "Section",
+                    [
+                        (
+                            "only",
+                            "not html",
+                            [
+                                ("p", "lead text"),
+                                (
+                                    "section",
+                                    "Level three",
+                                    [
+                                        ("p", "three body"),
+                                        ("section", "Level four", [("p", "four body")]),
+                                    ],
+                                ),
+                                ("section", "Another three", [("p", "another body")]),
+                            ],
+                        )
+                    ],
+                )
+            ],
+        )
+    ]
+    content = html(app)
+    for marker in ("lead text", "Level three", "four body", "Another three"):
+        assert marker not in content
+
