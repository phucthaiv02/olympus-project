+                    "section",
+                    "Section",
+                    [
+                        (
+                            "only",
+                            "not html",
+                            [("section", "Sub", [("p", "sub body")])],
+                        ),
+                        ("p", "after"),
+                    ],
+                )
+            ],
+        )
+    ]
+
