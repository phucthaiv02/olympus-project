+"""Headings in the content of directives that allow section titles,
+such as ``only`` and ``ifconfig``.
+"""
+
+from __future__ import annotations
+
+import re
+from io import StringIO
+from pathlib import Path
+from textwrap import dedent
+
+from docutils import nodes
+from sphinx.application import Sphinx
+
+CONF = """\
+extensions = ["myst_parser", "sphinx.ext.ifconfig"]
+show_flag = False
+
+
+def setup(app):
+    app.add_config_value("show_flag", False, "env")
+"""
+
+
+def build(
+    tmp_path: Path, files: dict[str, str], builder: str = "html", **conf
+) -> Sphinx:
+    src = tmp_path / "src"
+    src.mkdir(exist_ok=True)
+    (src / "conf.py").write_text(CONF)
+    for name, content in files.items():
+        path = src / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(dedent(content).lstrip(), encoding="utf8")
+    app = Sphinx(
+        str(src),
+        str(src),
+        str(tmp_path / "out" / builder),
+        str(tmp_path / "doctrees" / builder),
+        builder,
+        confoverrides=conf,
+        status=StringIO(),
+        warning=StringIO(),
+        freshenv=True,
+    )
+    app.build()
+    return app
+
+
+def html(app: Sphinx, docname: str = "index") -> str:
+    return (Path(app.outdir) / f"{docname}.html").read_text(encoding="utf8")
+
+
+def text(app: Sphinx, docname: str = "index") -> str:
+    return (Path(app.outdir) / f"{docname}.txt").read_text(encoding="utf8")
+
+
+def outline(node: nodes.Node) -> list:
+    """A compact view of the structure of a doctree."""
+    result: list = []
+    for child in node.children:
+        if isinstance(child, nodes.section):
+            result.append(("section", child[0].astext(), outline(child)))
+        elif child.tagname in ("only", "ifconfig"):
+            result.append((child.tagname, child["expr"], outline(child)))
+        elif isinstance(child, nodes.paragraph):
+            result.append(("p", child.astext()))
+    return result
+
+
+def doc_outline(app: Sphinx, docname: str) -> list:
+    return outline(app.env.get_doctree(docname))
+
+
+def toc_titles(app: Sphinx, target: str) -> list[str]:
+    """The titles of the entries for ``target`` in the root toctree."""
+    entries = re.findall(
+        r'class="toctree-l\d+"><a class="reference internal" href="([^"#]*)[^"]*">'
+        r"([^<]*)<",
+        html(app, "index"),
+    )
+    return list(
+        dict.fromkeys(title for href, title in entries if href == f"{target}.html")
+    )
+
+
+DOCS_WITH_TOCTREE = """\
+Root
+====
+
+.. toctree::
+
+   page
+   page_rst
+"""
+
+
+def test_only_heading_excluded(tmp_path):
+    files = {
+        "index.md": """
+            # Title
+
+            ## Section
+
+            text before
+
+            ```{only} not html
+            ### Hidden heading
+
+            hidden body
+            ```
+
+            text after
+            """
+    }
+    app = build(tmp_path, files, "html")
+    content = html(app)
+    assert "Hidden heading" not in content
+    assert "hidden body" not in content
+    assert "text before" in content
+    assert "text after" in content
+
+    app = build(tmp_path, files, "text")
+    content = text(app)
+    assert "Hidden heading" in content
+    assert "hidden body" in content
+
+
+def test_only_heading_kept(tmp_path):
+    files = {
+        "index.md": """
+            # Title
+
+            ```{only} html
+            ## Shown heading
+
+            shown body
+            ```
+            """
+    }
+    app = build(tmp_path, files, "html")
+    content = html(app)
+    assert "Shown heading" in content
+    assert "shown body" in content
+
+    app = build(tmp_path, files, "text")
+    content = text(app)
+    assert "Shown heading" not in content
+    assert "shown body" not in content
+
+
+def test_only_heading_wrapped_in_only_node(tmp_path):
