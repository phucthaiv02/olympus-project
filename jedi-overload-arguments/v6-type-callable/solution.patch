+    def annotation_accepts(self, value):
+        annotation_name = self.py__name__()
+        if annotation_name == 'Type':
+            # A class is accepted if its instances are accepted by the type
+            # given in the index.
+            return value.is_class() and any(
+                annotation.annotation_accepts(instance)
+                for annotation in self._generics_manager[0]
+                for instance in value.execute_annotation(None)
+            )
+        elif annotation_name == 'Callable':
+            if not is_callable(value):
+                return False
+            annotation_generics = self.get_generics()
+            if len(annotation_generics) != 2:
+                return True
+            # The callable also needs to return something the annotation
+            # accepts, if its result is known.
+            results = value.execute_annotation(None)
+            return all(
+                any(annotation.annotation_accepts(result)
+                    for annotation in annotation_generics[1])
+                for result in results
+            )
+        return super().annotation_accepts(value)
