+
+def mapping_items(value):
+    """
+    Returns the keys and the values of a mapping as lists of lazy values. The
+    entries of a dict literal, including the ones unpacked in it with ``**``,
+    and of a dict created with ``dict(...)`` are taken from the code.
+    """
+    pairs = _mapping_pairs(value, frozenset()).values()
+    return ([key for key, _ in pairs if key is not None],
+            [lazy_value for _, lazy_value in pairs if lazy_value is not None])
