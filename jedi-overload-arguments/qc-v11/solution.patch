+def _dict_literal_entries(dct, expanded):
+    """
+    Returns the entries of a dict literal, including the entries of mappings
+    unpacked in it with ``**``.
+    """
+    context = dct._defining_context
+    entries = {}
+    array_node = dct.atom.children[1]
+    if array_node.type != 'dictorsetmaker':
+        return dict(dct.exact_key_items())
+    if array_node.children[-1].type in ('comp_for', 'sync_comp_for'):
+        # A comprehension, the keys are not known.
+        return _value_entries(dct)
+    iterator = iter(array_node.children)
+    for node in iterator:
+        if node == ',':
+            continue
+        if node == '**':
+            mappings = context.infer_node(next(iterator))
+            alternatives = [_mapping_entries(mapping, expanded) for mapping in mappings]
+            if not alternatives:
+                alternatives = [{_UNKNOWN_DICT_ENTRY: LazyKnownValues(NO_VALUES)}]
+        else:
+            next(iterator)  # The colon.
+            lazy_value = LazyTreeValue(context, next(iterator))
+            alternatives = [{_entry_key(key): lazy_value}
+                            for key in context.infer_node(node)]
+            if not alternatives:
+                alternatives = [{_UNKNOWN_DICT_ENTRY: LazyKnownValues(NO_VALUES)}]
+        _update_entries(entries, _merge_alternative_entries(alternatives))
+    return entries
+
