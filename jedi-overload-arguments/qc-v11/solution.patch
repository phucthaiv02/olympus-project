+def _merge_arguments(sequences):
+    """
+    Merges lists of positional arguments of the same length position by
+    position. A merged argument may be missing if one of them may be.
+    """
+    merged = []
+    for lazy_values in zip(*sequences):
+        unique = list({id(v): v for v in lazy_values}.values())
+        lazy_value = get_merged_lazy_value(unique)
+        if len(unique) > 1 and any(isinstance(v, PossiblyMissingLazyValue) for v in unique):
+            lazy_value = PossiblyMissingLazyValue(lazy_value)
+        merged.append(lazy_value)
