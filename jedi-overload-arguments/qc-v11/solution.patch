+
+def _set_pair(pairs, key, pair):
+    """
+    Sets a pair that is surely in the mapping. Like Python, an equal earlier
+    key stays the key of the entry, like ``1`` in ``{1: A, True: C}``, and
+    only the value is replaced. If the earlier entry may be missing, the key
+    may be either of them.
+    """
+    earlier = pairs.get(key)
+    if earlier is not None and type(key) is not object:
+        if _is_possibly_missing(earlier[1]):
+            lazy_keys = [k for k in (earlier[0], pair[0]) if k is not None]
+            moved = _KeyOfMovedEntry(lazy_keys, len(pairs)) if lazy_keys else None
+            pair = (moved, pair[1])
+        elif earlier[0] is not None:
+            pair = (earlier[0], pair[1])
+    pairs[key] = pair
+
+
+def _update_with_alternative_pairs(pairs, alternatives):
+    """
+    Adds the pairs of mappings that are possible values of the same argument,
+    like ``**d`` in a dict literal, after the existing pairs. The pairs with
+    the same statically known key are merged and stay under this key, so that
+    a later entry with the key replaces all of them. A key that only some of
+    the mappings have may be missing, so it does not replace an earlier pair
+    with this key but is merged with it. Otherwise its value is marked as
+    possibly missing, so that a mapping containing this one knows it as well.
+    """
+    merged: dict[Any, list[Any]] = {}
+    for alternative in alternatives:
+        for key, pair in alternative.items():
+            merged.setdefault(key, []).append(pair)
+    for key, new_pairs in merged.items():
+        possibly_missing = any(key not in alternative for alternative in alternatives) \
+            or any(_is_possibly_missing(lazy_value) for _, lazy_value in new_pairs)
+        if not possibly_missing:
+            _set_pair(pairs, key, _merge_pairs(new_pairs))
+        elif key in pairs:
+            # The earlier pair stays possible, and if it may be missing as
+            # well, the key may still be missing.
+            pair = _merge_pairs([pairs[key]] + new_pairs)
+            if _is_possibly_missing(pairs[key][1]):
+                pair = _pair_possibly_missing(pair)
+                if pair[0] is not None:
+                    pair = (_KeyOfMovedEntry([pair[0]], len(pairs)), pair[1])
+            else:
+                # The earlier key is there, so it is the key of the entry.
+                pair = (pairs[key][0], pair[1])
+            pairs[key] = pair
+        else:
+            pairs[key] = _pair_possibly_missing(_merge_pairs(new_pairs))
