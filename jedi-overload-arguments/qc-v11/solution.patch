+        keys: dict[Any, Any] = {}
+        for key_values, _ in items:
+            static_key = _static_key(key_values)
+            if type(static_key) is object:
+                return None
+            keys.setdefault(static_key, LazyKnownValues(key_values))
+        return [(list(keys.values()), True)]
+    if not isinstance(value, iterable.DictLiteralValue):
+        return None
+    entries = []
+    for i, (key, (lazy_key, lazy_value)) in enumerate(
+            _mapping_pairs(value, frozenset()).items()):
+        if lazy_key is None or type(key) is object:
+            return None
+        positions = [i]
+        if isinstance(lazy_key, _KeyOfMovedEntry):
+            if any(isinstance(k, _KeyOfMovedEntry) for k in lazy_key.data):
+                return None
+            # After the entries that were there when it was written.
+            positions.append(lazy_key.later_position - 0.5)
+        maybe_missing = lazy_value is not None and _is_possibly_missing(lazy_value)
+        entries.append((positions, lazy_key, maybe_missing))
+    variants: list[tuple[list[Any], bool]] = []
+    for choice in product(*(positions for positions, _, _ in entries)):
+        ordered = sorted(zip(choice, entries), key=lambda item: item[0])
+        choice_variants: list[tuple[list[Any], bool]] = [([], True)]
+        for _, (_, lazy_key, maybe_missing) in ordered:
+            with_key = [(lazy_keys + [lazy_key], exact)
+                        for lazy_keys, exact in choice_variants]
