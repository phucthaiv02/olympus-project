+
+class _KeyOfMovedEntry(MergedLazyValues):
+    """
+    The key of an entry that replaces an earlier one with an equal key that
+    may be missing. The entry is where the earlier one is, if it is there,
+    and otherwise after the ``later_position`` entries that were there when
+    it was written.
+    """
+    def __init__(self, data, later_position):
+        super().__init__(data)
+        self.later_position = later_position
