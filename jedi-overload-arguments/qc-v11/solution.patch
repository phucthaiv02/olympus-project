+    items = _keys_and_getitem_items(value)
+    if items is not None:
+        lazy_items, exact = items
+        pairs = {}
+        for key, lazy_value in lazy_items:
+            key_set = NO_VALUES if key is None else ValueSet([key])
+            pair_key = _static_key(key_set) if exact else object()
+            _set_pair(pairs, pair_key, (LazyKnownValues(key_set), lazy_value))
+        return pairs
