+
+def _mapping_pairs(value, expanded):
+    """
+    Returns the ``(key, value)`` pairs of a mapping as lazy values in a dict.
+    A pair is stored under its key if the key is known statically, so that
+    a later entry with the same key replaces it like in the actual mapping.
+    Otherwise its key is a unique ``object()``. If keys and values cannot be
+    paired, ``None`` takes the place of the other one. ``expanded`` holds the
+    nodes of the mappings being read, like for ``_mapping_entries``.
+    """
+    from jedi.inference.gradual.base import is_empty_comprehension, comprehension_items
+    unknown_pair = (LazyKnownValues(NO_VALUES), LazyKnownValues(NO_VALUES))
+    node = _mapping_node(value)
+    if node is not None:
+        if node in expanded:
+            # A mapping that contains itself.
+            return {object(): unknown_pair}
+        expanded = expanded | {node}
+    if isinstance(value, iterable.DictLiteralValue):
+        pairs = _dict_literal_pairs(value, expanded)
+        if pairs is not None:
+            return pairs
+    if _is_dict_call(value):
+        return _dict_call_pairs(value, expanded)
+    if is_empty_comprehension(value):
+        return {}
+    iterations = None
+    if getattr(value, 'array_type', None) == 'dict':
+        iterations = comprehension_items(value)
+    if iterations is not None:
+        # Like in a dict literal, a later key replaces an earlier one.
+        pairs = {}
+        for keys, values in iterations:
+            _set_pair(pairs, _static_key(keys), (LazyKnownValues(keys), LazyKnownValues(values)))
