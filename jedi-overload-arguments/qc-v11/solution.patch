+def _star_arg_sequences(context, input_node, funcdef=None, max_length=None):
+    """
+    Returns the possible sequences of the arguments unpacked with ``*``, one
+    for each possible number of arguments and sorted by it, or ``None`` if
+    nothing is known about them. Sequences with the same number of arguments
+    are merged. With ``max_length``, the elements of a sequence of unknown
+    length, like ``tuple[int, ...]``, are any number of arguments up to it.
+    """
+    from jedi.inference.gradual.base import sequence_variants, merge_sequences
+    arrays = context.infer_node(input_node)
+    if not arrays:
+        return None
+    by_length: dict[int, list[Any]] = {}
+    for array in arrays:
+        if array.py__getattribute__('__iter__'):
+            # Unlike ``py__iter__``, this includes what is unpacked with
+            # ``*`` inside a literal, like the ``A`` of ``*[*[A], C]``.
+            sequences = [lazy_values for lazy_values, _ in sequence_variants(array)]
+        else:
+            sequences = [list(_iterate_star_args(context, array, input_node, funcdef))]
+        if max_length is not None:
+            sequences = [expanded for sequence in sequences
+                         for expanded in _expand_repeated(sequence, max_length)]
+        for sequence in sequences:
+            by_length.setdefault(len(sequence), []).append(sequence)
+    return [merge_sequences(sequences) for _, sequences in sorted(by_length.items())]
+
+
+def _expand_repeated(sequence, max_length):
+    """
+    Returns the sequences that ``sequence`` may be, one for each length: each
+    ``RepeatedLazyValue`` stands for zero up to ``max_length`` elements. More
+    arguments than a function has parameters fit it like ``max_length`` of
+    them do, if ``max_length`` is larger than the number of parameters.
+    """
+    from jedi.inference.gradual.base import merge_sequences
+    by_length: dict[int, list[Any]] = {0: []}
+    for lazy_value in sequence:
+        if isinstance(lazy_value, RepeatedLazyValue):
+            options = [[lazy_value.data] * count for count in range(max_length + 1)]
+        else:
+            options = [[lazy_value]]
+        grouped: dict[int, list[Any]] = {}
+        for lazy_values in by_length.values():
+            for option in options:
+                grouped.setdefault(len(lazy_values) + len(option), []) \
+                    .append(lazy_values + option)
+        by_length = {length: merge_sequences(group) for length, group in grouped.items()}
+    return [lazy_values for _, lazy_values in sorted(by_length.items())]
