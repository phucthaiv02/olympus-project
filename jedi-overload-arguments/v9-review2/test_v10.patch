+def test_entries_of_dict_comprehensions(Script):
+    def check_items(call, expected):
+        check(Script, ['dict[str, type[A]]', 'dict[str, type[C]]', 'object'], call, expected,
+              prefix=CONTAINERS)
+
+    # A comprehension over an empty literal holds no entries.
+    check_items('f({"k": C for _ in []})', ['RA'])
+    check_items('f({"k": A, **{"k": C for _ in ()}})', ['RA'])
+    check_items("f({**({k: C for k in ['p']} if random.random() else {})})", ['RB'])
+    check_items("f({**({k: C for k in ['p']} if random.random() else {'p': A})})", ['RC'])
+    code = CONTAINERS + variadic('type[A]', 'type[C]', '**x: %s')
+    call = "f(**({k: C for k in ['p']} if random.random() else {}))"
+    assert infer_result(Script, code + call) == ['RB']
+
+
+def test_entries_that_may_be_missing_in_nested_mappings(Script):
+    prefix = CONTAINERS + dedent('''\
+        d1 = {'p': A} if random.random() else {}
+        d2 = {'p': A} if random.random() else {}
+        d3 = {**d1, **d2}
+        def wrap(d):
+            return {**d}
+        ''')
+
+    def check_items(call, expected):
+        check(Script, ['dict[str, type[A]]', 'dict[str, type[C]]', 'object'], call, expected,
+              prefix=prefix)
+
+    # Neither ``d1`` nor ``d2`` may have the entry.
+    check_items("f({'p': C, **d3})", ['RC'])
+    check_items("f({'p': C, **d3, **{'p': A}})", ['RA'])
+    check_items("f({'p': C, **wrap(d3)})", ['RC'])
+    check_items("f(wrap(wrap({'p': C})))", ['RB'])
+    check_items("f(wrap({'p': A, **wrap({'p': C})}))", ['RB'])
+    code = prefix + variadic('type[A]', 'type[C]', '**x: %s')
+    assert infer_result(Script, code + "f(**{'p': C, **d3})") == ['RA', 'RB']
+
+
+def test_keys_that_are_not_strings(Script):
+    def check_items(key, call, expected):
+        annotations = ['dict[%s, type[A]]' % key, 'dict[%s, type[C]]' % key, 'object']
+        prefix = CONTAINERS + 'k = "a" if random.random() else "a"\n'
+        check(Script, annotations, call, expected, prefix=prefix)
+
+    check_items('type[C]', 'f({C: A, C: C})', ['RB'])
+    check_items('type[C]', 'f({C: A, **{C: C}})', ['RB'])
+    check_items('type', 'f({C: A, B: C})', ['RC'])
+    check_items('tuple[int, int]', 'f({(1, 2): A, (1, 2): C})', ['RB'])
+    check_items('tuple[int, int]', 'f({(1, 2): A, (1, 3): C})', ['RC'])
+    check_items('int', 'f({1: C, True: A})', ['RA'])
+    check_items('str', 'f({"a": A, k: C})', ['RB'])
