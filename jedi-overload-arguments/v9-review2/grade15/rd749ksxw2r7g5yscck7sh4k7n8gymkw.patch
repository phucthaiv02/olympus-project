diff --git a/jedi/inference/gradual/matching.py b/jedi/inference/gradual/matching.py
new file mode 100644
index 0000000..a7614da
--- /dev/null
+++ b/jedi/inference/gradual/matching.py
@@ -0,0 +1,502 @@
+"""Annotation matching and literal contents used by overload resolution."""
+
+from itertools import product
+
+from jedi.inference.base_value import LazyValueWrapper, ValueSet, ValueWrapper
+from jedi.inference.cache import inference_state_method_cache
+from jedi.inference.compiled import builtin_from_name, create_simple_object
+from jedi.inference.gradual.base import GenericClass
+from jedi.inference.gradual.conversion import convert_values
+from jedi.inference.gradual.generics import _resolve_forward_references
+from jedi.inference.gradual.type_var import TypeVar
+from jedi.inference.gradual.typing import AnyClass, Callable, ProxyTypingClassValue, \
+    ProxyWithGenerics, Tuple
+from jedi.inference.lazy_value import LazyKnownValue, LazyKnownValues, LazyTreeValue
+from jedi.inference.value import iterable
+from jedi.parser_utils import get_sync_comp_fors
+
+
+_UNKNOWN = object()
+
+
+class _LiteralValue(ValueWrapper):
+    def __init__(self, value, entries, is_mapping=False):
+        super().__init__(value)
+        self.entries = entries
+        self.is_mapping = is_mapping
+
+
+class _UnboundedMappingKey(ValueWrapper):
+    pass
+
+
+def match_annotations(values, annotations, class_object=False):
+    return AnnotationMatcher().match(values, annotations, class_object)
+
+
+class AnnotationMatcher:
+    def __init__(self, type_vars=None):
+        self._states = [type_vars or {}]
+
+    def match(self, values, annotations, class_object=False):
+        if not annotations:
+            return True
+        if not values:
+            return False
+        for original in values:
+            alternatives = _literal_values(original) if len(annotations) > 1 else (original,)
+            for value in alternatives:
+                states = {}
+                for state in self._states:
+                    for annotation in annotations:
+                        candidate = AnnotationMatcher(dict(state))
+                        if _match_annotation(value, annotation, class_object, candidate):
+                            for matched in candidate._states:
+                                states[frozenset(matched.items())] = matched
+                self._states = list(states.values())
+                if not self._states:
+                    return False
+        return True
+
+    def match_type_var(self, value, annotation, class_object):
+        bound = annotation._bound_lazy_value
+        if bound is not None:
+            values = bound.infer()
+            if values and all(value.get_safe_value(default=_UNKNOWN) is None for value in values):
+                return True
+            classes = _type_var_classes(annotation, bound)
+            return bool(classes) and self.match(ValueSet([value]), classes, class_object)
+        constraints = annotation._constraints_lazy_values
+        if not constraints:
+            return True
+        states = []
+        for state in self._states:
+            for index, constraint in enumerate(constraints):
+                if annotation in state and state[annotation] != index:
+                    continue
+                candidate = AnnotationMatcher(dict(state))
+                candidate._states[0][annotation] = index
+                classes = _type_var_classes(annotation, constraint)
+                if classes and candidate.match(ValueSet([value]), classes, class_object):
+                    states.extend(candidate._states)
+        self._states = states
+        return bool(states)
+
+
+def _type_var_classes(annotation, lazy_value):
+    context = getattr(lazy_value, 'context', annotation.parent_context)
+    return ValueSet(_resolve_forward_references(context, lazy_value.infer()))
+
+
+def _match_annotation(value, annotation, class_object, matcher):
+    if isinstance(annotation, AnyClass):
+        return True
+    if isinstance(annotation, TypeVar):
+        return matcher.match_type_var(value, annotation, class_object)
+
+    if isinstance(annotation, ProxyWithGenerics):
+        name = annotation.py__name__()
+        generics = annotation.get_generics()
+        if name in ('Union', 'Optional'):
+            if name == 'Optional' and value.get_safe_value(default=_UNKNOWN) is None:
+                return True
+            return matcher.match(ValueSet([value]), ValueSet.from_sets(generics), class_object)
+        if name in ('Annotated', 'ClassVar', 'Final'):
+            return not generics or matcher.match(ValueSet([value]), generics[0], class_object)
+        if name == 'Type':
+            return value.is_class() and (
+                not generics or matcher.match(ValueSet([value]), generics[0], True)
+            )
+        if name == 'Tuple':
+            tuple_class = builtin_from_name(annotation.inference_state, 'tuple')
+            if not _matches_class(value, tuple_class, class_object):
+                return False
+            if class_object:
+                if isinstance(value, ProxyWithGenerics) and value.py__name__() == 'Tuple':
+                    return matcher.match(value.execute_annotation(None), ValueSet([annotation]))
+                return True
+            variants = sequence_variants(value)
+            if annotation._generics_manager.is_homogenous_tuple():
+                return _match_sequence(value, generics[0], variants, matcher)
+            if variants is None:
+                return False
+            return all(
+                len(entries) == len(generics)
+                and all(matcher.match(entry.infer(), expected)
+                        for entry, expected in zip(entries, generics))
+                for entries in variants
+            )
+        if name == 'Callable':
+            return _is_callable(value) and (
+                len(generics) < 2 or matcher.match(value.execute_annotation(None), generics[1])
+            )
+        return False
+
+    if isinstance(annotation, ProxyTypingClassValue):
+        name = annotation.py__name__()
+        if name == 'Callable':
+            return _is_callable(value)
+        if name in ('Type', 'Tuple'):
+            expected = builtin_from_name(annotation.inference_state, name.lower())
+            return _matches_class(value, expected, class_object)
+
+    if annotation.get_safe_value(default=_UNKNOWN) is None:
+        return value.get_safe_value(default=_UNKNOWN) is None
+    if not annotation.is_class():
+        return False
+
+    expected_class = _origin_class(annotation)
+    if not _matches_class(value, expected_class, class_object):
+        return False
+    if not isinstance(annotation, GenericClass):
+        return True
+
+    generics = annotation.get_generics()
+    if not generics:
+        return True
+    name = annotation.py__name__()
+    if not class_object and name in ('list', 'set', 'frozenset', 'Iterable', 'Sequence',
+                                     'MutableSequence', 'Collection', 'Iterator'):
+        return _match_sequence(value, generics[0], sequence_variants(value), matcher)
+    if not class_object and name in ('dict', 'Mapping', 'MutableMapping', 'OrderedDict'):
+        variants = mapping_variants(value)
+        if variants is not None:
+            return all(
+                matcher.match(ValueSet([key]), generics[0])
+                and matcher.match(entry.infer(), generics[1])
+                for entries in variants for key, entry in entries
+            )
+
+    actual_class = value if class_object else value.py__class__()
+    for candidate in actual_class.py__mro__():
+        if isinstance(candidate, GenericClass) \
+                and _origin_class(candidate).is_same_class(expected_class):
+            actual_generics = candidate.get_generics()
+            return len(actual_generics) == len(generics) and all(
+                matcher.match(actual.execute_annotation(None), expected)
+                for actual, expected in zip(actual_generics, generics)
+            )
+    return False
+
+
+def _is_callable(value):
+    return isinstance(value, Callable) or value.is_function() or value.is_class() \
+        or value.is_instance() and bool(value.py__getattribute__(
+            '__call__', analysis_errors=False
+        ))
+
+
+def _origin_class(value):
+    while isinstance(value, (LazyValueWrapper, ValueWrapper)):
+        value = value._wrapped_value
+    return value
+
+
+def _matches_class(value, expected, class_object):
+    actual = value if class_object else value.py__class__()
+    if isinstance(actual, ProxyWithGenerics) and actual.py__name__() == 'Tuple':
+        actual = builtin_from_name(expected.inference_state, 'tuple')
+    actual = _origin_class(actual)
+    expected = _origin_class(expected)
+    actual_classes = ValueSet([actual])
+    if actual.is_compiled() and expected.is_stub():
+        actual_classes = convert_values(actual_classes, prefer_stubs=True)
+    if any(_origin_class(candidate).is_same_class(expected)
+           for actual_class in actual_classes for candidate in actual_class.py__mro__()):
+        return True
+    name = expected.py__name__()
+    if not class_object and name in ('float', 'complex'):
+        if expected.is_same_class(builtin_from_name(expected.inference_state, name)):
+            names = ('int',) if name == 'float' else ('int', 'float')
+            return any(actual_class.is_sub_class_of(
+                builtin_from_name(expected.inference_state, name)
+            ) for actual_class in actual_classes for name in names)
+    return False
+
+
+def _match_sequence(value, annotations, variants, matcher):
+    if variants is None:
+        entries = tuple(_sequence_content(value))
+        return bool(entries) and all(matcher.match(entry.infer(), annotations)
+                                     for entry in entries)
+    return all(matcher.match(entry.infer(), annotations)
+               for entries in variants for entry in entries)
+
+
+def _sequence_content(value, active=frozenset()):
+    if value in active:
+        yield LazyKnownValues(ValueSet([]))
+        return
+    active = active | {value}
+    if isinstance(value, iterable.DictLiteralValue):
+        variants = mapping_variants(value)
+        if variants is not None:
+            for entries in variants:
+                for key, entry in entries:
+                    yield LazyKnownValue(key)
+        else:
+            yield from value.py__iter__()
+    elif isinstance(value, iterable.SequenceLiteralValue) \
+            and not isinstance(value, iterable.DictLiteralValue):
+        for node in _sequence_entries(value):
+            if node.type == 'star_expr':
+                for unpacked in value._defining_context.infer_node(node.children[1]):
+                    yield from _sequence_content(unpacked, active)
+            else:
+                yield LazyTreeValue(value._defining_context, node)
+    else:
+        yield from value.py__iter__()
+
+
+def _sequence_entries(value):
+    children = value.atom.children
+    if value.atom.type in value._TUPLE_LIKE:
+        return children[::2]
+    entries = children[1]
+    if entries in (')', ']', '}'):
+        return ()
+    if entries.type in ('testlist_comp', 'dictorsetmaker'):
+        return entries.children[::2]
+    return (entries,)
+
+
+def _literal_values(value, active=frozenset()):
+    if isinstance(value, _LiteralValue) or value in active:
+        yield value
+        return
+    active = active | {value}
+    is_mapping = isinstance(value, (iterable.DictLiteralValue, iterable.DictComprehension))
+    if is_mapping:
+        variants = mapping_variants(value)
+        if variants is not None and any(isinstance(key, _UnboundedMappingKey)
+                                        for entries in variants for key, entry in entries):
+            variants = None
+    elif isinstance(value, (iterable.SequenceLiteralValue, iterable.ComprehensionMixin,
+                            iterable._FakeSequence, Tuple)):
+        variants = sequence_variants(value)
+    else:
+        variants = None
+    if variants is None:
+        yield value
+        return
+    for entries in variants:
+        options = []
+        for item in entries:
+            entry = item[1] if is_mapping else item
+            inferred = entry.infer()
+            options.append(tuple(LazyKnownValue(part)
+                                 for inferred_value in inferred
+                                 for part in _literal_values(inferred_value, active))
+                           if inferred else (entry,))
+        for combination in product(*options):
+            if is_mapping:
+                combination = tuple((key, entry) for (key, old_entry), entry
+                                    in zip(entries, combination))
+            yield _LiteralValue(value, combination, is_mapping)
+
+
+def sequence_variants(value, max_count=None):
+    if isinstance(value, _LiteralValue):
+        if value.is_mapping:
+            return (tuple(LazyKnownValue(key) for key, entry in value.entries),)
+        return (value.entries,)
+    if isinstance(value, (iterable.Sequence, iterable.ComprehensionMixin, Tuple)):
+        variants = _sequence_variants(value, max_count)
+        if variants is not None:
+            return variants
+    if max_count is not None:
+        values = ValueSet.from_sets(entry.infer() for entry in _sequence_content(value))
+        entry = LazyKnownValues(values)
+        return tuple((entry,) * count for count in range(max_count + 1))
+    return None
+
+
+@inference_state_method_cache(default=None)
+def _sequence_variants(value, max_count):
+    if isinstance(value, iterable.DictLiteralValue):
+        variants = mapping_variants(value)
+        if variants is not None:
+            if any(isinstance(key, _UnboundedMappingKey)
+                   for entries in variants for key, entry in entries):
+                return None
+            return tuple(tuple(LazyKnownValue(key) for key, entry in entries)
+                         for entries in variants)
+    elif isinstance(value, iterable.SequenceLiteralValue):
+        variants = ((),)
+        for node in _sequence_entries(value):
+            if node.type == 'star_expr':
+                additions = []
+                for unpacked in value._defining_context.infer_node(node.children[1]):
+                    nested = sequence_variants(unpacked, max_count)
+                    if nested is None:
+                        return None
+                    additions.extend(nested)
+                if not additions:
+                    return None
+            else:
+                additions = ((LazyTreeValue(value._defining_context, node),),)
+            variants = tuple(before + after for before, after in product(variants, additions))
+        return variants
+    elif isinstance(value, iterable.ComprehensionMixin):
+        variants = _comprehension_variants(value)
+        if variants is None:
+            return None
+        if isinstance(value, iterable.DictComprehension):
+            return tuple(tuple(LazyKnownValue(key) for key, entry in entries)
+                         for entries in variants)
+        return variants
+    elif isinstance(value, (iterable._FakeSequence, Tuple)):
+        if isinstance(value, Tuple) and value._is_homogenous():
+            return None
+        return (tuple(value.py__iter__()),)
+    elif isinstance(value, iterable.FakeDict):
+        return (tuple(value.py__iter__()),)
+    return None
+
+
+def _safe_key(value):
+    key = value.get_safe_value(default=_UNKNOWN)
+    if key is _UNKNOWN and isinstance(value, iterable.SequenceLiteralValue) \
+            and value.array_type == 'tuple':
+        variants = sequence_variants(value)
+        if variants is not None and len(variants) == 1:
+            entries = []
+            for entry in variants[0]:
+                values = entry.infer()
+                if len(values) != 1:
+                    return _UNKNOWN
+                entry_key = _safe_key(next(iter(values)))
+                if entry_key is _UNKNOWN:
+                    return _UNKNOWN
+                entries.append(entry_key)
+            key = tuple(entries)
+    return key
+
+
+def _update_mapping(entries, additions):
+    result = list(entries)
+    for key, entry in additions:
+        safe_key = _safe_key(key)
+        for index, (old_key, old_entry) in enumerate(result):
+            old_safe_key = _safe_key(old_key)
+            if key is old_key or safe_key is not _UNKNOWN \
+                    and old_safe_key is not _UNKNOWN and old_safe_key == safe_key:
+                result[index] = old_key, entry
+                break
+        else:
+            result.append((key, entry))
+    return tuple(result)
+
+
+def mapping_variants(value):
+    if isinstance(value, _LiteralValue):
+        return (value.entries,) if value.is_mapping else None
+    if isinstance(value, (iterable.DictLiteralValue, iterable.FakeDict,
+                          iterable.DictComprehension)):
+        return _mapping_variants(value)
+    for candidate in value.py__class__().py__mro__():
+        if isinstance(candidate, GenericClass) \
+                and candidate.py__name__() in ('dict', 'Mapping', 'MutableMapping'):
+            generics = candidate.get_generics()
+            if len(generics) == 2:
+                keys = generics[0].execute_annotation(None)
+                values = generics[1].execute_annotation(None)
+                if keys and values:
+                    return ((),) + tuple(((_UnboundedMappingKey(key), LazyKnownValues(values)),)
+                                         for key in keys)
+    return None
+
+
+@inference_state_method_cache(default=None)
+def _mapping_variants(value):
+    if isinstance(value, iterable.DictLiteralValue):
+        children = value.atom.children
+        if children[1] == '}':
+            return ((),)
+        variants = ((),)
+        iterator = iter(children[1].children)
+        for key_node in iterator:
+            if key_node == '**':
+                additions = []
+                for unpacked in value._defining_context.infer_node(next(iterator)):
+                    nested = mapping_variants(unpacked)
+                    if nested is None:
+                        return None
+                    additions.extend(nested)
+            else:
+                next(iterator)
+                entry = LazyTreeValue(value._defining_context, next(iterator))
+                additions = [((key, entry),)
+                             for key in value._defining_context.infer_node(key_node)]
+            if not additions:
+                return None
+            variants = tuple(_update_mapping(before, after)
+                             for before, after in product(variants, additions))
+            next(iterator, None)
+        return variants
+    if isinstance(value, iterable.FakeDict):
+        return (tuple((create_simple_object(value.inference_state, key), entry)
+                      for key, entry in value.exact_key_items()),)
+    if isinstance(value, iterable.DictComprehension):
+        variants = _comprehension_variants(value)
+        if variants is not None:
+            return tuple(_update_mapping((), entries) for entries in variants)
+    return None
+
+
+def _comprehension_variants(value):
+    comp_fors = tuple(get_sync_comp_fors(value._sync_comp_for_node))
+    return _comprehension_for(value, comp_fors, value._defining_context)
+
+
+def _comprehension_for(value, comp_fors, parent_context):
+    comp_for = comp_fors[0]
+    inputs = parent_context.infer_node(comp_for.children[3])
+    if not inputs:
+        return None
+    result = []
+    for input_value in inputs:
+        variants = sequence_variants(input_value)
+        if variants is None:
+            return None
+        for entries in variants:
+            outputs = ((),)
+            for entry in entries:
+                names = iterable.unpack_tuple_to_dict(parent_context, entry.infer(),
+                                                      comp_for.children[1])
+                context = value._get_comp_for_context(parent_context, comp_for)
+                with context.predefine_names(comp_for, names):
+                    include, skip = _comprehension_filter(context, comp_for)
+                    additions = []
+                    if include:
+                        if len(comp_fors) > 1:
+                            nested = _comprehension_for(value, comp_fors[1:], context)
+                            if nested is None:
+                                return None
+                            additions.extend(nested)
+                        elif isinstance(value, iterable.DictComprehension):
+                            keys = context.infer_node(value._entry_node)
+                            values = LazyKnownValues(context.infer_node(value._value_node))
+                            additions.extend(((key, values),) for key in keys)
+                        else:
+                            additions.append((LazyKnownValues(context.infer_node(
+                                value._entry_node
+                            )),))
+                    if skip:
+                        additions.append(())
+                outputs = tuple(before + after for before, after in product(outputs, additions))
+            result.extend(outputs)
+    return tuple(result)
+
+
+def _comprehension_filter(context, comp_for):
+    include = True
+    skip = False
+    node = comp_for.children[-1]
+    while node.type == 'comp_if':
+        values = context.infer_node(node.children[1])
+        truth_values = [value.py__bool__() for value in values] or [None]
+        include = include and any(truth is not False for truth in truth_values)
+        skip = skip or any(truth is not True for truth in truth_values)
+        node = node.children[-1]
+    return include, skip
