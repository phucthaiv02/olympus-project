+def _bind_single_seq_and_kw(param_names, pos_seq, kw_dict, unknown_kw_entries, has_duplicate_kw):
+    if has_duplicate_kw:
+        return None
+
+    pos_capable = [
+        p for p in param_names
+        if p.get_kind() in (Parameter.POSITIONAL_ONLY, Parameter.POSITIONAL_OR_KEYWORD)
+    ]
+    var_pos_param = next(
+        (p for p in param_names if p.get_kind() == Parameter.VAR_POSITIONAL),
+        None
+    )
+    var_kw_param = next(
+        (p for p in param_names if p.get_kind() == Parameter.VAR_KEYWORD),
+        None
+    )
+    kw_capable = {
+        p.string_name: p for p in param_names
+        if p.get_kind() in (Parameter.POSITIONAL_OR_KEYWORD, Parameter.KEYWORD_ONLY)
+    }
+
+    bound = {}
+    var_pos_items = []
+    extra_kw = {}
+
+    for i, lv in enumerate(pos_seq):
+        if i < len(pos_capable):
+            bound[pos_capable[i]] = lv
+        else:
+            if var_pos_param is None:
+                return None
+            var_pos_items.append(lv)
+
+    for k, lv in kw_dict.items():
+        if k in kw_capable:
+            p = kw_capable[k]
+            if p in bound:
+                return None
+            bound[p] = lv
+        else:
+            if var_kw_param is None:
+                return None
+            extra_kw[k] = lv
+
+    if unknown_kw_entries and var_kw_param is None:
+        return None
+
+    for p in param_names:
+        kind = p.get_kind()
+        if kind in (Parameter.POSITIONAL_ONLY, Parameter.POSITIONAL_OR_KEYWORD, Parameter.KEYWORD_ONLY):
+            if p not in bound and p.default_node is None:
+                return None
+
+    return bound, var_pos_items, extra_kw, unknown_kw_entries
+
