+def _value_satisfies_protocol(val, protocol_cls):
+    from jedi.inference.value.klass import ClassFilter
+    from jedi.inference.gradual.base import GenericClass
+
+    base_cls = protocol_cls._class_value if isinstance(protocol_cls, GenericClass) else protocol_cls
+    if not hasattr(base_cls, 'py__mro__'):
+        return False
+
+    ignored_names = {
+        '__init__', '__new__', '__doc__', '__module__', '__slots__',
+        '_is_protocol', '_is_runtime_protocol', '__non_callable_proto_members__',
+        '__protocol_attrs__', '__parameters__', '__orig_bases__', '__annotations__',
+        '__subclasshook__', '__init_subclass__',
+    }
+    required_names = set()
+    for mro_cls in base_cls.py__mro__():
+        mro_base = mro_cls._class_value if isinstance(mro_cls, GenericClass) else mro_cls
+        if mro_base.py__name__() in ('object', 'Protocol', 'Generic'):
+            continue
+        if not mro_base.is_compiled() and hasattr(mro_base, 'as_context'):
+            f = ClassFilter(mro_base, node_context=mro_base.as_context(), is_instance=True)
+            for name_def in f.values():
+                if name_def.string_name not in ignored_names:
+                    required_names.add(name_def.string_name)
+
+    if not required_names:
+        return True
+
+    for req_name in required_names:
+        if not val.py__getattribute__(req_name):
+            return False
+    return True
+
