+def _get_comp_ifs_for_comp_for(comp_for):
+    if len(comp_for.children) < 5:
+        return []
+    ifs = []
+    cur = comp_for.children[4]
+    while cur.type == 'comp_if':
+        ifs.append(cur.children[1])
+        if len(cur.children) < 3:
+            break
+        cur = cur.children[2]
+    return ifs
+
