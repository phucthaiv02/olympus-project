+def _is_protocol_class(cls):
+    from jedi.inference.gradual.typing import Protocol
+    from jedi.inference.gradual.base import GenericClass
+
+    base_cls = cls._class_value if isinstance(cls, GenericClass) else cls
+    if not hasattr(base_cls, 'py__bases__'):
+        return False
+    for lazy_base in base_cls.py__bases__():
+        for b in lazy_base.infer():
+            if isinstance(b, Protocol) or b.py__name__() == 'Protocol':
+                return True
+    return False
+
