+# -------------------------
+# Advanced Overload Resolution
+# -------------------------
+
+class Foo: ...
+class Bar: ...
+class FooBuilder:
+    def build_foo(self) -> int: ...
+class BarBuilder:
+    def build_bar(self) -> str: ...
+
+@overload
+def get_obj(input: type[Foo]) -> FooBuilder: ...
+@overload
+def get_obj(input: type[Bar]) -> BarBuilder: ...
+def get_obj(input): ...
+
+#? ['build_foo']
+get_obj(Foo).build_
+#? ['build_bar']
+get_obj(Bar).build_
+
+class A: ...
+class C: ...
+
+def check_overload(c: bool, xs_c: list[type[C]]):
+    @overload
+    def f1(x: type[A]) -> int: ...
+    @overload
+    def f1(x: type[C]) -> str: ...
+    def f1(x): ...
+
+    #? int() str()
+    f1(A if c else C)
+    #? int() str()
+    f1(*xs_c)
+
+    @overload
+    def f_dict(d: dict[int, type[C]]) -> int: ...
+    @overload
+    def f_dict(d: object) -> str: ...
+    def f_dict(d): ...
+
+    #? int()
+    f_dict({1: A, True: C})
+
+    d = {"k": A} if c else {}
+
+    @overload
+    def f_kw1(k: type[C]) -> int: ...
+    @overload
