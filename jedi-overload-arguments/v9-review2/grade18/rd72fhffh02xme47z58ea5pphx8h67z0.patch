+def _deduplicate_set_realization(r):
+    seen_keys = set()
+    result = []
+    for item in r:
+        if isinstance(item, PosItem):
+            vals = item.infer()
+            if len(vals) == 1:
+                rk = _get_runtime_dict_key(next(iter(vals)))
+                if rk is not None:
+                    if rk in seen_keys:
+                        continue
+                    seen_keys.add(rk)
+        result.append(item)
+    return tuple(result)
+
