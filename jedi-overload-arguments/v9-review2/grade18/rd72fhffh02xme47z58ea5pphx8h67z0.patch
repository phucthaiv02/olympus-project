+        base_reals = get_sequence_realizations_for_value(v._wrapped_value, depth + 1)
+        add_item = PosItem(LazyKnownValues(v._assigned_values))
+        return tuple(r + (add_item,) for r in base_reals)
+    if isinstance(v, DictModification):
+        dict_reals = get_dict_realizations_for_value(v, depth + 1)
+        return _dict_realizations_to_sequence_realizations(dict_reals)
+    from jedi.inference.gradual.typing import Tuple as TypingTuple
+    if isinstance(v, TypingTuple):
+        if v._is_homogenous():
+            elem_vals = v._generics_manager.get_index_and_execute(0)
+            return ((StarItem(LazyKnownValues(elem_vals)),),)
+        else:
+            items = tuple(
+                PosItem(LazyKnownValues(gs.execute_annotation(None)))
+                for gs in v._generics_manager.to_tuple()
+            )
+            return (items,)
+    elem_vals = v.merge_types_of_iterate()
+    return ((StarItem(LazyKnownValues(elem_vals)),),)
+
+
+def get_dict_realizations_for_value(v, depth=0):
+    if depth > 8:
+        return (DictRealization(unknown_entries=[(v.merge_types_of_iterate(), LazyKnownValues(NO_VALUES))]),)
+    if hasattr(v, 'get_dict_realizations'):
+        return v.get_dict_realizations()
+    from jedi.inference.value.dynamic_arrays import DictModification
+    if isinstance(v, DictModification):
+        base_reals = list(get_dict_realizations_for_value(v._wrapped_value, depth + 1))
+        key_set = v._contextualized_key.infer()
+        val_lv = LazyKnownValues(v._assigned_values)
+        return tuple(_add_entry_to_dict_realizations(base_reals, key_set, val_lv))
+    from jedi.inference.gradual.typing import TypedDict
+    if isinstance(v, TypedDict):
+        r = DictRealization()
+        for k in v.get_key_values():
+            rk = _get_runtime_dict_key(k)
+            k_str = k.get_safe_value(default=None)
+            if rk is not None and isinstance(k_str, str):
+                val_set = v.py__simple_getitem__(k_str)
+                r.known_entries[rk] = (ValueSet([k]), LazyKnownValues(val_set))
+        return (r,)
+    k_set = v.merge_types_of_iterate()
+    v_set = NO_VALUES
+    if k_set:
+        try:
+            v_set = v.py__getitem__(k_set, contextualized_node=None)
+        except Exception:
+            v_set = NO_VALUES
+    if not v_set:
+        values_method = v.py__getattribute__('values')
+        if values_method:
+            v_set = values_method.execute_with_values().merge_types_of_iterate()
+    return (DictRealization(unknown_entries=[(k_set, LazyKnownValues(v_set))]),)
+
