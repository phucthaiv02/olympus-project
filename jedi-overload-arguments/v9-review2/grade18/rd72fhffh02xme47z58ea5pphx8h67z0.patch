+def _value_set_matches_annotation_set(arg_value_set, ann_value_set, type_var_state,
+                                      depth=0, default_param_context=None):
+    from jedi.inference.gradual.typing import AnyClass
+    from jedi.inference.gradual.type_var import TypeVar
+
+    if depth > 15:
+        return True
+    if not ann_value_set or not arg_value_set:
+        return True
+
+    ann_list = _unwrap_annotations(ann_value_set, default_param_context)
+    if not ann_list:
+        return True
+
+    for ann in ann_list:
+        if isinstance(ann, AnyClass):
+            return True
+
+    # If the annotation is a single constrained TypeVar, all possible values in
+    # arg_value_set must satisfy the SAME constraint of that TypeVar.
+    if len(ann_list) == 1 and isinstance(ann_list[0], TypeVar) and ann_list[0].constraints:
+        tv = ann_list[0]
+        allowed = type_var_state.get(tv, set(tv.constraints))
+        matching = {
+            c for c in allowed
+            if _value_set_matches_annotation_set(
+                arg_value_set, ValueSet([c]), {}, depth + 1, default_param_context
+            )
+        }
+        if not matching:
+            return False
+        type_var_state[tv] = matching
+        return True
+
+    for val in arg_value_set:
+        matched_any = False
+        for ann in ann_list:
+            sub_state = dict(type_var_state)
+            if _single_value_matches_annotation(val, ann, sub_state, depth + 1, default_param_context):
+                type_var_state.update(sub_state)
+                matched_any = True
+                break
+        if not matched_any:
+            return False
+    return True
+
+
+def _single_value_matches_annotation(val, ann, type_var_state, depth=0, default_param_context=None):
+    from jedi.inference.gradual.typing import AnyClass, SelfClass, Tuple, Callable, \
+        TypingClassWithGenerics, BaseTypingValue, TypedDictClass, TypedDict
+    from jedi.inference.gradual.type_var import TypeVar, TypeWrapper
+    from jedi.inference.gradual.base import DefineGenericBaseClass, GenericClass
+    from jedi.plugins.stdlib import TupleClassWrapper, TypeClassWrapper
+
+    if depth > 15:
+        return True
