+def _class_matches_type_target(cls_val, target, type_var_state, depth, default_param_context=None):
+    from jedi.inference.gradual.typing import AnyClass
+    from jedi.inference.gradual.type_var import TypeVar, TypeWrapper
+
+    if isinstance(target, AnyClass):
+        return True
+    if target.py__name__() == 'object' and target.parent_context.is_builtins_module():
+        return True
+    if isinstance(target, TypeWrapper):
+        target = target._original_value
+    if isinstance(target, TypeVar):
+        if target.constraints:
+            allowed = type_var_state.get(target, set(target.constraints))
+            matching = {
+                c for c in allowed
+                if any(
+                    _class_matches_type_target(cls_val, sub_c, {}, depth + 1, default_param_context)
+                    for sub_c in _unwrap_annotations(ValueSet([c]), default_param_context)
+                )
+            }
+            if not matching:
+                return False
+            type_var_state[target] = matching
+            return True
+        if target.bound:
+            return any(
+                _class_matches_type_target(cls_val, b, type_var_state, depth + 1, default_param_context)
+                for b in _unwrap_annotations(target.bound, default_param_context)
+            )
+        return True
+    if target.is_class() or target.is_class_mixin():
+        if _is_nominal_sub_class(cls_val, target):
+            return True
+        if _is_protocol_class(target):
+            instances = cls_val.execute_annotation(None)
+            if instances and all(_value_satisfies_protocol(inst, target) for inst in instances):
+                return True
+    return False
+
