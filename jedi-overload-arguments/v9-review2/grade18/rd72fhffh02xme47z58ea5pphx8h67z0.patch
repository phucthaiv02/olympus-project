+def _unwrap_annotations(ann_value_set, default_param_context=None):
+    from jedi.inference.gradual.typing import ProxyWithGenerics, TypingClassWithGenerics, \
+        NewType, TypeAlias
+    from jedi.inference.gradual.type_var import TypeVar
+
+    result = []
+    for ann in ann_value_set:
+        if isinstance(ann, TypeVar):
+            result.append(ann)
+        elif isinstance(ann, TypeAlias):
+            result.extend(ann.gather_annotation_classes())
+        elif isinstance(ann, NewType):
+            result.extend(_unwrap_annotations(ann._type_value_set, default_param_context))
+        elif isinstance(ann, ProxyWithGenerics) and not isinstance(ann, TypingClassWithGenerics):
+            inner_name = ann._tree_name.value
+            if inner_name == 'Optional':
+                for gs in ann._generics_manager.to_tuple():
+                    result.extend(_unwrap_annotations(gs, default_param_context))
+                result.append(compiled.builtin_from_name(ann.inference_state, 'None'))
+            elif inner_name in ('ClassVar', 'Annotated', 'Final'):
+                if len(ann._generics_manager):
+                    result.extend(_unwrap_annotations(ann._generics_manager[0], default_param_context))
+            else:
+                for gs in ann._generics_manager.to_tuple():
+                    result.extend(_unwrap_annotations(gs, default_param_context))
+        else:
+            result.append(ann)
+    return result
+
