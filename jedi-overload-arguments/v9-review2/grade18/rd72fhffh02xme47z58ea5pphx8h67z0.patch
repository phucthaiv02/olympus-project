+def _is_nominal_sub_class(sub_cls, super_cls):
+    super_base = _unwrap_class_value(super_cls)
+    if not hasattr(sub_cls, 'py__mro__'):
+        return sub_cls.is_sub_class_of(super_base)
+    for mro_cls in sub_cls.py__mro__():
+        mro_base = _unwrap_class_value(mro_cls)
+        if mro_base.is_same_class(super_base):
+            return True
+    return False
