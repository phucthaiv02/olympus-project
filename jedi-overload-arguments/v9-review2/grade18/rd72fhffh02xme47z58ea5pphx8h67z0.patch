+class DictRealization:
+    def __init__(self, known_entries=None, unknown_entries=None):
+        # known_entries: dict[runtime_key, tuple[ValueSet, LazyValue]]
+        self.known_entries = dict(known_entries) if known_entries else {}
+        # unknown_entries: list[tuple[ValueSet, LazyValue]]
+        self.unknown_entries = list(unknown_entries) if unknown_entries else []
+
+    def copy(self):
+        return DictRealization(self.known_entries, self.unknown_entries)
+
+    def __repr__(self):
+        return 'DictRealization(known=%r, unknown=%r)' % (
+            self.known_entries, self.unknown_entries
+        )
+
