+class CallRealization:
+    def __init__(self, pos_items=(), kw_dict=None, unknown_kw_entries=(), has_duplicate_kw=False):
+        self.pos_items = tuple(pos_items)
+        self.kw_dict = dict(kw_dict) if kw_dict else {}
+        self.unknown_kw_entries = tuple(unknown_kw_entries)
+        self.has_duplicate_kw = has_duplicate_kw
+
+
+_MAX_CALL_REALIZATIONS = 64
+
+
+def _get_call_realizations(arguments):
+    from jedi.inference.arguments import TreeArguments, ValuesArguments, \
+        TreeArgumentsWrapper, unpack_arglist
+
+    if isinstance(arguments, TreeArgumentsWrapper):
+        inner = _get_call_realizations(arguments._wrapped_arguments)
+        if hasattr(arguments, 'instance'):
+            prefix = (iterable.PosItem(LazyKnownValue(arguments.instance)),)
+        elif hasattr(arguments, '_class'):
+            prefix = (iterable.PosItem(LazyKnownValue(arguments._class)),)
+        else:
+            prefix = ()
+        if not prefix:
+            return inner
+        return [
+            CallRealization(
+                prefix + r.pos_items,
+                r.kw_dict,
+                r.unknown_kw_entries,
+                r.has_duplicate_kw,
+            )
+            for r in inner
+        ]
+
+    if isinstance(arguments, ValuesArguments):
+        pos_items = [
+            iterable.PosItem(LazyKnownValues(values))
+            for values in arguments._values_list
+        ]
+        return [CallRealization(pos_items=pos_items)]
+
+    if not isinstance(arguments, TreeArguments):
+        pos_items = []
+        kw_dict = {}
+        has_dup = False
+        for key, lv in arguments.unpack():
+            if key is None:
+                pos_items.append(iterable.PosItem(lv))
+            else:
+                if key in kw_dict:
+                    has_dup = True
+                kw_dict[key] = lv
+        return [CallRealization(pos_items=pos_items, kw_dict=kw_dict, has_duplicate_kw=has_dup)]
+
+    realizations = [CallRealization()]
+    context = arguments.context
+    seen_kw = False
+    seen_star_star = False
+
+    for star_count, el in unpack_arglist(arguments.argument_node):
+        if star_count == 1:
+            arrays = context.infer_node(el)
+            seq_reals = []
+            if not arrays:
+                seq_reals.append((iterable.StarItem(LazyUnknownValue()),))
+            else:
+                for a in arrays:
+                    seq_reals.extend(iterable.get_sequence_realizations_for_value(a))
+            if not seq_reals:
+                seq_reals = [()]
+            new_reals = []
+            for r in realizations:
+                for sr in seq_reals:
+                    new_reals.append(CallRealization(
+                        r.pos_items + sr,
+                        r.kw_dict,
+                        r.unknown_kw_entries,
+                        r.has_duplicate_kw or seen_star_star,
+                    ))
+                    if len(new_reals) >= _MAX_CALL_REALIZATIONS:
+                        break
+                if len(new_reals) >= _MAX_CALL_REALIZATIONS:
+                    break
+            realizations = new_reals
+        elif star_count == 2:
+            seen_star_star = True
+            arrays = context.infer_node(el)
+            d_reals = []
+            if not arrays:
+                d_reals.append(iterable.DictRealization(
+                    unknown_entries=[(NO_VALUES, LazyUnknownValue())]
+                ))
+            else:
+                for dct in arrays:
+                    d_reals.extend(iterable.get_dict_realizations_for_value(dct))
+            if not d_reals:
+                d_reals = [iterable.DictRealization()]
+            new_reals = []
+            for r in realizations:
+                for dr in d_reals:
+                    new_kw = dict(r.kw_dict)
+                    new_dup = r.has_duplicate_kw
+                    for rk, (k_set, v_lv) in dr.known_entries.items():
+                        if rk[0] != 'safe' or not isinstance(rk[1], str):
+                            new_dup = True
+                        else:
+                            k_str = rk[1]
+                            if k_str in new_kw:
+                                new_dup = True
+                            new_kw[k_str] = v_lv
+                    new_unk = list(r.unknown_kw_entries) + list(dr.unknown_entries)
+                    new_reals.append(CallRealization(
+                        r.pos_items,
+                        new_kw,
+                        new_unk,
+                        new_dup,
+                    ))
+                    if len(new_reals) >= _MAX_CALL_REALIZATIONS:
+                        break
+                if len(new_reals) >= _MAX_CALL_REALIZATIONS:
+                    break
+            realizations = new_reals
+        else:
+            if el.type == 'argument':
+                c = el.children
+                if len(c) == 3:  # Keyword argument
+                    seen_kw = True
+                    k_str = c[0].value
+                    v_lv = LazyTreeValue(context, c[2])
+                    for r in realizations:
+                        if k_str in r.kw_dict:
+                            r.has_duplicate_kw = True
+                        r.kw_dict[k_str] = v_lv
+                    continue
+                else:  # Generator comprehension
+                    sync_comp_for = el.children[1]
+                    if sync_comp_for.type == 'comp_for':
+                        sync_comp_for = sync_comp_for.children[1]
+                    comp = iterable.GeneratorComprehension(
+                        arguments._inference_state,
+                        defining_context=context,
+                        sync_comp_for_node=sync_comp_for,
+                        entry_node=el.children[0],
+                    )
+                    pos_item = iterable.PosItem(LazyKnownValue(comp))
+            else:
+                pos_item = iterable.PosItem(LazyTreeValue(context, el))
+
+            invalid_pos = seen_kw or seen_star_star
+            realizations = [
+                CallRealization(
+                    r.pos_items + (pos_item,),
+                    r.kw_dict,
+                    r.unknown_kw_entries,
+                    r.has_duplicate_kw or invalid_pos,
+                )
+                for r in realizations
+            ]
+
+    return realizations
+
