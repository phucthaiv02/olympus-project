+def _contains_type_var_or_any(ann_value_set):
+    from jedi.inference.gradual.typing import AnyClass
+    from jedi.inference.gradual.type_var import TypeVar
+    from jedi.inference.gradual.base import DefineGenericBaseClass
+
+    for a in _unwrap_annotations(ann_value_set):
+        if isinstance(a, (TypeVar, AnyClass)):
+            return True
+        if isinstance(a, DefineGenericBaseClass):
+            for g in a.get_generics():
+                if _contains_type_var_or_any(g):
+                    return True
+    return False
+
