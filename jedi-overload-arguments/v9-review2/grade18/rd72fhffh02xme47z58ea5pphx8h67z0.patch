+def _unwrap_class_value(cls_val):
+    from jedi.inference.gradual.base import GenericClass
+    from jedi.plugins.stdlib import TupleClassWrapper, TypeClassWrapper
+    while isinstance(cls_val, (GenericClass, TupleClassWrapper, TypeClassWrapper)):
+        cls_val = cls_val._wrapped_value
+    return cls_val
+
