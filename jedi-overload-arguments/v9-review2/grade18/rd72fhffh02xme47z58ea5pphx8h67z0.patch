+def _expand_pos_items_for_params(pos_items, max_positional_params):
+    sequences = [()]
+    for item in pos_items:
+        if isinstance(item, iterable.PosItem):
+            sequences = [seq + (item.lazy_value,) for seq in sequences]
+        else:
+            new_sequences = []
+            for seq in sequences:
+                max_k = max(1, max_positional_params - len(seq) + 1)
+                for k in range(0, max_k + 1):
+                    new_sequences.append(seq + (item.lazy_value,) * k)
+                    if len(new_sequences) >= _MAX_CALL_REALIZATIONS:
+                        break
+                if len(new_sequences) >= _MAX_CALL_REALIZATIONS:
+                    break
+            sequences = new_sequences
+    return sequences
+
