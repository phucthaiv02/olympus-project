+_MAX_REALIZATIONS = 32
+
+
+def _cap_sequence_realizations(realizations):
+    if len(realizations) <= _MAX_REALIZATIONS:
+        return realizations
+    all_lvs = [
+        item.lazy_value
+        for r in realizations
+        for item in r
+    ]
+    merged = get_merged_lazy_value(all_lvs) if all_lvs else LazyKnownValues(NO_VALUES)
+    return [(StarItem(merged),)]
+
+
+def _cap_dict_realizations(realizations):
+    if len(realizations) <= _MAX_REALIZATIONS:
+        return realizations
+    merged = DictRealization()
+    all_known_keys = set()
+    for r in realizations:
+        all_known_keys.update(r.known_entries.keys())
+        merged.unknown_entries.extend(r.unknown_entries)
+    for rk in all_known_keys:
+        if all(rk in r.known_entries for r in realizations):
+            k_sets = ValueSet.from_sets(r.known_entries[rk][0] for r in realizations)
+            lvs = [r.known_entries[rk][1] for r in realizations]
+            merged.known_entries[rk] = (k_sets, get_merged_lazy_value(lvs))
+        else:
+            k_sets = ValueSet.from_sets(
+                r.known_entries[rk][0] for r in realizations if rk in r.known_entries
+            )
+            lvs = [
+                r.known_entries[rk][1] for r in realizations if rk in r.known_entries
+            ]
+            merged.unknown_entries.append((k_sets, get_merged_lazy_value(lvs)))
+    return [merged]
+
+
+def _get_runtime_dict_key(k, depth=0):
+    if depth > 5:
+        return None
+    safe_val = k.get_safe_value(default=sentinel)
+    if safe_val is not sentinel:
+        try:
+            hash(safe_val)
+        except TypeError:
+            return None
+        return ('safe', safe_val)
+    if isinstance(k, SequenceLiteralValue) and k.array_type == 'tuple':
+        realizations = k.get_sequence_realizations()
+        if len(realizations) == 1:
+            r = realizations[0]
+            sub_keys = []
+            for item in r:
+                if isinstance(item, StarItem):
+                    return None
+                vals = item.infer()
+                if len(vals) != 1:
+                    return None
+                sk = _get_runtime_dict_key(next(iter(vals)), depth + 1)
+                if sk is None:
+                    return None
+                sub_keys.append(sk)
+            return ('tuple', tuple(sub_keys))
+        return None
+    if k.is_class() or k.is_function() or k.is_module() or k.is_compiled():
+        try:
+            hash(k)
+        except TypeError:
+            return None
+        return ('value', k)
+    return None
+
+
+def _keys_could_be_equal(k_set1, k_set2):
+    if not k_set1 or not k_set2:
+        return True
+    classes1 = k_set1.py__class__()
+    classes2 = k_set2.py__class__()
+    for c1 in classes1:
+        for c2 in classes2:
+            if c1.is_sub_class_of(c2) or c2.is_sub_class_of(c1):
+                return True
+    return False
+
+
+def _add_entry_to_dict_realizations(realizations, key_set, val_lv):
+    if not key_set:
+        new_reals = []
+        for r in realizations:
+            nr = r.copy()
+            nr.unknown_entries.append((NO_VALUES, val_lv))
+            new_reals.append(nr)
+        return new_reals
+
+    new_realizations = []
+    for r in realizations:
+        for k in key_set:
+            nr = r.copy()
+            rk = _get_runtime_dict_key(k)
+            if rk is not None:
+                if rk in nr.known_entries:
+                    orig_k_set, _ = nr.known_entries[rk]
+                    nr.known_entries[rk] = (orig_k_set, val_lv)
+                else:
+                    nr.known_entries[rk] = (ValueSet([k]), val_lv)
+            else:
+                k_vs = ValueSet([k])
+                nr.unknown_entries.append((k_vs, val_lv))
+                for erk, (ek_set, elv) in list(nr.known_entries.items()):
+                    if _keys_could_be_equal(k_vs, ek_set):
+                        nr.known_entries[erk] = (
+                            ek_set,
+                            get_merged_lazy_value([elv, val_lv]),
+                        )
+            new_realizations.append(nr)
+    return _cap_dict_realizations(new_realizations)
+
+
+def _merge_dict_realization(r, sub_r):
+    nr = r.copy()
+    for uk_set, ulv in sub_r.unknown_entries:
+        nr.unknown_entries.append((uk_set, ulv))
+        for erk, (ek_set, elv) in list(nr.known_entries.items()):
+            if _keys_could_be_equal(uk_set, ek_set):
+                nr.known_entries[erk] = (
+                    ek_set,
+                    get_merged_lazy_value([elv, ulv]),
+                )
+    for rk, (k_set, lv) in sub_r.known_entries.items():
+        if rk in nr.known_entries:
+            orig_k_set, _ = nr.known_entries[rk]
+            nr.known_entries[rk] = (orig_k_set, lv)
+        else:
+            nr.known_entries[rk] = (k_set, lv)
+    return nr
+
+
+def _dict_realizations_to_sequence_realizations(dict_reals):
+    seq_reals = []
+    for dr in dict_reals:
+        items = []
+        for _rk, (k_set, _lv) in dr.known_entries.items():
+            items.append(PosItem(LazyKnownValues(k_set)))
+        for uk_set, _ulv in dr.unknown_entries:
+            items.append(StarItem(LazyKnownValues(uk_set)))
+        seq_reals.append(tuple(items))
+    return tuple(seq_reals) if seq_reals else ((),)
+
