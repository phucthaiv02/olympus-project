diff --git a/jedi/inference/unpacking.py b/jedi/inference/unpacking.py
new file mode 100644
index 0000000..94ff4b8
--- /dev/null
+++ b/jedi/inference/unpacking.py
@@ -0,0 +1,530 @@
+"""
+Python creates the content of containers like ``[A, *b]`` or
+``{'k': C, **d}`` at runtime. Jedi usually merges the values of containers,
+which is good enough for completions, but not for deciding which ``@overload``
+is called: For that it matters how many arguments are passed and which
+argument ends up at which position.
+
+The functions in this module therefore return lists of alternatives. Every
+alternative is one possible runtime content. An alternative of a sequence is a
+tuple of :class:`Exact` (exactly one element) and :class:`Variadic` (any
+number of elements, including none) items. If Jedi does not know something,
+like the length of a ``list[int]``, :class:`Variadic` is used.
+"""
+import operator
+
+from jedi import debug
+from jedi.inference import compiled
+from jedi.inference.base_value import ValueSet, NO_VALUES
+from jedi.inference.cache import inference_state_function_cache
+from jedi.inference.lazy_value import MergedLazyValues
+from jedi.inference.arguments import TreeArguments, TreeArgumentsWrapper, \
+    unpack_arglist, comprehension_from_argument
+from jedi.inference.value import iterable
+from jedi.inference.value.dynamic_arrays import check_array_additions
+from jedi.inference.gradual.typing import Tuple
+
+# More alternatives than this are merged, which loses precision, but avoids
+# exponential growth.
+_MAX_ALTERNATIVES = 64
+# Avoids endless recursion in cases like ``a = [*a]``.
+_MAX_DEPTH = 10
+# Avoids huge alternatives in cases like ``[1] * 10**9``.
+_MAX_REPEATED_ITEMS = 256
+_UNKNOWN_KEY = object()
+
+
+class Exact:
+    """Exactly one element with one of the given ``values``."""
+    def __init__(self, values, is_implicit=False):
+        self.values = values
+        # Implicit arguments like ``self`` are not written in a call.
+        self.is_implicit = is_implicit
+
+    def __repr__(self):
+        return '<%s: %s>' % (self.__class__.__name__, self.values)
+
+
+class Variadic:
+    """Any number of elements (including none) with one of the ``values``."""
+    is_implicit = False
+
+    def __init__(self, values):
+        self.values = values
+
+    def __repr__(self):
+        return '<%s: %s>' % (self.__class__.__name__, self.values)
+
+
+class DictContent:
+    """
+    The content of a dict. ``entries`` maps keys that are known (as Python
+    objects) to tuples of the inferred key and value. If ``extra_keys`` is not
+    None, there might be other entries with these keys and ``extra_values``.
+    """
+    def __init__(self, entries=None, extra_keys=None, extra_values=None):
+        self.entries = {} if entries is None else entries
+        self.extra_keys = extra_keys
+        self.extra_values = extra_values
+
+    def with_item(self, key, key_values, values):
+        if key is _UNKNOWN_KEY:
+            return self.with_unknown_items(key_values, values)
+        entries = dict(self.entries)
+        if key in entries:
+            # Python keeps the first key, e.g. ``{1: A, True: C} == {1: C}``.
+            key_values = entries[key][0]
+        entries[key] = key_values, values
+        return DictContent(entries, self.extra_keys, self.extra_values)
+
+    def with_unknown_items(self, key_values, values):
+        # An unknown key might replace the value of every known key.
+        entries = {
+            key: (known_key_values, known_values | values)
+            for key, (known_key_values, known_values) in self.entries.items()
+        }
+        return DictContent(
+            entries,
+            _union(self.extra_keys, key_values),
+            _union(self.extra_values, values),
+        )
+
+    def merged(self, other):
+        """Returns the content of ``{**self, **other}``."""
+        result = self
+        for key, (key_values, values) in other.entries.items():
+            result = result.with_item(key, key_values, values)
+        if other.extra_keys is not None:
+            result = result.with_unknown_items(other.extra_keys, other.extra_values)
+        return result
+
+    def __repr__(self):
+        return '<%s: %s, %s: %s>' % (
+            self.__class__.__name__, self.entries, self.extra_keys, self.extra_values)
+
+
+class CallAlternative:
+    """
+    One possible way the arguments of a call are passed at runtime.
+    ``extra_keywords`` is not None if there might be keyword arguments with
+    unknown names.
+    """
+    def __init__(self, positional=(), keywords=(), extra_keywords=None, is_valid=True):
+        self.positional = positional
+        self.keywords = keywords
+        self.extra_keywords = extra_keywords
+        # False if Python raises a TypeError or if Jedi gave up.
+        self.is_valid = is_valid
+
+    def with_positional(self, items):
+        return CallAlternative(
+            self.positional + tuple(items), self.keywords,
+            self.extra_keywords, self.is_valid,
+        )
+
+    def with_keyword(self, name, values):
+        return CallAlternative(
+            self.positional, self.keywords + ((name, values),),
+            self.extra_keywords, self.is_valid,
+        )
+
+    def with_mapping(self, dict_content):
+        """Adds ``**mapping``."""
+        is_valid = self.is_valid
+        keywords = list(self.keywords)
+        for key, (_, values) in dict_content.entries.items():
+            if isinstance(key, str):
+                keywords.append((key, values))
+            else:
+                # TypeError: keywords must be strings
+                is_valid = False
+        extra_keywords = self.extra_keywords
+        if dict_content.extra_keys is not None:
+            extra_keywords = _union(extra_keywords, dict_content.extra_values)
+        return CallAlternative(self.positional, tuple(keywords), extra_keywords, is_valid)
+
+    def __repr__(self):
+        return '<%s: %s, %s, %s>' % (
+            self.__class__.__name__, self.positional, self.keywords, self.extra_keywords)
+
+
+def _union(value_set, other):
+    if value_set is None:
+        return other
+    return value_set | other
+
+
+def _combine(alternatives, choices, combine, merge):
+    """
+    Combines every alternative with every choice. ``merge`` is used to merge
+    the alternatives if there are too many.
+    """
+    result = [combine(alternative, choice)
+              for alternative in alternatives
+              for choice in choices]
+    if len(result) > _MAX_ALTERNATIVES:
+        debug.dbg('Too many alternatives (%s), merging them', len(result))
+        return [merge(result)]
+    return result
+
+
+def _merge_sequences(alternatives):
+    return (Variadic(ValueSet.from_sets(
+        item.values for alternative in alternatives for item in alternative
+    )),)
+
+
+def _merge_dicts(alternatives):
+    keys = values = NO_VALUES
+    for dict_content in alternatives:
+        for key_values, entry_values in dict_content.entries.values():
+            keys |= key_values
+            values |= entry_values
+        if dict_content.extra_keys is not None:
+            keys |= dict_content.extra_keys
+            values |= dict_content.extra_values
+    return DictContent(extra_keys=keys, extra_values=values)
+
+
+def _merge_calls(alternatives):
+    return CallAlternative(is_valid=False)
+
+
+def sequence_alternatives(values, depth=0):
+    """
+    Returns the possible contents of iterating over one of the ``values``.
+    """
+    if not values or depth > _MAX_DEPTH:
+        return [(Variadic(NO_VALUES),)]
+    alternatives = []
+    for value in values:
+        alternatives += _value_sequence_alternatives(value, depth)
+    if len(alternatives) > _MAX_ALTERNATIVES:
+        return [_merge_sequences(alternatives)]
+    return alternatives
+
+
+def _value_sequence_alternatives(value, depth):
+    if isinstance(value, (iterable.DictLiteralValue, iterable.DictComprehension,
+                          iterable.FakeDict)):
+        # Iterating over a dict returns its keys.
+        return [
+            tuple(Exact(key_values) for key_values, _ in dict_content.entries.values())
+            + (() if dict_content.extra_keys is None
+               else (Variadic(dict_content.extra_keys),))
+            for dict_content in _value_dict_alternatives(value, depth)
+        ]
+    if isinstance(value, iterable.SequenceLiteralValue):
+        alternatives = _literal_sequence_alternatives(value, depth)
+    elif isinstance(value, iterable.ComprehensionMixin):
+        alternatives = _comprehension_alternatives(value, depth)
+    elif isinstance(value, iterable.MergedArray):
+        alternatives = [()]
+        for array in value._arrays:
+            alternatives = _combine(
+                alternatives,
+                _value_sequence_alternatives(array, depth + 1),
+                operator.add,
+                _merge_sequences,
+            )
+    elif isinstance(value, iterable.SlicedArray):
+        # The bounds of slices are often unknown.
+        alternatives = [_merge_sequences(_value_sequence_alternatives(value.array, depth + 1))]
+    elif isinstance(value, iterable.RepeatedArray):
+        alternatives = _value_sequence_alternatives(value.array, depth + 1)
+        if value.count is None \
+                or value.count * max(map(len, alternatives)) > _MAX_REPEATED_ITEMS:
+            alternatives = [_merge_sequences(alternatives)]
+        else:
+            alternatives = [alternative * value.count for alternative in alternatives]
+    elif isinstance(value, (iterable.FakeTuple, iterable.FakeList)):
+        lazy_values = list(value.py__iter__())
+        if not lazy_values:
+            # Jedi also uses empty tuples for *args if it does not know them.
+            return [(Variadic(NO_VALUES),)]
+        alternatives = [tuple(
+            Variadic(lazy_value.infer())
+            if isinstance(lazy_value, MergedLazyValues)
+            or lazy_value.min != 1 or lazy_value.max != 1
+            else Exact(lazy_value.infer())
+            for lazy_value in lazy_values
+        )]
+    elif isinstance(value, Tuple):
+        lazy_values = list(value.py__iter__())
+        if value._is_homogenous():
+            return [_merge_sequences([[Exact(lazy_value.infer()) for lazy_value in lazy_values]])]
+        return [tuple(Exact(lazy_value.infer()) for lazy_value in lazy_values)]
+    else:
+        return [(Variadic(value.merge_types_of_iterate()),)]
+
+    if value.array_type == 'set':
+        # The order of sets is unknown and duplicates are removed.
+        return [_merge_sequences(alternatives)]
+    return alternatives
+
+
+def _get_literal_element_nodes(atom):
+    if atom.type in iterable.SequenceLiteralValue._TUPLE_LIKE:
+        return atom.children[::2]
+    inner = atom.children[1]
+    if inner in (')', ']', '}'):
+        return []
+    if inner.type in ('testlist_comp', 'dictorsetmaker'):
+        return inner.children[::2]
+    return [inner]
+
+
+def _literal_sequence_alternatives(sequence, depth):
+    context = sequence._defining_context
+    alternatives = [()]
+    for node in _get_literal_element_nodes(sequence.atom):
+        if node.type == 'star_expr':
+            choices = sequence_alternatives(context.infer_node(node.children[1]), depth + 1)
+        else:
+            choices = [(Exact(context.infer_node(node)),)]
+        alternatives = _combine(alternatives, choices, operator.add, _merge_sequences)
+
+    additions = check_array_additions(context, sequence)
+    if additions:
+        # It's unknown where and how often values are added.
+        added = ValueSet.from_sets(lazy_value.infer() for lazy_value in additions)
+        alternatives = [_merge_sequences(alternatives + [(Variadic(added),)])]
+    return alternatives
+
+
+def _get_input_alternatives(comprehension, depth):
+    """
+    Returns the possible contents of the iterable of the first ``for`` of a
+    comprehension or None for ``async for``.
+    """
+    comp_for = comprehension._sync_comp_for_node
+    if comp_for.parent.type == 'comp_for':  # async for
+        return None
+    input_values = comprehension._defining_context.infer_node(comp_for.children[3])
+    return sequence_alternatives(input_values, depth + 1)
+
+
+def _is_empty(alternatives):
+    return alternatives is not None and all(not alternative for alternative in alternatives)
+
+
+def _comprehension_alternatives(comprehension, depth):
+    inputs = _get_input_alternatives(comprehension, depth)
+    if _is_empty(inputs):
+        return [()]
+    entries = comprehension._iterate()
+    if inputs is not None and len(inputs) == 1 \
+            and len(comprehension._sync_comp_for_node.children) == 4 \
+            and all(isinstance(item, Exact) for item in inputs[0]) \
+            and len(entries) == len(inputs[0]):
+        # A simple comprehension like ``[x for x in (A, C)]`` without ``if``
+        # and nested ``for``: Every element of the input creates an element.
+        return [tuple(Exact(values) for values in entries)]
+    return [(Variadic(ValueSet.from_sets(entries)),)]
+
+
+def dict_alternatives(values, depth=0):
+    """
+    Returns the possible :class:`DictContent` of one of the ``values``.
+    """
+    if not values or depth > _MAX_DEPTH:
+        return [DictContent(extra_keys=NO_VALUES, extra_values=NO_VALUES)]
+    alternatives = []
+    for value in values:
+        alternatives += _value_dict_alternatives(value, depth)
+    if len(alternatives) > _MAX_ALTERNATIVES:
+        return [_merge_dicts(alternatives)]
+    return alternatives
