+        if _is_empty(_get_input_alternatives(value, depth)):
+            return [DictContent()]
+        entries = value._iterate()
+        return [DictContent(
+            extra_keys=ValueSet.from_sets(keys for keys, _ in entries),
+            extra_values=ValueSet.from_sets(values for _, values in entries),
+        )]
+    if isinstance(value, iterable.FakeDict):
+        items = list(value.exact_key_items())
+        if items:
+            return [DictContent({
+                key: (
+                    ValueSet([compiled.create_simple_object(value.inference_state, key)]),
+                    lazy_value.infer(),
