diff --git a/jedi/inference/gradual/matching.py b/jedi/inference/gradual/matching.py
new file mode 100644
index 0000000..2d0f790
--- /dev/null
+++ b/jedi/inference/gradual/matching.py
@@ -0,0 +1,629 @@
+"""
+Decides whether a call matches a signature according to typing rules. This is
+used to find the ``@overload`` that is called.
+
+The results are True, False or None if it's unknown. A signature only matches
+if Jedi is sure that it accepts the call: Every possible way the arguments are
+passed at runtime (see :mod:`jedi.inference.unpacking`) needs to be accepted
+and every possible value of an argument needs to match the annotation of its
+parameter. If Jedi does not know the type of an argument, the result is
+usually unknown, because it might be anything (like ``Any`` in type checkers).
+"""
+import itertools
+from inspect import Parameter
+
+from jedi.cache import memoize_method
+from jedi.inference import compiled
+from jedi.inference.base_value import ValueSet, NO_VALUES
+from jedi.inference.cache import inference_state_function_cache
+from jedi.inference.helpers import is_string
+from jedi.inference.gradual.base import GenericClass
+from jedi.inference.gradual.type_var import TypeVar
+from jedi.inference.gradual.typing import AnyClass, SelfClass, ProxyWithGenerics, \
+    TypingClassWithGenerics, ProxyTypingValue, ProxyTypingClassValue, TypeAlias, \
+    NewType, Tuple, Callable, LiteralWithValues
+from jedi.inference.unpacking import Variadic, get_call_alternatives, \
+    sequence_alternatives, get_container_content
+
+_POSITIONAL_KINDS = (Parameter.POSITIONAL_ONLY, Parameter.POSITIONAL_OR_KEYWORD)
+_KEYWORD_KINDS = (Parameter.POSITIONAL_OR_KEYWORD, Parameter.KEYWORD_ONLY)
+_MAX_EXPANSIONS = 256
+_MAX_DEPTH = 10
+# Every class has these, they are not relevant for protocols.
+_IGNORED_PROTOCOL_MEMBERS = {
+    '__slots__', '__doc__', '__module__', '__dict__', '__weakref__',
+    '__annotations__', '__init__', '__new__', '__init_subclass__',
+    '__class_getitem__', '__subclasshook__', '__abstractmethods__',
+    '__parameters__', '__orig_bases__', '__match_args__',
+}
+_sentinel = object()
+
+
+def match_signature(function_value, arguments):
+    """
+    Returns True if the function definitely accepts the arguments, False if it
+    definitely doesn't and None if it's unknown.
+    """
+    alternatives = get_call_alternatives(function_value.inference_state, arguments)
+    if not alternatives:
+        return None
+    signature = _Signature(function_value)
+    matcher = _TypeMatcher(
+        function_value.inference_state,
+        _get_self_classes(function_value, alternatives[0]),
+    )
+    return _all(signature.matches(matcher, call) for call in alternatives)
+
+
+def _all(results):
+    """Like ``all``, but for True, False and None (unknown)."""
+    final = True
+    for result in results:
+        if result is False:
+            return False
+        if result is None:
+            final = None
+    return final
+
+
+def _any(results):
+    """Like ``any``, but for True, False and None (unknown)."""
+    final = False
+    for result in results:
+        if result is True:
+            return True
+        if result is None:
+            final = None
+    return final
+
+
+class _Param:
+    def __init__(self, param_name):
+        self.name = param_name.string_name
+        self.kind = param_name.get_kind()
+        self.has_default = param_name.default_node is not None
+        self._param_name = param_name
+
+    @memoize_method
+    def get_annotations(self):
+        return self._param_name.infer_annotation(execute_annotation=False, ignore_stars=True)
+
+
+class _Signature:
+    def __init__(self, function_value):
+        self._params = [_Param(n) for n in function_value.get_param_names()]
+        self._positional_params = [p for p in self._params if p.kind in _POSITIONAL_KINDS]
+        self._keyword_params = {p.name: p for p in self._params if p.kind in _KEYWORD_KINDS}
+        self._var_positional = self._find_param(Parameter.VAR_POSITIONAL)
+        self._var_keyword = self._find_param(Parameter.VAR_KEYWORD)
+
+    def _find_param(self, kind):
+        return next((p for p in self._params if p.kind == kind), None)
+
+    def matches(self, matcher, call):
+        if not call.is_valid:
+            return call.is_valid
+        max_count = len(self._positional_params) + 1
+        return _all(
+            None if positional is None
+            else self._bound_call_matches(matcher, positional, call)
+            for positional in _expand_variadics(call.positional, max_count)
+        )
+
+    def _bound_call_matches(self, matcher, positional, call):
+        assigned = set()
+        checks = []
+        for i, item in enumerate(positional):
+            if i < len(self._positional_params):
+                param = self._positional_params[i]
+                assigned.add(param.name)
+            elif self._var_positional is not None:
+                param = self._var_positional
+            else:
+                return False  # Too many positional arguments
+            checks.append((item.values, param))
+
+        used_keywords = set()
+        for name, values in call.keywords:
+            if name in used_keywords:
+                return False  # Multiple values for the same keyword argument
+            used_keywords.add(name)
+            param = self._keyword_params.get(name)
+            if param is None:
+                if self._var_keyword is None:
+                    return False  # Unexpected keyword argument
+                param = self._var_keyword
+            elif name in assigned:
+                return False  # Multiple values for an argument
+            assigned.add(name)
+            checks.append((values, param))
+
+        if call.extra_keywords is not None:
+            # Keyword arguments with unknown names might go to any parameter
+            # that accepts keywords, but also to **kwargs.
+            if self._var_keyword is None:
+                return False
+            checks.append((call.extra_keywords, self._var_keyword))
+            for name, param in self._keyword_params.items():
+                if name in assigned:
+                    return False
+                checks.append((call.extra_keywords, param))
+
+        for param in self._params:
+            if param.kind not in (Parameter.VAR_POSITIONAL, Parameter.VAR_KEYWORD) \
+                    and param.name not in assigned and not param.has_default:
+                return False  # Missing argument
+
+        return _all(matcher.values_match(values, param.get_annotations())
+                    for values, param in checks)
+
+
+def _get_self_classes(function_value, call):
+    """Returns the classes that ``Self`` refers to."""
+    if call.positional and call.positional[0].is_implicit:
+        return ValueSet(
+            value if _is_class(value) else value.py__class__()
+            for value in call.positional[0].values
+        )
+    context = function_value.parent_context
+    if context.is_class():
+        return ValueSet([context.get_value()])
+    return None
+
+
+def _expand_variadics(items, max_count):
+    """
+    Yields the positional arguments for every possible length of the
+    :class:`Variadic` items. More than ``max_count`` arguments don't need to be
+    checked, because the additional ones would be passed to ``*args`` or fail.
+    Yields None if there are too many combinations.
+    """
+    variadic_count = sum(isinstance(item, Variadic) for item in items)
+    if (max_count + 1) ** variadic_count > _MAX_EXPANSIONS:
+        yield None
+        return
+    for counts in itertools.product(range(max_count + 1), repeat=variadic_count):
+        count_iterator = iter(counts)
+        expanded = []
+        for item in items:
+            if isinstance(item, Variadic):
+                expanded += [item] * next(count_iterator)
+            else:
+                expanded.append(item)
+        yield expanded
+
+
+class _TypeMatcher:
+    def __init__(self, inference_state, self_classes):
+        self._inference_state = inference_state
+        self._self_classes = self_classes
+        self._cache = {}
+        self._depth = 0
+
+    def values_match(self, values, annotations):
+        """
+        Checks if every value matches one of the annotations (which are a
+        union). No annotations means that there is no annotation.
+        """
+        if not annotations:
+            return True
+        key = values, annotations
+        try:
+            return self._cache[key]
+        except KeyError:
+            pass
+        if self._depth > _MAX_DEPTH:
+            return None
+
+        self._cache[key] = None  # In case of recursion
+        self._depth += 1
+        try:
+            if any(self._accepts_anything(a) for a in annotations):
+                result = True
+            elif not values:
+                # Jedi does not know the value, it might be anything.
+                result = None
+            else:
+                result = _all(
+                    _any(self._value_matches(value, a) for a in annotations)
+                    for value in values
+                )
+        finally:
+            self._depth -= 1
+        self._cache[key] = result
+        return result
+
+    def _accepts_anything(self, annotation):
+        if isinstance(annotation, AnyClass):
+            return True
+        if isinstance(annotation, TypeVar):
+            return not annotation.bound and not annotation.constraints
+        if isinstance(annotation, SelfClass):
+            return self._self_classes is None
+        if isinstance(annotation, TypingClassWithGenerics):
+            return False
+        if isinstance(annotation, ProxyWithGenerics):
+            return any(self._accepts_anything(a) for a in _get_union_members(annotation))
+        if isinstance(annotation, ProxyTypingClassValue):
+            return False
+        if isinstance(annotation, ProxyTypingValue):
+            # Something like a bare Optional, which is not a valid annotation.
+            return True
+        if is_string(annotation):
+            # An unresolvable forward reference.
+            return True
+        return _is_class(annotation) and _is_builtin(annotation, 'object')
+
+    def _value_matches(self, value, annotation):
+        if self._accepts_anything(annotation):
+            return True
+        if isinstance(annotation, TypeVar):
+            return self._matches_type_var(value, annotation, self._value_matches)
+        if isinstance(annotation, SelfClass):
+            return _any(self._is_instance(value, cls) for cls in self._self_classes)
+        if isinstance(annotation, TypingClassWithGenerics):
+            name = annotation.py__name__()
+            generics = annotation.get_generics()
+            if name == 'Type':
+                if not _is_class(value):
+                    return False
+                if not generics or not generics[0]:
+                    return True
+                return _any(self._is_subclass(value, a) for a in generics[0])
+            if name == 'Tuple':
+                return self._tuple_matches(value, annotation)
+            if name == 'Callable':
+                return self._callable_matches(value, generics)
+            return False
+        if isinstance(annotation, ProxyWithGenerics):
+            if annotation.py__name__() == 'Optional' and _is_none(value):
+                return True
+            members = _get_union_members(annotation)
+            if not members:
+                return True
+            return _any(self._value_matches(value, a) for a in members)
+        if isinstance(annotation, ProxyTypingClassValue):
+            name = annotation.py__name__()
+            if name == 'Type':
+                return _is_class(value)
+            if name == 'Tuple':
+                return self._is_instance(value, self._builtin('tuple'))
+            if name == 'Callable':
+                return _is_callable(value)
+            return False
+        if isinstance(annotation, TypeAlias):
+            # e.g. List without generics
+            return _any(self._is_instance(value, cls)
+                        for cls in annotation.gather_annotation_classes())
+        if isinstance(annotation, NewType):
+            # Jedi infers NewType calls as their underlying type.
+            return self.values_match(ValueSet([value]), annotation._type_value_set)
+        if isinstance(annotation, LiteralWithValues):
+            return any(_is_same_literal(value, literal)
+                       for literal in annotation.get_literal_values())
+        if _is_class(annotation):
+            return self._is_instance(value, annotation)
+        if _is_none(annotation):
+            return _is_none(value)
+        return False
+
+    def _callable_matches(self, value, generics):
+        if not _is_callable(value):
+            return False
+        # The parameters are not checked, only the return type.
+        if len(generics) != 2:
+            return True
+        returns = generics[1]
+        if not returns or any(self._accepts_anything(a) for a in returns):
+            return True
+        return self.values_match(value.execute_with_values(), returns)
+
+    def _matches_type_var(self, value, type_var, match):
+        bound = type_var.bound
+        if bound:
+            return _any(True if is_string(b) else match(value, b) for b in bound)
+        constraints = type_var.constraints
+        if not constraints:
+            return True
+        return _any(match(value, c) for c in constraints)
+
+    def _builtin(self, name):
+        return compiled.builtin_from_name(self._inference_state, name)
+
+    def _is_instance(self, value, cls):
+        if _is_builtin(cls, 'object'):
+            return True
+        content = get_container_content(value)
+        if content is None:
+            value_class = _get_class(value)
+            elements = None
+        else:
+            value_class, elements = content
+        if value_class is None:
+            return None
+
+        base = _find_base(value_class, cls)
+        if base is None:
+            return _any([
+                self._is_promoted(value, cls),
+                self._implements_protocol(value, cls),
+            ])
+        if not isinstance(cls, GenericClass):
+            return True
+        return self._generics_match(base, cls, elements)
+
+    def _implements_protocol(self, value, cls):
+        # The types of the members are not checked.
+        if not _is_protocol(cls):
+            return False
+        members = _get_protocol_members(self._inference_state, _get_plain_class(cls))
+        return all(_has_attribute(value, name) for name in members)
+
+    def _is_promoted(self, value, cls):
+        """int is accepted for float and int/float for complex."""
+        if _is_builtin(cls, 'float'):
+            names = ['int']
+        elif _is_builtin(cls, 'complex'):
+            names = ['int', 'float']
+        else:
+            return False
+        return _any(self._is_instance(value, self._builtin(name)) for name in names)
+
+    def _generics_match(self, base, cls, elements):
+        """
+        Compares the generics of ``cls`` (e.g. ``Sequence[int]``) with the
+        generics of ``base``, which is the same class in the MRO of the value.
+        ``elements`` are the elements of containers written in the code.
+        """
+        base_generics = _get_generics(base)
+        type_vars = _get_plain_class(cls).list_type_vars()
+        results = []
+        for i, annotations in enumerate(cls.get_generics()):
+            if not annotations:
+                continue  # Not inferable, e.g. not existing names.
+            try:
+                generic = base_generics[i]
+            except IndexError:
+                return None
+
+            element_values = _get_element_values(generic, elements)
+            if element_values is not None:
+                # The actual content is known, so just compare that. This is
+                # what type checkers do as well, e.g. `[1]` is a valid
+                # `list[float]`.
+                results += [self.values_match(values, annotations)
+                            for values in element_values]
+            else:
+                type_var = type_vars[i] if i < len(type_vars) else None
+                results.append(self._types_match(generic, annotations, type_var))
+            if False in results:
+                return False
+        return _all(results)
+
+    def _types_match(self, types, annotations, type_var):
+        """
+        Compares two generics, e.g. the ``int`` of a ``list[int]`` value with
+        the ``float`` of a ``list[float]`` annotation, according to the
+        variance of the type var.
+        """
+        if any(self._accepts_anything(a) for a in annotations):
+            return True
+        is_covariant = type_var is None or type_var.is_covariant
+        is_contravariant = type_var is not None and type_var.is_contravariant
+        results = []
+        if not is_contravariant:
+            results.append(self.values_match(types.execute_annotation(None), annotations))
+        if not is_covariant and not any(self._accepts_anything(t) for t in types):
+            results.append(self.values_match(annotations.execute_annotation(None), types))
+        return _all(results)
+
+    def _tuple_matches(self, value, annotation):
+        is_tuple = self._is_instance(value, self._builtin('tuple'))
+        if not is_tuple:
+            return is_tuple
+        generics = annotation.get_generics()
+        if not generics:
+            return True
+        is_homogenous = annotation._generics_manager.is_homogenous_tuple()
+        results = []
+        for alternative in sequence_alternatives(ValueSet([value])):
+            if is_homogenous:
+                results += [self.values_match(item.values, generics[0])
+                            for item in alternative]
+                continue
+            for item in alternative:
+                if isinstance(item, Variadic):
+                    # A tuple of unknown length is only accepted if it's
+                    # a tuple[Any, ...].
+                    return None if not item.values else False
+            if len(alternative) != len(generics):
+                return False
+            results += [self.values_match(item.values, annotations)
+                        for item, annotations in zip(alternative, generics)]
+        return _all(results)
+
+    def _is_subclass(self, cls, annotation):
+        """Checks a class for ``type[annotation]``."""
+        if self._accepts_anything(annotation):
+            return True
+        if isinstance(annotation, TypeVar):
+            return self._matches_type_var(cls, annotation, self._is_subclass)
+        if isinstance(annotation, SelfClass):
+            return any(_find_base(cls, c) is not None for c in self._self_classes)
+        if isinstance(annotation, (TypingClassWithGenerics, ProxyTypingClassValue)):
+            if annotation.py__name__() == 'Tuple':
+                return _find_base(cls, self._builtin('tuple')) is not None
+            return False
+        if isinstance(annotation, ProxyWithGenerics):
+            return _any(self._is_subclass(cls, a) for a in _get_union_members(annotation))
+        if isinstance(annotation, TypeAlias):
+            return any(_find_base(cls, c) is not None
+                       for c in annotation.gather_annotation_classes())
+        if _is_class(annotation):
+            return _find_base(cls, annotation) is not None \
+                or self._implements_protocol(cls, annotation)
+        return False
+
+
+def _get_union_members(annotation):
+    """For Union, Optional, Annotated, ClassVar and Final."""
+    generics = annotation.get_generics()
+    if annotation.py__name__() == 'Union':
+        return ValueSet.from_sets(generics)
+    return generics[0] if generics else NO_VALUES
+
+
+def _get_element_values(generic, elements):
+    """
+    Returns the elements for a generic of a container written in the code,
+    e.g. the keys of a dict for the ``_KT`` of ``Mapping[_KT, _VT_co]``.
+    """
+    if elements is None or len(generic) != 1:
+        return None
+    type_var, = generic
+    if not isinstance(type_var, TypeVar):
+        return None
+    return elements.get(type_var.py__name__())
+
+
+def _get_class(value):
+    if isinstance(value, Tuple):
+        return compiled.builtin_from_name(value.inference_state, 'tuple')
+    get_annotated_class_object = getattr(value, 'get_annotated_class_object', None)
+    if get_annotated_class_object is not None \
+            and value.is_instance() and not value.is_compiled():
+        # Contains the generics that are inferred from the arguments of the
+        # class, e.g. Box[int] for Box(1).
+        return get_annotated_class_object()
+    try:
+        return value.py__class__()
+    except AttributeError:
+        return None
+
+
+def _get_generics(cls):
+    try:
+        return cls.get_generics()
+    except AttributeError:
+        pass
+    try:
+        type_vars = cls.list_type_vars()
+    except AttributeError:
+        return ()
+    return tuple(ValueSet([type_var]) for type_var in type_vars)
+
+
+def _get_mro(cls):
+    try:
+        return cls.py__mro__()
+    except AttributeError:
+        return [cls]
+
+
+def _find_base(cls, base):
+    """Returns ``base`` how it appears in the MRO of ``cls``."""
+    for c in _get_mro(cls):
+        if _is_same_class(c, base):
+            return c
+    return None
+
+
+def _is_same_class(cls1, cls2):
+    if cls1 == cls2:
+        return True
+    node1 = cls1.tree_node
+    node2 = cls2.tree_node
+    if node1 is not None and node2 is not None \
+            and node1.get_root_node() is node2.get_root_node():
+        return node1 == node2
+
+    # Classes in stubs and compiled classes are not the same objects as the
+    # classes in Python files.
+    names = cls1.get_qualified_names()
+    return names is not None and names == cls2.get_qualified_names() \
+        and cls1.get_root_context().py__name__() == cls2.get_root_context().py__name__()
+
+
+def _get_plain_class(cls):
+    while isinstance(cls, GenericClass):
+        cls = cls._class_value
+    return cls
+
+
+def _is_builtin(cls, name):
+    try:
+        return cls.py__name__() == name and cls.get_root_context().is_builtins_module()
+    except AttributeError:
+        return False
+
+
+def _is_class(value):
+    is_class = getattr(value, 'is_class', None)
+    return is_class is not None and is_class()
+
+
+def _is_none(value):
+    try:
