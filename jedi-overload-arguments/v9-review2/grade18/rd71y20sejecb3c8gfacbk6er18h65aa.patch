+
+
+def _literal_dict_alternatives(dct, depth):
+    context = dct._defining_context
+    alternatives = [DictContent()]
+    inner = dct.atom.children[1]
+    if inner == '}':
+        return alternatives
+
+    iterator = iter(inner.children)
+    for node in iterator:
+        if node == '**':
+            choices = dict_alternatives(context.infer_node(next(iterator)), depth + 1)
+            alternatives = _combine(alternatives, choices, DictContent.merged, _merge_dicts)
+        else:
+            next(iterator)  # The colon
+            values = context.infer_node(next(iterator))
+            alternatives = _combine(
+                alternatives,
+                _get_key_choices(context.infer_node(node)),
+                lambda dict_content, choice: dict_content.with_item(*choice, values),
+                _merge_dicts,
+            )
+        next(iterator, None)  # The comma
+    return alternatives
+
+
+def _get_key_choices(key_values):
+    """
+    Returns the possible keys as tuples of the key as a Python object and the
+    inferred key.
+    """
+    choices = []
+    for key_value in key_values:
+        key = _get_safe_key(key_value)
+        if key is _UNKNOWN_KEY:
+            return [(_UNKNOWN_KEY, key_values)]
+        choices.append((key, ValueSet([key_value])))
+    return choices or [(_UNKNOWN_KEY, NO_VALUES)]
+
+
+def _get_safe_key(value):
+    try:
+        key = value.get_safe_value(default=_UNKNOWN_KEY)
+    except AttributeError:
+        return _UNKNOWN_KEY
+    try:
+        hash(key)
+    except TypeError:
+        return _UNKNOWN_KEY
+    return key
+
+
+def get_container_content(value):
+    """
+    For containers that are written in the code (or created by Jedi), returns
+    the class of the container and a dict that maps the type var names of the
+    class to lists of the values of the elements, e.g. ``{'_T': [...]}`` for
+    lists or ``{'_KT': [...], '_VT': [...]}`` for dicts. Returns None for other
+    values.
+    """
+    if isinstance(value, (iterable.DictLiteralValue, iterable.DictComprehension,
+                          iterable.FakeDict)):
+        keys = []
+        values = []
+        for dict_content in _value_dict_alternatives(value, 0):
+            for key_values, entry_values in dict_content.entries.values():
+                keys.append(key_values)
+                values.append(entry_values)
+            if dict_content.extra_keys is not None:
+                keys.append(dict_content.extra_keys)
+                values.append(dict_content.extra_values)
+        cls = compiled.builtin_from_name(value.inference_state, 'dict')
+        element_lists = [keys, values]
+    elif isinstance(value, (iterable.SequenceLiteralValue, iterable.ComprehensionMixin,
+                            iterable.MergedArray, iterable.RepeatedArray, iterable.SlicedArray,
+                            iterable.FakeTuple, iterable.FakeList)):
+        if isinstance(value, iterable.GeneratorComprehension):
+            cls = value._get_cls()
+        else:
+            cls = compiled.builtin_from_name(value.inference_state, value.array_type)
+        element_lists = [[
+            item.values
+            for alternative in _value_sequence_alternatives(value, 0)
+            for item in alternative
+        ]]
+    else:
+        return None
+    type_var_names = [type_var.py__name__() for type_var in cls.list_type_vars()]
+    return cls, dict(zip(type_var_names, element_lists))
+
+
+@inference_state_function_cache(default=None)
+def get_call_alternatives(inference_state, arguments):
+    """
+    Returns the possible ways the ``arguments`` are passed at runtime as a list
+    of :class:`CallAlternative`.
+    """
+    alternatives = _get_call_alternatives(arguments, ())
+    if len(alternatives) > _MAX_ALTERNATIVES:
+        return [_merge_calls(alternatives)]
+    return alternatives
+
+
+def _get_call_alternatives(arguments, implicit_items):
+    if isinstance(arguments, TreeArguments):
+        return _tree_call_alternatives(arguments, implicit_items)
+
+    if isinstance(arguments, TreeArgumentsWrapper):
+        unwrapped = arguments.unwrap_implicit_values()
+        if unwrapped is not None:
+            implicit_values, wrapped_arguments = unwrapped
+            return _get_call_alternatives(
+                wrapped_arguments,
+                implicit_items + tuple(
+                    Exact(ValueSet([v]), is_implicit=True) for v in implicit_values
+                ),
+            )
+
+    alternative = CallAlternative(implicit_items)
+    for key, lazy_value in arguments.unpack():
+        if key is not None:
+            alternative = alternative.with_keyword(key, lazy_value.infer())
+        elif isinstance(lazy_value, MergedLazyValues) \
+                or lazy_value.min != 1 or lazy_value.max != 1:
+            alternative = alternative.with_positional([Variadic(lazy_value.infer())])
+        else:
+            alternative = alternative.with_positional([Exact(lazy_value.infer())])
+    return [alternative]
+
+
+def _tree_call_alternatives(arguments, implicit_items):
+    context = arguments.context
+    alternatives = [CallAlternative(implicit_items)]
+    for star_count, node in unpack_arglist(arguments.argument_node):
+        if star_count == 1:
+            alternatives = _combine(
+                alternatives,
+                sequence_alternatives(context.infer_node(node)),
+                CallAlternative.with_positional,
+                _merge_calls,
+            )
+        elif star_count == 2:
+            alternatives = _combine(
+                alternatives,
+                dict_alternatives(context.infer_node(node)),
+                CallAlternative.with_mapping,
+                _merge_calls,
+            )
+        elif node.type == 'argument' and len(node.children) == 3:
+            name = node.children[0].value
+            values = context.infer_node(node.children[2])
+            alternatives = [a.with_keyword(name, values) for a in alternatives]
+        else:
+            if node.type == 'argument':
+                # A generator comprehension like ``f(x for x in y)``.
+                values = ValueSet([comprehension_from_argument(context, node)])
+            else:
+                values = context.infer_node(node)
+            alternatives = [a.with_positional([Exact(values)]) for a in alternatives]
+    return alternatives
