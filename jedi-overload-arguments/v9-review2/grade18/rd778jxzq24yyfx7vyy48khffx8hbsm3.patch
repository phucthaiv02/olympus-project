+def test_container_arguments(Script, first, second, expression, setup, expected):
+    assert _infer_overload(
+        Script, 'x: ' + first, 'x: ' + second, expression, setup,
+    ) == expected
+
+
+@pytest.mark.parametrize('first, second, expression, setup, expected', [
+    ('x: type[A], /', 'x: type[C]', 'x=A', '', {'str', 'int'}),
+    ('*, x: type[A]', 'x: type[C]', 'A', '', {'str', 'int'}),
+    ('*, x: type[A]', 'x: type[C]', 'x=A', '', {'str'}),
+    ('x: type[A], y: type[C]', 'x: type[C]', 'x=A', '', {'str', 'int'}),
+    ('x: type[A], y: type[C]=C', 'x: type[C]', 'x=A', '', {'str'}),
+    ('*args: type[A]', '*args: type[C]', 'A, B', '', {'str'}),
+    ('*args: type[A]', '*args: type[C]', 'A, C', '', {'str', 'int'}),
+    ('*args: type[A]', '*args: type[C]', '*values', 'values: list[type[C]]', {'int'}),
+    ('**kwargs: type[A]', '**kwargs: type[C]', 'x=C, y=C', '', {'int'}),
+    ('x: type[C]', '**kwargs: type[C]', '**values',
+     'values: dict[str, type[C]]', {'int'}),
