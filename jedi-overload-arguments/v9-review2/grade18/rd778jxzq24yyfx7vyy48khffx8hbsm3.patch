+def test_builder_completions(Script):
+    code = dedent('''\
+        from typing import overload
+
+        class Foo: pass
+        class Bar: pass
+
+        class FooBuilder:
+            def foo_method(self): pass
+
+        class BarBuilder:
+            def bar_method(self): pass
+
+        @overload
+        def get_obj(input: type[Foo]) -> FooBuilder: ...
+        @overload
+        def get_obj(input: type[Bar]) -> BarBuilder: ...
+
+        get_obj(Foo).
+    ''')
+    completions = {completion.name for completion in Script(code.rstrip()).complete()}
+    assert 'foo_method' in completions
+    assert 'bar_method' not in completions
+
+
+@pytest.mark.parametrize('decorator, params, receiver', [
+    ('', 'self, ', 'Factory()'),
+    ('@classmethod', 'cls, ', 'Factory'),
+    ('@classmethod', 'cls, ', 'Factory()'),
+    ('@staticmethod', '', 'Factory'),
+    ('@staticmethod', '', 'Factory()'),
+])
+def test_overloaded_methods(Script, decorator, params, receiver):
+    code = _PREAMBLE + dedent('''\
+        class Factory:
+            @overload
+            %s
+            def f(%sx: type[A]) -> str: ...
+            @overload
+            %s
+            def f(%sx: type[C]) -> int: ...
+
+        %s.f(*[C])
+    ''' % (decorator, params, decorator, params, receiver))
+    assert {name.name for name in Script(code.rstrip()).infer()} == {'int'}
