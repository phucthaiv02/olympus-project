+    ('dict[str, type[A]]', 'dict[str, type[C]]', '{"k": C, **value}',
+     'value = {"k": A} if condition else {}', {'str', 'int'}),
+    ('dict[str, type[A]]', 'dict[str, type[C]]', '{**value, "k": C}',
+     'value = {"k": A} if condition else {}', {'int'}),
+    ('dict[str, type[A]]', 'dict[str, type[C]]', 'value',
+     'value: dict[str, type[C]]', {'int'}),
+    ('dict[str, type[A]]', 'dict[str, type[C]]', '{"k": C for _ in []}', '', {'str'}),
+    ('dict[str, type[A]]', 'dict[str, type[C]]', '{"k": item for item in [A, C]}',
+     '', {'int'}),
