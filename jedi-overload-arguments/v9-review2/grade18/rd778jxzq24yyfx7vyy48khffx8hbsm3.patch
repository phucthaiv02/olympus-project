+from textwrap import dedent
+
+import pytest
+
+
+_PREAMBLE = dedent('''\
+    from typing import Any, Dict, List, Optional, Tuple, Type, TypeVar, Union, overload
+
+    class A:
+        pass
+
+    class B(A):
+        pass
+
+    class C:
+        pass
+
+    condition: bool
+''')
+
+
+def _infer_overload(Script, first, second, expression, setup=''):
+    code = _PREAMBLE + setup + '\n' + dedent('''\
+        @overload
+        def f(%s) -> str: ...
+        @overload
+        def f(%s) -> int: ...
+    ''' % (first, second)) + '\nf(' + expression + ')'
+    return {name.name for name in Script(code).infer()}
+
+
+@pytest.mark.parametrize('annotation', ['type', 'Type'])
+@pytest.mark.parametrize('expression, setup, expected', [
+    ('A', '', {'str'}),
+    ('B', '', {'str'}),
+    ('C', '', {'int'}),
+    ('x=A', '', {'str'}),
+    ('x=C', '', {'int'}),
+    ('A()', '', {'str', 'int'}),
+    ('A if condition else C', '', {'str', 'int'}),
+    ('value', 'value: type[A] | type[C]', {'str', 'int'}),
+    ('value', 'value: Type[Union[A, C]]', {'str', 'int'}),
+    ('*(C,)', '', {'int'}),
+    ('*[C]', '', {'int'}),
+    ('*values', 'values = [C]', {'int'}),
+    ('*values', 'values = (C,)', {'int'}),
+    ('*values', 'values: list[type[C]] = [C]', {'int'}),
+    ('*alias', 'values: list[type[C]] = [C]\nalias = values', {'int'}),
+    ('*values', 'values: tuple[type[C]]', {'int'}),
+    ('*values', 'values: list[type[C]]', {'str', 'int'}),
+    ('*values', 'values: tuple[type[C], ...]', {'str', 'int'}),
+    ('*values', 'values = [C] if condition else []', {'str', 'int'}),
+    ('**{"x": C}', '', {'int'}),
+    ('**values', 'values = {"x": C}', {'int'}),
+    ('**values', 'values: dict[str, type[C]] = {"x": C}', {'int'}),
+    ('**values', 'values = {"x": C} if condition else {}', {'str', 'int'}),
+    ('**{"x": A, "x": C}', '', {'int'}),
+    ('**{"x": A, **{"x": C}}', '', {'int'}),
+    ('**{**{"x": C}, "x": A}', '', {'str'}),
+    ('*[*[C]]', '', {'int'}),
+    ('*[C, *values]', 'values = []', {'int'}),
+    ('*[C, *values]', 'values = [A]', {'str', 'int'}),
+    ('*[A, *values]', 'values = []', {'str'}),
+    ('*values, C', 'values = [C for _ in []]', {'int'}),
+    ('x=A, **{"x": C}', '', {'str', 'int'}),
+    ('A, x=A', '', {'str', 'int'}),
+    ('other=A', '', {'str', 'int'}),
+    ('', '', {'str', 'int'}),
+    ('A, C', '', {'str', 'int'}),
+    ('**[]', '', {'str', 'int'}),
+    ('**{None: C}', '', {'str', 'int'}),
+    ('*[C for _ in [1]]', '', {'int'}),
+    ('*[C for _ in [1] if False]', '', {'str', 'int'}),
+    ('*[C for _ in [1] if condition]', '', {'str', 'int'}),
+    ('**{key: C for key in ["x"]}', '', {'int'}),
+])
+def test_class_arguments(Script, annotation, expression, setup, expected):
+    assert _infer_overload(
+        Script, 'x: %s[A]' % annotation, 'x: %s[C]' % annotation,
+        expression, setup,
+    ) == expected
+
+
+@pytest.mark.parametrize('first, second, expression, setup, expected', [
