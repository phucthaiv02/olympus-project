+     'values: dict[str, type[C]]', {'str'}),
+    ('x: type[C], **kwargs: type[C]', '*args: type[C]', 'x=C, **values',
+     'values: dict[str, type[C]]', {'str', 'int'}),
+    ('x: type[C], *args: type[C]', '*args: type[C]', '*values, C',
+     'values: list[type[C]]', {'str'}),
+    ('x: type[C]', '*args: type[C]', '*values, C',
+     'values = [C] if condition else []', {'int'}),
+    ('x: type[A], y: type[C]=C', '*args: type[C]', '*values, C',
+     'values = [A] if condition else []', {'str', 'int'}),
