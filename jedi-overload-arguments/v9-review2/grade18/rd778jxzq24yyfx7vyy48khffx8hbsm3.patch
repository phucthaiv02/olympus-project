+    ('dict[object, type[A]]', 'dict[object, type[C]]', '{None: C}', '', {'int'}),
+    ('dict[object, type[A]]', 'dict[object, type[C]]', '{(1,): A, (True,): C}',
+     '', {'int'}),
+    ('dict[object, type[A]]', 'dict[object, type[C]]', '{A: A, A: C}', '', {'int'}),
+    ('dict[str, type[A]]', 'dict[str, type[C]]', '{"k": A, **value}',
