+
+@pytest.mark.parametrize('signature, call, matches', [
+    ('*values: type[A]', 'choose(A, B)', True),
+    ('*values: type[A]', 'choose(A, C)', False),
+    ('*values: type[A]', 'choose(A, A())', False),
+    ('*values: type[A]', 'choose()', True),
