+from textwrap import dedent
+
+import pytest
+
+
+_PREAMBLE = '''\
+from typing import Any, Callable, Dict, List, Optional, Tuple, Type, TypeVar, Union, overload
+
+class A: pass
+class B(A): pass
+class C: pass
+
+T = TypeVar('T')
+Bound = TypeVar('Bound', bound=A)
+Constrained = TypeVar('Constrained', A, C)
+condition: bool
+'''
+
+
+def _infer_overload(Script, signature, call, setup=''):
+    source = _PREAMBLE + dedent(setup) + '''\
+@overload
+def choose(%s) -> int: ...
+@overload
+def choose(*args, **kwargs) -> str: ...
+%s''' % (signature, call)
+    return {name.name for name in Script(source).infer()}
+
+
+@pytest.mark.parametrize('annotation, argument, matches', [
+    ('type[A]', 'A', True),
+    ('type[A]', 'B', True),
+    ('type[A]', 'C', False),
+    ('type[A]', 'A()', False),
+    ('Type[A]', 'B', True),
+    ('Type[A]', 'C', False),
+    ('type[A]', 'A if condition else B', True),
+    ('type[A]', 'A if condition else C', False),
+    ('A', 'A() if condition else C()', False),
+    ('Union[A, C]', 'A() if condition else C()', True),
+    ('Optional[A]', 'None', True),
+    ('Optional[A]', 'B()', True),
+    ('Optional[A]', 'C()', False),
+    ('Optional[type[A]]', 'None if condition else B', True),
+    ('Optional[type[A]]', 'None if condition else C', False),
+    ('type[Union[A, C]]', 'A if condition else C', True),
+    ('type[A | C]', 'A if condition else C', True),
+    ('A | C', 'A() if condition else C()', True),
+    ('type[Bound]', 'B', True),
+    ('type[Bound]', 'C', False),
+    ('type[Constrained]', 'B', True),
+    ('type[Constrained]', 'C', True),
+    ('type[Constrained]', 'int', False),
+    ('Bound', 'B()', True),
+    ('Bound', 'C()', False),
+    ('Constrained', 'C()', True),
+    ('Constrained', '1', False),
+    ('Constrained', 'A() if condition else B()', True),
+    ('Constrained', 'A() if condition else C()', False),
+    ('T', 'A', True),
+    ('type[T]', 'C', True),
+    ('type[T]', 'C()', False),
+    ('Any', 'C()', True),
+    ('type[Any]', 'C', True),
+    ('type[Any]', 'C()', False),
+    ('type', 'C', True),
+    ('Type', 'C', True),
+    ('A', 'A', False),
+])
+def test_overload_annotations(Script, annotation, argument, matches):
+    assert _infer_overload(Script, 'value: ' + annotation, 'choose(%s)' % argument) == {
+        'int' if matches else 'str'
+    }
+
+
+@pytest.mark.parametrize('annotation, argument, matches', [
