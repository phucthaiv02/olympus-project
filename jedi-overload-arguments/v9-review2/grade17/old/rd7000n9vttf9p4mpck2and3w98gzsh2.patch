+    ('**values: type[A]', 'choose(**values)', 'values: dict[str, type[A]]', True),
+    ('**values: type[A]', 'choose(**values)', 'values: dict[str, type[C]]', False),
+    ('**values: type[A]', 'choose(**values)',
+     'values: dict[str, Union[type[A], type[C]]]', False),
+    ('first: type[A] = A, **values: type[A]', 'choose(**values)',
+     'values: dict[str, type[B]]', True),
+    ('first: type[C] = C, **values: type[A]', 'choose(**values)',
+     'values: dict[str, type[B]]', False),
+    ('value: dict[str, type[A]]', 'choose({key: A})', 'key = missing', False),
+    ('value: dict[str, type[A]]', "choose({key: A for item in [B]})",
+     'key = missing', False),
+])
+def test_overload_literal_variables(Script, signature, call, setup, matches):
+    assert _infer_overload(Script, signature, call, setup + '\n') == {
+        'int' if matches else 'str'
+    }
+
+
+@pytest.mark.parametrize('argument', ['A()', 'C', 'A if condition else C'])
+def test_overload_fallback(Script, argument):
+    source = _PREAMBLE + '''\
+@overload
+def choose(value: type[A]) -> int: ...
+@overload
+def choose(value: type[B]) -> str: ...
+choose(%s)''' % argument
+    assert {name.name for name in Script(source).infer()} == {'int', 'str'}
+
+
+def test_overload_class_completion(Script):
+    source = _PREAMBLE + '''\
+class ABuilder:
+    def a_only(self): pass
+class CBuilder:
+    def c_only(self): pass
+@overload
+def get_obj(value: type[A]) -> ABuilder: ...
+@overload
+def get_obj(value: type[C]) -> CBuilder: ...
+get_obj(A).'''
+    assert {name.name for name in Script(source).complete() if name.name.endswith('_only')} == {
+        'a_only'
+    }
+
+
+@pytest.mark.parametrize('decorator, prefix, receiver', [
+    ('', 'self, ', 'Factory()'),
+    ('@classmethod', 'cls, ', 'Factory'),
+    ('@staticmethod', '', 'Factory'),
+])
+@pytest.mark.parametrize('arguments, setup, expected', [
+    ('B', '', 'int'),
+    ('C', '', 'str'),
+    ('value=B', '', 'int'),
+    ('*[B]', '', 'int'),
+    ('*values, C', 'values = [B] if condition else []\n', 'str'),
+])
+def test_overload_methods(Script, decorator, prefix, receiver, arguments, setup, expected):
+    decorators = '    @overload\n' + ('    ' + decorator + '\n' if decorator else '')
+    source = _PREAMBLE + setup + 'class Factory:\n' + decorators + '''\
+    def choose(%svalue: type[A], other: type[C] = C) -> int: ...
+''' % prefix + decorators + '''\
+    def choose(%s*args, **kwargs) -> str: ...
+%s.choose(%s)''' % (prefix, receiver, arguments)
+    assert {name.name for name in Script(source).infer()} == {expected}
