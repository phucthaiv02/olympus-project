diff --git a/jedi/inference/gradual/overload.py b/jedi/inference/gradual/overload.py
new file mode 100644
index 0000000..2c696b1
--- /dev/null
+++ b/jedi/inference/gradual/overload.py
@@ -0,0 +1,569 @@
+"""Annotation matching and literal argument shapes for overload resolution."""
+
+from itertools import product
+
+from jedi.inference.base_value import ValueSet, NO_VALUES, ValueWrapper
+from jedi.inference.cache import inference_state_method_cache
+from jedi.inference.compiled import builtin_from_name, create_simple_object
+from jedi.inference.context import CompForContext
+from jedi.inference.gradual.base import DefineGenericBaseClass, GenericClass
+from jedi.inference.gradual.generics import LazyGenericManager, _resolve_forward_references
+from jedi.inference.gradual.type_var import TypeVar
+from jedi.inference.gradual.typing import AnyClass, ProxyWithGenerics, \
+    ProxyTypingClassValue, Tuple, TypeAlias, IGNORE_ANNOTATION_PARTS
+from jedi.inference.lazy_value import LazyKnownValue, LazyKnownValues, \
+    LazyTreeValue, LazyUnknownValue
+from jedi.inference.value import iterable
+
+
+_ANY = object()
+_UNKNOWN = object()
+UNKNOWN_KEYWORD = object()
+
+
+class _LiteralValue(ValueWrapper):
+    def __init__(self, value, sequence=None, mapping=None):
+        super().__init__(value)
+        self.sequence = sequence
+        self.mapping = mapping
+
+
+def _infer_type_var_argument(type_var, lazy):
+    return ValueSet(_resolve_forward_references(
+        getattr(lazy, 'context', type_var.parent_context), lazy.infer()
+    ))
+
+
+def _iter_constrained_type_vars(annotations, seen):
+    for annotation in annotations:
+        if annotation in seen:
+            continue
+        seen.add(annotation)
+        if isinstance(annotation, TypeVar) and annotation._constraints_lazy_values:
+            yield annotation
+        elif isinstance(annotation, DefineGenericBaseClass):
+            for generic in _iter_annotation_arguments(annotation):
+                yield from _iter_constrained_type_vars(generic, seen)
+
+
+def _iter_annotation_arguments(annotation):
+    from jedi.inference.gradual.annotation import infer_annotation
+
+    manager = annotation._generics_manager
+    if isinstance(manager, LazyGenericManager) \
+            and isinstance(manager._index_value, iterable.SequenceLiteralValue):
+        index = manager._index_value
+        for node in index.get_tree_entries():
+            if node != '...':
+                yield infer_annotation(index._defining_context, node)
+    else:
+        yield from annotation.get_generics()
+
+
+def iter_type_var_bindings(params):
+    variables = {}
+    seen = set()
+    for param in params:
+        annotations = param.infer_annotation(execute_annotation=False, ignore_stars=True)
+        for variable in _iter_constrained_type_vars(annotations, seen):
+            variables[variable.py__name__()] = tuple(
+                _infer_type_var_argument(variable, lazy)
+                for lazy in variable._constraints_lazy_values
+            )
+    for choices in product(*variables.values()):
+        yield dict(zip(variables, choices))
+
+
+def substitute_type_vars(annotations, type_var_dict):
+    if not type_var_dict:
+        return annotations
+    return ValueSet.from_sets(
+        annotation.define_generics(type_var_dict)
+        if isinstance(annotation, (DefineGenericBaseClass, TypeVar)) else ValueSet([annotation])
+        for annotation in annotations
+    )
+
+
+@inference_state_method_cache(default=())
+def _expand_annotation(annotation):
+    if isinstance(annotation, AnyClass):
+        return (_ANY,)
+    if isinstance(annotation, TypeVar):
+        if annotation._bound_lazy_value is None and not annotation.constraints:
+            return (_ANY,)
+        lazy_values = (annotation._bound_lazy_value,) if annotation._bound_lazy_value is not None \
+            else annotation._constraints_lazy_values
+        annotations = ValueSet.from_sets(
+            _infer_type_var_argument(annotation, lazy) for lazy in lazy_values
+        )
+    elif isinstance(annotation, TypeAlias):
+        annotations = annotation.gather_annotation_classes()
+    elif isinstance(annotation, ProxyWithGenerics) \
+            and annotation.py__name__() in ('Union', 'Optional', *IGNORE_ANNOTATION_PARTS):
+        generics = annotation.get_generics()
+        if annotation.py__name__() in IGNORE_ANNOTATION_PARTS:
+            annotations = generics[0] if generics else NO_VALUES
+        else:
+            annotations = ValueSet.from_sets(generics)
+        if annotation.py__name__() == 'Optional':
+            annotations |= ValueSet([builtin_from_name(annotation.inference_state, 'None')])
+    else:
+        return (annotation,)
+    return tuple(part for value in annotations for part in _expand_annotation(value))
+
+
+def matches_annotation(values, annotations, as_class=False):
+    """Require the annotation to accept every possible argument value."""
+    annotations = tuple(part for value in annotations for part in _expand_annotation(value))
+    if _ANY in annotations:
+        return True
+    for value in values:
+        if any(_matches_value(annotation, value, as_class) for annotation in annotations):
+            continue
+        if as_class or len(annotations) < 2 or not all(
+            any(_matches_value(annotation, variant) for annotation in annotations)
+            for variant in _value_variants(value)
+        ):
+            return False
+    return bool(values)
+
+
+def _class_for_matching(value, as_class=False):
+    if isinstance(value, _LiteralValue):
+        value = value._wrapped_value
+    if as_class:
+        return value
+    if isinstance(value, Tuple):
+        return builtin_from_name(value.inference_state, 'tuple')
+    if isinstance(value, iterable.Sequence):
+        return builtin_from_name(value.inference_state, value.array_type)
+    return value.py__class__()
+
+
+def _class_origin(value):
+    while isinstance(value, GenericClass):
+        value = value._class_value
+    return next(iter(value.py__mro__()))
+
+
+def _is_subclass(actual, expected):
+    expected = _class_origin(expected)
+    return any(_class_origin(candidate).is_same_class(expected)
+               for candidate in actual.py__mro__())
+
+
+@inference_state_method_cache(default=False)
+def _matches_value(annotation, value, as_class=False):
+    if isinstance(annotation, ProxyTypingClassValue):
+        name = annotation.py__name__()
+        if name == 'Callable':
+            return _matches_callable(value, None)
+        if name == 'Type':
+            return value.is_class()
+        if name == 'Tuple':
+            expected_class = builtin_from_name(annotation.inference_state, 'tuple')
+            return _is_subclass(_class_for_matching(value, as_class), expected_class)
+
+    if isinstance(annotation, ProxyWithGenerics) and annotation.py__name__() == 'Type':
+        generics = annotation.get_generics()
+        return value.is_class() and bool(generics) and matches_annotation(
+            ValueSet([value]), generics[0], as_class=True
+        )
+
+    if isinstance(annotation, ProxyWithGenerics) and annotation.py__name__() == 'Callable':
+        return _matches_callable(value, annotation)
+
+    if isinstance(annotation, ProxyWithGenerics) and annotation.py__name__() == 'Tuple':
+        expected_class = builtin_from_name(annotation.inference_state, 'tuple')
+        if not _is_subclass(_class_for_matching(value, as_class), expected_class):
+            return False
+        variants = None if as_class else _sequence_variants(value)
+        generics = annotation.get_generics()
+        if variants is None:
+            return not as_class and isinstance(value, Tuple) and value._is_homogenous() \
+                and annotation._generics_manager.is_homogenous_tuple() \
+                and matches_annotation(
+                    value._generics_manager.get_index_and_execute(0), generics[0]
+                )
+        if annotation._generics_manager.is_homogenous_tuple():
+            return all(matches_annotation(item.infer(), generics[0])
+                       for variant in variants for item in variant)
+        return all(
+            len(variant) == len(generics)
+            and all(matches_annotation(item.infer(), expected)
+                    for item, expected in zip(variant, generics))
+            for variant in variants
+        )
+
+    if isinstance(annotation, GenericClass):
+        if not _is_subclass(_class_for_matching(value, as_class), annotation._class_value):
+            return False
+        generics = annotation.get_generics()
+        if not generics:
+            return True
+        if all(any(_ANY in _expand_annotation(part) for part in generic)
+               for generic in generics):
+            return True
+        name = annotation.py__name__()
+        if not as_class and annotation.get_root_context().is_builtins_module():
+            if name == 'dict' and len(generics) == 2:
+                variants = _mapping_variants(value)
+                if variants is not None:
+                    return all(
+                        matches_annotation(ValueSet([key]), generics[0])
+                        and matches_annotation(item.infer(), generics[1])
+                        for variant in variants for key, item in variant
+                    )
+            elif name in ('list', 'set', 'frozenset') and len(generics) == 1:
+                variants = _sequence_variants(value)
+                if variants is not None:
+                    return all(matches_annotation(item.infer(), generics[0])
+                               for variant in variants for item in variant)
+        return _matches_generic_class(value, annotation, as_class)
+
+    if annotation.get_safe_value(default=_UNKNOWN) is None:
+        expected_class = annotation.py__class__()
+    elif annotation.is_class():
+        expected_class = annotation
+    else:
+        return False
+    return _is_subclass(_class_for_matching(value, as_class), expected_class)
+
+
+def _matches_callable(value, annotation):
+    from jedi.inference.arguments import ValuesArguments
+
+    signatures = value.get_signatures()
+    if not signatures and not value.py__getattribute__('__call__'):
+        return False
+    if annotation is None:
+        return True
+    generics = annotation.get_generics()
+    if len(generics) != 2:
+        return True
+    calls = [ValuesArguments([])]
+    parameter_lists = [part for part in generics[0]
+                       if isinstance(part, iterable.SequenceLiteralValue)]
+    if parameter_lists:
+        calls = [ValuesArguments([item.infer().execute_annotation(None) for item in parameters])
+                 for parameter_list in parameter_lists
+                 for parameters in _sequences_from_values(ValueSet([parameter_list]))]
+        if not all(any(signature.matches_signature(
+            signature.value._get_arguments(call)
+            if signature.is_bound and hasattr(signature.value, '_get_arguments') else call
+        ) for signature in signatures) for call in calls):
+            return False
+    if any(_ANY in _expand_annotation(part) for part in generics[1]):
+        return True
+    return all(matches_annotation(value.execute(call), generics[1]) for call in calls)
+
+
+def _matches_generic_class(value, annotation, as_class):
+    actual_class = _class_for_matching(value, as_class)
+    if not as_class and getattr(value, 'is_instance', lambda: False)() \
+            and not value.is_compiled() \
+            and not isinstance(actual_class, GenericClass):
+        actual_class = value.get_annotated_class_object()
+    for candidate in actual_class.py__mro__():
+        if not isinstance(candidate, GenericClass) \
+                or not _class_origin(candidate).is_same_class(_class_origin(annotation)):
+            continue
+        actual = candidate.get_generics()
+        expected = annotation.get_generics()
+        if len(actual) != len(expected):
+            continue
+        return all(
+            any(isinstance(part, AnyClass) for part in given)
+            or matches_annotation(given.execute_annotation(None), wanted)
+            for given, wanted in zip(actual, expected)
+        )
+    return False
+
+
+def _concatenate_variants(left, right):
+    return tuple(first + second for first, second in product(left, right))
+
+
+def _sequences_from_values(values):
+    variants = []
+    for value in values:
+        sequences = _sequence_variants(value)
+        if sequences is None:
+            try:
+                sequences = (tuple(value.py__iter__()),)
+            except AttributeError:
+                sequences = ((LazyUnknownValue(),),)
+        variants.extend(sequences)
+    return tuple(variants) if variants else ((LazyUnknownValue(),),)
+
+
+def _sequence_variants(value):
+    """Return finite sequence alternatives, or None if their shape is unknown."""
+    if isinstance(value, _LiteralValue):
+        if value.mapping is not None:
+            return (tuple(LazyKnownValue(key) for key, item in value.mapping),)
+        return (value.sequence,)
+    if not isinstance(value, (iterable.Sequence, iterable.GeneratorComprehension, Tuple)):
+        return None
+    return _known_sequence_variants(value)
+
+
+@inference_state_method_cache(default=None)
+def _known_sequence_variants(value):
+    if value.array_type == 'dict':
+        mappings = _mapping_variants(value)
+        if mappings is not None:
+            return tuple(tuple(LazyKnownValue(key) for key, item in mapping)
+                         for mapping in mappings)
+    elif isinstance(value, iterable.ComprehensionMixin):
+        return _comprehension_variants(value, value._sync_comp_for_node, value._defining_context)
+    elif isinstance(value, iterable.SequenceLiteralValue):
+        atom = value.atom
+        if atom.type in value._TUPLE_LIKE:
+            entries = atom.children[::2]
+        elif len(atom.children) == 2:
+            entries = []
+        else:
+            node = atom.children[1]
+            entries = node.children[::2] if node.type in ('testlist_comp', 'dictorsetmaker') \
+                else [node]
+        variants = ((),)
+        for node in entries:
+            if node.type == 'star_expr':
+                contents = value._defining_context.infer_node(node.children[1])
+                variants = _concatenate_variants(variants, _sequences_from_values(contents))
+            else:
+                item = LazyTreeValue(value._defining_context, node)
+                variants = tuple(variant + (item,) for variant in variants)
+        return variants
+    elif isinstance(value, iterable.MergedArray):
+        variants = ((),)
+        for array in value._arrays:
+            variants = _concatenate_variants(variants, _sequences_from_values(ValueSet([array])))
+        return variants
+    elif isinstance(value, (iterable.FakeTuple, iterable.FakeList)):
+        return (tuple(value.py__iter__()),)
+    elif isinstance(value, Tuple) and not value._is_homogenous():
+        return (tuple(value.py__iter__()),)
+    return None
+
+
+def _mapping_variants(value):
+    """Return alternatives containing final keys and their last assigned values."""
+    if isinstance(value, _LiteralValue):
+        return (value.mapping,) if value.mapping is not None else None
+    if not isinstance(value, (iterable.DictLiteralValue, iterable.DictComprehension,
+                              iterable.FakeDict)):
+        return None
+    return _known_mapping_variants(value)
+
+
+def _key_identity(key):
+    if key.array_type == 'tuple':
+        variants = _sequence_variants(key)
+        if variants is not None and len(variants) == 1:
+            items = [item.infer() for item in variants[0]]
+            if all(len(item) == 1 for item in items):
+                return tuple(_key_identity(next(iter(item))) for item in items)
+    if isinstance(key, ValueWrapper) and key.is_class():
+        return _class_origin(key)
+    return key.get_safe_value(default=key)
+
+
+def _merge_mapping(left, right):
+    result = {_key_identity(key): (key, item) for key, item in left}
+    for key, item in right:
+        identity = _key_identity(key)
+        previous_key = result.get(identity, (key, None))[0]
+        result[identity] = previous_key, item
+    return tuple(result.values())
+
+
+@inference_state_method_cache(default=None)
+def _known_mapping_variants(value):
+    if isinstance(value, iterable.FakeDict):
+        return (tuple((create_simple_object(value.inference_state, key), item)
+                      for key, item in value.exact_key_items()),)
+    if isinstance(value, iterable.DictComprehension):
+        entries = _comprehension_variants(
+            value, value._sync_comp_for_node, value._defining_context
+        )
+        if entries is None:
+            return None
+        return tuple(_merge_mapping((), variant) for variant in entries)
+    if len(value.atom.children) == 2:
+        return ((),)
+    variants = ((),)
+    context = value._defining_context
+    nodes = iter(value.atom.children[1].children)
+    for node in nodes:
+        if node == ',':
+            continue
+        if node == '**':
+            mappings = []
+            for mapping in context.infer_node(next(nodes)):
+                contents = _mapping_variants(mapping)
+                if contents is None:
+                    return None
+                mappings.extend(contents)
+            if not mappings:
+                return None
+        else:
+            next(nodes)
+            item = LazyTreeValue(context, next(nodes))
+            mappings = [((variant, item),) for key in context.infer_node(node)
+                        for variant in _value_variants(key)]
+            if not mappings:
+                return None
+        variants = tuple(_merge_mapping(first, second)
+                         for first, second in product(variants, mappings))
+    return variants
+
+
+def _value_variants(value, seen=frozenset()):
+    """Split literal contents lazily when separate union members must be tried."""
+    if isinstance(value, _LiteralValue):
+        yield value
+        return
+    if value not in seen and isinstance(
+        value, (iterable.Sequence, iterable.GeneratorComprehension, Tuple)
+    ):
+        mappings = _mapping_variants(value)
+        if mappings is not None:
+            for mapping in mappings:
+                for items in _item_combinations((item for key, item in mapping), seen | {value}):
+                    yield _LiteralValue(value, mapping=tuple(zip(
+                        (key for key, item in mapping), items
+                    )))
+            return
+        sequences = _sequence_variants(value)
+        if sequences is not None:
+            for sequence in sequences:
+                for items in _item_combinations(sequence, seen | {value}):
+                    yield _LiteralValue(value, sequence=items)
+            return
+    yield value
+
+
+def _item_variants(item, seen):
+    values = item.infer()
+    if not values:
+        yield LazyUnknownValue()
+    for value in values:
+        for variant in _value_variants(value, seen):
+            yield LazyKnownValue(variant)
+
+
+def _extend_item_combinations(combinations, item, seen):
+    for combination in combinations:
+        for variant in _item_variants(item, seen):
+            yield combination + (variant,)
+
+
+def _item_combinations(items, seen):
+    combinations = ((),)
+    for item in items:
+        combinations = _extend_item_combinations(combinations, item, seen)
+    return combinations
+
+
+def _comprehension_variants(value, node, context):
+    if node is None:
+        item = _comprehension_entry(context, value._entry_node)
+        if value.array_type == 'dict':
+            mapped = _comprehension_entry(context, value._value_node)
+            keys = item.infer()
+            return tuple(((variant, mapped),) for key in keys
+                         for variant in _value_variants(key)) if keys else None
+        return ((item,),)
+    if node.type == 'comp_for':
+        node = node.children[1]
+    if node.type == 'comp_if':
+        conditions = context.infer_node(node.children[1])
+        truths = {_literal_bool(condition) for condition in conditions} or {None}
+        variants = ((),) if truths != {True} else ()
+        if truths != {False}:
+            following = node.children[2] if len(node.children) > 2 else None
+            entries = _comprehension_variants(value, following, context)
+            if entries is None:
+                return None
+            variants += entries
+        return variants
+    variants = ()
+    for sequence in _sequences_from_values(context.infer_node(node.children[3])):
+        contents = ((),)
+        for item in sequence:
+            names = iterable.unpack_tuple_to_dict(context, item.infer(), node.children[1])
+            nested_context = CompForContext(context, node)
+            with nested_context.predefine_names(node, names):
+                following = node.children[4] if len(node.children) > 4 else None
+                entries = _comprehension_variants(value, following, nested_context)
+            if entries is None:
+                return None
+            contents = _concatenate_variants(contents, entries)
+        variants += contents
+    return variants
+
+
+def _comprehension_entry(context, node):
+    return LazyKnownValues(ValueSet(
+        variant for value in context.infer_node(node) for variant in _value_variants(value)
+    ))
+
+
+def _literal_bool(value):
+    if value.array_type in ('list', 'tuple', 'dict', 'set'):
+        variants = _sequence_variants(value)
+        if variants is not None:
+            truths = {bool(variant) for variant in variants}
+            if len(truths) == 1:
+                return next(iter(truths))
+    return value.py__bool__()
+
+
+def _unknown_mapping_values(value):
+    actual_class = value.py__class__()
+    expected = builtin_from_name(value.inference_state, 'dict')
+    if not _is_subclass(actual_class, expected):
+        return None
+    for candidate in actual_class.py__mro__():
+        if not isinstance(candidate, GenericClass) \
+                or not _class_origin(candidate).is_same_class(_class_origin(expected)):
+            continue
+        generics = candidate.get_generics()
+        if len(generics) == 2:
+            keys = generics[0].execute_annotation(None)
+            string = builtin_from_name(value.inference_state, 'str')
+            if keys and not matches_annotation(keys, ValueSet([string])):
+                return None
+            return LazyKnownValues(generics[1].execute_annotation(None))
+    return LazyUnknownValue()
+
+
+def unpack_argument_variants(arguments, funcdef=None):
+    """Keep alternative argument lengths and keyword sets separate for binding."""
+    from jedi.inference.arguments import TreeArguments, unpack_arglist
+
+    variants = ((),)
+    for star_count, node in unpack_arglist(arguments.argument_node):
+        if star_count == 1:
+            sequences = _sequences_from_values(arguments.context.infer_node(node))
+            unpacked = tuple(tuple((None, item) for item in sequence) for sequence in sequences)
+        elif star_count == 2:
+            unpacked = []
+            for value in arguments.context.infer_node(node):
+                mappings = _mapping_variants(value)
+                if mappings is None:
+                    item = _unknown_mapping_values(value)
+                    unpacked.append(((UNKNOWN_KEYWORD if item is not None else _UNKNOWN,
+                                      item or LazyUnknownValue()),))
