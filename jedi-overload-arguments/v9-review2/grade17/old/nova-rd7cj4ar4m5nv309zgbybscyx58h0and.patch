+def _get_comp_ifs(comp_for):
+    if len(comp_for.children) <= 4:
+        return []
+    ifs = []
+    last = comp_for.children[4]
+    while last.type == 'comp_if':
+        ifs.append(last)
+        if len(last.children) > 2:
+            last = last.children[-1]
+        else:
+            break
+    return ifs
+
+
+_UNKNOWN_KEY = object()
+
+
+class _TupleKey:
+    def __init__(self, items):
+        self.items = items
+
+    def __hash__(self):
+        return hash((_TupleKey, self.items))
+
+    def __eq__(self, other):
+        return isinstance(other, _TupleKey) and self.items == other.items
+
+    def __repr__(self):
+        return '_TupleKey(%r)' % (self.items,)
+
+
+class _ObjectKey:
+    def __init__(self, obj):
+        self.obj = obj
+
+    def __hash__(self):
+        return hash((_ObjectKey, self.obj))
+
+    def __eq__(self, other):
+        return isinstance(other, _ObjectKey) and self.obj == other.obj
+
+    def __repr__(self):
+        return '_ObjectKey(%r)' % (self.obj,)
+
+
+class VarPositional:
+    def __init__(self, value_set):
+        self.value_set = value_set
+
+    def __eq__(self, other):
+        return isinstance(other, VarPositional) and self.value_set == other.value_set
+
+    def __repr__(self):
+        return 'VarPositional(%r)' % (self.value_set,)
+
+
+def _get_dict_key_identity(key_value, seen=None):
+    if key_value is None:
+        return _UNKNOWN_KEY
+    try:
+        safe = key_value.get_safe_value(default=sentinel)
+    except Exception:
+        safe = sentinel
+    if safe is not sentinel:
+        if safe is None or isinstance(safe, (str, bytes, int, float, bool, complex)):
+            try:
+                hash(safe)
+                return safe
+            except TypeError:
+                return _UNKNOWN_KEY
+    if isinstance(key_value, Sequence) and key_value.array_type == 'tuple' and not isinstance(key_value, FakeList):
+        branches = get_sequence_branches(key_value, seen)
+        if len(branches) == 1:
+            branch = branches[0]
+            items = []
+            for elem_set in branch:
+                if isinstance(elem_set, VarPositional) or len(elem_set) != 1:
+                    return _UNKNOWN_KEY
+                sub_key = _get_dict_key_identity(next(iter(elem_set)), seen)
+                if sub_key is _UNKNOWN_KEY:
+                    return _UNKNOWN_KEY
+                items.append(sub_key)
+            return _TupleKey(tuple(items))
+        return _UNKNOWN_KEY
+    if key_value.is_class() or key_value.is_function() or key_value.is_module():
+        orig = getattr(key_value, '_original_value', key_value)
+        return _ObjectKey(orig)
+    return _UNKNOWN_KEY
+
+
+def _dedup_sequence_branches(branches, max_branches=32):
+    result = []
+    for b in branches:
+        if b not in result:
+            result.append(b)
+            if len(result) >= max_branches:
+                break
+    return result or [[]]
+
+
+def _dedup_dict_branches(branches, max_branches=32):
+    result = []
+    for b in branches:
+        if b not in result:
+            result.append(b)
+            if len(result) >= max_branches:
+                break
+    return result or [{}]
