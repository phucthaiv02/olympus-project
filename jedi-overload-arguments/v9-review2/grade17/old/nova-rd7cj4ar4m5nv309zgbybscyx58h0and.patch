+        for node in value._get_raw_tree_entries():
+            if node == ':' or node.type == 'subscript':
+                elem_set = ValueSet([Slice(value._defining_context, None, None, None)])
+                branches = [b + [elem_set] for b in branches]
+            elif node.type == 'star_expr':
+                unpacked_set = value._defining_context.infer_node(node.children[1])
+                sub_branches = []
+                for uv in unpacked_set:
+                    sub_branches.extend(get_sequence_branches(uv, seen))
+                if not sub_branches:
+                    sub_branches = [[]]
+                new_branches = []
+                for b in branches:
+                    for sb in sub_branches:
+                        new_branches.append(b + sb)
+                branches = _dedup_sequence_branches(new_branches)
+            else:
+                elem_set = value._defining_context.infer_node(node)
+                branches = [b + [elem_set] for b in branches]
+        additions = list(check_array_additions(value._defining_context, value))
+        if additions:
+            added_set = ValueSet.from_sets(lv.infer() for lv in additions)
+            if added_set:
