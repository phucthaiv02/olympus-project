+    if isinstance(value, (DictLiteralValue, DictComprehension, FakeDict)):
+        dict_branches = _extract_dict_branches(value, seen)
+        seq_branches = []
+        for db in dict_branches:
+            seq_branches.append([k_set for k_set, _ in db.values() if k_set])
+        return _dedup_sequence_branches(seq_branches)
+
+    seen = seen | {value}
