+def _generic_set_accepts_unparameterized(ann_g_set, type_var_bindings=None):
+    from jedi.inference.gradual.typing import AnyClass, ProxyWithGenerics, IGNORE_ANNOTATION_PARTS
+    from jedi.inference.gradual.type_var import TypeVar
+    if not ann_g_set:
+        return True
+    for g in ann_g_set:
+        if isinstance(g, AnyClass):
+            return True
+        if isinstance(g, TypeVar):
+            if type_var_bindings and g.py__name__() in type_var_bindings:
+                if _generic_set_accepts_unparameterized(type_var_bindings[g.py__name__()], type_var_bindings):
+                    return True
+                continue
+            if g._bound_lazy_value is None and not g._constraints_lazy_values:
+                return True
+            if g._bound_lazy_value is not None and _generic_set_accepts_unparameterized(g.bound, type_var_bindings):
+                return True
+        if isinstance(g, ProxyWithGenerics):
+            sub_name = g._tree_name.value
+            if sub_name in ('Union', 'Optional'):
+                if _generic_set_accepts_unparameterized(g.gather_annotation_classes(), type_var_bindings):
+                    return True
+            elif sub_name in IGNORE_ANNOTATION_PARTS and len(g._generics_manager) > 0:
+                if _generic_set_accepts_unparameterized(g._generics_manager[0], type_var_bindings):
+                    return True
+        if g.is_class() and g.py__name__() == 'object' and g.get_root_context().is_builtins_module():
+            return True
+    return False
