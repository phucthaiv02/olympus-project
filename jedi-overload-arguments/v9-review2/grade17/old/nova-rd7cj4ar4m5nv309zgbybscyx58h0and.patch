+                        return False
+                    if v_set and not _annotation_set_accepts_values(val_ann, v_set, type_var_bindings):
+                        return False
+            return True
+        if ann_name in ('Iterable', 'Collection', 'Container', 'Reversible', 'Sized') and len(generics) >= 1:
+            key_ann = generics[0]
