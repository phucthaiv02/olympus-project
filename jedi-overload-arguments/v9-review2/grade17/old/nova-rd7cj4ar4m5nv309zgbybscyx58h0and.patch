+def _collect_constrained_type_vars(annotation_set, found=None):
+    from jedi.inference.gradual.type_var import TypeVar
+    from jedi.inference.gradual.base import DefineGenericBaseClass
+    if found is None:
+        found = {}
+    for ann in annotation_set:
+        if isinstance(ann, TypeVar) and ann._constraints_lazy_values:
+            found[ann.py__name__()] = ann
