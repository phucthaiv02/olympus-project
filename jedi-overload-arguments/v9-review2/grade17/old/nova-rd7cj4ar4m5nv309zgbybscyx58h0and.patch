+        return _dedup_sequence_branches(branches)
+
+    if isinstance(value, (_BaseComprehension, GeneratorComprehension)):
+        return value._get_comp_branches(seen)
+
+    if isinstance(value, _FakeSequence):
+        return [[lv.infer() for lv in value.py__iter__()]]
+
+    if isinstance(value, MergedArray):
