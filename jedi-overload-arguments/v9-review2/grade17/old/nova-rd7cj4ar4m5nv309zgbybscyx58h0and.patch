+        elif star_count == 2:
+            seen_keyword = True
+            arrays = arguments.context.infer_node(el)
+            if not arrays:
+                sub_dict_branches = [{}]
+            else:
+                sub_dict_branches = []
+                for dct in arrays:
+                    from jedi.inference.value.instance import CompiledInstance
+                    if isinstance(dct, CompiledInstance) and dct.name.string_name == 'dict':
+                        sub_dict_branches.append({})
+                    elif isinstance(dct, iterable.Sequence) and dct.array_type == 'dict':
+                        sub_dict_branches.extend(iterable._extract_dict_branches(dct))
+                    elif dct.is_instance() and dct.py__getattribute__('keys') and dct.py__getattribute__('__getitem__'):
+                        sub_dict_branches.extend(iterable._extract_dict_branches(dct))
+                    else:
+                        return None
+                if not sub_dict_branches:
+                    sub_dict_branches = [{}]
+            new_branches = []
+            for pos_list, kw_dict, extra_kw, conflict in branches:
+                for db in sub_dict_branches:
+                    new_kw = dict(kw_dict)
+                    new_extra = list(extra_kw)
+                    new_conflict = conflict
+                    for kid, (k_set, v_set) in db.items():
+                        if isinstance(kid, str):
+                            if kid in new_kw:
+                                new_conflict = True
+                            new_kw[kid] = v_set
+                        else:
+                            if k_set and all(not _is_str_value(kv) for kv in k_set):
+                                new_conflict = True
+                            elif v_set:
+                                new_extra.append(v_set)
+                    new_branches.append((list(pos_list), new_kw, new_extra, new_conflict))
+            branches = new_branches[:32]
+        else:
+            if el.type == 'argument':
+                c = el.children
+                if len(c) == 3:  # Keyword argument
+                    seen_keyword = True
+                    k_name = c[0].value
+                    v_set = arguments.context.infer_node(c[2])
+                    new_branches = []
+                    for pos_list, kw_dict, extra_kw, conflict in branches:
+                        new_kw = dict(kw_dict)
+                        new_conflict = conflict or (k_name in new_kw)
+                        new_kw[k_name] = v_set
+                        new_branches.append((list(pos_list), new_kw, list(extra_kw), new_conflict))
+                    branches = new_branches
+                else:  # Generator comprehension
+                    if seen_keyword:
+                        return None
+                    sync_comp_for = el.children[1]
+                    if sync_comp_for.type == 'comp_for':
+                        sync_comp_for = sync_comp_for.children[1]
+                    comp = iterable.GeneratorComprehension(
+                        arguments._inference_state,
+                        defining_context=arguments.context,
+                        sync_comp_for_node=sync_comp_for,
+                        entry_node=el.children[0],
+                    )
+                    v_set = ValueSet([comp])
+                    branches = [
+                        (pos_list + [v_set], dict(kw_dict), list(extra_kw), conflict)
+                        for pos_list, kw_dict, extra_kw, conflict in branches
+                    ]
+            else:
+                if seen_keyword:
+                    return None
+                v_set = arguments.context.infer_node(el)
+                branches = [
+                    (pos_list + [v_set], dict(kw_dict), list(extra_kw), conflict)
+                    for pos_list, kw_dict, extra_kw, conflict in branches
+                ]
+
+    expanded_branches = []
+    for pos_list, kw_dict, extra_kw, conflict in branches:
+        for exp_pos in _expand_pos_list(pos_list):
+            expanded_branches.append((exp_pos, kw_dict, extra_kw, conflict))
+    return expanded_branches[:32]
+
+
+def _classify_params(funcdef):
+    params = funcdef.get_params()
+    if not params:
+        return [], set(), {}, None, None
+
+    parent = params[0].parent
+    has_slash = '/' in parent.children
+    seen_slash = not has_slash
+    seen_star = False
+
+    pos_params = []
+    pos_only_names = set()
+    kw_able_params = {}
+    var_pos_param = None
+    var_kw_param = None
+
+    for child in parent.children:
+        if child == '/':
+            seen_slash = True
+        elif child == '*':
+            seen_star = True
+        elif child.type == 'param':
+            if child.star_count == 1:
+                var_pos_param = child
+                seen_star = True
+            elif child.star_count == 2:
+                var_kw_param = child
+            else:
+                name = child.name.value
+                is_pos_only = (not seen_slash) or (
+                    not seen_star and name.startswith('__') and not name.endswith('__')
+                )
+                if is_pos_only:
+                    pos_params.append(child)
+                    pos_only_names.add(name)
+                elif seen_star:
+                    kw_able_params[name] = child
+                else:
+                    pos_params.append(child)
+                    kw_able_params[name] = child
+    return pos_params, pos_only_names, kw_able_params, var_pos_param, var_kw_param
+
+
+def _bind_call_branch(pos_list, kw_dict, extra_kw, conflict, param_info):
+    if conflict:
+        return None
+
+    pos_params, pos_only_names, kw_able_params, var_pos_param, var_kw_param = param_info
+    bound_params = {}
+    star_args_list = []
+    star_kwargs_list = []
+
+    trailing_var_pos = None
+    fixed_pos = pos_list
+    if pos_list and isinstance(pos_list[-1], iterable.VarPositional):
+        trailing_var_pos = pos_list[-1]
+        fixed_pos = pos_list[:-1]
+
+    for i, arg_set in enumerate(fixed_pos):
+        if i < len(pos_params):
+            bound_params[pos_params[i]] = arg_set
+        elif var_pos_param is not None:
+            star_args_list.append(arg_set)
+        else:
+            return None
+
+    for k_name, arg_set in kw_dict.items():
+        if k_name in kw_able_params:
+            param = kw_able_params[k_name]
+            if param in bound_params:
+                return None
+            bound_params[param] = arg_set
+        elif var_kw_param is not None:
+            star_kwargs_list.append(arg_set)
+        else:
+            return None
+
+    if trailing_var_pos is not None:
+        vp_set = trailing_var_pos.value_set
+        remaining_pos = [p for p in pos_params[len(fixed_pos):] if p not in bound_params]
+        if var_pos_param is not None:
+            if vp_set:
+                star_args_list.append(vp_set)
+            for p in remaining_pos:
+                if p.default is None:
+                    if not vp_set:
+                        return None
+                    bound_params[p] = vp_set
+                elif vp_set:
+                    bound_params[p] = vp_set
+        else:
+            if not remaining_pos and vp_set:
+                return None
+            for p in remaining_pos:
+                if p.default is None:
+                    if not vp_set:
+                        return None
+                    bound_params[p] = vp_set
+                elif vp_set:
+                    bound_params[p] = vp_set
+
+    if extra_kw:
+        merged_extra = ValueSet.from_sets(extra_kw)
+        if var_kw_param is not None:
+            star_kwargs_list.extend(extra_kw)
+        for p in kw_able_params.values():
+            if p not in bound_params and p.default is None and merged_extra:
+                bound_params[p] = merged_extra
+        if var_kw_param is None and not kw_able_params and merged_extra:
+            return None
+
+    for p in pos_params:
+        if p not in bound_params and p.default is None:
+            return None
+    for p in kw_able_params.values():
+        if p not in bound_params and p.default is None:
+            return None
+
+    return bound_params, star_args_list, star_kwargs_list
+
+
+def _branch_annotations_match(function_value, arguments, bound_params, star_args_list, star_kwargs_list, param_info):
+    from jedi.inference.gradual.annotation import infer_param
+    from jedi.inference.value.instance import InstanceArguments
+
+    funcdef = function_value.tree_node
+    pos_params, _, _, var_pos_param, var_kw_param = param_info
+
+    skip_first_self = (
+        isinstance(arguments, InstanceArguments)
+        and funcdef.name.value in ('__init__', '__new__')
+        and bool(pos_params)
+    )
+
+    checks = []
+    for param, arg_set in bound_params.items():
+        if skip_first_self and param == pos_params[0]:
+            continue
+        ann_set = infer_param(function_value, param, ignore_stars=True)
+        if ann_set and arg_set:
+            checks.append((ann_set, arg_set))
+
+    if var_pos_param is not None and star_args_list:
+        ann_set = infer_param(function_value, var_pos_param, ignore_stars=True)
+        if ann_set:
+            for arg_set in star_args_list:
+                if arg_set:
+                    checks.append((ann_set, arg_set))
+
+    if var_kw_param is not None and star_kwargs_list:
+        ann_set = infer_param(function_value, var_kw_param, ignore_stars=True)
+        if ann_set:
+            for arg_set in star_kwargs_list:
+                if arg_set:
+                    checks.append((ann_set, arg_set))
+
+    for ann_set, arg_set in checks:
+        if not _annotation_set_accepts_values(ann_set, arg_set):
+            return False
+
+    # Also verify cross-parameter consistency for constrained TypeVars that appear
+    # in more than one checked argument.
+    tv_occurrences = defaultdict(list)
+    for ann_set, arg_set in checks:
+        found_tvs = _collect_constrained_type_vars(ann_set)
+        for tv_name, tv in found_tvs.items():
+            tv_occurrences[tv_name].append((tv, ann_set, arg_set))
+
+    for tv_name, occ_list in tv_occurrences.items():
+        if len(occ_list) > 1:
+            tv = occ_list[0][0]
+            # There must exist at least one constraint that is compatible with at least one
+            # value in each occurrence, or if each occurrence is a single concrete value,
+            # a single constraint that accepts all of them.
+            has_shared_constraint = False
+            for c_set in tv.constraint_sets:
+                if not c_set:
+                    continue
+                bindings = {tv_name: c_set}
+                if all(
+                    any(_annotation_set_accepts_single_value(ann_set, val, bindings) for val in arg_set)
+                    for _, ann_set, arg_set in occ_list
+                ):
+                    has_shared_constraint = True
+                    break
+            if not has_shared_constraint:
+                return False
+
+    return True
+
+
+def matches_call_signature(function_value, arguments):
+    funcdef = function_value.tree_node
+    call_branches = _unpack_call_branches(arguments)
+    if call_branches is None:
+        return False
+
+    param_info = _classify_params(funcdef)
+    for pos_list, kw_dict, extra_kw, conflict in call_branches:
+        bound = _bind_call_branch(pos_list, kw_dict, extra_kw, conflict, param_info)
+        if bound is None:
+            return False
+        bound_params, star_args_list, star_kwargs_list = bound
+        if not _branch_annotations_match(
+            function_value, arguments, bound_params, star_args_list, star_kwargs_list, param_info
+        ):
+            return False
+    return True
+
+
+def get_call_branch_param_values(function_value, arguments):
+    funcdef = function_value.tree_node
+    call_branches = _unpack_call_branches(arguments)
+    if not call_branches:
+        return {}
+
+    param_info = _classify_params(funcdef)
+    _, _, _, var_pos_param, var_kw_param = param_info
+    merged = defaultdict(lambda: NO_VALUES)
+
+    for pos_list, kw_dict, extra_kw, conflict in call_branches:
+        bound = _bind_call_branch(pos_list, kw_dict, extra_kw, conflict, param_info)
+        if bound is None:
+            continue
+        bound_params, star_args_list, star_kwargs_list = bound
+        for param, arg_set in bound_params.items():
+            merged[param.name.value] |= arg_set
+        if var_pos_param is not None and star_args_list:
+            for arg_set in star_args_list:
+                merged[var_pos_param.name.value] |= arg_set
+        if var_kw_param is not None and star_kwargs_list:
+            for arg_set in star_kwargs_list:
+                merged[var_kw_param.name.value] |= arg_set
+    return dict(merged)
+
