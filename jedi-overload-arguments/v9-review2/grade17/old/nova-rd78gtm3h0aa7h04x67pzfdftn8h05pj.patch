+        else:
+            return True
+    elif not is_homo and len(generics) == 1 and len(generics[0]) == 0:
+        expected_empty = True
+    else:
+        expected_empty = False
+
+    realizations = iterable.get_sequence_realizations(val)
+    if not realizations:
+        return False
+
+    for r in realizations:
+        if expected_empty:
+            if len(r) != 0:
+                return False
+        elif is_homo:
+            elem_ann = generics[0]
+            for elem in r:
+                if not annotation_set_accepts_values(elem_ann, elem.values, type_var_env):
+                    return False
+        else:
+            if any(isinstance(elem, VarElement) for elem in r):
+                return False
+            if len(r) != len(generics):
+                return False
+            for elem, elem_ann in zip(r, generics):
+                if not annotation_set_accepts_values(elem_ann, elem.values, type_var_env):
+                    return False
+    return True
+
+
+_SEQUENCE_LIKE_NAMES = frozenset({
+    'list', 'set', 'frozenset', 'deque',
+    'Sequence', 'MutableSequence', 'AbstractSet', 'MutableSet',
+    'Collection', 'Iterable', 'Iterator', 'Reversible', 'Container',
+})
+_MAPPING_LIKE_NAMES = frozenset({
+    'dict', 'defaultdict', 'OrderedDict', 'ChainMap', 'Counter',
+    'Mapping', 'MutableMapping',
+})
+
+
+def _generic_class_accepts_value(ann, val, type_var_env):
+    from jedi.inference.gradual.typing import TypeAlias, Tuple as TypingTuple
+    from jedi.inference.gradual.base import DefineGenericBaseClass
+
+    base_cls = ann._wrapped_value
+    while isinstance(base_cls, TypeAlias):
+        base_cls = base_cls._get_wrapped_value()
+
+    if base_cls.py__name__() in ('tuple', 'Tuple'):
+        return _tuple_annotation_accepts_value(ann, val, type_var_env)
+    if base_cls.py__name__() in ('type', 'Type'):
+        return _type_annotation_accepts_value(ann, val, type_var_env)
+
+    val_cls = _get_effective_class(val)
+    if not _is_subclass_of_base(val_cls, base_cls):
+        return False
+
+    generics = ann.get_generics()
+    if not generics:
+        return True
+
+    base_name = base_cls.py__name__()
+
+    if base_name in _MAPPING_LIKE_NAMES and len(generics) >= 2:
+        key_ann = generics[0]
+        val_ann = generics[1]
+        dict_reals = iterable.get_dict_realizations(val)
+        if not dict_reals:
+            return False
+        for dr in dict_reals:
+            for ek_val_set, ev_set in dr.exact.values():
+                if not annotation_set_accepts_values(key_ann, ek_val_set, type_var_env):
+                    return False
+                if not annotation_set_accepts_values(val_ann, ev_set, type_var_env):
+                    return False
+            for dk_set, dv_set in dr.dynamic:
+                if not annotation_set_accepts_values(key_ann, dk_set, type_var_env):
+                    return False
+                if not annotation_set_accepts_values(val_ann, dv_set, type_var_env):
+                    return False
+        return True
+
+    if base_name in _SEQUENCE_LIKE_NAMES and len(generics) == 1:
+        elem_ann = generics[0]
+        if base_name in ('list', 'set', 'frozenset', 'deque'):
+            if val_cls.py__name__() != base_name and not _is_subclass_of_base(val_cls, base_cls):
+                return False
+        if isinstance(val, (iterable.SequenceLiteralValue, iterable._BaseComprehension, iterable._FakeSequence, TypingTuple)):
+            seq_reals = iterable.get_sequence_realizations(val)
+            for sr in seq_reals:
+                for elem in sr:
+                    if not annotation_set_accepts_values(elem_ann, elem.values, type_var_env):
+                        return False
+            return True
+        if isinstance(val, (iterable.DictLiteralValue, iterable.DictComprehension, iterable.FakeDict)):
+            dict_reals = iterable.get_dict_realizations(val)
+            for dr in dict_reals:
+                for ek_val_set, _ in dr.exact.values():
+                    if not annotation_set_accepts_values(elem_ann, ek_val_set, type_var_env):
+                        return False
+                for dk_set, _ in dr.dynamic:
+                    if not annotation_set_accepts_values(elem_ann, dk_set, type_var_env):
+                        return False
+            return True
+        seq_reals = iterable.get_sequence_realizations(val)
+        for sr in seq_reals:
+            for elem in sr:
+                if not annotation_set_accepts_values(elem_ann, elem.values, type_var_env):
+                    return False
+        return True
+
+    # Custom generic class (e.g. Box[T], Pair[K, V], or subclass of Generic[...])
+    from jedi.inference.gradual.type_var import TypeWrapper
+    val_ann_cls = val.get_annotated_class_object() if hasattr(val, 'get_annotated_class_object') else val_cls
+    matched_mro = None
+    if isinstance(val_ann_cls, DefineGenericBaseClass):
+        if _unwrap_mro_class(val_ann_cls).is_same_class(base_cls):
+            matched_mro = val_ann_cls
+        else:
+            for mro_cls in val_ann_cls.py__mro__():
+                if _unwrap_mro_class(mro_cls).is_same_class(base_cls):
+                    matched_mro = mro_cls
+                    break
+    else:
+        for mro_cls in val_ann_cls.py__mro__():
+            if isinstance(mro_cls, DefineGenericBaseClass) and _unwrap_mro_class(mro_cls).is_same_class(base_cls):
+                matched_mro = mro_cls
+                break
+
+    if matched_mro is None or not isinstance(matched_mro, DefineGenericBaseClass):
+        return all(
+            any(_is_any_or_object(a) for a in g_set)
+            for g_set in generics
+        )
+
+    val_generics = matched_mro.get_generics()
+    if len(val_generics) != len(generics):
+        return False
+
+    for ann_g_set, val_g_set in zip(generics, val_generics):
+        if not val_g_set:
+            if not annotation_set_accepts_values(ann_g_set, NO_VALUES, type_var_env):
+                return False
+            continue
+        executed_vals = NO_VALUES
+        for vg in val_g_set:
+            if isinstance(vg, TypeWrapper):
+                executed_vals |= ValueSet([vg._original_value])
+            else:
+                executed_vals |= vg.execute_annotation(None)
+        if not annotation_set_accepts_values(ann_g_set, executed_vals, type_var_env):
+            return False
+    return True
+
+
+def _single_annotation_accepts_value(ann, val, type_var_env):
+    from jedi.inference.gradual.typing import (
+        ProxyWithGenerics, ProxyTypingClassValue, ProxyTypingValue,
+        TypeAlias,
+    )
+    from jedi.inference.gradual.type_var import TypeVar, TypeWrapper
+    from jedi.inference.gradual.base import DefineGenericBaseClass
+
+    while isinstance(ann, TypeAlias):
+        ann = ann._get_wrapped_value()
+
+    if _is_any_or_object(ann):
+        return True
+
+    if _is_none_value(ann):
+        return _is_none_value(val)
+
+    if isinstance(ann, TypeVar):
+        if ann in type_var_env:
+            return annotation_set_accepts_values(type_var_env[ann], ValueSet([val]), type_var_env)
+        if ann.constraint_sets:
+            return any(
+                annotation_set_accepts_values(cs, ValueSet([val]), type_var_env)
+                for cs in ann.constraint_sets
+            )
+        if ann.bound:
+            return annotation_set_accepts_values(ann.bound, ValueSet([val]), type_var_env)
+        return True
+
+    if isinstance(ann, ProxyWithGenerics):
+        ann_name = ann.py__name__()
+        generics = ann.get_generics()
+        if ann_name == 'Union':
+            if not generics:
+                return True
+            return any(
+                annotation_set_accepts_values(g, ValueSet([val]), type_var_env)
+                for g in generics
+            )
+        if ann_name == 'Optional':
+            if _is_none_value(val):
+                return True
+            if not generics:
+                return True
+            return annotation_set_accepts_values(generics[0], ValueSet([val]), type_var_env)
+        if ann_name in ('Final', 'Annotated', 'ClassVar'):
+            if generics:
+                return annotation_set_accepts_values(generics[0], ValueSet([val]), type_var_env)
+            return True
+        if ann_name == 'Type':
+            return _type_annotation_accepts_value(ann, val, type_var_env)
+        if ann_name == 'Tuple':
+            return _tuple_annotation_accepts_value(ann, val, type_var_env)
+        if ann_name == 'Callable':
+            is_callable = val.is_function() or val.is_class() or val.is_bound_method() \
+                or bool(val.py__getattribute__('__call__'))
+            if not is_callable:
+                return False
+            if len(generics) == 2:
+                return annotation_set_accepts_values(
+                    generics[1], val.execute_annotation(None), type_var_env
+                )
+            return True
+        return True
+
+    if isinstance(ann, (ProxyTypingClassValue, ProxyTypingValue)):
+        ann_name = ann.py__name__()
+        if ann_name == 'Tuple':
+            tuple_cls = compiled.builtin_from_name(ann.inference_state, 'tuple')
+            return _is_subclass_of_base(_get_effective_class(val), tuple_cls)
+        if ann_name == 'Type':
+            if isinstance(val, TypeWrapper) or val.is_class():
+                return True
+            type_cls = compiled.builtin_from_name(ann.inference_state, 'type')
+            return _is_subclass_of_base(_get_effective_class(val), type_cls)
+        if ann_name == 'Callable':
+            return val.is_function() or val.is_class() or val.is_bound_method() \
+                or bool(val.py__getattribute__('__call__'))
+        return True
+
+    if isinstance(ann, DefineGenericBaseClass):
+        return _generic_class_accepts_value(ann, val, type_var_env)
+
+    from jedi.plugins.stdlib import TupleClassWrapper, TypeClassWrapper
+    if isinstance(ann, TupleClassWrapper):
+        return _is_subclass_of_base(_get_effective_class(val), ann._wrapped_value)
+    if isinstance(ann, TypeClassWrapper):
+        if isinstance(val, TypeWrapper) or val.is_class():
+            return True
+        return _is_subclass_of_base(_get_effective_class(val), ann._wrapped_value)
+
+    if ann.is_class():
+        if ann.py__name__() == 'type' and ann.get_qualified_names() == ('type',):
+            if isinstance(val, TypeWrapper) or val.is_class():
+                return True
+        if isinstance(val, TypeWrapper) or val.is_class():
+            if not (ann.py__name__() == 'type' and ann.get_qualified_names() == ('type',)):
+                return False
+        val_cls = _get_effective_class(val)
+        return _is_subclass_of_base(val_cls, ann)
+
+    return False
+
+
+def _annotation_accepts_empty_values(ann, type_var_env):
+    from jedi.inference.gradual.typing import ProxyWithGenerics, TypeAlias
+    from jedi.inference.gradual.type_var import TypeVar
+
+    while isinstance(ann, TypeAlias):
+        ann = ann._get_wrapped_value()
+
+    if _is_any_or_object(ann):
+        return True
+    if isinstance(ann, TypeVar):
+        if ann in type_var_env:
+            return any(_annotation_accepts_empty_values(a, type_var_env) for a in type_var_env[ann])
+        if not ann.constraint_sets and not ann.bound:
+            return True
+        return False
+    if isinstance(ann, ProxyWithGenerics):
+        ann_name = ann.py__name__()
+        generics = ann.get_generics()
+        if ann_name == 'Union':
+            return any(
+                any(_annotation_accepts_empty_values(a, type_var_env) for a in g)
+                for g in generics
+            )
+        if ann_name == 'Optional':
+            return generics and any(_annotation_accepts_empty_values(a, type_var_env) for a in generics[0])
+        if ann_name in ('Final', 'Annotated', 'ClassVar'):
+            return not generics or any(_annotation_accepts_empty_values(a, type_var_env) for a in generics[0])
+    return False
+
+
+def annotation_set_accepts_values(annotation_set, arg_values, type_var_env=None):
+    """
+    Returns True if `annotation_set` accepts ALL possible values in `arg_values`.
+    """
+    if not annotation_set:
+        return True
+    if type_var_env is None:
+        type_var_env = {}
+
+    if not arg_values:
+        return any(_annotation_accepts_empty_values(ann, type_var_env) for ann in annotation_set)
+
+    for val in arg_values:
+        if not any(_single_annotation_accepts_value(ann, val, type_var_env) for ann in annotation_set):
+            return False
+    return True
+
+
+class CallRealization:
+    def __init__(self, pos_args=(), kw_args=(), var_kwargs=()):
+        # pos_args: tuple of PositionalElement or VarElement
+        self.pos_args = tuple(pos_args)
+        # kw_args: tuple of (key_str, ValueSet)
+        self.kw_args = tuple(kw_args)
+        # var_kwargs: tuple of (key_value_set, val_value_set)
+        self.var_kwargs = tuple(var_kwargs)
+
+    def __repr__(self):
+        return 'CallRealization(pos=%r, kw=%r, var_kw=%r)' % (
+            self.pos_args, self.kw_args, self.var_kwargs
+        )
+
+
+def _build_call_realizations(arguments, funcdef=None):
+    from jedi.inference.arguments import TreeArguments, ValuesArguments, \
+        TreeArgumentsWrapper, unpack_arglist
+    from jedi.inference.value.instance import InstanceArguments
+    from jedi.plugins.stdlib import ClassMethodArguments
+
+    prefix_args = []
+    while isinstance(arguments, TreeArgumentsWrapper):
+        if isinstance(arguments, InstanceArguments):
+            if funcdef is None or not parser_utils.function_is_staticmethod(funcdef):
+                prefix_args.append(PositionalElement(ValueSet([arguments.instance])))
+        elif isinstance(arguments, ClassMethodArguments):
+            prefix_args.append(PositionalElement(ValueSet([arguments._class])))
+        arguments = arguments._wrapped_arguments
+
+    realizations = [CallRealization(pos_args=prefix_args)]
+
+    if isinstance(arguments, ValuesArguments):
+        for val_set in arguments._values_list:
+            realizations = [
+                CallRealization(r.pos_args + (PositionalElement(val_set),), r.kw_args, r.var_kwargs)
+                for r in realizations
+            ]
+        return realizations
+
+    if not isinstance(arguments, TreeArguments):
+        for key, lv in arguments.unpack():
+            val_set = lv.infer()
+            if key is None:
+                realizations = [
+                    CallRealization(r.pos_args + (PositionalElement(val_set),), r.kw_args, r.var_kwargs)
+                    for r in realizations
+                ]
+            else:
+                realizations = [
+                    CallRealization(r.pos_args, r.kw_args + ((key, val_set),), r.var_kwargs)
+                    for r in realizations
+                ]
+        return realizations
+
+    context = arguments.context
+    for star_count, el in unpack_arglist(arguments.argument_node):
+        if star_count == 0:
+            if el.type == 'argument':
+                c = el.children
+                if len(c) == 3:  # Keyword argument k=v
+                    key_str = c[0].value
+                    val_set = context.infer_node(c[2])
+                    realizations = [
+                        CallRealization(r.pos_args, r.kw_args + ((key_str, val_set),), r.var_kwargs)
+                        for r in realizations
+                    ]
+                else:  # Generator comprehension
+                    sync_comp_for = c[1]
+                    if sync_comp_for.type == 'comp_for':
+                        sync_comp_for = sync_comp_for.children[1]
+                    comp = iterable.GeneratorComprehension(
+                        arguments._inference_state,
+                        defining_context=context,
+                        sync_comp_for_node=sync_comp_for,
+                        entry_node=c[0],
+                    )
+                    val_set = ValueSet([comp])
+                    realizations = [
+                        CallRealization(r.pos_args + (PositionalElement(val_set),), r.kw_args, r.var_kwargs)
+                        for r in realizations
+                    ]
+            else:
+                val_set = context.infer_node(el)
+                realizations = [
+                    CallRealization(r.pos_args + (PositionalElement(val_set),), r.kw_args, r.var_kwargs)
+                    for r in realizations
+                ]
+        elif star_count == 1:
+            arrays = context.infer_node(el)
+            if not arrays:
+                realizations = [
+                    CallRealization(r.pos_args + (VarElement(NO_VALUES),), r.kw_args, r.var_kwargs)
+                    for r in realizations
+                ]
+            else:
+                new_realizations = []
+                for r in realizations:
+                    for arr in arrays:
+                        for seq_r in iterable.get_sequence_realizations(arr):
+                            if len(new_realizations) < MAX_REALIZATIONS:
+                                new_realizations.append(
+                                    CallRealization(r.pos_args + seq_r, r.kw_args, r.var_kwargs)
+                                )
+                if new_realizations:
+                    realizations = new_realizations
+        elif star_count == 2:
+            dicts = context.infer_node(el)
+            if not dicts:
+                realizations = [
+                    CallRealization(r.pos_args, r.kw_args, r.var_kwargs + ((NO_VALUES, NO_VALUES),))
+                    for r in realizations
+                ]
+            else:
+                new_realizations = []
+                for r in realizations:
+                    for d in dicts:
+                        for dict_r in iterable.get_dict_realizations(d):
+                            if any(not isinstance(ek, str) for ek in dict_r.exact):
+                                continue
+                            extra_kw = tuple((ek, ev) for ek, (_, ev) in dict_r.exact.items())
+                            extra_var_kw = tuple(dict_r.dynamic)
+                            if len(new_realizations) < MAX_REALIZATIONS:
+                                new_realizations.append(
+                                    CallRealization(
+                                        r.pos_args,
+                                        r.kw_args + extra_kw,
+                                        r.var_kwargs + extra_var_kw,
+                                    )
+                                )
+                if not new_realizations:
+                    return []
+                realizations = new_realizations
+
+    return realizations
+
+
+def _get_param_kinds(funcdef):
+    params = funcdef.get_params()
+    if not params:
+        return [], []
+
+    parent = params[0].parent
+    slash_seen = False
+    star_seen = False
+    has_slash = '/' in parent.children
+
+    kinds = []
+    for p in parent.children:
+        if p == '/':
+            slash_seen = True
+        elif p == '*':
+            star_seen = True
+        elif getattr(p, 'type', None) == 'param':
+            if p.star_count == 1:
+                kinds.append(Parameter.VAR_POSITIONAL)
+                star_seen = True
+            elif p.star_count == 2:
+                kinds.append(Parameter.VAR_KEYWORD)
+            elif has_slash and not slash_seen:
+                kinds.append(Parameter.POSITIONAL_ONLY)
+            elif star_seen:
+                kinds.append(Parameter.KEYWORD_ONLY)
+            elif p.name.value.startswith('__') and not p.name.value.endswith('__'):
+                kinds.append(Parameter.POSITIONAL_ONLY)
+            else:
+                kinds.append(Parameter.POSITIONAL_OR_KEYWORD)
+    return params, kinds
+
+
+def _bind_realization_to_params(function_value, realization):
+    funcdef = function_value.tree_node
+    params, p_kinds = _get_param_kinds(funcdef)
+
+    pos_params = [
+        i for i, k in enumerate(p_kinds)
+        if k in (Parameter.POSITIONAL_ONLY, Parameter.POSITIONAL_OR_KEYWORD)
+    ]
+    var_pos_idx = next((i for i, k in enumerate(p_kinds) if k == Parameter.VAR_POSITIONAL), None)
+    var_kw_idx = next((i for i, k in enumerate(p_kinds) if k == Parameter.VAR_KEYWORD), None)
+    kw_param_map = {
+        params[i].name.value: i
+        for i, k in enumerate(p_kinds)
+        if k in (Parameter.POSITIONAL_OR_KEYWORD, Parameter.KEYWORD_ONLY)
+    }
+
+    bound_values = defaultdict(list)
+    definitely_bound = set()
+    maybe_bound = set()
+
+    pos_cursor = 0
+    in_var_mode = False
+
+    for elem in realization.pos_args:
+        if isinstance(elem, PositionalElement):
+            if not in_var_mode:
+                if pos_cursor < len(pos_params):
+                    p_idx = pos_params[pos_cursor]
+                    bound_values[p_idx].append(elem.values)
+                    definitely_bound.add(p_idx)
+                    pos_cursor += 1
+                elif var_pos_idx is not None:
+                    bound_values[var_pos_idx].append(elem.values)
+                else:
+                    return None
+            else:
+                possible_targets = pos_params[pos_cursor:]
+                for t_idx in possible_targets:
+                    bound_values[t_idx].append(elem.values)
+                    maybe_bound.add(t_idx)
+                if var_pos_idx is not None:
+                    bound_values[var_pos_idx].append(elem.values)
+                if pos_cursor < len(pos_params):
+                    pos_cursor += 1
+                elif var_pos_idx is None:
+                    return None
+        elif isinstance(elem, VarElement):
+            in_var_mode = True
+            for t_idx in pos_params[pos_cursor:]:
+                bound_values[t_idx].append(elem.values)
+                maybe_bound.add(t_idx)
+            if var_pos_idx is not None:
+                bound_values[var_pos_idx].append(elem.values)
+
+    seen_keywords = set()
+    bound_from_exact_kw = set()
+    for k, v_set in realization.kw_args:
+        if k in seen_keywords:
+            return None
+        seen_keywords.add(k)
+        if k in kw_param_map:
+            p_idx = kw_param_map[k]
+            if p_idx in definitely_bound:
+                return None
+            bound_values[p_idx].append(v_set)
+            definitely_bound.add(p_idx)
+            bound_from_exact_kw.add(k)
+        elif var_kw_idx is not None:
+            if any(
+                params[i].name.value == k and p_kinds[i] == Parameter.POSITIONAL_ONLY
+                for i in range(len(params))
+            ):
+                bound_values[var_kw_idx].append(v_set)
+            else:
+                bound_values[var_kw_idx].append(v_set)
+        else:
+            return None
+
+    for k_set, v_set in realization.var_kwargs:
+        str_cls = compiled.builtin_from_name(function_value.inference_state, 'str')
+        if k_set and not all(_is_subclass_of_base(kc, str_cls) for kc in k_set.py__class__()):
+            return None
+        for p_idx, p in enumerate(params):
+            if p_kinds[p_idx] in (Parameter.POSITIONAL_OR_KEYWORD, Parameter.KEYWORD_ONLY):
+                if p.name.value not in bound_from_exact_kw and p_idx not in definitely_bound:
+                    bound_values[p_idx].append(v_set)
+                    maybe_bound.add(p_idx)
+        if var_kw_idx is not None:
+            bound_values[var_kw_idx].append(v_set)
+
+    for p_idx, p in enumerate(params):
+        if p_kinds[p_idx] in (
+            Parameter.POSITIONAL_ONLY,
+            Parameter.POSITIONAL_OR_KEYWORD,
+            Parameter.KEYWORD_ONLY,
+        ):
+            if p.default is None and p_idx not in definitely_bound and p_idx not in maybe_bound:
+                return None
+
+    return bound_values
+
+
+def _realization_matches(bound_values, param_annotations, type_var_env):
+    for p_idx, val_sets in bound_values.items():
+        ann_set = param_annotations.get(p_idx, NO_VALUES)
+        if not ann_set:
+            continue
+        for val_set in val_sets:
+            if not annotation_set_accepts_values(ann_set, val_set, type_var_env):
+                return False
+    return True
+
+
+def matches_call_signature(function_value, arguments):
+    from jedi.inference.gradual.annotation import _infer_param
+    from jedi.inference.value.instance import InstanceArguments
+
+    funcdef = function_value.tree_node
+    realizations = _build_call_realizations(arguments, funcdef)
+    if not realizations:
+        return False
