index 0000000..5a99fd4
--- /dev/null
+++ b/jedi/inference/gradual/matching.py
@@ -0,0 +1,604 @@
+"""Match annotations without losing alternative argument and literal shapes."""
+
+from inspect import Parameter
+from itertools import product
+
+from jedi.common import monkeypatch
+from jedi.inference.base_value import NO_VALUES, ValueSet, ValueWrapper
+from jedi.inference.cache import inference_state_method_cache
+from jedi.inference.compiled import builtin_from_name
+from jedi.inference.gradual.base import GenericClass
+from jedi.inference.gradual.generics import _resolve_forward_references
+from jedi.inference.gradual.type_var import TypeVar
+from jedi.inference.gradual.typing import AnyClass, ProxyTypingValue, ProxyWithGenerics, Tuple
+from jedi.inference.lazy_value import LazyKnownValue, LazyKnownValues, LazyTreeValue
+from jedi.inference.value import iterable
+
+
+_UNKNOWN_KEY = object()
+
+
+def infer_argument(lazy_value):
+    if isinstance(lazy_value, LazyTreeValue):
+        with monkeypatch(lazy_value.context, 'predefined_names', lazy_value._predefined_names):
+            return _infer_argument_node(lazy_value.context, lazy_value.data, set())
+    return lazy_value.infer()
+
+
+def _infer_argument_node(context, node, seen):
+    if node in seen:
+        return context.infer_node(node)
+    seen = seen | {node}
+    if node.type == 'test' and len(node.children) == 5:
+        return _infer_argument_node(context, node.children[0], seen) \
+            | _infer_argument_node(context, node.children[-1], seen)
+    if node.type == 'atom' and node.children[0] == '(' and len(node.children) == 3 \
+            and node.children[1].type not in ('testlist_comp', 'yield_expr'):
+        return _infer_argument_node(context, node.children[1], seen)
+    if node.type == 'name':
+        values = NO_VALUES
+        names = context.goto(node, node.start_pos)
+        for name in names:
+            tree_name = getattr(name, 'tree_name', None)
+            definition = tree_name.get_definition() if tree_name is not None else None
+            if definition is None or definition.type != 'expr_stmt' \
+                    or definition.children[0] != tree_name:
+                break
+            assigned = definition.children[-1]
+            if assigned.type == 'annassign':
+                if len(assigned.children) != 4:
+                    break
+                assigned = assigned.children[-1]
+            elif definition.children[1] != '=':
+                break
+            inferred = _infer_argument_node(name.parent_context, assigned, seen)
+            if not any(isinstance(value, (iterable.SequenceLiteralValue,
+                                         iterable.ComprehensionMixin, iterable.MergedArray))
+                       for value in inferred):
+                break
+            values |= inferred
+        else:
+            if names:
+                return values
+    return context.infer_node(node)
+
+
+def matches_signature(function_value, arguments, check_annotations=True):
+    parameters = function_value.get_param_names()
+    has_variant = False
+    comparisons = []
+    annotations_by_name = {}
+    for unpacked in arguments.unpack_variants(function_value.tree_node):
+        has_variant = True
+        bound = _bind(parameters, unpacked)
+        if bound is None:
+            return False
+        if not check_annotations:
+            continue
+        for parameter in parameters:
+            lazy_values = bound.get(parameter.string_name, ())
+            if not lazy_values:
+                continue
+            try:
+                annotations = annotations_by_name[parameter.string_name]
+            except KeyError:
+                annotations = parameter.infer_annotation(
+                    execute_annotation=False, ignore_stars=True
+                )
+                annotations_by_name[parameter.string_name] = annotations
+            if annotations:
+                comparisons.extend((lazy_value, annotations) for lazy_value in lazy_values)
+    if not has_variant:
+        return False
+    type_vars = {}
+    for annotations in annotations_by_name.values():
+        _collect_constraints(annotations, type_vars, set())
+    for choices in product(*type_vars.values()):
+        constraints = dict(zip(type_vars, choices))
+        if all(_matches_values(infer_argument(lazy_value), annotations, constraints=constraints)
+               for lazy_value, annotations in comparisons):
+            return True
+    return False
+
+
+def _collect_constraints(annotations, type_vars, seen):
+    for annotation in annotations:
+        if annotation in seen:
+            continue
+        seen.add(annotation)
+        if isinstance(annotation, TypeVar):
+            if annotation._constraints_lazy_values:
+                type_vars[annotation] = tuple(
+                    _resolve_type_var(annotation, [lazy_value])
+                    for lazy_value in annotation._constraints_lazy_values
+                )
+        elif isinstance(annotation, (GenericClass, ProxyWithGenerics)):
+            for generic in annotation.get_generics():
+                _collect_constraints(generic, type_vars, seen)
+
+
+def _resolve_type_var(annotation, lazy_values):
+    return ValueSet.from_sets(
+        ValueSet(_resolve_forward_references(
+            getattr(lazy_value, 'context', annotation.parent_context), lazy_value.infer()
+        )) for lazy_value in lazy_values
+    )
+
+
+def _bind(parameters, unpacked):
+    positional = []
+    keywords = {}
+    unknown_keywords = []
+    for key, lazy_value in unpacked:
+        if key is None:
+            positional.append(lazy_value)
+        elif not isinstance(key, str):
+            if not hasattr(key, 'inference_state') or not _matches_values(
+                ValueSet([key]), ValueSet([builtin_from_name(key.inference_state, 'str')])
+            ):
+                return None
+            unknown_keywords.append(lazy_value)
+        elif key in keywords:
+            return None
+        else:
+            keywords[key] = lazy_value
+
+    bound = {}
+    position = 0
+    keyword_parameter = None
+    for parameter in parameters:
+        name = parameter.string_name
+        kind = parameter.get_kind()
+        if kind == Parameter.VAR_KEYWORD:
+            keyword_parameter = parameter
+            continue
+        if kind == Parameter.VAR_POSITIONAL:
+            bound[name] = positional[position:]
+            position = len(positional)
+            continue
+        if kind != Parameter.KEYWORD_ONLY and position < len(positional):
+            if kind != Parameter.POSITIONAL_ONLY and name in keywords:
+                return None
+            bound[name] = [positional[position]]
+            position += 1
+        elif kind != Parameter.POSITIONAL_ONLY and name in keywords:
+            bound[name] = [keywords.pop(name)]
+        elif parameter.default_node is None:
+            return None
+    if position != len(positional):
+        return None
+    if keywords or unknown_keywords:
+        if keyword_parameter is None:
+            return None
+        bound[keyword_parameter.string_name] = list(keywords.values()) + unknown_keywords
+    return bound
+
+
+def _matches_values(values, annotations, class_object=False, depth=0, constraints=None):
+    return bool(values) and all(
+        any(_matches_annotation(value, annotation, class_object, depth, constraints)
+            for annotation in annotations)
+        for value in values
+    )
+
+
+def _matches_annotation(value, annotation, class_object=False, depth=0, constraints=None):
+    if depth > 20:
+        return False
+    if isinstance(annotation, AnyClass):
+        return True
+    if isinstance(value, TypeVar):
+        lazy_values = value._constraints_lazy_values
+        if value._bound_lazy_value is not None:
+            lazy_values = [value._bound_lazy_value]
+        classes = _resolve_type_var(value, lazy_values).execute_annotation(None).py__class__()
+        if not classes:
+            classes = ValueSet([builtin_from_name(value.inference_state, 'object')])
+        return _matches_values(
+            classes, ValueSet([annotation]), class_object, depth + 1, constraints
+        )
+    if isinstance(annotation, ProxyTypingValue):
+        name = annotation.py__name__()
+        if name == 'Type':
+            return value.is_class()
+        if name == 'Tuple':
+            return _is_subclass(
+                _value_class(value), builtin_from_name(value.inference_state, 'tuple')
+            )
+        if name == 'Callable':
+            return bool(value.py__getattribute__('__call__'))
+    if isinstance(annotation, TypeVar):
+        lazy_values = annotation._constraints_lazy_values
+        if annotation._bound_lazy_value is not None:
+            lazy_values = [annotation._bound_lazy_value]
+        classes = (constraints or {}).get(annotation)
+        if classes is None:
+            classes = _resolve_type_var(annotation, lazy_values)
+        return not classes or _matches_values(
+            ValueSet([value]), classes, class_object, depth + 1, constraints
+        )
+    if isinstance(annotation, ProxyWithGenerics):
+        name = annotation.py__name__()
+        generics = annotation.get_generics()
+        if name in ('Union', 'Optional'):
+            if name == 'Optional' and _matches_none(value, class_object):
+                return True
+            return _matches_values(
+                ValueSet([value]), ValueSet.from_sets(generics), class_object,
+                depth + 1, constraints
+            )
+        if name in ('Annotated', 'ClassVar', 'Final') and generics:
+            return _matches_values(
+                ValueSet([value]), generics[0], class_object, depth + 1, constraints
+            )
+        if name == 'Type' and generics:
+            return value.is_class() and _matches_values(
+                ValueSet([value]), generics[0], True, depth + 1, constraints
+            )
+        if name == 'Tuple':
+            return not class_object and _matches_tuple(value, generics, depth + 1, constraints)
+        if name == 'Callable':
+            return bool(value.py__getattribute__('__call__')) and (
+                len(generics) != 2 or _matches_values(
+                    value.execute_annotation(None), generics[1], depth=depth + 1,
+                    constraints=constraints
+                )
+            )
+
+    if annotation.get_safe_value(default=_UNKNOWN_KEY) is None:
+        return _matches_none(value, class_object)
+
+    if class_object:
+        return value.is_class() and any(
+            _is_subclass(value, expected)
+            for expected in annotation.gather_annotation_classes()
+        )
+
+    if isinstance(annotation, GenericClass):
+        name = annotation.py__name__()
+        generics = annotation.get_generics()
+        module = annotation.get_root_context().py__name__()
+        is_typing = module in ('typing', '_collections_abc', 'collections.abc')
+        if is_typing and name in ('Mapping', 'MutableMapping') and len(generics) == 2:
+            return _matches_mapping(value, generics, depth + 1, constraints)
+        if is_typing and name in ('Iterable', 'Iterator', 'Sequence', 'MutableSequence',
+                                  'Collection', 'Container') \
+                and len(generics) == 1:
+            if not hasattr(value, 'inference_state'):
+                return False
+            if not value.py__getattribute__('__iter__'):
+                return False
+            if name in ('Sequence', 'MutableSequence') \
+                    and not value.py__getattribute__('__getitem__'):
+                return False
+            if name == 'Iterator' and not value.py__getattribute__('__next__'):
+                return False
+            return _matches_sequence(value, generics[0], depth + 1, constraints)
+        if not _is_subclass(_value_class(value), annotation._class_value):
+            return False
+        if not generics:
+            return True
+        if module == 'builtins' and name == 'dict' and len(generics) == 2:
+            return _matches_mapping(value, generics, depth + 1, constraints)
+        if module == 'builtins' and name in ('list', 'set', 'frozenset') and len(generics) == 1:
+            return _matches_sequence(value, generics[0], depth + 1, constraints)
+        if name == 'tuple':
+            return _matches_tuple(value, generics, depth + 1, constraints)
+        actual = value.get_annotated_class_object()
+        if not isinstance(actual, GenericClass):
+            return False
+        actual_generics = actual.get_generics()
+        return len(actual_generics) == len(generics) and all(
+            _matches_values(actual_set.execute_annotation(None), expected_set, depth=depth + 1,
+                            constraints=constraints)
+            for actual_set, expected_set in zip(actual_generics, generics)
+        )
+
+    return any(_is_subclass(_value_class(value), expected)
+               for expected in annotation.gather_annotation_classes())
+
+
+def _value_class(value):
+    if isinstance(value, Tuple):
+        return builtin_from_name(value.inference_state, 'tuple')
+    return value.py__class__()
+
+
+def _matches_mapping(value, generics, depth, constraints):
+    variants = mapping_variants(value)
+    return variants is not None and all(
+        _matches_values(ValueSet([key]), generics[0], depth=depth, constraints=constraints)
+        and _matches_values(infer_argument(lazy_value), generics[1], depth=depth,
+                            constraints=constraints)
+        for entries in variants for key, lazy_value in entries
+    )
+
+
+def _matches_sequence(value, annotations, depth, constraints):
+    variants = sequence_variants(value)
+    return variants is not None and all(
+        _matches_values(infer_argument(lazy_value), annotations, depth=depth,
+                        constraints=constraints)
+        for entries in variants for lazy_value in entries
+    )
+
+
+def _matches_none(value, class_object):
+    if class_object:
+        none = builtin_from_name(value.inference_state, 'None')
+        return value.is_class() and _is_subclass(value, none.py__class__())
+    return value.get_safe_value(default=_UNKNOWN_KEY) is None
+
+
+def _is_subclass(actual, expected):
+    from jedi.inference.gradual.conversion import to_stub
+
+    while isinstance(actual, ValueWrapper):
+        actual = actual._wrapped_value
+    while isinstance(expected, ValueWrapper):
+        expected = expected._wrapped_value
+    if expected.is_same_class(builtin_from_name(actual.inference_state, 'object')):
+        return True
+    if actual.is_sub_class_of(expected):
+        return True
+    if actual.is_compiled() and not expected.is_compiled():
+        if any(_is_subclass(stub, expected) for stub in to_stub(actual) if stub != actual):
+            return True
+    for name, accepted in (('float', ('int',)), ('complex', ('int', 'float'))):
+        if expected.is_same_class(builtin_from_name(actual.inference_state, name)):
+            return any(actual.is_sub_class_of(builtin_from_name(actual.inference_state, base))
+                       for base in accepted)
+    return False
+
+
+def _matches_tuple(value, generics, depth, constraints=None):
+    if not isinstance(value, Tuple) and not _is_subclass(
+        value.py__class__(), builtin_from_name(value.inference_state, 'tuple')
+    ):
+        return False
+    homogeneous = len(generics) == 2 and any(
+        annotation.get_safe_value(default=_UNKNOWN_KEY) is Ellipsis
+        or annotation.py__name__() in ('EllipsisType', 'ellipsis')
+        for annotation in generics[1]
+    )
+    if isinstance(value, Tuple) and value._is_homogenous() and not homogeneous:
+        return False
+    variants = sequence_variants(value)
+    if variants is None:
+        return False
+    if homogeneous:
+        return all(_matches_values(infer_argument(lazy_value), generics[0], depth=depth,
+                                   constraints=constraints)
+                   for entries in variants for lazy_value in entries)
+    return all(
+        len(entries) == len(generics)
+        and all(_matches_values(infer_argument(lazy_value), expected, depth=depth,
+                                constraints=constraints)
+                for lazy_value, expected in zip(entries, generics))
+        for entries in variants
+    )
+
+
+@inference_state_method_cache(default=None)
+def sequence_variants(value):
+    """Keep alternative lengths separate until a complete call has been bound."""
+    if isinstance(value, (iterable.DictLiteralValue, iterable.DictComprehension)):
+        variants = mapping_variants(value)
+        if variants is None:
+            return None
+        return tuple(tuple(LazyKnownValue(key) for key, lazy_value in entries)
+                     for entries in variants)
+    if isinstance(value, iterable.SequenceLiteralValue):
+        context = value._defining_context
+        children = value.atom.children
+        if value.atom.type in value._TUPLE_LIKE:
+            entries = children[::2]
+        elif children[1] in (']', ')', '}'):
+            entries = []
+        elif children[1].type in ('testlist_comp', 'dictorsetmaker'):
+            entries = children[1].children[::2]
+        else:
+            entries = children[1:2]
+        variants = ((),)
+        for entry in entries:
+            if entry.type == 'star_expr':
+                additions = []
+                for unpacked in infer_argument(LazyTreeValue(context, entry.children[1])):
+                    unpacked_variants = sequence_variants(unpacked)
+                    if unpacked_variants is None:
+                        return None
+                    additions.extend(unpacked_variants)
+                if not additions:
+                    return None
+            else:
+                additions = ((LazyTreeValue(context, entry),),)
+            variants = tuple(left + right for left, right in product(variants, additions))
+        return variants
+    if isinstance(value, iterable.MergedArray):
+        variants = ((),)
+        for array in value._arrays:
+            additions = sequence_variants(array)
+            if additions is None:
+                return None
+            variants = tuple(left + right for left, right in product(variants, additions))
+        return variants
+    if isinstance(value, iterable.ComprehensionMixin):
+        return _comprehension_variants(value, value._sync_comp_for_node, value._defining_context)
+    if isinstance(value, iterable._FakeSequence):
+        return (tuple(value.py__iter__()),)
+    try:
+        annotated_class = value.get_annotated_class_object()
+    except AttributeError:
+        pass
+    else:
+        if isinstance(annotated_class, GenericClass):
+            generics = annotated_class.get_generics()
+            if annotated_class.py__name__() in ('list', 'set', 'frozenset', 'dict', 'Iterable',
+                                              'Iterator', 'Sequence') and generics:
+                return ((LazyKnownValues(generics[0].execute_annotation(None)),),)
+    try:
+        entries = tuple(value.py__iter__())
+    except AttributeError:
+        return None
+    if entries or isinstance(value, (iterable._FakeSequence, Tuple)):
+        return (entries,)
+    return None
+
+
+@inference_state_method_cache(default=None)
+def mapping_variants(value):
+    """Resolve literal updates in order, including Python's equality of keys."""
+    if isinstance(value, iterable.DictLiteralValue):
+        context = value._defining_context
+        if value.atom.children[1] == '}':
+            return ((),)
+        children = iter(value.atom.children[1].children)
+        variants = ((),)
+        for key_node in children:
+            if key_node == ',':
+                continue
+            if key_node == '**':
+                additions = []
+                for unpacked in infer_argument(LazyTreeValue(context, next(children))):
+                    unpacked_variants = mapping_variants(unpacked)
+                    if unpacked_variants is None:
+                        return None
+                    additions.extend(unpacked_variants)
+                if not additions:
+                    return None
+            else:
+                next(children)
+                lazy_value = LazyTreeValue(context, next(children))
+                additions = (((key, lazy_value),)
+                             for inferred in infer_argument(LazyTreeValue(context, key_node))
+                             for key in _key_variants(inferred))
+            variants = tuple(_update_mapping(left, right)
+                             for left, right in product(variants, additions))
+        return variants
+    if isinstance(value, iterable.DictComprehension):
+        variants = _comprehension_variants(
+            value, value._sync_comp_for_node, value._defining_context
+        )
+        if variants is not None:
+            return tuple(_update_mapping((), entries) for entries in variants)
+        return None
+    if isinstance(value, iterable.FakeDict):
+        from jedi.inference.compiled import create_simple_object
+        return (tuple((create_simple_object(value.inference_state, key), lazy_value)
+                      for key, lazy_value in value.exact_key_items()),)
+    try:
+        annotated_class = value.get_annotated_class_object()
+    except AttributeError:
+        return None
+    if isinstance(annotated_class, GenericClass) \
+            and annotated_class.py__name__() in ('dict', 'Mapping', 'MutableMapping'):
+        generics = annotated_class.get_generics()
+        if len(generics) == 2:
+            values = LazyKnownValues(generics[1].execute_annotation(None))
+            return (tuple((key, values) for key in generics[0].execute_annotation(None)),)
+    return None
+
+
+def _update_mapping(entries, additions):
+    result = list(entries)
+    known_keys = {}
+    for index, (key, lazy_value) in enumerate(result):
+        safe_key = _safe_key(key)
+        if safe_key is not _UNKNOWN_KEY:
+            known_keys[safe_key] = index
+    for key, lazy_value in additions:
+        safe_key = _safe_key(key)
+        if safe_key is not _UNKNOWN_KEY and safe_key in known_keys:
+            index = known_keys[safe_key]
+            result[index] = result[index][0], lazy_value
+        else:
+            index = len(result)
+            result.append((key, lazy_value))
+            if safe_key is not _UNKNOWN_KEY:
+                known_keys[safe_key] = index
+    return tuple(result)
+
+
+def _key_variants(value):
+    if isinstance(value, (iterable.SequenceLiteralValue, iterable.FakeTuple)) \
+            and value.array_type == 'tuple':
+        variants = sequence_variants(value)
+        if variants is not None:
+            for entries in variants:
+                choices = [tuple(key for inferred in infer_argument(entry)
+                                 for key in _key_variants(inferred)) for entry in entries]
+                for keys in product(*choices):
+                    yield iterable.FakeTuple(
+                        value.inference_state, [LazyKnownValue(key) for key in keys]
+                    )
+            return
+    yield value
+
+
+def _safe_key(value):
+    safe_value = value.get_safe_value(default=_UNKNOWN_KEY)
+    if safe_value is not _UNKNOWN_KEY:
+        try:
+            hash(safe_value)
+        except TypeError:
+            return _UNKNOWN_KEY
+        return safe_value
+    if value.is_class() or value.is_function():
+        return value
+    if isinstance(value, iterable.FakeTuple):
+        keys = []
+        for entry in value.py__iter__():
+            inferred = entry.infer()
+            if len(inferred) != 1:
+                return _UNKNOWN_KEY
+            key = _safe_key(next(iter(inferred)))
+            if key is _UNKNOWN_KEY:
+                return _UNKNOWN_KEY
+            keys.append(key)
+        return tuple(keys)
+    return _UNKNOWN_KEY
+
+
+def _comprehension_variants(value, node, context):
+    if node is None:
+        if value.array_type == 'dict':
+            lazy_value = LazyTreeValue(context, value._value_node)
+            return tuple(((key, lazy_value),)
+                         for inferred in infer_argument(LazyTreeValue(context, value._entry_node))
+                         for key in _key_variants(inferred))
+        return ((LazyTreeValue(context, value._entry_node),),)
+    if node.type == 'comp_for':
+        node = node.children[-1]
+    if node.type == 'comp_if':
+        conditions = {condition.py__bool__() for condition in context.infer_node(node.children[1])}
+        variants = []
+        if not conditions or conditions - {True}:
+            variants.append(())
+        if not conditions or conditions - {False}:
+            additions = _comprehension_variants(
+                value, node.children[2] if len(node.children) > 2 else None, context
+            )
+            if additions is None:
+                return None
+            variants.extend(additions)
+        return tuple(variants)
+
+    variants = []
+    for source in infer_argument(LazyTreeValue(context, node.children[3])):
+        sequences = sequence_variants(source)
+        if sequences is None:
+            return None
+        for entries in sequences:
+            outputs = ((),)
+            for entry in entries:
+                names = iterable.unpack_tuple_to_dict(context, entry.infer(), node.children[1])
+                comp_context = value._get_comp_for_context(context, node)
+                with comp_context.predefine_names(node, names):
+                    additions = _comprehension_variants(
+                        value, node.children[4] if len(node.children) > 4 else None, comp_context
+                    )
+                if additions is None:
+                    return None
+                outputs = tuple(left + right for left, right in product(outputs, additions))
+            variants.extend(outputs)
+    return tuple(variants) if variants else None
