+        Owner().method({argument})
+    ''')
+    assert [result.name for result in Script(source.rstrip()).infer()] == ['First']
+
+
+@pytest.mark.parametrize('annotation, declaration', [
+    ('list[type[A]]', 'value: list[type[Child]]'),
+    ('tuple[type[A], ...]', 'value: tuple[type[Child], ...]'),
+    ('tuple[type[A], type[B]]', 'value: tuple[type[Child], type[B]]'),
+    ('dict[str, type[A]]', 'value: dict[str, type[Child]]'),
+    ('list[type[A]]', 'value: list[object] = [A]'),
+    ('tuple[type[A], type[B]]', 'value: tuple[object, ...] = (A, B)'),
+    ('list[type[A]]', 'original: list[object] = [A]\nvalue = original'),
+    ('list[type[A]]', 'original: list[object] = [A]\nvalue = [*original]'),
+    ('dict[str, type[A]]', 'original: dict[str, object] = {"x": A}\nvalue = {**original}'),
+    ('dict[tuple[int], type[A]]',
+     'key: tuple[object, ...] = (1,)\nvalue = {key: B, (True,): A}'),
+])
+def test_overload_annotated_containers(Script, annotation, declaration):
+    source = _PRELUDE + declaration + '\n' + dedent(f'''\
+        @overload
+        def f(value: {annotation}) -> First: ...
+        @overload
+        def f(value: object) -> Second: ...
+        f(value)
+    ''')
+    assert [result.name for result in Script(source.rstrip()).infer()] == ['First']
+
+
+@pytest.mark.parametrize('parameters, argument', [
+    ('*args: type[{}]', 'A, B'),
+    ('**kwargs: type[{}]', 'a=A, b=B'),
+])
+def test_overload_variadic_fallback(Script, parameters, argument):
+    source = _PRELUDE + dedent(f'''\
+        @overload
+        def f({parameters.format('A')}) -> First: ...
+        @overload
+        def f({parameters.format('B')}) -> Second: ...
+        f({argument})
+    ''')
+    assert sorted(result.name for result in Script(source.rstrip()).infer()) == ['First', 'Second']
+
+
+def test_overload_first_match(Script):
+    source = _PRELUDE + dedent('''\
+        @overload
+        def f(value: type[object]) -> First: ...
+        @overload
+        def f(value: type[A]) -> Second: ...
+        f(A)
+    ''')
+    assert [result.name for result in Script(source.rstrip()).infer()] == ['First']
