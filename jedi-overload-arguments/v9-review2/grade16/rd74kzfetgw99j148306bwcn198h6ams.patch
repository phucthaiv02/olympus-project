+def test_overload_resolution_completions(Script):
+    code = dedent('''\
+        from typing import overload, Union, Tuple
+
+        class Foo: pass
+        class Bar: pass
+        class FooBuilder:
+            def build_foo(self) -> Foo: ...
+        class BarBuilder:
+            def build_bar(self) -> Bar: ...
+
+        @overload
+        def get_obj(input: type[Foo]) -> FooBuilder: ...
+        @overload
+        def get_obj(input: type[Bar]) -> BarBuilder: ...
+        def get_obj(input): ...
+
+        get_obj(Foo).''')
+    names = {c.name for c in Script(code).complete() if not c.name.startswith('_')}
+    assert names == {'build_foo'}
+
