+def test_overload_edge_cases(Script):
+    code = dedent('''\
+        from typing import overload, Union, Tuple
+
+        class A: pass
+        class B(A): pass
+        class C: pass
+
+        class R1: pass
+        class R2: pass
+        class R3: pass
+
+        # 1. Conditional expression: f(A if c else C)
+        @overload
+        def f1(x: type[A]) -> R1: ...
+        @overload
+        def f1(x: type[C]) -> R2: ...
+        def f1(x): ...
+
+        @overload
+        def f1_union(x: type[A]) -> R1: ...
+        @overload
+        def f1_union(x: Union[type[A], type[C]]) -> R2: ...
+        def f1_union(x): ...
+
+        c = True
+        r_f1 = f1(A if c else C)
+        r_f1_union = f1_union(A if c else C)
+
+        # 2. Unpacking variable-length list: xs: list[type[C]], f(*xs)
+        @overload
+        def f2(x: type[C]) -> R1: ...
+        @overload
+        def f2(*args: type[C]) -> R2: ...
+        def f2(*args): ...
+
+        xs_list: list[type[C]] = []
+        r_f2 = f2(*xs_list)
+
+        # 3. Equal dict keys: {1: A, True: C} only has value C
+        @overload
+        def f3(d: dict[int, type[A]]) -> R1: ...
+        @overload
+        def f3(d: dict[int, type[C]]) -> R2: ...
+        def f3(d): ...
+
+        d_eq = {1: A, True: C}
+        r_f3_direct = f3({1: A, True: C})
+        r_f3_var = f3(d_eq)
+
+        # 4. Dict unpacking with conditional dict: {"k": C, **d}
+        @overload
+        def f4(d: dict[str, type[C]]) -> R1: ...
+        @overload
+        def f4(d: dict[str, type[A]]) -> R2: ...
+        @overload
+        def f4(d: dict[str, Union[type[A], type[C]]]) -> R3: ...
+        def f4(d): ...
+
+        @overload
+        def f4_kw(*, k: type[C]) -> R1: ...
+        @overload
+        def f4_kw(*, k: type[A]) -> R2: ...
+        @overload
+        def f4_kw(*, k: Union[type[A], type[C]]) -> R3: ...
+        def f4_kw(**kwargs): ...
+
+        d_cond = {"k": A} if c else {}
+        r_f4_direct = f4({"k": C, **d_cond})
+        r_f4_kw = f4_kw(**{"k": C, **d_cond})
+
+        d_only_a = {"k": A}
+        r_f4_overwrite = f4({"k": C, **d_only_a})
+        r_f4_kw_overwrite = f4_kw(**{"k": C, **d_only_a})
+
+        # 5. Empty comprehension: [C for _ in []] has no elements
+        @overload
+        def f5(x: type[C]) -> R1: ...
+        @overload
+        def f5() -> R2: ...
+        def f5(*args): ...
+
+        @overload
+        def f5_list(x: list[type[A]]) -> R1: ...
+        @overload
+        def f5_list(x: list[type[C]]) -> R2: ...
+        def f5_list(x): ...
+
+        empty_comp = [C for _ in []]
+        r_f5_unpack = f5(*[C for _ in []])
+        r_f5_unpack_var = f5(*empty_comp)
+        r_f5_list = f5_list([C for _ in []])
+
+        # 6. Conditional length unpacking: xs = [A] if c else [], f(*xs, C)
+        @overload
+        def f6(x: type[C]) -> R1: ...
+        @overload
+        def f6(x: type[A], y: type[C]) -> R2: ...
+        @overload
+        def f6(x: Union[type[A], type[C]], y: type[C] = C) -> R3: ...
+        def f6(*args): ...
+
+        xs_cond = [A] if c else []
+        r_f6 = f6(*xs_cond, C)
+
+        # 7. Nested unpacking: f(*[A, *b])
+        @overload
+        def f7(x: type[A], y: type[A]) -> R1: ...
+        @overload
+        def f7(x: type[A], y: type[C]) -> R2: ...
+        def f7(*args): ...
+
+        b_lit = [C]
+        r_f7 = f7(*[A, *b_lit])
+
+        # 8. Positional-only (/ and __x), keyword-only (*), and defaults
+        @overload
+        def f8(x: type[A], /) -> R1: ...
+        @overload
+        def f8(*, x: type[A]) -> R2: ...
+        def f8(*args, **kwargs): ...
+
+        r_f8_pos = f8(A)
+        r_f8_kw = f8(x=A)
+
+        @overload
+        def f8_dunder(__x: type[A]) -> R1: ...
+        @overload
+        def f8_dunder(__x: type[C] = C, **kwargs: type[A]) -> R2: ...
+        def f8_dunder(*args, **kwargs): ...
+
+        r_f8_dunder_pos = f8_dunder(A)
+        r_f8_dunder_kw = f8_dunder(__x=A)
+
+        # 9. Tuple literals and unpacking inside tuple literals
+        @overload
+        def f9(t: Tuple[type[A], type[A]]) -> R1: ...
+        @overload
+        def f9(t: Tuple[type[A], type[C]]) -> R2: ...
+        def f9(t): ...
+
+        t_lit = (A, *b_lit)
+        r_f9_direct = f9((A, *b_lit))
+        r_f9_var = f9(t_lit)
+    ''')
+    script = Script(code)
+
+    def infer_var(name):
+        lines = code.splitlines()
+        for idx, line in enumerate(lines, 1):
+            if line.startswith(name + ' ='):
+                return {d.name for d in script.infer(line=idx, column=len(name))}
+        raise ValueError(name)
+
+    assert infer_var('r_f1') == {'R1', 'R2'}
+    assert infer_var('r_f1_union') == {'R2'}
+    assert infer_var('r_f2') == {'R2'}
+    assert infer_var('r_f3_direct') == {'R2'}
+    assert infer_var('r_f3_var') == {'R2'}
+    assert infer_var('r_f4_direct') == {'R3'}
+    assert infer_var('r_f4_kw') == {'R3'}
+    assert infer_var('r_f4_overwrite') == {'R2'}
+    assert infer_var('r_f4_kw_overwrite') == {'R2'}
+    assert infer_var('r_f5_unpack') == {'R2'}
+    assert infer_var('r_f5_unpack_var') == {'R2'}
+    assert infer_var('r_f5_list') == {'R1'}
+    assert infer_var('r_f6') == {'R3'}
+    assert infer_var('r_f7') == {'R2'}
+    assert infer_var('r_f8_pos') == {'R1'}
+    assert infer_var('r_f8_kw') == {'R2'}
+    assert infer_var('r_f8_dunder_pos') == {'R1'}
+    assert infer_var('r_f8_dunder_kw') == {'R2'}
+    assert infer_var('r_f9_direct') == {'R2'}
+    assert infer_var('r_f9_var') == {'R2'}
