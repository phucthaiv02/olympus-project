+                        if is_star:
+                            if comp.array_type == 'dict':
+                                sub_branches = [
+                                    [('star', k_v, v_v) for _, k_v, v_v in sb]
+                                    for sb in sub_branches
+                                ]
+                            else:
+                                sub_branches = [
+                                    [StarItem(it.values) for it in sb]
+                                    for sb in sub_branches
+                                ]
+                    else:
+                        if comp.array_type == 'dict':
+                            k_vals = context.infer_node(comp._entry_node)
+                            v_vals = context.infer_node(comp._value_node)
+                            sub_branches = [[('star' if is_star else 'exact', k_vals, v_vals)]]
+                        else:
+                            e_vals = context.infer_node(comp._entry_node)
+                            sub_branches = [[StarItem(e_vals) if is_star else ExactItem(e_vals)]]
+
+                    if maybe_false and not is_star and [] not in sub_branches:
+                        sub_branches = sub_branches + [[]]
+
+                    cur_options = [b + tuple(sb) for b in cur_options for sb in sub_branches][:64]
+
+            for opt in cur_options:
+                if opt not in all_branches:
+                    all_branches.append(opt)
+    return all_branches or [()]
+
+
+def get_sequence_branches(value, seen=()):
+    if value in seen:
+        return [(StarItem(NO_VALUES),)]
+    seen = seen + (value,)
+
+    if isinstance(value, (DictLiteralValue, DictComprehension, FakeDict)):
+        d_branches = get_dict_branches(value, seen)
+        result = []
+        for db in d_branches:
+            items = tuple(ExactItem(ValueSet([k_val])) for k_val, _ in db.known_entries.values())
+            items += tuple(StarItem(uk_set) for uk_set, _ in db.unknown_entries)
+            if items not in result:
+                result.append(items)
+        return result or [()]
+
+    if isinstance(value, SequenceLiteralValue):
+        branches = [()]
+        for node in value._get_raw_tree_entries():
+            if node != ':' and node.type == 'star_expr':
+                sub_vals = value._defining_context.infer_node(node.children[1])
+                if not sub_vals:
+                    sub_branches = [(StarItem(NO_VALUES),)]
+                else:
+                    sub_branches = []
+                    for sv in sub_vals:
+                        for sb in get_sequence_branches(sv, seen):
+                            if sb not in sub_branches:
+                                sub_branches.append(sb)
+                branches = [b + sb for b in branches for sb in sub_branches][:64]
+            else:
+                if node == ':' or node.type == 'subscript':
+                    elem_vals = ValueSet([Slice(value._defining_context, None, None, None)])
+                else:
+                    elem_vals = value._defining_context.infer_node(node)
+                item = ExactItem(elem_vals)
+                branches = [b + (item,) for b in branches]
+        return branches
+
+    if isinstance(value, (ListComprehension, SetComprehension, GeneratorComprehension)):
+        comp_fors = tuple(get_sync_comp_fors(value._sync_comp_for_node))
+        return [tuple(b) for b in _nested_comp_branches(value, comp_fors, seen=seen)]
+
+    if isinstance(value, _FakeSequence):
+        return [tuple(ExactItem(lv.infer()) for lv in value._lazy_value_list)]
+
+    if isinstance(value, MergedArray):
+        branches = [()]
+        for arr in value._arrays:
+            sub_branches = get_sequence_branches(arr, seen)
+            branches = [b + sb for b in branches for sb in sub_branches][:64]
+        return branches or [()]
+
+    from jedi.inference.gradual.typing import Tuple
+    from jedi.inference.gradual.base import GenericClass
+    if isinstance(value, Tuple):
+        if value._is_homogenous():
+            return [(StarItem(value._generics_manager.get_index_and_execute(0)),)]
+        else:
+            tup = value._generics_manager.to_tuple()
+            return [tuple(ExactItem(v.execute_annotation(None)) for v in tup)]
+
+    if getattr(value, 'is_instance', lambda: False)() and not value.is_compiled() and hasattr(value, 'get_annotated_class_object'):
+        ann_cls = value.get_annotated_class_object()
+        if (
+            isinstance(ann_cls, GenericClass)
+            and ann_cls.py__name__() == 'tuple'
+            and ann_cls.get_root_context().is_builtins_module()
+            and len(ann_cls._generics_manager)
+        ):
+            if ann_cls._generics_manager.is_homogenous_tuple():
+                return [(StarItem(ann_cls._generics_manager.get_index_and_execute(0)),)]
+            else:
+                tup = ann_cls._generics_manager.to_tuple()
+                return [tuple(ExactItem(v.execute_annotation(None)) for v in tup)]
+
+    elem_vals = ValueSet([value]).merge_types_of_iterate()
+    return [(StarItem(elem_vals),)]
+
+
+def get_dict_branches(value, seen=()):
+    if value in seen:
+        return [DictBranch(unknown_entries=[(NO_VALUES, NO_VALUES)])]
+    seen = seen + (value,)
+
+    from jedi.inference.value.dynamic_arrays import DictModification
+    if isinstance(value, DictModification):
+        base_branches = get_dict_branches(value._wrapped_value, seen)
+        key_vals = value._contextualized_key.infer()
+        val_vals = value._assigned_values
+        new_branches = []
+        for b in base_branches:
+            if not key_vals:
+                nb = b.copy()
+                nb.add_unknown(NO_VALUES, val_vals)
+                new_branches.append(nb)
+            else:
+                for k_val in key_vals:
+                    nb = b.copy()
+                    sk = _get_safe_key(k_val, seen)
+                    if sk is not None:
+                        nb.add_known(sk, k_val, val_vals)
+                    else:
+                        nb.add_unknown(ValueSet([k_val]), val_vals)
+                    new_branches.append(nb)
+        return new_branches[:64]
+
+    if isinstance(value, DictLiteralValue):
+        branches = [DictBranch()]
+        for kind, data in value._get_raw_dict_entries():
+            if kind == '**':
+                unpack_node = data
+                d_vals = value._defining_context.infer_node(unpack_node)
+                if not d_vals:
+                    for b in branches:
+                        b.add_unknown(NO_VALUES, NO_VALUES)
+                else:
+                    new_branches = []
+                    for dv in d_vals:
+                        sub_branches = get_dict_branches(dv, seen)
+                        for b in branches:
+                            for sb in sub_branches:
+                                nb = b.copy()
+                                if sb.invalid:
+                                    nb.invalid = True
+                                for uk_set, uv_set in sb.unknown_entries:
+                                    nb.add_unknown(uk_set, uv_set)
+                                for sk, (k_val, v_set) in sb.known_entries.items():
+                                    nb.add_known(sk, k_val, v_set)
+                                new_branches.append(nb)
+                    branches = new_branches[:64]
+            else:
+                key_node, val_node = data
+                key_vals = value._defining_context.infer_node(key_node)
+                val_vals = value._defining_context.infer_node(val_node)
+                if not key_vals:
+                    for b in branches:
+                        b.add_unknown(NO_VALUES, val_vals)
+                else:
+                    new_branches = []
+                    for b in branches:
+                        for k_val in key_vals:
+                            nb = b.copy()
+                            sk = _get_safe_key(k_val, seen)
+                            if sk is not None:
+                                nb.add_known(sk, k_val, val_vals)
+                            else:
+                                nb.add_unknown(ValueSet([k_val]), val_vals)
+                            new_branches.append(nb)
+                    branches = new_branches[:64]
+        return branches
+
+    if isinstance(value, DictComprehension):
+        comp_fors = tuple(get_sync_comp_fors(value._sync_comp_for_node))
+        comp_branches = _nested_comp_branches(value, comp_fors, seen=seen)
+        result = []
+        for cb in comp_branches:
+            branches = [DictBranch()]
+            for item_kind, k_vals, v_vals in cb:
+                if item_kind == 'star' or not k_vals:
+                    for b in branches:
+                        b.add_unknown(k_vals, v_vals)
+                else:
+                    new_branches = []
+                    for b in branches:
+                        for k_val in k_vals:
+                            nb = b.copy()
+                            sk = _get_safe_key(k_val, seen)
+                            if sk is not None:
+                                nb.add_known(sk, k_val, v_vals)
+                            else:
+                                nb.add_unknown(ValueSet([k_val]), v_vals)
+                            new_branches.append(nb)
+                    branches = new_branches[:64]
+            result.extend(branches)
+        return result[:64] or [DictBranch()]
+
+    if isinstance(value, FakeDict):
+        db = DictBranch()
+        for k_str, lazy_v in value._dct.items():
+            k_obj = compiled.create_simple_object(value.inference_state, k_str)
+            db.add_known(_SafeKey(k_str), k_obj, lazy_v.infer())
+        return [db]
+
+    keys_attr = value.py__getattribute__('keys')
+    if not keys_attr:
+        return [DictBranch(invalid=True)]
+    k_set = keys_attr.execute_with_values().merge_types_of_iterate()
+    v_set = value.py__getattribute__('values').execute_with_values().merge_types_of_iterate()
+    return [DictBranch(unknown_entries=[(k_set, v_set)])]
+
