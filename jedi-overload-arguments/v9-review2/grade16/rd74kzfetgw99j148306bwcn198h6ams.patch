+def _bind_branch_to_params(function_value, pos_items, kw_branch, check_annotations=True,
+                           skip_self_annotation=False, depth=0):
+    if kw_branch.invalid:
+        return False, None, None
+
+    param_names = function_value.get_param_names()
+    pos_params = []
+    var_pos_idx = None
+    kw_map = {}
+    var_kw_idx = None
+
+    for idx, p_name in enumerate(param_names):
+        kind = p_name.get_kind()
+        if kind == Parameter.POSITIONAL_ONLY:
+            pos_params.append(idx)
+        elif kind == Parameter.POSITIONAL_OR_KEYWORD:
+            pos_params.append(idx)
+            kw_map[p_name.string_name] = idx
+        elif kind == Parameter.VAR_POSITIONAL:
+            var_pos_idx = idx
+        elif kind == Parameter.KEYWORD_ONLY:
+            kw_map[p_name.string_name] = idx
+        elif kind == Parameter.VAR_KEYWORD:
+            var_kw_idx = idx
+
+    bound_value_sets = defaultdict(list)
+    definitely_bound = [False] * len(param_names)
+    possibly_bound_pos = [False] * len(param_names)
+
+    first_star_idx = next(
+        (i for i, it in enumerate(pos_items) if isinstance(it, iterable.StarItem)),
+        None
+    )
+
+    if first_star_idx is None:
+        if len(pos_items) > len(pos_params) and var_pos_idx is None:
+            return False, None, None
+        for i, item in enumerate(pos_items):
+            if i < len(pos_params):
+                p_idx = pos_params[i]
+                bound_value_sets[p_idx].append(item.values)
+                definitely_bound[p_idx] = True
+                possibly_bound_pos[p_idx] = True
+            else:
+                bound_value_sets[var_pos_idx].append(item.values)
+                definitely_bound[var_pos_idx] = True
+    else:
+        if var_pos_idx is None:
+            return False, None, None
+        min_pos_args = sum(1 for it in pos_items if isinstance(it, iterable.ExactItem))
+        for j in range(min(min_pos_args, len(pos_params))):
+            definitely_bound[pos_params[j]] = True
+        for j in range(len(pos_params)):
+            possibly_bound_pos[pos_params[j]] = True
+
+        for k, item in enumerate(pos_items):
+            if k < first_star_idx:
+                if k < len(pos_params):
+                    bound_value_sets[pos_params[k]].append(item.values)
+                else:
+                    bound_value_sets[var_pos_idx].append(item.values)
+            else:
+                min_j = sum(1 for prev in pos_items[:k] if isinstance(prev, iterable.ExactItem))
+                for j in range(min_j, len(pos_params)):
+                    bound_value_sets[pos_params[j]].append(item.values)
+                bound_value_sets[var_pos_idx].append(item.values)
+
+    for sk, (k_val, v_set) in kw_branch.known_entries.items():
+        if not is_string(k_val):
+            return False, None, None
+        k_str = k_val.get_safe_value()
+        if k_str in kw_map:
+            p_idx = kw_map[k_str]
+            if possibly_bound_pos[p_idx]:
+                return False, None, None
+            bound_value_sets[p_idx].append(v_set)
+            definitely_bound[p_idx] = True
+        else:
+            if var_kw_idx is None:
+                return False, None, None
+            bound_value_sets[var_kw_idx].append(v_set)
+
+    if kw_branch.unknown_entries:
+        if var_kw_idx is None:
+            return False, None, None
+        for uk_set, uv_set in kw_branch.unknown_entries:
+            if not uk_set:
+                return False, None, None
+            for uk in uk_set:
+                uk_classes = ValueSet([uk]).py__class__() if uk.is_instance() else ValueSet([uk])
+                if not uk_classes or not all(
+                    hasattr(cls, 'py__mro__') and any(
+                        c.py__name__() == 'str' and c.get_root_context().is_builtins_module()
+                        for c in cls.py__mro__()
+                    )
+                    for cls in uk_classes
+                ):
+                    return False, None, None
+            bound_value_sets[var_kw_idx].append(uv_set)
+            for p_idx in kw_map.values():
+                if not definitely_bound[p_idx] and not possibly_bound_pos[p_idx]:
+                    bound_value_sets[p_idx].append(uv_set)
+
+    for idx, p_name in enumerate(param_names):
+        if p_name.get_kind() in (Parameter.VAR_POSITIONAL, Parameter.VAR_KEYWORD):
+            continue
+        param_node = p_name._get_param_node()
+        if param_node.default is None and not definitely_bound[idx]:
+            return False, None, None
+
+    if not check_annotations:
+        return True, bound_value_sets, param_names
+
+    type_var_dict = {}
+    for idx, p_name in enumerate(param_names):
+        if idx == 0 and skip_self_annotation:
+            continue
+        if not bound_value_sets[idx]:
+            continue
+        annotations = p_name.infer_annotation(execute_annotation=False, ignore_stars=True)
+        if not annotations:
+            continue
+        for v_set in bound_value_sets[idx]:
+            if not _value_set_matches_annotation_set(
+                v_set, annotations, type_var_dict, 'covariant', depth
+            ):
+                return False, None, None
+
+    return True, bound_value_sets, param_names
+
+
+def matches_call_signature(function_value, arguments, depth=0):
+    from jedi.inference.value.instance import InstanceArguments
+    funcdef = function_value.tree_node
+    if funcdef.type == 'lambdef':
+        return True
+
+    skip_self_annotation = (
+        isinstance(arguments, InstanceArguments)
+        and function_value.py__name__() in ('__init__', '__new__')
+    )
+    branches = unpack_call_branches(arguments)
+    if not branches:
+        return False
+
+    for pos_items, kw_branch in branches:
+        ok, _, _ = _bind_branch_to_params(
+            function_value,
+            pos_items,
+            kw_branch,
+            check_annotations=True,
+            skip_self_annotation=skip_self_annotation,
+            depth=depth,
+        )
+        if not ok:
+            return False
+    return True
+
+
+def _flatten_annotation_set(annotation_set, depth=0):
+    if depth > 12:
+        return
+    from jedi.inference.gradual.typing import ProxyWithGenerics, TypeAlias, IGNORE_ANNOTATION_PARTS
+    for ann in annotation_set:
+        if isinstance(ann, ProxyWithGenerics):
+            name = ann._tree_name.value
+            if name == 'Union':
+                yield from _flatten_annotation_set(ann.gather_annotation_classes(), depth + 1)
+                continue
+            elif name == 'Optional':
+                yield from _flatten_annotation_set(ann.gather_annotation_classes(), depth + 1)
+                yield builtin_from_name(ann.inference_state, 'None')
+                continue
+            elif name in IGNORE_ANNOTATION_PARTS:
+                if len(ann._generics_manager):
+                    yield from _flatten_annotation_set(ann._generics_manager[0], depth + 1)
+                continue
+        if isinstance(ann, TypeAlias):
+            yield ann._get_wrapped_value()
+        else:
+            yield ann
+
+
+def _is_top_or_unconstrained_annotation(annotation_set):
+    from jedi.inference.gradual.typing import AnyClass
+    from jedi.inference.gradual.type_var import TypeVar
+    from jedi.inference.gradual.base import DefineGenericBaseClass
+    flat = list(_flatten_annotation_set(annotation_set))
+    if not flat:
+        return True
+    for ann in flat:
+        if isinstance(ann, AnyClass):
+            return True
+        if isinstance(ann, TypeVar) and not ann.constraints and not ann.bound:
+            return True
+        if (
+            ann.is_class()
+            and not isinstance(ann, DefineGenericBaseClass)
+            and ann.py__name__() == 'object'
+            and ann.get_root_context().is_builtins_module()
+        ):
+            return True
+    return False
+
+
+def _value_set_matches_annotation_set(value_set, annotation_set, type_var_dict,
+                                      variance='covariant', depth=0):
+    if depth > 12:
+        return True
+    if not annotation_set:
+        return True
+    if not value_set:
+        return _is_top_or_unconstrained_annotation(annotation_set)
+
+    flat_annotations = list(_flatten_annotation_set(annotation_set))
+    if not flat_annotations:
+        return True
+
+    from jedi.inference.value.dynamic_arrays import DictModification
+    literal_types = (
+        iterable.SequenceLiteralValue,
+        iterable.ListComprehension,
+        iterable.SetComprehension,
+        iterable.GeneratorComprehension,
+        iterable.DictComprehension,
+        iterable._FakeSequence,
+        iterable.FakeDict,
+        iterable.MergedArray,
+        DictModification,
+    )
+
+    for val in value_set:
+        if len(flat_annotations) > 1 and isinstance(val, literal_types):
+            is_dict_lit = (
+                isinstance(val, (iterable.DictLiteralValue, iterable.DictComprehension, iterable.FakeDict, DictModification))
+                or getattr(val, 'array_type', None) == 'dict'
+            )
+            branches = iterable.get_dict_branches(val) if is_dict_lit else iterable.get_sequence_branches(val)
+            for branch in branches:
+                if not any(
+                    _single_value_matches_single_annotation(
+                        val, ann, type_var_dict, variance, depth, precomputed_branches=[branch]
+                    )
+                    for ann in flat_annotations
+                ):
+                    return False
+        else:
+            if not any(
+                _single_value_matches_single_annotation(val, ann, type_var_dict, variance, depth)
+                for ann in flat_annotations
+            ):
+                return False
+    return True
+
+
+def _unwrap_class_value(cls):
+    from jedi.inference.gradual.typing import TypeAlias
+    from jedi.inference.gradual.base import GenericClass
+    if isinstance(cls, GenericClass):
+        cls = cls._class_value
+    if isinstance(cls, TypeAlias):
+        cls = cls._get_wrapped_value()
+    return cls
+
+
+def _same_base_class(cls1, cls2):
+    b1 = _unwrap_class_value(cls1)
+    b2 = _unwrap_class_value(cls2)
+    if b1 == b2:
+        return True
+    if getattr(b1, 'tree_node', None) is not None and b1.tree_node == getattr(b2, 'tree_node', None):
+        return True
+    if (
+        b1.py__name__() == b2.py__name__()
+        and b1.get_root_context().is_builtins_module()
+        and b2.get_root_context().is_builtins_module()
+    ):
+        return True
+    return False
+
+
+def _class_matches(arg_cls, target_cls, variance='covariant'):
+    b_arg = _unwrap_class_value(arg_cls)
+    b_target = _unwrap_class_value(target_cls)
+    if not b_arg.is_class() or not b_target.is_class():
+        return False
+
+    # Note: in Python typing, bool is a subtype of int, int is a subtype of float,
+    # float is a subtype of complex (PEP 484 numeric tower).
+    if variance == 'covariant':
+        return _is_subclass_with_protocols(b_arg, b_target)
+    elif variance == 'contravariant':
+        return _is_subclass_with_protocols(b_target, b_arg)
+    else:  # invariant
+        return _same_base_class(b_arg, b_target) or (
+            b_arg.is_sub_class_of(b_target) and b_target.is_sub_class_of(b_arg)
+        )
+
+
+def _is_subclass_with_protocols(sub_cls, super_cls):
+    if _same_base_class(sub_cls, super_cls):
+        return True
+    if sub_cls.is_sub_class_of(super_cls):
+        return True
+    if hasattr(sub_cls, 'py__mro__') and any(
+        _same_base_class(mro_cls, super_cls) for mro_cls in sub_cls.py__mro__()
+    ):
+        return True
+    # PEP 484 numeric tower: int -> float -> complex
+    if sub_cls.get_root_context().is_builtins_module() and super_cls.get_root_context().is_builtins_module():
+        sub_name = sub_cls.py__name__()
+        sup_name = super_cls.py__name__()
+        if sub_name in ('bool', 'int') and sup_name in ('float', 'complex'):
+            return True
+        if sub_name == 'float' and sup_name == 'complex':
+            return True
+    return False
+
+
+def _is_type_instance(val):
+    if not val.is_instance():
+        return False
+    cls = val.py__class__()
+    return any(
+        c.py__name__() == 'type' and c.get_root_context().is_builtins_module()
+        for c in cls.py__mro__()
+    )
+
+
+def _matches_type_annotation(arg_val, target_type_set, type_var_dict, variance, depth):
+    from jedi.inference.gradual.typing import AnyClass
+    from jedi.inference.gradual.type_var import TypeVar
+
+    if not arg_val.is_class():
+        # Could be an unparameterized instance of `type`
+        return False
+
+    flat_targets = list(_flatten_annotation_set(target_type_set))
+    if not flat_targets:
+        return True
+
+    for target in flat_targets:
+        if isinstance(target, AnyClass):
+            return True
+        if isinstance(target, TypeVar):
+            if target.constraints:
+                if any(
+                    _matches_type_annotation(arg_val, ValueSet([c]), type_var_dict, variance, depth + 1)
+                    for c in target.constraints
+                ):
+                    return True
+                continue
+            if target.bound:
+                if _matches_type_annotation(arg_val, target.bound, type_var_dict, 'covariant', depth + 1):
+                    return True
+                continue
+            return True
+        if target.is_class():
+            # type[T] is covariant in T!
+            check_var = variance
+            if _class_matches(arg_val, target, check_var):
+                # If target is a GenericClass (e.g. type[Box[int]]), also check generics if arg_val has them
+                from jedi.inference.gradual.base import GenericClass, DefineGenericBaseClass
+                if isinstance(target, GenericClass):
+                    if isinstance(arg_val, DefineGenericBaseClass):
+                        if _check_generic_class_args(arg_val, target, type_var_dict, check_var, depth + 1):
+                            return True
+                    else:
+                        if all(_is_top_or_unconstrained_annotation(tg) for tg in target.get_generics()):
+                            return True
+                else:
+                    return True
+    return False
+
+
+def _get_tuple_annotation_elements(generics_manager):
+    tup = generics_manager.to_tuple()
+    if len(tup) == 1:
+        only_set = tup[0]
+        if len(only_set) == 1:
+            only_val = next(iter(only_set))
+            if (
+                isinstance(only_val, iterable.SequenceLiteralValue)
+                and only_val.array_type == 'tuple'
+                and not only_val._get_raw_tree_entries()
+            ):
+                return ()
+    return tup
+
+
+def _is_tuple_annotation(ann_val):
+    from jedi.inference.gradual.typing import ProxyWithGenerics, Tuple as TypingTuple
+    from jedi.inference.gradual.base import GenericClass
+    if isinstance(ann_val, TypingTuple):
+        return True
+    if isinstance(ann_val, ProxyWithGenerics) and ann_val._tree_name.value == 'Tuple':
+        return True
+    if (
+        isinstance(ann_val, GenericClass)
+        and ann_val.py__name__() == 'tuple'
+        and ann_val.get_root_context().is_builtins_module()
+    ):
+        return True
+    return False
+
+
+def _is_callable_annotation(ann_val):
+    from jedi.inference.gradual.typing import ProxyWithGenerics, Callable as TypingCallable
+    from jedi.inference.gradual.base import GenericClass, BaseTypingValue
+    if isinstance(ann_val, TypingCallable):
+        return True
+    if isinstance(ann_val, (ProxyWithGenerics, BaseTypingValue)) and ann_val._tree_name.value == 'Callable':
+        return True
+    if isinstance(ann_val, GenericClass) and ann_val.py__name__() == 'Callable':
+        return True
+    if ann_val.is_class() and ann_val.py__name__() == 'Callable':
+        return True
+    return False
+
+
+def _single_value_matches_single_annotation(arg_val, ann_val, type_var_dict,
+                                            variance='covariant', depth=0,
+                                            precomputed_branches=None):
+    if depth > 12:
+        return True
+
+    from jedi.inference.gradual.typing import AnyClass, ProxyWithGenerics, BaseTypingValue
+    from jedi.inference.gradual.type_var import TypeVar, TypeWrapper
+    from jedi.inference.gradual.base import GenericClass, DefineGenericBaseClass
+    from jedi.inference.value.dynamic_arrays import DictModification
+
+    if isinstance(arg_val, TypeWrapper):
+        arg_val = arg_val.execute_annotation(None)
+        if len(arg_val) == 1:
+            arg_val = next(iter(arg_val))
+        else:
+            return _value_set_matches_annotation_set(
+                arg_val, ValueSet([ann_val]), type_var_dict, variance, depth + 1
+            )
+
+    if isinstance(ann_val, AnyClass) or isinstance(arg_val, AnyClass):
+        return True
+
+    if isinstance(ann_val, TypeVar):
+        if ann_val.constraints:
+            return any(
+                _single_value_matches_single_annotation(
+                    arg_val, c, type_var_dict, 'covariant', depth + 1, precomputed_branches
+                )
+                for c in ann_val.constraints
+            )
+        if ann_val.bound:
+            return any(
+                _single_value_matches_single_annotation(
+                    arg_val, b, type_var_dict, 'covariant', depth + 1, precomputed_branches
+                )
+                for b in _flatten_annotation_set(ann_val.bound)
+            )
+        return True
+
+    if isinstance(arg_val, TypeVar):
+        if arg_val == ann_val:
+            return True
+        if arg_val.constraints:
+            return all(
+                _single_value_matches_single_annotation(c, ann_val, type_var_dict, variance, depth + 1)
+                for c in arg_val.constraints
+            )
+        if arg_val.bound:
+            return _value_set_matches_annotation_set(
+                arg_val.bound.execute_annotation(None),
+                ValueSet([ann_val]),
+                type_var_dict,
+                variance,
+                depth + 1
+            )
+        return False
+
+    if (
+        variance == 'covariant'
+        and ann_val.is_class()
+        and not isinstance(ann_val, DefineGenericBaseClass)
+        and ann_val.py__name__() == 'object'
+        and ann_val.get_root_context().is_builtins_module()
+    ):
+        return True
+
+    none_val = builtin_from_name(ann_val.inference_state, 'None')
+    none_type = none_val.py__class__()
+    if ann_val == none_val or ann_val == none_type:
+        return arg_val == none_val or arg_val == none_type
+    if arg_val == none_val or arg_val == none_type:
+        return False
+
+    # Check type[X] / Type[X] / bare type / bare Type
+    if isinstance(ann_val, ProxyWithGenerics) and ann_val._tree_name.value == 'Type':
+        ann_generics = ann_val.get_generics()
+        if not ann_generics or not ann_generics[0]:
+            return arg_val.is_class() or _is_type_instance(arg_val)
+        return _matches_type_annotation(arg_val, ann_generics[0], type_var_dict, variance, depth + 1)
+
+    if (
+        isinstance(ann_val, GenericClass)
+        and ann_val.py__name__() == 'type'
+        and ann_val.get_root_context().is_builtins_module()
+    ):
+        ann_generics = ann_val.get_generics()
+        if not ann_generics or not ann_generics[0]:
+            return arg_val.is_class() or _is_type_instance(arg_val)
+        return _matches_type_annotation(arg_val, ann_generics[0], type_var_dict, variance, depth + 1)
+
+    if (
+        (ann_val.is_class() and ann_val.py__name__() == 'type' and ann_val.get_root_context().is_builtins_module())
+        or (isinstance(ann_val, BaseTypingValue) and ann_val._tree_name.value == 'Type')
+    ):
+        return arg_val.is_class() or _is_type_instance(arg_val)
+
+    # Literal containers (tuple, list, set, dict, comprehensions)
+    if isinstance(arg_val, (
+        iterable.SequenceLiteralValue,
+        iterable.ListComprehension,
+        iterable.SetComprehension,
+        iterable.GeneratorComprehension,
+        iterable.DictComprehension,
+        iterable._FakeSequence,
+        iterable.FakeDict,
+        iterable.MergedArray,
+        DictModification,
+    )):
+        return _literal_container_matches_annotation(
+            arg_val, ann_val, type_var_dict, variance, depth, precomputed_branches
+        )
+
+    return _non_literal_matches_single_annotation(arg_val, ann_val, type_var_dict, variance, depth)
+
+
+def _literal_container_matches_annotation(arg_val, ann_val, type_var_dict, variance, depth,
+                                          precomputed_branches=None):
+    from jedi.inference.gradual.base import GenericClass
+    from jedi.inference.value.dynamic_arrays import DictModification
+
+    is_dict_lit = (
+        isinstance(arg_val, (iterable.DictLiteralValue, iterable.DictComprehension, iterable.FakeDict, DictModification))
+        or getattr(arg_val, 'array_type', None) == 'dict'
+    )
+
+    if _is_tuple_annotation(ann_val):
+        if is_dict_lit or getattr(arg_val, 'array_type', None) != 'tuple':
+            return False
+        gm = ann_val._generics_manager
+        if not len(gm):
+            return True
+        branches = precomputed_branches if precomputed_branches is not None else iterable.get_sequence_branches(arg_val)
+        if gm.is_homogenous_tuple():
+            elem_ann = gm[0]
+            for b in branches:
+                for it in b:
+                    if isinstance(it, iterable.StarItem) and not it.values:
+                        if not _is_top_or_unconstrained_annotation(elem_ann):
+                            return False
+                    elif not _value_set_matches_annotation_set(
+                        it.values, elem_ann, type_var_dict, 'covariant', depth + 1
+                    ):
+                        return False
+            return True
+        else:
+            ann_tup = _get_tuple_annotation_elements(gm)
+            for b in branches:
+                if any(isinstance(it, iterable.StarItem) for it in b):
+                    return False
+                if len(b) != len(ann_tup):
+                    return False
+                for it, elem_ann in zip(b, ann_tup):
+                    if not _value_set_matches_annotation_set(
+                        it.values, elem_ann, type_var_dict, 'covariant', depth + 1
+                    ):
+                        return False
+            return True
+
+    target_cls = _unwrap_class_value(ann_val)
+    if not target_cls.is_class():
+        return False
+
+    arg_cls_set = arg_val.py__class__()
+    if isinstance(arg_cls_set, ValueSet):
+        if not arg_cls_set or not all(_class_matches(c, target_cls, 'covariant') for c in arg_cls_set):
+            return False
+    else:
+        if not _class_matches(arg_cls_set, target_cls, 'covariant'):
+            return False
+
+    if is_dict_lit:
+        if getattr(target_cls, 'is_typeddict', lambda: False)():
+            return _dict_literal_matches_typeddict(arg_val, target_cls, type_var_dict, depth + 1, precomputed_branches)
+        if isinstance(ann_val, GenericClass):
+            ann_generics = ann_val.get_generics()
+            if len(ann_generics) >= 1:
+                key_ann = ann_generics[0]
+                val_ann = ann_generics[1] if len(ann_generics) >= 2 else None
+                d_branches = precomputed_branches if precomputed_branches is not None else iterable.get_dict_branches(arg_val)
+                for db in d_branches:
+                    if db.invalid:
+                        return False
+                    for sk, (k_val, v_set) in db.known_entries.items():
+                        if not _value_set_matches_annotation_set(
+                            ValueSet([k_val]), key_ann, type_var_dict, 'covariant', depth + 1
+                        ):
+                            return False
+                        if val_ann is not None and not _value_set_matches_annotation_set(
+                            v_set, val_ann, type_var_dict, 'covariant', depth + 1
+                        ):
+                            return False
+                    for uk_set, uv_set in db.unknown_entries:
+                        if not uk_set:
+                            if not _is_top_or_unconstrained_annotation(key_ann):
+                                return False
+                        elif not _value_set_matches_annotation_set(
+                            uk_set, key_ann, type_var_dict, 'covariant', depth + 1
+                        ):
+                            return False
+                        if val_ann is not None:
+                            if not uv_set:
+                                if not _is_top_or_unconstrained_annotation(val_ann):
+                                    return False
+                            elif not _value_set_matches_annotation_set(
+                                uv_set, val_ann, type_var_dict, 'covariant', depth + 1
+                            ):
+                                return False
+        return True
+
+    # Sequence / set / generator comprehension literal
+    if isinstance(ann_val, GenericClass):
+        ann_generics = ann_val.get_generics()
+        if ann_generics:
+            elem_ann = ann_generics[0]
+            branches = precomputed_branches if precomputed_branches is not None else iterable.get_sequence_branches(arg_val)
+            for b in branches:
+                for it in b:
+                    if isinstance(it, iterable.StarItem) and not it.values:
+                        if not _is_top_or_unconstrained_annotation(elem_ann):
+                            return False
+                    elif not _value_set_matches_annotation_set(
+                        it.values, elem_ann, type_var_dict, 'covariant', depth + 1
+                    ):
+                        return False
+    return True
+
+
+def _dict_literal_matches_typeddict(arg_val, td_cls, type_var_dict, depth, precomputed_branches=None):
+    fields = {}
+    for f in td_cls.get_filters(is_instance=True):
+        for name in f.values():
+            if name.api_type == ' statement' or hasattr(name, 'infer'):
+                ann = name.infer()
+                if ann:
+                    fields[name.string_name] = ann
+    d_branches = precomputed_branches if precomputed_branches is not None else iterable.get_dict_branches(arg_val)
+    for db in d_branches:
+        if db.invalid or db.unknown_entries:
+            return False
+        for k_name, f_ann in fields.items():
+            sk = iterable._SafeKey(k_name)
+            if sk not in db.known_entries:
+                return False
+            _, v_set = db.known_entries[sk]
+            if not _value_set_matches_annotation_set(
+                v_set, f_ann, type_var_dict, 'covariant', depth + 1
+            ):
+                return False
+    return True
+
+
+def _non_literal_matches_single_annotation(arg_val, ann_val, type_var_dict,
+                                           variance='covariant', depth=0):
+    from jedi.inference.gradual.typing import Tuple as TypingTuple, Callable as TypingCallable
+    from jedi.inference.gradual.base import GenericClass, DefineGenericBaseClass
+    from jedi.inference.value.dynamic_arrays import _DynamicArrayAdditions
+
+    if isinstance(arg_val, _DynamicArrayAdditions):
+        arg_cls = arg_val.py__class__()
+        target_cls = _unwrap_class_value(ann_val)
+        if not target_cls.is_class() or not _class_matches(arg_cls, target_cls, variance):
+            return False
+        if isinstance(ann_val, GenericClass):
+            ann_generics = ann_val.get_generics()
+            if ann_generics:
+                elem_vals = ValueSet.from_sets(lv.infer() for lv in arg_val.py__iter__())
+                if elem_vals and not _value_set_matches_annotation_set(
+                    elem_vals, ann_generics[0], type_var_dict, 'covariant', depth + 1
+                ):
+                    return False
+        return True
+
+    if _is_callable_annotation(ann_val):
+        return _matches_callable_annotation(arg_val, ann_val, type_var_dict, variance, depth)
+
+    arg_tuple_gm = None
+    if isinstance(arg_val, TypingTuple):
+        arg_tuple_gm = arg_val._generics_manager
+    elif arg_val.is_instance() and not arg_val.is_compiled() and hasattr(arg_val, 'get_annotated_class_object'):
+        ann_cls = arg_val.get_annotated_class_object()
+        if (
+            isinstance(ann_cls, GenericClass)
+            and ann_cls.py__name__() == 'tuple'
+            and ann_cls.get_root_context().is_builtins_module()
+            and len(ann_cls._generics_manager)
+        ):
+            arg_tuple_gm = ann_cls._generics_manager
+
+    if _is_tuple_annotation(ann_val):
+        gm = ann_val._generics_manager
+        if arg_tuple_gm is not None:
+            if not len(gm):
+                return True
