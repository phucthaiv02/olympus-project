+def _check_generic_class_args(arg_cls, ann_val, type_var_dict, variance, depth):
+    from jedi.inference.gradual.base import DefineGenericBaseClass
+
+    target_cls = _unwrap_class_value(ann_val)
+    target_generics = ann_val.get_generics()
+    if not target_generics:
+        return True
+
+    matched_mro_cls = None
+    for mro_cls in arg_cls.py__mro__():
+        if _same_base_class(mro_cls, target_cls):
+            matched_mro_cls = mro_cls
+            break
+
+    if matched_mro_cls is None or not isinstance(matched_mro_cls, DefineGenericBaseClass):
+        return all(_is_top_or_unconstrained_annotation(tg) for tg in target_generics)
+
+    actual_generics = matched_mro_cls.get_generics()
+    if not actual_generics:
+        return all(_is_top_or_unconstrained_annotation(tg) for tg in target_generics)
+
+    if len(actual_generics) < len(target_generics):
+        return False
+
+    type_vars = getattr(target_cls, 'list_type_vars', lambda: [])()
+    for idx, (actual_g, target_g) in enumerate(zip(actual_generics, target_generics)):
+        if idx < len(type_vars):
+            tv = type_vars[idx]
+            if tv.is_covariant:
+                param_variance = variance
+            elif tv.is_contravariant:
+                if variance == 'covariant':
+                    param_variance = 'contravariant'
+                elif variance == 'contravariant':
+                    param_variance = 'covariant'
+                else:
+                    param_variance = 'invariant'
+            else:
+                param_variance = 'invariant'
+        else:
+            param_variance = 'invariant'
+
+        if not actual_g:
+            if target_cls.py__name__() in ('Generator', 'GeneratorType') and idx >= 1:
+                continue
+            if not _is_top_or_unconstrained_annotation(target_g):
+                return False
+            continue
+
+        actual_executed = actual_g.execute_annotation(None)
+        if not _value_set_matches_annotation_set(
+            actual_executed, target_g, type_var_dict, param_variance, depth + 1
+        ):
+            return False
+
+    return True
