+        else:
+            prefix_items.append(iterable.ExactItem(ValueSet([base_args._class])))
+        base_args = base_args._wrapped_arguments
+
+    pos_branches = [list(prefix_items)]
+    kw_branches = [iterable.DictBranch()]
+
+    if isinstance(base_args, ValuesArguments):
+        for values in base_args._values_list:
+            item = iterable.ExactItem(values)
+            pos_branches = [b + [item] for b in pos_branches]
+        return [(tuple(pb), kb) for pb in pos_branches for kb in kw_branches]
+
+    if not isinstance(base_args, TreeArguments):
+        for k, lv in base_args.unpack():
+            if k is None:
+                item = iterable.ExactItem(lv.infer())
+                pos_branches = [b + [item] for b in pos_branches]
+            else:
+                k_obj = iterable.compiled.create_simple_object(
+                    base_args.context.inference_state, k
+                )
+                for kb in kw_branches:
+                    kb.add_known(iterable._SafeKey(k), k_obj, lv.infer())
+        return [(tuple(pb), kb) for pb in pos_branches for kb in kw_branches]
+
+    context = base_args.context
+    inference_state = base_args._inference_state
+    for star_count, el in unpack_arglist(base_args.argument_node):
+        if star_count == 1:
+            arrays = context.infer_node(el)
