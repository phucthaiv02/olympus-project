+def _matches_callable_annotation(arg_val, ann_val, type_var_dict, variance, depth):
+    from jedi.inference.gradual.typing import Callable as TypingCallable
+    from jedi.inference.gradual.base import DefineGenericBaseClass
+    from jedi.inference.arguments import ValuesArguments
+
+    is_callable = (
+        arg_val.is_function()
+        or arg_val.is_class()
+        or isinstance(arg_val, TypingCallable)
+        or (arg_val.is_instance() and bool(arg_val.py__getattribute__('__call__')))
+    )
+    if not is_callable:
+        return False
+
+    if not isinstance(ann_val, (DefineGenericBaseClass, TypingCallable)):
+        return True
+
+    gm = ann_val._generics_manager
+    if len(gm) < 2:
+        return True
+
+    param_spec_set = gm[0]
+    ret_ann_set = gm[1]
+
+    if isinstance(arg_val, TypingCallable):
+        arg_gm = arg_val._generics_manager
+        if len(arg_gm) < 2:
+            return _is_top_or_unconstrained_annotation(ret_ann_set)
+        if not _value_set_matches_annotation_set(
+            arg_gm[1].execute_annotation(None), ret_ann_set, type_var_dict, variance, depth + 1
+        ):
+            return False
+        # Check parameter list if specified as a list literal
+        if len(param_spec_set) == 1:
+            p_spec = next(iter(param_spec_set))
+            if isinstance(p_spec, iterable.SequenceLiteralValue) and p_spec.array_type == 'list':
+                if len(arg_gm[0]) == 1:
+                    a_spec = next(iter(arg_gm[0]))
+                    if isinstance(a_spec, iterable.SequenceLiteralValue) and a_spec.array_type == 'list':
+                        p_branches = iterable.get_sequence_branches(p_spec)
+                        a_branches = iterable.get_sequence_branches(a_spec)
+                        if len(p_branches) == 1 and len(a_branches) == 1:
+                            pb, ab = p_branches[0], a_branches[0]
+                            if len(pb) != len(ab):
+                                return False
+                            for p_it, a_it in zip(pb, ab):
+                                # Contravariant parameter check
+                                if not _value_set_matches_annotation_set(
+                                    p_it.values.execute_annotation(None),
+                                    a_it.values,
+                                    type_var_dict,
+                                    'covariant',
+                                    depth + 1
+                                ):
+                                    return False
+        return True
+
+    if len(param_spec_set) == 1:
+        p_spec = next(iter(param_spec_set))
+        if isinstance(p_spec, iterable.SequenceLiteralValue) and p_spec.array_type == 'list':
+            p_branches = iterable.get_sequence_branches(p_spec)
+            if len(p_branches) == 1 and all(isinstance(it, iterable.ExactItem) for it in p_branches[0]):
+                synth_args = ValuesArguments([
+                    it.values.execute_annotation(None) for it in p_branches[0]
+                ])
+                if arg_val.is_function() and hasattr(arg_val, 'tree_node'):
+                    if not matches_call_signature(arg_val, synth_args, depth + 1):
+                        return False
+                    ret_vals = ValueSet([arg_val]).execute(synth_args)
+                    if not _value_set_matches_annotation_set(
+                        ret_vals, ret_ann_set, type_var_dict, variance, depth + 1
+                    ):
+                        return False
+                return True
+
+    if arg_val.is_function() and hasattr(arg_val, 'as_context'):
+        ret_vals = arg_val.as_context(ValuesArguments([])).infer()
+        if not _value_set_matches_annotation_set(
+            ret_vals, ret_ann_set, type_var_dict, variance, depth + 1
+        ):
+            return False
+    return True
+
