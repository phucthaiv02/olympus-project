+                s = pos_specs[idx]
+                bound_params[s].append(item.value_set)
+                potentially_pos_bound.add(s)
+                if idx < min_pos:
+                    definitely_bound.add(s)
+            var_pos_values.append(item.value_set)
+            if item.is_star:
+                stars_before += 1
+            else:
+                fixed_before += 1
+
+    for k_str, kw_val_set in branch.keywords.items():
+        if k_str in kw_able_map:
+            s = kw_able_map[k_str]
+            if s in potentially_pos_bound:
+                return None
+            bound_params[s].append(kw_val_set)
+            definitely_bound.add(s)
+        else:
+            if var_kw_spec is None:
+                return None
+            var_kw_values.append(kw_val_set)
+
+    if branch.unknown_keywords:
+        if var_kw_spec is None:
+            return None
+        for _, uv_set in branch.unknown_keywords:
+            var_kw_values.append(uv_set)
+            for s in kw_able_map.values():
+                if s not in definitely_bound and s not in potentially_pos_bound:
+                    bound_params[s].append(uv_set)
+
+    for s in specs:
+        if s.kind in (
+            Parameter.POSITIONAL_ONLY,
+            Parameter.POSITIONAL_OR_KEYWORD,
+            Parameter.KEYWORD_ONLY,
+        ):
+            if s not in definitely_bound and not s.has_default:
+                return None
+
+    return bound_params, var_pos_spec, var_pos_values, var_kw_spec, var_kw_values
+
+
+def _branch_matches_function(function_value, branch):
+    from jedi.inference.gradual.annotation import infer_param
+
+    specs = _get_param_specs(function_value)
+    bound = _bind_branch_to_specs(specs, branch)
+    if bound is None:
+        return False
+
+    bound_params, var_pos_spec, var_pos_values, var_kw_spec, var_kw_values = bound
+    funcdef = function_value.tree_node
+    is_init_or_new = funcdef.name.value in ('__init__', '__new__')
+    type_var_constraints = {}
+
+    for i, s in enumerate(specs):
+        val_sets = bound_params.get(s)
+        if not val_sets:
+            continue
+        ann_set = infer_param(function_value, s.param_node, ignore_stars=True)
+        if not ann_set:
+            continue
+        is_init_self = (i == 0 and is_init_or_new)
+        for val_set in val_sets:
+            if not value_matches_annotation_set(
+                function_value, val_set, ann_set, type_var_constraints,
+                is_init_self=is_init_self
+            ):
+                return False
+
+    if var_pos_spec is not None and var_pos_values:
+        ann_set = infer_param(function_value, var_pos_spec.param_node, ignore_stars=True)
+        if ann_set:
+            for val_set in var_pos_values:
+                if not value_matches_annotation_set(
+                    function_value, val_set, ann_set, type_var_constraints
+                ):
+                    return False
+
+    if var_kw_spec is not None and var_kw_values:
+        ann_set = infer_param(function_value, var_kw_spec.param_node, ignore_stars=True)
+        if ann_set:
+            for val_set in var_kw_values:
+                if not value_matches_annotation_set(
+                    function_value, val_set, ann_set, type_var_constraints
+                ):
+                    return False
+
+    return True
+
+
+def matches_signature(function_value, arguments):
+    branches = _unpack_call_branches(arguments)
+    if not branches:
+        return False
+    return all(_branch_matches_function(function_value, b) for b in branches)
+
+
+def get_branch_param_values(function_value, arguments):
+    specs = _get_param_specs(function_value)
+    if not specs:
+        return {}
+    branches = _unpack_call_branches(arguments)
+    result = defaultdict(lambda: NO_VALUES)
+    for b in branches:
+        bound = _bind_branch_to_specs(specs, b)
+        if bound is None:
+            continue
+        bound_params, var_pos_spec, var_pos_values, var_kw_spec, var_kw_values = bound
+        for s, val_sets in bound_params.items():
+            for vs in val_sets:
+                result[s.name] |= vs
+        if var_pos_spec is not None:
+            for vs in var_pos_values:
+                result[var_pos_spec.name] |= vs
+        if var_kw_spec is not None:
+            for vs in var_kw_values:
+                result[var_kw_spec.name] |= vs
+    return result
+
+
+def _unwrap_class(cls):
+    from jedi.inference.gradual.base import BaseTypingValue, GenericClass
+    while isinstance(cls, (ValueWrapper, LazyValueWrapper)) and not isinstance(cls, BaseTypingValue):
+        if isinstance(cls, GenericClass):
+            cls = cls._class_value
+        else:
+            cls = cls._wrapped_value
+    if cls.is_compiled() and cls.get_root_context().is_builtins_module():
+        try:
+            cls = builtin_from_name(cls.inference_state, cls.py__name__())
+            while isinstance(cls, (ValueWrapper, LazyValueWrapper)) and not isinstance(cls, BaseTypingValue):
+                cls = cls._wrapped_value
+        except (KeyError, ValueError):
+            pass
+    return cls
+
+
+def _is_subclass(sub_cls, sup_cls):
+    sub_base = _unwrap_class(sub_cls)
+    sup_base = _unwrap_class(sup_cls)
+    if sub_base == sup_base:
+        return True
+    if sup_base.py__name__() == 'object' and sup_base.get_root_context().is_builtins_module():
+        return True
+    try:
+        mro = list(sub_base.py__mro__())
+    except AttributeError:
+        return False
+    for mro_cls in mro:
+        if _unwrap_class(mro_cls) == sup_base:
+            return True
+    if sup_base.get_root_context().is_builtins_module():
+        sup_name = sup_base.py__name__()
+        if sup_name == 'float':
+            int_cls = _unwrap_class(builtin_from_name(sup_base.inference_state, 'int'))
+            if any(_unwrap_class(c) == int_cls for c in mro):
+                return True
+        elif sup_name == 'complex':
+            int_cls = _unwrap_class(builtin_from_name(sup_base.inference_state, 'int'))
+            float_cls = _unwrap_class(builtin_from_name(sup_base.inference_state, 'float'))
+            if any(_unwrap_class(c) in (int_cls, float_cls) for c in mro):
+                return True
+    return False
+
+
+def _is_protocol_class(cls):
+    base = _unwrap_class(cls)
+    if not hasattr(base, 'py__bases__'):
+        return False
+    for lazy_base in base.py__bases__():
+        for b in lazy_base.infer():
+            if b.py__name__() == 'Protocol':
+                return True
+    return False
+
+
+def _get_protocol_members(cls):
+    from jedi.inference.filters import ParserTreeFilter
+    members = set()
+    base = _unwrap_class(cls)
+    if not hasattr(base, 'py__mro__'):
+        return members
+    for mro_cls in base.py__mro__():
+        u_cls = _unwrap_class(mro_cls)
+        if u_cls.py__name__() in ('Protocol', 'object', 'Generic'):
+            continue
+        if not _is_protocol_class(u_cls):
+            continue
+        if hasattr(u_cls, 'as_context'):
+            for name_def in ParserTreeFilter(parent_context=u_cls.as_context()).values():
+                name_str = name_def.string_name
+                if name_str not in ('__init__', '__new__', '__slots__', '__weakref__'):
+                    members.add(name_str)
+    return members
+
+
+def _matches_structural_or_protocol(v, ann_cls):
+    ann_base = _unwrap_class(ann_cls)
+    ann_name = ann_base.py__name__()
+    if ann_name == 'Iterable':
+        return _is_iterable_value(v)
+    if ann_name == 'Iterator':
+        return bool(
+            v.py__getattribute__('__iter__', analysis_errors=False)
+            and v.py__getattribute__('__next__', analysis_errors=False)
+        )
+    if ann_name == 'Reversible':
+        return bool(v.py__getattribute__('__reversed__', analysis_errors=False))
+    if ann_name == 'Sized':
+        return bool(v.py__getattribute__('__len__', analysis_errors=False))
+    if ann_name == 'Container':
+        return bool(v.py__getattribute__('__contains__', analysis_errors=False))
+    if ann_name == 'Hashable':
+        h = v.py__getattribute__('__hash__', analysis_errors=False)
+        return bool(h) and not any(x.py__name__() == 'NoneType' for x in h)
+    if ann_name == 'Callable':
+        return (
+            v.is_function()
+            or v.is_class()
+            or v.is_bound_method()
+            or bool(v.py__getattribute__('__call__', analysis_errors=False))
+        )
+    if _is_protocol_class(ann_base):
+        members = _get_protocol_members(ann_base)
+        if not members:
+            return True
+        for m in members:
+            if v.is_class():
+                found = False
+                for meta in v.get_metaclasses():
+                    if meta.py__getattribute__(m, analysis_errors=False):
+                        found = True
+                        break
+                if not found:
+                    type_cls = builtin_from_name(v.inference_state, 'type')
+                    if not type_cls.py__getattribute__(m, analysis_errors=False):
+                        return False
+            else:
+                if not v.py__getattribute__(m, analysis_errors=False):
+                    return False
+        return True
+    return False
+
+
+def _unwrap_annotations(ann_set):
+    from jedi.inference.gradual.typing import ProxyWithGenerics, TypeAlias, NewType, \
+        IGNORE_ANNOTATION_PARTS
+    for ann in ann_set:
+        if isinstance(ann, ProxyWithGenerics):
+            name = ann._tree_name.value
+            if name == 'Union':
+                yield from _unwrap_annotations(ann.gather_annotation_classes())
+            elif name == 'Optional':
+                yield from _unwrap_annotations(ann.gather_annotation_classes())
+                yield builtin_from_name(ann.inference_state, 'None')
+            elif name in IGNORE_ANNOTATION_PARTS:
+                generics = ann.get_generics()
+                if generics:
+                    yield from _unwrap_annotations(generics[0])
+            else:
+                yield ann
+        elif isinstance(ann, TypeAlias):
+            yield ann._get_wrapped_value()
+        elif isinstance(ann, NewType):
+            yield from _unwrap_annotations(ann._type_value_set)
+        else:
+            yield ann
+
+
+def _contains_type_var_or_any(ann_set):
+    from jedi.inference.gradual.typing import AnyClass
+    from jedi.inference.gradual.type_var import TypeVar
+    from jedi.inference.gradual.base import DefineGenericBaseClass
+    for ann in _unwrap_annotations(ann_set):
+        if isinstance(ann, (TypeVar, AnyClass)):
+            return True
+        if isinstance(ann, DefineGenericBaseClass):
+            if any(_contains_type_var_or_any(g) for g in ann.get_generics()):
+                return True
+    return False
+
+
+def _is_any_or_unconstrained_typevar(ann_set, type_var_constraints=None):
+    from jedi.inference.gradual.typing import AnyClass
+    from jedi.inference.gradual.type_var import TypeVar
+    unwrapped = list(_unwrap_annotations(ann_set))
+    if not unwrapped:
+        return True
+    for ann in unwrapped:
+        if isinstance(ann, AnyClass):
+            return True
+        if isinstance(ann, TypeVar):
+            if ann._bound_lazy_value is None and not ann._constraints_lazy_values:
+                return True
+            if ann._bound_lazy_value is not None:
+                bound_set = ann._bound_lazy_value.infer()
+                if any(
+                    b.py__name__() == 'object' and b.get_root_context().is_builtins_module()
+                    for b in _unwrap_annotations(bound_set)
+                ):
+                    return True
+    return False
+
+
+def _annotation_to_values(function_value, sub_ann):
+    from jedi.inference.gradual.typing import AnyClass
+    from jedi.inference.gradual.type_var import TypeVar
+    if isinstance(sub_ann, AnyClass):
+        return ValueSet([sub_ann])
+    if isinstance(sub_ann, TypeVar):
+        if sub_ann._bound_lazy_value is not None:
+            return ValueSet.from_sets(
+                _annotation_to_values(function_value, b)
+                for b in _unwrap_annotations(sub_ann._bound_lazy_value.infer())
+            )
+        if sub_ann._constraints_lazy_values:
+            return ValueSet.from_sets(
+                _annotation_to_values(function_value, c)
+                for c in _unwrap_annotations(sub_ann.constraints)
+            )
+        return NO_VALUES
+    if sub_ann.is_instance() and sub_ann.py__name__() == 'NoneType':
+        return ValueSet([sub_ann])
+    return sub_ann.execute_annotation(None)
+
+
+def annotation_is_subtype(function_value, sub_ann_set, sup_ann_set, type_var_constraints):
+    unwrapped_sub = list(_unwrap_annotations(sub_ann_set))
+    if not unwrapped_sub:
+        return _is_any_or_unconstrained_typevar(sup_ann_set, type_var_constraints)
+    for sub_ann in unwrapped_sub:
+        vals = _annotation_to_values(function_value, sub_ann)
+        if not vals:
+            if not _is_any_or_unconstrained_typevar(sup_ann_set, type_var_constraints):
+                return False
+            continue
+        if not value_matches_annotation_set(
+            function_value, vals, sup_ann_set, type_var_constraints
+        ):
+            return False
+    return True
+
+
+def _generics_match(function_value, actual_generic_cls, ann_generic_cls, type_var_constraints):
+    from jedi.inference.gradual.base import DefineGenericBaseClass
+    ann_generics = ann_generic_cls.get_generics()
+    if not ann_generics:
+        return True
+    if not isinstance(actual_generic_cls, DefineGenericBaseClass):
+        return all(
+            _is_any_or_unconstrained_typevar(g, type_var_constraints)
+            for g in ann_generics
+        )
+    actual_generics = actual_generic_cls.get_generics()
+    if not actual_generics:
+        return all(
+            _is_any_or_unconstrained_typevar(g, type_var_constraints)
+            for g in ann_generics
+        )
+
+    ann_base = _unwrap_class(ann_generic_cls)
+    type_vars = ann_base.list_type_vars() if hasattr(ann_base, 'list_type_vars') else []
+
+    for idx, (actual_g_set, ann_g_set) in enumerate(zip(actual_generics, ann_generics)):
+        tv = type_vars[idx] if idx < len(type_vars) else None
+        if tv is not None and tv.is_covariant:
+            if not annotation_is_subtype(function_value, actual_g_set, ann_g_set, type_var_constraints):
+                return False
+        elif tv is not None and tv.is_contravariant:
+            if not annotation_is_subtype(function_value, ann_g_set, actual_g_set, type_var_constraints):
+                return False
+        else:
+            if not annotation_is_subtype(function_value, actual_g_set, ann_g_set, type_var_constraints):
+                return False
+            if not _contains_type_var_or_any(ann_g_set) and not _contains_type_var_or_any(actual_g_set):
+                if not annotation_is_subtype(function_value, ann_g_set, actual_g_set, type_var_constraints):
+                    return False
+    return True
+
+
+def _class_matches_type_target(function_value, v_cls, target, type_var_constraints):
+    from jedi.inference.gradual.typing import AnyClass
+    from jedi.inference.gradual.type_var import TypeVar
+    from jedi.inference.gradual.base import GenericClass
+
+    if isinstance(target, AnyClass):
+        return True
+    if isinstance(target, TypeVar):
+        inst_vals = v_cls.execute_annotation(None)
+        return value_matches_annotation_set(
+            function_value, inst_vals, ValueSet([target]), type_var_constraints
+        )
+    if not (target.is_class() or target.is_class_mixin()):
+        return False
+    if not _is_subclass(v_cls, target):
+        if _is_protocol_class(target):
+            inst_vals = v_cls.execute_annotation(None)
+            return bool(inst_vals) and all(
+                _matches_structural_or_protocol(iv, target) for iv in inst_vals
+            )
+        return False
+    if isinstance(target, GenericClass) and target.get_generics():
+        target_base = _unwrap_class(target)
+        for parent_cls in v_cls.py__mro__():
+            if _unwrap_class(parent_cls) == target_base:
+                return _generics_match(function_value, parent_cls, target, type_var_constraints)
+        return False
+    return True
+
+
+def _callable_matches_annotation(function_value, v, ann, type_var_constraints):
+    from jedi.inference.gradual.typing import Callable as TypingCallable
+    from jedi.inference.arguments import ValuesArguments
+    from jedi.inference.value.function import AnonymousFunctionExecution
+
+    if not (
+        v.is_function()
+        or v.is_class()
+        or v.is_bound_method()
+        or isinstance(v, TypingCallable)
+        or (v.is_instance() and bool(v.py__getattribute__('__call__', analysis_errors=False)))
+    ):
+        return False
+
+    generics = ann.get_generics()
+    if len(generics) < 2:
+        return True
+
+    param_spec_set = generics[0]
+    ret_ann_set = generics[1]
+
+    if isinstance(v, TypingCallable):
+        v_generics = v._generics_manager.to_tuple()
+        if len(v_generics) < 2:
+            return True
+        if not annotation_is_subtype(function_value, v_generics[1], ret_ann_set, type_var_constraints):
+            return False
+        ann_param_spec = next(iter(param_spec_set), None)
+        v_param_spec = next(iter(v_generics[0]), None)
+        if isinstance(ann_param_spec, iterable.SequenceLiteralValue) and isinstance(v_param_spec, iterable.SequenceLiteralValue):
+            ann_entries = [ lv.infer() for lv in ann_param_spec.py__iter__() ]
+            v_entries = [ lv.infer() for lv in v_param_spec.py__iter__() ]
+            if len(ann_entries) != len(v_entries):
+                return False
+            for ann_p, v_p in zip(ann_entries, v_entries):
+                if not annotation_is_subtype(function_value, ann_p, v_p, type_var_constraints):
+                    return False
+        return True
+
+    param_spec = next(iter(param_spec_set), None)
+    if isinstance(param_spec, iterable.SequenceLiteralValue):
+        arg_sets = []
+        for lv in param_spec.py__iter__():
+            p_ann_set = lv.infer()
+            p_vals = ValueSet.from_sets(
+                _annotation_to_values(function_value, pa)
+                for pa in _unwrap_annotations(p_ann_set)
+            )
+            arg_sets.append(p_vals)
+        synth_args = ValuesArguments(arg_sets)
+        sigs = v.get_signatures()
+        if sigs and not any(sig.matches_signature(synth_args) for sig in sigs):
+            return False
+        if ret_ann_set:
+            ret_vals = v.execute(synth_args)
+            if ret_vals and not value_matches_annotation_set(
+                function_value, ret_vals, ret_ann_set, type_var_constraints
+            ):
+                return False
+        return True
+
+    # Callable[..., R]
+    if ret_ann_set:
+        ret_vals = v.execute_annotation(None)
+        if not ret_vals and hasattr(v, 'tree_node') and v.tree_node is not None and v.is_function():
+            anon = AnonymousFunctionExecution(v)
+            ret_vals = anon.infer_annotations() or anon.get_return_values()
+        if ret_vals and not value_matches_annotation_set(
+            function_value, ret_vals, ret_ann_set, type_var_constraints
+        ):
+            return False
+    return True
+
+
+def _sequence_branch_matches_annotation(function_value, v, seq_b, ann, type_var_constraints):
+    from jedi.inference.gradual.typing import ProxyWithGenerics, Tuple as TypingTuple
+    from jedi.inference.gradual.base import GenericClass
+
+    if isinstance(ann, ProxyWithGenerics) and ann._tree_name.value == 'Tuple':
+        if getattr(v, 'array_type', None) != 'tuple' and not isinstance(v, TypingTuple):
+            return False
+        generics = ann.get_generics()
+        if ann._generics_manager.is_homogenous_tuple():
+            if not generics:
+                return True
+            elem_ann_set = generics[0]
+            for pos_item in seq_b:
+                if not value_matches_annotation_set(
+                    function_value, pos_item.value_set, elem_ann_set, type_var_constraints
+                ):
+                    return False
+            return True
+        else:
+            if any(item.is_star for item in seq_b):
+                return False
+            if len(seq_b) != len(generics):
+                return False
+            for pos_item, elem_ann_set in zip(seq_b, generics):
+                if not value_matches_annotation_set(
+                    function_value, pos_item.value_set, elem_ann_set, type_var_constraints
+                ):
+                    return False
+            return True
+
+    if not _nominal_or_structural_match(v, ann):
+        return False
+
+    if isinstance(ann, GenericClass):
+        ann_generics = ann.get_generics()
+        if ann_generics:
+            elem_ann_set = ann_generics[0]
+            for pos_item in seq_b:
+                if not value_matches_annotation_set(
+                    function_value, pos_item.value_set, elem_ann_set, type_var_constraints
+                ):
+                    return False
+    return True
+
+
+def _dict_branch_matches_annotation(function_value, v, db, ann, type_var_constraints):
+    from jedi.inference.gradual.base import GenericClass
+
+    if not _nominal_or_structural_match(v, ann):
+        return False
+
+    if isinstance(ann, GenericClass):
+        ann_generics = ann.get_generics()
+        if not ann_generics:
+            return True
+        ann_name = _unwrap_class(ann).py__name__()
+        mapping_like = (
+            'dict', 'Mapping', 'MutableMapping', 'OrderedDict',
+            'defaultdict', 'ChainMap', 'UserDict',
+            'SupportsKeysAndGetItem', 'SupportsItems', 'SupportsGetItem',
+            'SupportsContainsAndGetItem', 'SupportsItemAccess',
+        )
+        if ann_name in mapping_like:
+            key_ann_set = ann_generics[0] if len(ann_generics) >= 1 else NO_VALUES
+            val_ann_set = ann_generics[1] if len(ann_generics) >= 2 else NO_VALUES
+            for dk, dv_set in db.entries.values():
+                if key_ann_set and not value_matches_annotation_set(
+                    function_value, ValueSet([dk]), key_ann_set, type_var_constraints
+                ):
+                    return False
+                if val_ann_set and not value_matches_annotation_set(
+                    function_value, dv_set, val_ann_set, type_var_constraints
+                ):
+                    return False
+            for uk_set, uv_set in db.unknown_entries:
+                if key_ann_set and not value_matches_annotation_set(
+                    function_value, uk_set, key_ann_set, type_var_constraints
+                ):
+                    return False
+                if val_ann_set and not value_matches_annotation_set(
+                    function_value, uv_set, val_ann_set, type_var_constraints
+                ):
+                    return False
+            return True
+        else:
+            # Iterable[K] / Collection[K] / Container[K] on a dict iterates over keys
+            key_ann_set = ann_generics[0]
+            for dk, _ in db.entries.values():
+                if not value_matches_annotation_set(
+                    function_value, ValueSet([dk]), key_ann_set, type_var_constraints
+                ):
+                    return False
+            for uk_set, _ in db.unknown_entries:
+                if not value_matches_annotation_set(
+                    function_value, uk_set, key_ann_set, type_var_constraints
+                ):
+                    return False
+            return True
+    return True
+
+
+def _nominal_or_structural_match(v, ann):
+    from jedi.inference.gradual.typing import AnyClass, ProxyTypingClassValue, \
+        ProxyWithGenerics
+    from jedi.inference.gradual.type_var import TypeVar
+    from jedi.inference.value.dynamic_arrays import _DynamicArrayAdditions
+
+    if isinstance(ann, (AnyClass, TypeVar)):
+        return True
+    if isinstance(ann, ProxyTypingClassValue):
+        name = ann._tree_name.value
+        if name == 'Tuple':
+            return getattr(v, 'array_type', None) == 'tuple' or _is_subclass(
+                v.py__class__(), builtin_from_name(v.inference_state, 'tuple')
+            )
+        if name in ('Generic', 'Protocol'):
+            return True
+        return False
+    if isinstance(ann, ProxyWithGenerics):
+        return False
+    if ann.is_instance():
+        return False
+    if isinstance(v, _DynamicArrayAdditions):
+        ann_name = _unwrap_class(ann).py__name__()
+        return ann_name in ('Iterable', 'object')
+    v_cls = v.py__class__()
+    if _is_subclass(v_cls, ann):
+        return True
+    return _matches_structural_or_protocol(v, ann)
+
+
+def _single_value_matches_annotation(function_value, v, ann, type_var_constraints, is_init_self=False):
+    from jedi.inference.gradual.typing import AnyClass, ProxyWithGenerics, \
+        ProxyTypingClassValue, Tuple as TypingTuple, TypedDict
+    from jedi.inference.gradual.type_var import TypeVar
+    from jedi.inference.gradual.base import GenericClass, BaseTypingValue
+    from jedi.inference.value.dynamic_arrays import _DynamicArrayAdditions
+    from jedi.plugins.stdlib import EnumInstance
+
+    if isinstance(v, AnyClass) or isinstance(ann, AnyClass):
+        return True
+
+    if isinstance(ann, TypeVar):
+        if ann._bound_lazy_value is not None:
+            bound_set = ann._bound_lazy_value.infer()
+            if bound_set and not value_matches_annotation_set(
+                function_value, ValueSet([v]), bound_set, type_var_constraints
+            ):
+                return False
+        if ann._constraints_lazy_values:
+            constraints = ann.constraints
+            if constraints:
+                matching = {
+                    c for c in constraints
+                    if value_matches_annotation_set(
+                        function_value, ValueSet([v]), ValueSet([c]), {}
+                    )
+                }
+                if not matching:
+                    return False
+                if ann in type_var_constraints:
+                    common = type_var_constraints[ann] & matching
+                    if not common:
+                        return False
+                    type_var_constraints[ann] = common
+                else:
+                    type_var_constraints[ann] = matching
+        return True
+
+    if (ann.is_instance() or ann.is_class()) and ann.py__name__() == 'NoneType':
+        return v.is_instance() and v.py__name__() == 'NoneType'
+
+    if isinstance(ann, ProxyTypingClassValue):
+        name = ann._tree_name.value
+        if name == 'Tuple':
+            return (
+                isinstance(v, TypingTuple)
+                or getattr(v, 'array_type', None) == 'tuple'
+                or (v.is_instance() and _is_subclass(v.py__class__(), builtin_from_name(v.inference_state, 'tuple')))
+            )
+        if name == 'Type':
+            return (
+                v.is_class()
+                or v.is_class_mixin()
+                or (v.is_instance() and _is_subclass(v.py__class__(), builtin_from_name(v.inference_state, 'type')))
+            )
+        if name == 'Callable':
+            return _callable_matches_annotation(function_value, v, ann, type_var_constraints)
+        if name in ('Generic', 'Protocol'):
+            return True
+        return False
+
+    if isinstance(ann, ProxyWithGenerics):
+        name = ann._tree_name.value
+        if name == 'Literal':
+            lit_values = ann.execute_annotation(None)
+            for lit in lit_values:
+                if isinstance(v, EnumInstance) or isinstance(lit, EnumInstance):
+                    if v == lit:
+                        return True
+                    continue
+                v_raw = v.get_safe_value(default=_NO_SAFE_VALUE)
+                lit_raw = lit.get_safe_value(default=_NO_SAFE_VALUE)
+                if (
+                    v_raw is not _NO_SAFE_VALUE
+                    and lit_raw is not _NO_SAFE_VALUE
+                    and type(v_raw) is type(lit_raw)
+                    and v_raw == lit_raw
+                ):
+                    return True
+            return False
+
+        if name == 'Type':
+            generics = ann.get_generics()
+            if not generics or not generics[0]:
+                return (
+                    v.is_class()
+                    or v.is_class_mixin()
+                    or (v.is_instance() and _is_subclass(v.py__class__(), builtin_from_name(v.inference_state, 'type')))
+                )
+            targets = list(_unwrap_annotations(generics[0]))
+            if v.is_class() or v.is_class_mixin():
+                return any(
+                    _class_matches_type_target(function_value, v, target, type_var_constraints)
+                    for target in targets
+                )
+            if v.is_instance() and _is_subclass(v.py__class__(), builtin_from_name(v.inference_state, 'type')):
+                return _is_any_or_unconstrained_typevar(generics[0], type_var_constraints) or any(
+                    (t.is_class() and t.py__name__() == 'object' and t.get_root_context().is_builtins_module())
+                    for t in targets
+                )
+            return False
+
+        if name == 'Tuple':
+            if isinstance(v, TypingTuple):
+                for seq_b in iterable.get_sequence_branches(v):
+                    if not _sequence_branch_matches_annotation(
+                        function_value, v, seq_b, ann, type_var_constraints
+                    ):
+                        return False
+                return True
+            if v.is_instance() and _is_subclass(v.py__class__(), builtin_from_name(v.inference_state, 'tuple')):
+                if ann._generics_manager.is_homogenous_tuple():
+                    generics = ann.get_generics()
+                    if not generics:
+                        return True
+                    return _is_any_or_unconstrained_typevar(generics[0], type_var_constraints)
+            return False
+
+        if name == 'Callable':
+            return _callable_matches_annotation(function_value, v, ann, type_var_constraints)
+
+        return False
+
+    # Invalid instance annotation such as `value: 1` or `_SpecialForm` like `Never`/`NoReturn`
+    if ann.is_instance():
+        return False
+    if isinstance(ann, BaseTypingValue):
+        return False
+
+    ann_base = _unwrap_class(ann)
+    if ann_base.py__name__() == 'Callable' and not isinstance(v, _DynamicArrayAdditions):
+        return _callable_matches_annotation(function_value, v, ann, type_var_constraints)
+
+    if is_init_self and not isinstance(v, _DynamicArrayAdditions) and v.is_instance():
+        return _is_subclass(v.py__class__(), ann_base)
+
+    # Check if v is a class (e.g. `Foo` passed where `type` or `object` or `Foo` is expected)
+    if not isinstance(v, _DynamicArrayAdditions) and (v.is_class() or v.is_class_mixin()):
+        if ann_base.py__name__() == 'object' and ann_base.get_root_context().is_builtins_module():
+            return True
+        if ann_base.py__name__() == 'Hashable':
+            return True
+        type_cls = builtin_from_name(v.inference_state, 'type')
+        if _is_subclass(type_cls, ann_base):
+            return True
+        for meta in v.get_metaclasses():
+            if _is_subclass(meta, ann_base):
+                return True
+        return _matches_structural_or_protocol(v, ann_base)
+
+    if isinstance(v, _DynamicArrayAdditions):
+        if not _nominal_or_structural_match(v, ann):
+            return False
+        if isinstance(ann, GenericClass) and ann.get_generics():
+            return value_matches_annotation_set(
+                function_value, v.merge_types_of_iterate(), ann.get_generics()[0], type_var_constraints
+            )
+        return True
+
+    if isinstance(v, TypedDict):
+        for db in iterable.get_dict_branches(v):
+            if not _dict_branch_matches_annotation(function_value, v, db, ann, type_var_constraints):
+                return False
+        return True
+
+    if isinstance(v, TypingTuple):
+        if not _nominal_or_structural_match(v, ann):
+            return False
+        if isinstance(ann, GenericClass) and ann.get_generics():
+            elem_ann_set = ann.get_generics()[0]
+            for seq_b in iterable.get_sequence_branches(v):
+                for pos_item in seq_b:
+                    if not value_matches_annotation_set(
+                        function_value, pos_item.value_set, elem_ann_set, type_var_constraints
+                    ):
+                        return False
+        return True
+
+    if not _nominal_or_structural_match(v, ann):
+        return False
+
+    if isinstance(ann, GenericClass) and ann.get_generics():
+        if not v.is_instance():
+            return False
+        v_ann_cls = v.get_annotated_class_object()
+        for parent_cls in v_ann_cls.py__mro__():
+            if _unwrap_class(parent_cls) == ann_base:
+                return _generics_match(function_value, parent_cls, ann, type_var_constraints)
+        # Matched via structural/protocol (e.g. Iterable, SupportsNext, etc.)
+        ann_name = ann_base.py__name__()
+        if ann_name in ('Iterable', 'Iterator', 'Reversible', 'Collection', 'Sequence', 'Container'):
+            elem_vals = v.merge_types_of_iterate()
+            if not elem_vals:
+                return _is_any_or_unconstrained_typevar(ann.get_generics()[0], type_var_constraints)
+            return value_matches_annotation_set(
+                function_value, elem_vals, ann.get_generics()[0], type_var_constraints
+            )
+        return True
+
+    return True
+
+
+def value_matches_annotation_set(function_value, val_set, ann_set, type_var_constraints, is_init_self=False):
+    if not val_set or not ann_set:
+        return True
+    unwrapped_anns = list(_unwrap_annotations(ann_set))
+    if not unwrapped_anns:
+        return True
+
+    for v in val_set:
+        if not is_init_self and isinstance(
+            v,
+            (
+                iterable.DictLiteralValue,
+                iterable.DictComprehension,
+                iterable.FakeDict,
+                iterable.DictModification,
+            ),
+        ):
+            for db in iterable.get_dict_branches(v):
+                matched_any = False
+                for ann in unwrapped_anns:
+                    tvc_copy = {k: set(s) for k, s in type_var_constraints.items()}
+                    if _dict_branch_matches_annotation(
+                        function_value, v, db, ann, tvc_copy
+                    ):
+                        type_var_constraints.clear()
+                        type_var_constraints.update(tvc_copy)
+                        matched_any = True
+                        break
+                if not matched_any:
+                    return False
+        elif not is_init_self and isinstance(
+            v,
+            (
+                iterable.SequenceLiteralValue,
+                iterable._BaseComprehension,
+                iterable._FakeSequence,
+                iterable.MergedArray,
+                iterable.ListModification,
+            ),
+        ):
+            for seq_b in iterable.get_sequence_branches(v):
+                matched_any = False
+                for ann in unwrapped_anns:
+                    tvc_copy = {k: set(s) for k, s in type_var_constraints.items()}
+                    if _sequence_branch_matches_annotation(
+                        function_value, v, seq_b, ann, tvc_copy
+                    ):
+                        type_var_constraints.clear()
+                        type_var_constraints.update(tvc_copy)
+                        matched_any = True
+                        break
+                if not matched_any:
+                    return False
+        else:
+            matched_any = False
+            for ann in unwrapped_anns:
+                tvc_copy = {k: set(s) for k, s in type_var_constraints.items()}
+                if _single_value_matches_annotation(
+                    function_value, v, ann, tvc_copy, is_init_self=is_init_self
+                ):
+                    type_var_constraints.clear()
+                    type_var_constraints.update(tvc_copy)
+                    matched_any = True
+                    break
+            if not matched_any:
+                return False
+
+    return True
+
