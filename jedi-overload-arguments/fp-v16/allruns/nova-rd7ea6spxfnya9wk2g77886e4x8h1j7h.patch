+_NO_SAFE_VALUE = object()
+
+
+def _get_dict_key_id(v, seen=frozenset()):
+    if v in seen:
+        return None
+    sv = v.get_safe_value(default=_NO_SAFE_VALUE)
+    if sv is not _NO_SAFE_VALUE:
+        try:
+            hash(sv)
+        except TypeError:
+            return None
+        return ('safe', sv)
+    if v.is_compiled() and v.name.string_name == 'None':
+        return ('safe', None)
+    if (isinstance(v, SequenceLiteralValue) and v.array_type == 'tuple') or isinstance(v, FakeTuple):
+        seqs = get_iterable_sequences(v._defining_context if hasattr(v, '_defining_context') else None, v, seen)
+        if len(seqs) == 1:
+            sub_ids = []
+            for elem_set in seqs[0]:
+                if len(elem_set) != 1:
+                    return None
+                sub_id = _get_dict_key_id(next(iter(elem_set)), seen | {v})
+                if sub_id is None:
+                    return None
+                sub_ids.append(sub_id)
+            return ('tuple', tuple(sub_ids))
+        return None
+    if v.is_class() or v.is_function() or v.is_module():
+        return ('obj', v)
+    return None
+
+
+def _keys_could_overlap(k_set1, k_set2):
+    if not k_set1 or not k_set2:
+        return True
+    cls_set1 = _values_to_annotation_classes(k_set1)
+    cls_set2 = _values_to_annotation_classes(k_set2)
+    return any(
+        c1.is_sub_class_of(c2) or c2.is_sub_class_of(c1)
+        for c1 in cls_set1
+        for c2 in cls_set2
+    )
