+def _iterable_container_ann_accepts_value(function_value, ann, v, depth):
+    from jedi.inference.gradual.base import DefineGenericBaseClass
+    from jedi.inference.gradual.typing import Tuple
+    from jedi.inference.value.dynamic_arrays import ListModification
+
+    if v.is_class() or v.is_function() or v.is_module():
+        return False
+    v_cls = _get_value_class(v)
+    if v_cls is None or not v_cls.is_class():
+        return False
+    if not _is_subclass(v_cls, ann._class_value):
+        return False
+
+    gens = ann.get_generics()
+    if not gens:
+        return True
+    elem_ann = gens[0]
+    if not elem_ann:
+        return True
+
+    if isinstance(v, (
+        iterable.SequenceLiteralValue, iterable.ListComprehension,
+        iterable.SetComprehension, iterable.GeneratorComprehension,
+        iterable._FakeSequence, iterable.MergedArray,
+    )) and v.array_type != 'dict':
+        seqs = iterable.get_iterable_sequences(
+            v._defining_context if hasattr(v, '_defining_context') else None,
+            v,
+        )
+        for seq in seqs:
+            for elem_set in seq:
+                if not _annotation_set_accepts_values(function_value, elem_ann, elem_set, depth + 1):
+                    return False
+        return True
+
+    if isinstance(v, ListModification):
+        if not _iterable_container_ann_accepts_value(function_value, ann, v._wrapped_value, depth + 1):
+            return False
+        return _annotation_set_accepts_values(function_value, elem_ann, v._assigned_values, depth + 1)
+
+    if isinstance(v, (iterable.DictLiteralValue, iterable.DictComprehension, iterable.FakeDict)):
+        branches = iterable.get_mapping_branches(
+            v._defining_context if hasattr(v, '_defining_context') else None,
+            v,
+        )
+        for b in branches:
+            if b.invalid:
+                return False
+            for k_set, _, _ in b.known_entries.values():
+                if not _annotation_set_accepts_values(function_value, elem_ann, k_set, depth + 1):
+                    return False
+            for u_k_set, _ in b.unknown_entries:
+                if not _annotation_set_accepts_values(function_value, elem_ann, u_k_set, depth + 1):
+                    return False
+        return True
+
+    if isinstance(v, Tuple):
+        v_gm = v._generics_manager
+        if v._is_homogenous():
+            return _annotation_set_accepts_values(function_value, elem_ann, v_gm.get_index_and_execute(0), depth + 1)
+        for vg in v_gm.to_tuple():
+            if not _annotation_set_accepts_values(function_value, elem_ann, vg.execute_annotation(None), depth + 1):
+                return False
+        return True
+
+    if v.is_compiled():
+        if isinstance(v, compiled.ExactValue) and v.get_safe_value(default=None) in ('', b''):
+            return True
+        if v.py__name__() in ('str', 'bytes'):
+            elem_vals = ValueSet.from_sets(lazy.infer() for lazy in v.py__iter__())
+            if elem_vals:
+                return _annotation_set_accepts_values(function_value, elem_ann, elem_vals, depth + 1)
+        return False
+
+    target_name = ann._class_value.py__name__()
+    for parent_cls in v_cls.py__mro__():
+        if parent_cls.py__name__() == target_name:
+            if isinstance(parent_cls, DefineGenericBaseClass):
+                v_gens = parent_cls.get_generics()
+                if not v_gens or not v_gens[0]:
+                    if v_cls.py__name__() in ('str', 'bytes'):
+                        return _annotation_set_accepts_values(function_value, elem_ann, ValueSet([v]), depth + 1)
+                    return False
+                for vg in v_gens if parent_cls.py__name__() in ('tuple', 'Tuple') and not parent_cls._generics_manager.is_homogenous_tuple() else (v_gens[0],):
+                    if not _annotation_set_accepts_values(function_value, elem_ann, vg.execute_annotation(None), depth + 1):
+                        return False
+                return True
+            elif v_cls.py__name__() in ('str', 'bytes'):
+                return _annotation_set_accepts_values(function_value, elem_ann, ValueSet([v]), depth + 1)
+    return False
