+def _values_to_annotation_classes(value_set):
+    from jedi.inference.gradual.type_var import TypeWrapper
+    from jedi.inference.gradual.conversion import convert_values
+
+    def iterate():
+        for v in value_set:
+            cls = v.py__class__()
+            if cls.is_compiled():
+                converted = convert_values(ValueSet([cls]), prefer_stubs=True)
+                if converted:
+                    cls = next(iter(converted))
+            if v.is_function() or v.is_class():
+                cls = TypeWrapper(cls, v)
+            yield cls
+
+    return ValueSet(iterate())
+
