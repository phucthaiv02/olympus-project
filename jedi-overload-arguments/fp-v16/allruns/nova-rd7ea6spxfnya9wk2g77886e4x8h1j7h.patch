+def _mapping_ann_accepts_value(function_value, ann, v, depth):
+    from jedi.inference.gradual.base import DefineGenericBaseClass
+    from jedi.inference.value.dynamic_arrays import DictModification
+
+    if v.is_class() or v.is_function() or v.is_module():
+        return False
+    v_cls = _get_value_class(v)
+    if v_cls is None or not v_cls.is_class():
+        return False
+    if not _is_subclass(v_cls, ann._class_value):
+        return False
+
+    gens = ann.get_generics()
+    if not gens:
+        return True
+    key_ann = gens[0]
+    val_ann = gens[1] if len(gens) >= 2 else NO_VALUES
+
+    if isinstance(v, (iterable.DictLiteralValue, iterable.DictComprehension, iterable.FakeDict, DictModification)):
+        branches = iterable.get_mapping_branches(
+            v._defining_context if hasattr(v, '_defining_context') else None,
+            v,
+        )
+        for b in branches:
+            if b.invalid:
+                return False
+            for k_set, v_set, _ in b.known_entries.values():
+                if key_ann and not _annotation_set_accepts_values(function_value, key_ann, k_set, depth + 1):
+                    return False
+                if val_ann and not _annotation_set_accepts_values(function_value, val_ann, v_set, depth + 1):
+                    return False
+            for u_k_set, u_v_set in b.unknown_entries:
+                if key_ann and not _annotation_set_accepts_values(function_value, key_ann, u_k_set, depth + 1):
+                    return False
+                if val_ann and not _annotation_set_accepts_values(function_value, val_ann, u_v_set, depth + 1):
+                    return False
+        return True
+
+    if v.is_compiled():
+        return False
+
+    target_name = ann._class_value.py__name__()
+    for parent_cls in v_cls.py__mro__():
+        if parent_cls.py__name__() == target_name or (
+            target_name in ('dict', 'Dict', 'Mapping', 'MutableMapping')
+            and parent_cls.py__name__() in ('dict', 'Dict', 'Mapping', 'MutableMapping')
+        ):
+            if isinstance(parent_cls, DefineGenericBaseClass):
+                v_gens = parent_cls.get_generics()
+                if not v_gens:
+                    return False
+                if key_ann and len(v_gens) >= 1:
+                    if not v_gens[0]:
+                        return False
+                    if not _annotation_set_accepts_values(function_value, key_ann, v_gens[0].execute_annotation(None), depth + 1):
+                        return False
+                if val_ann and len(v_gens) >= 2:
+                    if not v_gens[1]:
+                        return False
+                    if not _annotation_set_accepts_values(function_value, val_ann, v_gens[1].execute_annotation(None), depth + 1):
+                        return False
+                return True
+    return False
