+# -------------------------
+# Dict literals: equal keys, absent keys, **kwargs unpacking
+# -------------------------
+@overload
+def dict_fn(d: dict[int, Bar]) -> int: ...
+@overload
+def dict_fn(d: dict[int, Union[Foo, Bar]]) -> str: ...
+def dict_fn(d):
+    pass
+
+# Later equal key (True == 1) replaces earlier key (1), so value is only Bar
+#? int()
+dict_fn({1: Foo(), True: Bar()})
+
+maybe_bar_dict = {1: Bar()} if cond else {}
+# Entry that may be absent replaces only when present -> value can be Foo or Bar
+#? str()
+dict_fn({1: Foo(), **maybe_bar_dict})
+
+d_override = {"k": Bar()}
+@overload
+def kw_unpack(k: Bar) -> int: ...
+@overload
+def kw_unpack(k: Union[Foo, Bar]) -> str: ...
+def kw_unpack(k):
+    pass
+
+#? int()
+kw_unpack(**{"k": Foo(), **d_override})
+
+maybe_kw_override = {"k": Bar()} if cond else {}
+#? str()
+kw_unpack(**{"k": Foo(), **maybe_kw_override})
