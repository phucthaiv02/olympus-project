+    if isinstance(v, iterable.Slice) and ann.py__name__() == 'slice':
+        return True
+
+    gens = ann.get_generics()
+    if not gens:
+        return True
+
+    target_name = ann._class_value.py__name__()
+    for parent_cls in v_cls.py__mro__():
+        if parent_cls.py__name__() == target_name:
+            if isinstance(parent_cls, DefineGenericBaseClass):
+                v_gens = parent_cls.get_generics()
+                if not v_gens:
+                    return False
+                for ann_g, val_g in zip(gens, v_gens):
