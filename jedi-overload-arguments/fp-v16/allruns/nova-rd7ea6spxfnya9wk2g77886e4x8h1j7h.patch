+class DictBranch:
+    def __init__(self, known_entries=None, unknown_entries=None, invalid=False):
+        # known_entries: dict[key_id, (key_value_set, val_value_set, may_be_absent)]
+        self.known_entries = dict(known_entries) if known_entries else {}
+        # unknown_entries: list[(key_value_set, val_value_set)]
+        self.unknown_entries = list(unknown_entries) if unknown_entries else []
+        self.invalid = invalid
+
+    def copy(self):
+        return DictBranch(self.known_entries, self.unknown_entries, self.invalid)
+
+    def iter_key_sequences(self):
+        req_keys = []
+        opt_indices = []
+        all_items = []
+        for k_set, v_set, is_absent in self.known_entries.values():
+            if is_absent:
+                opt_indices.append(len(all_items))
+            else:
+                req_keys.append(k_set)
+            all_items.append((k_set, is_absent))
+        unknown_k = tuple(uk for uk, uv in self.unknown_entries)
+        if not opt_indices:
+            yield tuple(req_keys) + unknown_k
+            return
+        if len(opt_indices) <= 4:
+            import itertools
+            for mask in itertools.product((False, True), repeat=len(opt_indices)):
+                chosen = set(idx for idx, inc in zip(opt_indices, mask) if inc)
+                seq = tuple(
+                    k_set for i, (k_set, is_absent) in enumerate(all_items)
+                    if not is_absent or i in chosen
+                ) + unknown_k
+                yield seq
+        else:
+            yield tuple(req_keys) + unknown_k
+            yield tuple(k_set for k_set, _ in all_items) + unknown_k
+
+
+def _set_or_merge_known_entry(branch, key_id, k_set, v_set, may_be_absent):
+    if not may_be_absent:
+        branch.known_entries[key_id] = (k_set, v_set, False)
+    else:
+        if key_id in branch.known_entries:
+            old_k, old_v, old_absent = branch.known_entries[key_id]
+            branch.known_entries[key_id] = (old_k | k_set, old_v | v_set, old_absent)
+        else:
+            branch.known_entries[key_id] = (k_set, v_set, True)
+
+
+def _add_unknown_entry_to_branch(branch, u_k_set, u_v_set):
+    for kid, (old_k_set, old_v_set, old_absent) in list(branch.known_entries.items()):
+        if _keys_could_overlap(old_k_set, u_k_set):
+            branch.known_entries[kid] = (old_k_set, old_v_set | u_v_set, old_absent)
+    branch.unknown_entries.append((u_k_set, u_v_set))
+
+
+def _add_pair_to_dict_branches(branches, key_set, val_set, is_absent=False, max_branches=32):
+    grouped_known = {}
+    unknown_keys = []
+    for k in key_set:
+        kid = _get_dict_key_id(k)
+        if kid is not None:
+            if kid in grouped_known:
+                grouped_known[kid] |= ValueSet([k])
+            else:
+                grouped_known[kid] = ValueSet([k])
+        else:
+            unknown_keys.append(k)
+    unknown_key_set = ValueSet(unknown_keys)
+
+    if not grouped_known and not unknown_key_set:
+        for b in branches:
+            b.unknown_entries.append((NO_VALUES, val_set))
+        return branches
+
+    num_choices = len(grouped_known) + (1 if unknown_key_set else 0)
+    if num_choices == 1 and grouped_known:
+        kid, k_sub_set = next(iter(grouped_known.items()))
+        for b in branches:
+            _set_or_merge_known_entry(b, kid, k_sub_set, val_set, is_absent)
+        return branches
+    if num_choices == 1 and unknown_key_set:
+        for b in branches:
+            _add_unknown_entry_to_branch(b, unknown_key_set, val_set)
+        return branches
+
+    total_choices = num_choices + (1 if is_absent else 0)
+    if len(branches) * total_choices <= max_branches:
+        new_branches = []
+        for b in branches:
+            for kid, k_sub_set in grouped_known.items():
+                nb = b.copy()
+                _set_or_merge_known_entry(nb, kid, k_sub_set, val_set, False)
+                new_branches.append(nb)
+            if unknown_key_set:
+                nb = b.copy()
+                _add_unknown_entry_to_branch(nb, unknown_key_set, val_set)
+                new_branches.append(nb)
+            if is_absent:
+                new_branches.append(b.copy())
+        return new_branches
+    else:
+        for b in branches:
+            for kid, k_sub_set in grouped_known.items():
+                _set_or_merge_known_entry(b, kid, k_sub_set, val_set, True)
+            if unknown_key_set:
+                _add_unknown_entry_to_branch(b, unknown_key_set, val_set)
+        return branches
+
+
+def _apply_dict_branch(base_branch, d_branch):
+    nb = base_branch.copy()
+    if d_branch.invalid:
+        nb.invalid = True
+    for kid, (k_set, v_set, is_absent) in d_branch.known_entries.items():
+        _set_or_merge_known_entry(nb, kid, k_set, v_set, is_absent)
+    for u_k_set, u_v_set in d_branch.unknown_entries:
+        _add_unknown_entry_to_branch(nb, u_k_set, u_v_set)
+    return nb
+
