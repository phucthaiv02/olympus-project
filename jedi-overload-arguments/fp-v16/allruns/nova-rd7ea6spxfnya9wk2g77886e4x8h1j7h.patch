+                    for kid, (k_set, v_set, is_absent) in b.known_entries.items():
+                        if kid[0] == 'safe' and isinstance(kid[1], str):
+                            pair = (kid[1], LazyKnownValues(v_set))
+                            if is_absent:
+                                opt_kw.append(pair)
+                            else:
+                                req_kw.append(pair)
+                        else:
+                            if not is_absent:
+                                branch_invalid = True
+                                break
+                    if branch_invalid:
+                        kw_branches.append(((), (), True))
+                        continue
+                    for u_k_set, u_v_set in b.unknown_entries:
+                        dyn_kw.append((LazyKnownValues(u_k_set), LazyKnownValues(u_v_set)))
+                    if not opt_kw:
+                        kw_branches.append((tuple(req_kw), tuple(dyn_kw), False))
+                    elif len(opt_kw) <= 4:
+                        for mask in itertools.product((False, True), repeat=len(opt_kw)):
+                            chosen = tuple(p for p, inc in zip(opt_kw, mask) if inc)
+                            kw_branches.append((tuple(req_kw) + chosen, tuple(dyn_kw), False))
+                    else:
+                        kw_branches.append((tuple(req_kw), tuple(dyn_kw), False))
+                        kw_branches.append((tuple(req_kw) + tuple(opt_kw), tuple(dyn_kw), False))
+            if not kw_branches:
+                continue
+            new_configs = []
+            for c in configs:
+                for b_kw, b_dyn, is_inv in kw_branches:
+                    new_configs.append(CallConfig(
+                        pos_args=c.pos_args,
+                        kw_args=c.kw_args + b_kw,
+                        dynamic_pos=c.dynamic_pos,
+                        dynamic_kw=c.dynamic_kw + b_dyn,
+                        invalid=c.invalid or is_inv,
+                    ))
+            if len(new_configs) > max_configs:
+                new_configs = new_configs[:max_configs]
+            configs = new_configs
+
+    return configs or [CallConfig()]
+
+
+def _bind_config_to_params(function_value, config):
+    if config.invalid:
+        return None
+    funcdef = function_value.tree_node
+    params = funcdef.get_params()
+    param_names = function_value.get_param_names()
+
+    pos_indices = []
+    kw_map = {}
+    var_pos_idx = None
+    var_kw_idx = None
+
+    for idx, (p, pn) in enumerate(zip(params, param_names)):
+        kind = pn.get_kind()
+        if kind == Parameter.POSITIONAL_ONLY:
+            pos_indices.append(idx)
+        elif kind == Parameter.POSITIONAL_OR_KEYWORD:
+            pos_indices.append(idx)
+            kw_map[p.name.value] = idx
+        elif kind == Parameter.VAR_POSITIONAL:
+            var_pos_idx = idx
+        elif kind == Parameter.KEYWORD_ONLY:
+            kw_map[p.name.value] = idx
+        elif kind == Parameter.VAR_KEYWORD:
+            var_kw_idx = idx
+
+    bound_normal = {}
+    var_pos_args = []
+    var_kw_args = []
+
+    if len(config.pos_args) <= len(pos_indices):
+        for i, lazy_val in enumerate(config.pos_args):
+            bound_normal[pos_indices[i]] = lazy_val
+    else:
+        if var_pos_idx is None:
+            return None
+        for i, p_idx in enumerate(pos_indices):
+            bound_normal[p_idx] = config.pos_args[i]
+        var_pos_args.extend(config.pos_args[len(pos_indices):])
+
+    if config.dynamic_pos:
+        if var_pos_idx is not None:
+            var_pos_args.extend(config.dynamic_pos)
+            if len(config.pos_args) < len(pos_indices):
+                merged_dyn = get_merged_lazy_value(list(config.dynamic_pos))
+                for i in range(len(config.pos_args), len(pos_indices)):
+                    p_idx = pos_indices[i]
+                    if params[p_idx].default is None:
+                        bound_normal[p_idx] = merged_dyn
+        else:
+            if len(config.pos_args) >= len(pos_indices):
+                return None
+            merged_dyn = get_merged_lazy_value(list(config.dynamic_pos))
+            for i in range(len(config.pos_args), len(pos_indices)):
+                bound_normal[pos_indices[i]] = merged_dyn
+
+    for k_str, lazy_val in config.kw_args:
+        if k_str in kw_map:
+            p_idx = kw_map[k_str]
+            if p_idx in bound_normal:
+                return None
+            bound_normal[p_idx] = lazy_val
+        else:
+            if var_kw_idx is None:
+                return None
+            var_kw_args.append((None, k_str, lazy_val))
+
+    if config.dynamic_kw:
+        unbound_kw_indices = [idx for idx in kw_map.values() if idx not in bound_normal]
+        if var_kw_idx is None and not unbound_kw_indices:
+            return None
+        if var_kw_idx is not None:
+            for k_lazy, v_lazy in config.dynamic_kw:
+                var_kw_args.append((k_lazy, None, v_lazy))
+        if unbound_kw_indices:
+            merged_kw_val = get_merged_lazy_value([v_lazy for _, v_lazy in config.dynamic_kw])
+            for idx in unbound_kw_indices:
+                if params[idx].default is None:
+                    bound_normal[idx] = merged_kw_val
+
+    for idx, (p, pn) in enumerate(zip(params, param_names)):
+        if pn.get_kind() in (Parameter.VAR_POSITIONAL, Parameter.VAR_KEYWORD):
+            continue
+        if idx not in bound_normal and p.default is None:
+            return None
+
+    return bound_normal, var_pos_args, var_kw_args
+
+
+def matches_call_signature(function_value, arguments):
+    configs = expand_call_arguments(arguments)
+    if not configs:
+        return False
+    return all(_config_matches_function(function_value, c) for c in configs)
+
+
+def _config_matches_function(function_value, config):
+    bound = _bind_config_to_params(function_value, config)
+    if bound is None:
+        return False
+    bound_normal, var_pos_args, var_kw_args = bound
+    param_names = function_value.get_param_names()
+
+    if config.dynamic_kw:
+        str_cls = compiled.builtin_from_name(function_value.inference_state, 'str')
+        str_ann = ValueSet([str_cls])
+        for k_lazy, _ in config.dynamic_kw:
+            if not _annotation_set_accepts_values(function_value, str_ann, k_lazy.infer()):
+                return False
+
+    for idx, lazy_val in bound_normal.items():
+        pn = param_names[idx]
+        ann_set = pn.infer_annotation(execute_annotation=False, ignore_stars=True)
+        if not ann_set:
+            continue
+        val_set = lazy_val.infer()
+        if not _annotation_set_accepts_values(function_value, ann_set, val_set):
+            return False
+
+    for idx, pn in enumerate(param_names):
+        kind = pn.get_kind()
+        if kind == Parameter.VAR_POSITIONAL and var_pos_args:
+            ann_set = pn.infer_annotation(execute_annotation=False, ignore_stars=True)
+            if ann_set:
+                for arg_lazy in var_pos_args:
+                    if not _annotation_set_accepts_values(function_value, ann_set, arg_lazy.infer()):
+                        return False
+        elif kind == Parameter.VAR_KEYWORD and var_kw_args:
+            ann_set = pn.infer_annotation(execute_annotation=False, ignore_stars=True)
+            if ann_set:
+                for _, _, arg_lazy in var_kw_args:
+                    if not _annotation_set_accepts_values(function_value, ann_set, arg_lazy.infer()):
+                        return False
+
+    return True
+
+
+def _unwrap_class(cls):
+    from jedi.inference.gradual.base import GenericClass
+    from jedi.plugins.stdlib import TupleClassWrapper, TypeClassWrapper
+    while isinstance(cls, (GenericClass, TupleClassWrapper, TypeClassWrapper)):
+        if isinstance(cls, GenericClass):
+            cls = cls._class_value
+        else:
+            cls = cls._wrapped_value
+    return cls
+
+
+def _to_stub_class(cls):
+    cls = _unwrap_class(cls)
+    if cls.is_compiled() and cls.is_class():
+        from jedi.inference.gradual.conversion import convert_values
+        converted = convert_values(ValueSet([cls]), prefer_stubs=True)
+        if converted:
+            return _unwrap_class(next(iter(converted)))
+    return cls
+
+
+def _is_subclass(sub_cls, super_cls):
+    sub_c = _to_stub_class(sub_cls)
+    super_c = _to_stub_class(super_cls)
+    if sub_c.is_sub_class_of(super_c):
+        return True
+    for cls in sub_c.py__mro__():
+        if _unwrap_class(cls).is_same_class(super_c):
+            return True
+    u_sub = _unwrap_class(sub_cls)
+    u_super = _unwrap_class(super_cls)
+    if u_sub != sub_c or u_super != super_c:
+        for cls in u_sub.py__mro__():
+            if _unwrap_class(cls).is_same_class(u_super):
+                return True
+    return False
+
+
+def _is_none_value(v):
+    if v.is_compiled() and v.name.string_name == 'None':
+        return True
+    if v.is_instance() and v.py__name__() == 'NoneType':
+        return True
+    if v.is_class() and v.py__name__() == 'NoneType':
+        return True
+    return False
+
+
+def _is_any_annotation(ann):
+    from jedi.inference.gradual.typing import AnyClass
+    return isinstance(ann, AnyClass)
+
+
+def _is_object_class(ann):
+    return (
+        ann.is_class()
+        and ann.py__name__() == 'object'
+        and ann.get_root_context().is_builtins_module()
+    )
+
+
+def _is_type_annotation(ann):
+    from jedi.inference.gradual.base import GenericClass
+    from jedi.inference.gradual.typing import ProxyTypingClassValue, TypingClassWithGenerics, TypeAlias
+    from jedi.plugins.stdlib import TypeClassWrapper
+    if isinstance(ann, TypeClassWrapper):
+        return True
+    if isinstance(ann, TypeAlias) and ann._actual == 'builtins.type':
+        return True
+    if isinstance(ann, (ProxyTypingClassValue, TypingClassWithGenerics)) and ann.py__name__() == 'Type':
+        return True
+    if isinstance(ann, GenericClass) and ann.py__name__() == 'type':
+        return True
+    if ann.is_class() and ann.py__name__() == 'type' and ann.get_root_context().is_builtins_module():
+        return True
+    return False
+
+
+def _get_type_annotation_generics(ann):
+    from jedi.inference.gradual.base import DefineGenericBaseClass
+    if isinstance(ann, DefineGenericBaseClass):
+        gens = ann.get_generics()
+        if gens:
+            return gens[0]
+    return NO_VALUES
+
+
+def _class_ann_set_accepts_class(function_value, inner_ann_set, target_cls, depth=0):
+    if depth > 12:
+        return True
+    if not inner_ann_set:
+        return True
+    return any(
+        _single_class_ann_accepts_class(function_value, ann, target_cls, depth)
+        for ann in inner_ann_set
+    )
+
+
+def _single_class_ann_accepts_class(function_value, ann, target_cls, depth=0):
+    from jedi.inference.gradual.type_var import TypeVar, TypeWrapper
+    from jedi.inference.gradual.typing import ProxyWithGenerics, TypeAlias
+    from jedi.inference.gradual.base import GenericClass
+
+    if _is_any_annotation(ann) or _is_object_class(ann):
+        return True
+    if isinstance(ann, TypeWrapper):
+        ann = ann._original_value
+    if isinstance(ann, TypeAlias):
+        ann = ann._get_wrapped_value()
+    if isinstance(ann, TypeVar):
+        if ann._bound_lazy_value is not None:
+            bound_set = ann._bound_lazy_value.infer()
+            return _class_ann_set_accepts_class(function_value, bound_set, target_cls, depth + 1)
+        if ann._constraints_lazy_values:
+            return any(
+                _class_ann_set_accepts_class(function_value, lazy.infer(), target_cls, depth + 1)
+                for lazy in ann._constraints_lazy_values
+            )
+        return True
+    if isinstance(ann, ProxyWithGenerics):
+        ann_name = ann.py__name__()
+        gens = ann.get_generics()
+        if ann_name == 'Optional' and target_cls.py__name__() == 'NoneType':
+            return True
+        if ann_name in ('Union', 'Optional'):
+            return any(
+                _class_ann_set_accepts_class(function_value, g_set, target_cls, depth + 1)
+                for g_set in gens
+            )
+        for c in ann.gather_annotation_classes():
+            if c != ann and _single_class_ann_accepts_class(function_value, c, target_cls, depth + 1):
+                return True
+        return False
+    if _is_none_value(ann):
+        return target_cls.py__name__() == 'NoneType'
+    if isinstance(ann, GenericClass):
+        return _is_subclass(target_cls, ann._class_value)
+    if ann.is_class():
+        return _is_subclass(target_cls, ann)
+    return False
+
+
+def _annotation_set_accepts_values(function_value, ann_set, val_set, depth=0):
+    if depth > 12:
+        return True
+    if not ann_set or not val_set:
+        return True
+    for v in val_set:
+        if not any(_single_ann_accepts_value(function_value, ann, v, depth) for ann in ann_set):
+            return False
+    return True
+
+
+def _callable_ann_accepts_value(function_value, gens, v, depth):
+    if not (v.is_function() or v.is_class() or bool(v.py__getattribute__('__call__'))):
+        return False
+    if len(gens) == 2 and gens[1]:
+        ret_vals = ValueSet([v]).execute_annotation(None)
+        if ret_vals:
+            return _annotation_set_accepts_values(function_value, gens[1], ret_vals, depth + 1)
+    return True
+
+
+def _single_ann_accepts_value(function_value, ann, v, depth=0):
+    from jedi.inference.gradual.type_var import TypeVar, TypeWrapper
+    from jedi.inference.gradual.typing import ProxyWithGenerics, ProxyTypingValue, \
+        ProxyTypingClassValue, TypeAlias, Tuple, Callable, NewType
+    from jedi.inference.gradual.base import GenericClass, _GenericInstanceWrapper
+    from jedi.inference.value.dynamic_arrays import _DynamicArrayAdditions
+
+    if depth > 12:
+        return True
+    if isinstance(v, _DynamicArrayAdditions):
+        return True
+    if _is_any_annotation(ann) or _is_object_class(ann):
+        return True
+    if _is_any_annotation(v):
+        return True
+
+    if isinstance(ann, TypeWrapper):
+        ann = ann._original_value
+    if isinstance(v, TypeWrapper):
+        v = v._original_value
+
+    if isinstance(ann, NewType):
+        return _annotation_set_accepts_values(function_value, ann._type_value_set, ValueSet([v]), depth + 1)
+
+    if isinstance(ann, TypeVar):
+        if ann._bound_lazy_value is not None:
+            bound_set = ann._bound_lazy_value.infer()
+            return _annotation_set_accepts_values(function_value, bound_set, ValueSet([v]), depth + 1)
+        if ann._constraints_lazy_values:
+            return any(
+                _annotation_set_accepts_values(function_value, lazy.infer(), ValueSet([v]), depth + 1)
+                for lazy in ann._constraints_lazy_values
+            )
+        return True
+
+    if _is_none_value(ann):
+        return _is_none_value(v)
+
+    if _is_type_annotation(ann):
+        inner_ann_set = _get_type_annotation_generics(ann)
+        if v.is_class():
+            return _class_ann_set_accepts_class(function_value, inner_ann_set, v, depth + 1)
+        if v.is_instance():
+            v_cls = _get_value_class(v)
+            if v_cls is not None and v_cls.py__name__() == 'type':
+                if not inner_ann_set or any(_is_any_annotation(a) or _is_object_class(a) for a in inner_ann_set):
+                    return True
+        return False
+
+    if isinstance(ann, TypeAlias):
+        ann = ann._get_wrapped_value()
+
+    if isinstance(ann, ProxyWithGenerics):
+        ann_name = ann.py__name__()
+        gens = ann.get_generics()
+        if ann_name == 'Optional' and _is_none_value(v):
+            return True
+        if ann_name in ('Union', 'Optional'):
+            return any(
+                _annotation_set_accepts_values(function_value, g_set, ValueSet([v]), depth + 1)
+                for g_set in gens
+            )
+        if ann_name in ('Annotated', 'Final', 'ClassVar', 'Required', 'NotRequired', 'ReadOnly'):
+            if gens:
+                return _annotation_set_accepts_values(function_value, gens[0], ValueSet([v]), depth + 1)
+            return True
+        if ann_name == 'Literal':
+            return _literal_ann_accepts_value(gens, v)
+        if ann_name == 'Tuple':
+            return _tuple_ann_accepts_value(function_value, ann, v, depth)
+        if ann_name == 'Callable':
+            return _callable_ann_accepts_value(function_value, gens, v, depth)
+        executed = ann.execute_annotation(None)
+        if executed:
+            for ex in executed:
+                if isinstance(ex, _GenericInstanceWrapper):
+                    ex_cls = ex.get_annotated_class_object()
+                    if _single_ann_accepts_value(function_value, ex_cls, v, depth + 1):
+                        return True
+                elif isinstance(ex, (Tuple, Callable)):
+                    if _single_ann_accepts_value(function_value, ex, v, depth + 1):
+                        return True
+            return False
+        for c in ann.gather_annotation_classes():
+            if c != ann and _single_ann_accepts_value(function_value, c, v, depth + 1):
+                return True
+        return False
+
+    if isinstance(ann, (ProxyTypingValue, ProxyTypingClassValue)):
+        ann_name = ann.py__name__()
+        if ann_name in ('Union', 'Optional', 'Any', 'Annotated', 'Final', 'ClassVar'):
+            return True
+        if ann_name == 'Tuple':
+            return _is_value_instance_of_named_class(v, 'tuple')
+        if ann_name == 'Callable':
+            return _callable_ann_accepts_value(function_value, (), v, depth)
+        for c in ann.gather_annotation_classes():
+            if c != ann and _single_ann_accepts_value(function_value, c, v, depth + 1):
+                return True
+        return False
+
+    if isinstance(ann, Tuple):
+        return _tuple_ann_accepts_value(function_value, ann._class_value, v, depth)
+
+    if isinstance(ann, Callable):
+        return _callable_ann_accepts_value(function_value, ann._class_value.get_generics(), v, depth)
+
+    if isinstance(ann, GenericClass):
+        ann_name = ann.py__name__()
+        if ann_name == 'Callable':
+            return _callable_ann_accepts_value(function_value, ann.get_generics(), v, depth)
+        if ann_name in ('tuple', 'Tuple'):
+            return _tuple_ann_accepts_value(function_value, ann, v, depth)
+        if ann_name in (
+            'dict', 'Dict', 'Mapping', 'MutableMapping',
+            'defaultdict', 'DefaultDict', 'OrderedDict', 'ChainMap', 'Counter',
+        ):
+            return _mapping_ann_accepts_value(function_value, ann, v, depth)
+        if ann_name in (
+            'list', 'List', 'set', 'Set', 'frozenset', 'FrozenSet',
+            'Sequence', 'MutableSequence', 'AbstractSet', 'MutableSet',
+            'Iterable', 'Collection', 'Reversible', 'Container', 'Deque', 'deque',
+        ):
+            return _iterable_container_ann_accepts_value(function_value, ann, v, depth)
+        return _generic_class_ann_accepts_value(function_value, ann, v, depth)
+
+    if ann.is_class():
+        if v.is_class() or v.is_function() or v.is_module():
+            # A class, function, or module is only an instance of `type`, `object`, `Callable`, etc.
+            v_cls = v.py__class__()
+            return _is_subclass(v_cls, ann)
+        v_cls = _get_value_class(v)
+        if v_cls is None:
+            return False
+        return _is_subclass(v_cls, ann)
+
+    return False
+
+
+def _get_value_class(v):
+    from jedi.inference.gradual.typing import Tuple
+    if isinstance(v, Tuple):
+        return compiled.builtin_from_name(v.inference_state, 'tuple')
+    if v.is_instance():
+        if not v.is_compiled() and hasattr(v, 'get_annotated_class_object'):
+            cls = v.get_annotated_class_object()
+            if cls is not None and cls.is_class():
+                return cls
+        return v.py__class__()
+    if hasattr(v, 'py__class__'):
+        return v.py__class__()
+    return None
+
+
+def _is_value_instance_of_named_class(v, class_name):
+    if v.is_class() or v.is_function() or v.is_module():
+        return False
+    v_cls = _get_value_class(v)
+    if v_cls is None or not v_cls.is_class():
+        return False
+    for parent in v_cls.py__mro__():
+        if parent.py__name__() == class_name:
+            return True
+    return False
+
+
+_NO_SAFE_VALUE = object()
+
+
+def _literal_ann_accepts_value(gens, v):
+    v_safe = v.get_safe_value(default=_NO_SAFE_VALUE)
+    if v_safe is _NO_SAFE_VALUE:
+        return False
+    for g_set in gens:
+        for g in g_set:
+            g_safe = g.get_safe_value(default=_NO_SAFE_VALUE)
+            if g_safe is not _NO_SAFE_VALUE and type(v_safe) is type(g_safe) and v_safe == g_safe:
+                return True
+    return False
+
+
+def _tuple_ann_accepts_value(function_value, ann, v, depth):
+    from jedi.inference.gradual.typing import Tuple
+    from jedi.inference.gradual.base import DefineGenericBaseClass
+
+    if v.is_class() or v.is_function() or v.is_module():
+        return False
+    v_cls = _get_value_class(v)
+    if v_cls is None or not v_cls.is_class():
+        return False
+    tuple_cls = compiled.builtin_from_name(function_value.inference_state, 'tuple')
+    if not _is_subclass(v_cls, tuple_cls):
+        return False
+
+    gm = ann._generics_manager
+    gens = gm.to_tuple()
+    is_homogenous = gm.is_homogenous_tuple()
+    is_empty_tuple_ann = (
+        len(gens) == 0
+        or (
+            len(gens) == 1
+            and len(gens[0]) == 1
+            and isinstance(next(iter(gens[0])), iterable.SequenceLiteralValue)
+            and next(iter(gens[0])).array_type == 'tuple'
+            and len(next(iter(gens[0])).get_raw_sequence_entries()) == 0
+        )
+    )
+
+    if isinstance(v, (iterable.SequenceLiteralValue, iterable._FakeSequence)) and v.array_type == 'tuple':
+        seqs = iterable.get_iterable_sequences(
+            v._defining_context if hasattr(v, '_defining_context') else None,
+            v,
+        )
+        for seq in seqs:
+            if is_empty_tuple_ann:
+                if len(seq) != 0:
+                    return False
+            elif is_homogenous:
+                elem_ann = gens[0]
+                for elem_set in seq:
+                    if not _annotation_set_accepts_values(function_value, elem_ann, elem_set, depth + 1):
+                        return False
+            else:
+                if len(seq) != len(gens):
+                    return False
+                for elem_ann, elem_set in zip(gens, seq):
+                    if not _annotation_set_accepts_values(function_value, elem_ann, elem_set, depth + 1):
+                        return False
+        return True
+
+    if isinstance(v, Tuple):
+        v_gm = v._generics_manager
+        v_gens = v_gm.to_tuple()
+        if v._is_homogenous():
+            if is_empty_tuple_ann:
+                return False
+            if is_homogenous:
+                elem_vals = v_gm.get_index_and_execute(0)
+                return _annotation_set_accepts_values(function_value, gens[0], elem_vals, depth + 1)
+            return False
+        else:
+            if is_empty_tuple_ann:
+                return len(v_gens) == 0
+            if is_homogenous:
+                for vg in v_gens:
+                    if not _annotation_set_accepts_values(function_value, gens[0], vg.execute_annotation(None), depth + 1):
+                        return False
+                return True
+            if len(v_gens) != len(gens):
+                return False
+            for elem_ann, vg in zip(gens, v_gens):
+                if not _annotation_set_accepts_values(function_value, elem_ann, vg.execute_annotation(None), depth + 1):
+                    return False
+            return True
+
+    for parent_cls in v_cls.py__mro__():
+        if parent_cls.py__name__() in ('tuple', 'Tuple'):
+            if isinstance(parent_cls, DefineGenericBaseClass):
+                v_gm = parent_cls._generics_manager
+                v_gens = v_gm.to_tuple()
+                if not v_gens:
+                    return is_empty_tuple_ann
+                if v_gm.is_homogenous_tuple():
+                    if is_empty_tuple_ann:
+                        return False
+                    if is_homogenous:
+                        elem_vals = v_gm.get_index_and_execute(0)
+                        return _annotation_set_accepts_values(function_value, gens[0], elem_vals, depth + 1)
+                    return False
+                else:
+                    if is_empty_tuple_ann:
+                        return len(v_gens) == 0
+                    if is_homogenous:
+                        for vg in v_gens:
+                            if not _annotation_set_accepts_values(function_value, gens[0], vg.execute_annotation(None), depth + 1):
+                                return False
+                        return True
+                    if len(v_gens) != len(gens):
+                        return False
+                    for elem_ann, vg in zip(gens, v_gens):
+                        if not _annotation_set_accepts_values(function_value, elem_ann, vg.execute_annotation(None), depth + 1):
+                            return False
+                    return True
+            else:
+                return False
+    return False
