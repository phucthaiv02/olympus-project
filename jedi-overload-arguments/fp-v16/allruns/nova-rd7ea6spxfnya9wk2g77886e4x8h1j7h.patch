+@overload
+def by_type_bound(x: type[TBar]) -> TBar: ...
+def by_type_bound(x):
+    pass
+
+#? FooSub()
+by_type_bound(FooSub)
+#? Bar()
+by_type_bound(Bar)
+
+@overload
+def by_constr(x: TConstr) -> TConstr: ...
+@overload
+def by_constr(x: Baz) -> str: ...
+def by_constr(x):
+    pass
+
+#? Foo()
+by_constr(Foo())
+#? Bar()
+by_constr(Bar())
+#? str()
+by_constr(Baz())
+
+# -------------------------
+# Optional, Union, and multiple values
+# -------------------------
+cond: bool
+foo_or_none: Optional[Foo]
+foo_or_bar = Foo() if cond else Bar()
+
+@overload
+def opt_fn(x: Foo) -> int: ...
+@overload
+def opt_fn(x: Optional[Foo]) -> str: ...
+def opt_fn(x):
+    pass
+
+#? int()
+opt_fn(Foo())
+#? str()
+opt_fn(None)
+#? str()
+opt_fn(foo_or_none)
+
+@overload
+def union_fn(x: Foo) -> int: ...
+@overload
+def union_fn(x: Bar) -> str: ...
+@overload
+def union_fn(x: Union[Foo, Bar]) -> float: ...
+def union_fn(x):
+    pass
+
+#? int()
+union_fn(Foo())
+#? str()
+union_fn(Bar())
+#? float()
+union_fn(foo_or_bar)
+
+# -------------------------
+# *args and **kwargs annotations
+# -------------------------
+@overload
+def varargs_fn(*args: Foo, **kwargs: Bar) -> int: ...
+@overload
+def varargs_fn(*args: Union[Foo, Bar], **kwargs: Union[Bar, Baz]) -> str: ...
+def varargs_fn(*args, **kwargs):
+    pass
+
+#? int()
+varargs_fn(Foo(), FooSub(), a=Bar())
+#? str()
+varargs_fn(Foo(), Bar(), a=Bar())
+#? str()
+varargs_fn(Foo(), a=Bar(), b=Baz())
+
+# -------------------------
+# Containers & literal unpacking
+# -------------------------
+@overload
+def tuple_fn(x: tuple[Foo, Bar]) -> int: ...
+@overload
+def tuple_fn(x: tuple[()]) -> bytes: ...
+@overload
+def tuple_fn(x: tuple[Foo, ...]) -> str: ...
+def tuple_fn(x):
+    pass
+
+#? int()
+tuple_fn((Foo(), Bar()))
+#? str()
+tuple_fn((Foo(), FooSub(), Foo()))
+#? bytes()
+tuple_fn(())
+
+b_foos = [FooSub()]
+#? str()
+tuple_fn((Foo(), *b_foos))
+#? int()
+tuple_fn((*[Foo()], *[Bar()]))
+
+@overload
+def unpack_pos(a: Foo, b: Foo) -> int: ...
+@overload
+def unpack_pos(a: Foo, b: Bar) -> str: ...
+@overload
+def unpack_pos(a: Union[Foo, Baz], b: Baz) -> float: ...
+def unpack_pos(a, b):
+    pass
+
+#? int()
+unpack_pos(*[Foo(), *b_foos])
+#? str()
+unpack_pos(*[Foo(), *[Bar()]])
+
+xs_cond = [Foo()] if cond else []
+#? int() str() float()
+unpack_pos(*xs_cond, Baz())
+
+@overload
+def unpack_cond_ok(a: Foo, b: Baz) -> int: ...
+@overload
+def unpack_cond_ok(a: Union[Foo, Baz], b: Baz = Baz()) -> str: ...
+def unpack_cond_ok(a, b=Baz()):
+    pass
+
+#? str()
+unpack_cond_ok(*xs_cond, Baz())
