+# -------------------------
+# Empty literal comprehensions
+# -------------------------
+@overload
+def comp_fn(x: list[Foo]) -> int: ...
+@overload
+def comp_fn(x: list[Union[Foo, Bar]]) -> str: ...
+def comp_fn(x):
+    pass
+
+# Comprehension over empty literal [] has no elements, so it matches list[Foo]
+#? int()
+comp_fn([Bar() for _ in []])
+#? str()
+comp_fn([Bar() for _ in [1]])
+
+@overload
+def comp_unpack(a: Foo) -> int: ...
+@overload
+def comp_unpack(a: Bar, b: Foo) -> str: ...
+def comp_unpack(*args):
+    pass
+
+#? int()
+comp_unpack(*[Bar() for _ in ()], Foo())
