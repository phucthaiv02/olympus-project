+def _combine_sequences(seqs1, seqs2, max_branches=32):
+    if not seqs1:
+        return list(seqs2)
+    if not seqs2:
+        return list(seqs1)
+    combined = []
+    for s1 in seqs1:
+        for s2 in seqs2:
+            c = s1 + s2
+            if c not in combined:
+                combined.append(c)
+    if len(combined) > max_branches:
+        by_len = {}
+        for seq in combined:
+            by_len.setdefault(len(seq), []).append(seq)
+        combined = [
+            tuple(ValueSet.from_sets(s[i] for s in group) for i in range(length))
+            for length, group in by_len.items()
+        ]
+    return combined
+
+
+def _comp_for_has_if(comp_for):
+    last = comp_for.children[-1]
+    while last.type == 'comp_if':
+        return True
+    return False
