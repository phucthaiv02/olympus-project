+from textwrap import dedent
+
+import pytest
+
+
+_PREAMBLE = dedent('''\
+    from typing import Any, Callable, Dict, List, Optional, Tuple, Type, TypeVar, Union, overload
+
+    class A:
+        pass
+
+    class B(A):
+        pass
+
+    class C:
+        pass
+
+    condition: bool
+
+    T = TypeVar('T')
+    Bound = TypeVar('Bound', bound=A)
+''')
+
+
+def _infer_overload(Script, first, second, call, setup=''):
+    source = _PREAMBLE + dedent('''\
+        @overload
+        def f(%s) -> int: ...
+        @overload
+        def f(%s) -> str: ...
+    ''') % (first, second)
+    source += setup + '\nf(' + call + ')'
+    return {value.name for value in Script(source).infer()}
+
+
+@pytest.mark.parametrize(('first', 'second', 'call', 'expected'), [
+    ('x: type[A]', 'x: type[C]', 'A', {'int'}),
+    ('x: Type[A]', 'x: Type[C]', 'C', {'str'}),
+    ('x: type[A]', 'x: type[C]', 'B', {'int'}),
+    ('x: type[A]', 'x: type[C]', 'x=A', {'int'}),
+    ('x: type[A]', 'x: type[C]', 'x=C', {'str'}),
+    ('x: type[A]', 'x: type[C]', 'A()', {'int', 'str'}),
+    ('x: A', 'x: C', 'A()', {'int'}),
+    ('x: A', 'x: C', 'B()', {'int'}),
+    ('x: A', 'x: C', 'A', {'int', 'str'}),
+    ('x: type[A]', 'x: type[C]', 'A if condition else C', {'int', 'str'}),
+    ('x: type[A]', 'x: type[C]', 'A if condition else B', {'int'}),
+    ('x: type[A | C]', 'x: type[C]', 'A if condition else C', {'int'}),
+    ('x: Union[A, C]', 'x: C', 'A() if condition else C()', {'int'}),
+    ('x: Optional[A]', 'x: C', 'None', {'int'}),
+    ('x: Any', 'x: C', 'C', {'int'}),
+    ('x: type[A]', 'x: object', 'C', {'str'}),
+    ('x: type[A]', 'x: type[A]', 'A', {'int'}),
+    ('x: type[A]', 'x: type[C]', '', {'int', 'str'}),
+    ('x: type[A]', 'x: type[C]', 'A, C', {'int', 'str'}),
+    ('x: type[A]', 'x: type[C]', 'unexpected=A', {'int', 'str'}),
+    ('x: type[A]', 'x: type[C]', 'A, x=A', {'int', 'str'}),
+    ('x: type[A], /', 'x: type[C]', 'x=A', {'int', 'str'}),
+    ('*, x: type[A]', 'x: type[C]', 'A', {'int', 'str'}),
+    ('*, x: type[A]', 'x: type[C]', 'x=A', {'int'}),
+    ('x: type[A] = A', 'x: type[C]', '', {'int'}),
+    ('x: type[A], *, y: type[C]', 'x: type[C]', 'A', {'int', 'str'}),
+    ('x: type[A], *, y: type[C]', 'x: type[C]', 'y=C, x=A', {'int'}),
+    ('*xs: type[A]', '*xs: type[C]', 'A, B', {'int'}),
+    ('*xs: type[A]', '*xs: type[C]', 'C', {'str'}),
+    ('*xs: type[A]', '*xs: type[C]', 'A, C', {'int', 'str'}),
+    ('**xs: type[A]', '**xs: type[C]', 'x=C', {'str'}),
+    ('**xs: type[A]', '**xs: type[C]', 'x=A, y=C', {'int', 'str'}),
+    ('x: type[A], /, **xs: type[C]', 'x: type[C]', 'A, x=C', {'int'}),
+    ('x: object', 'x: Any', 'None', {'int'}),
+    ('x: int', 'x: object', 'True', {'int'}),
+    ('x: float', 'x: object', '1', {'int'}),
+    ('x: type[T]', 'x: object', 'C', {'int'}),
+    ('x: type[Bound]', 'x: object', 'B', {'int'}),
+    ('x: type[Bound]', 'x: object', 'C', {'str'}),
+    ('x: Type', 'x: object', 'A', {'int'}),
+])
+def test_overload_call_matching(Script, first, second, call, expected):
+    assert _infer_overload(Script, first, second, call) == expected
+
+
+@pytest.mark.parametrize(('first', 'second', 'call', 'setup', 'expected'), [
+    ('x: type[A]', 'x: type[C]', '*[A]', '', {'int'}),
+    ('x: type[A]', 'x: type[C]', '*(C,)', '', {'str'}),
+    ('x: type[A]', 'x: type[C]', '*xs', 'xs = [A]', {'int'}),
+    ('x: type[A]', 'x: type[C]', '**{"x": A}', '', {'int'}),
+    ('x: type[A]', 'x: type[C]', '**xs', 'xs = {"x": C}', {'str'}),
+    ('x: type[A]', 'x: type[C]', '**{"x": A, "x": C}', '', {'str'}),
+    ('x: type[A]', 'x: type[C]', '**{"x": A, **{"x": C}}', '', {'str'}),
+    ('x: type[A]', 'x: type[C]', '**{**{"x": A}, "x": C}', '', {'str'}),
+    ('x: type[A]', 'x: type[C]', '**{"x": C, **xs}',
+     'xs = {"x": A} if condition else {}', {'int', 'str'}),
+    ('x: type[A]', 'x: type[C]', '**{"x": C, **xs}', 'xs = {}', {'str'}),
+    ('x: type[A]', 'x: type[C]', '**{"x": A}, **{"x": C}', '', {'int', 'str'}),
+    ('x: type[A]', 'x: type[C]', '*[A if condition else C]', '', {'int', 'str'}),
+    ('x: type[A]', 'x: type[C]', '*xs',
+     'xs = [A] if condition else []', {'int', 'str'}),
+    ('x: type[A], y: type[C] = C', 'x: type[C]', '*xs, C',
+     'xs = [A] if condition else []', {'int', 'str'}),
+    ('x: type[A | C], y: type[C] = C', 'x: type[C]', '*xs, C',
+     'xs = [A] if condition else []', {'int'}),
+    ('x: type[A], y: type[C]', 'x: type[C]', '*[A, *xs]', 'xs = (C,)', {'int'}),
+    ('x: type[A], y: type[C]', 'x: type[C]', '*(A, *xs)', 'xs = [C]', {'int'}),
+    ('x: type[A]', 'x: type[C]', '*[A, *xs]', 'xs = [C]', {'int', 'str'}),
+    ('x: type[A]', 'x: type[C]', '*xs', 'xs: list[type[C]]', {'int', 'str'}),
+    ('*xs: type[A]', '*xs: type[C]', '*xs', 'xs: list[type[C]]', {'str'}),
+    ('x: type[A]', '*xs: type[C]', '*xs', 'xs: list[type[C]]', {'str'}),
+    ('x: type[A]', 'x: type[C]', '*xs', 'xs: tuple[type[C], ...]', {'int', 'str'}),
+    ('x: type[A]', 'x: type[C]', '*xs', 'xs: tuple[type[C]]', {'str'}),
+    ('*xs: type[A]', '*xs: type[C]', '*[C for _ in []]', '', {'int'}),
+    ('x: type[A]', 'x: type[C]', '*[C for _ in []]', '', {'int', 'str'}),
+    ('x: type[A]', 'x: type[C]', 'A, *[C for _ in []]', '', {'int'}),
+    ('x: type[A]', 'x: type[C]', '**{1: A}', '', {'int', 'str'}),
+    ('x: type[A]', 'x: type[C]', '*[item for item in [C]]', '', {'str'}),
+    ('x: type[A]', 'x: type[C]', 'A, *[C for _ in [1] if False]', '', {'int'}),
+    ('x: type[A]', 'x: type[C]', '*[item for item in [A, C] if condition]',
+     '', {'int', 'str'}),
+    ('x: type[A]', 'x: type[C]', '**{key: C for key in ["x"]}', '', {'str'}),
+    ('x: type[A]', 'x: type[C]', '**{key: C for key in []}', '', {'int', 'str'}),
+    ('**xs: type[A]', '**xs: type[C]', '**xs', 'xs: dict[str, type[C]]', {'str'}),
+    ('x: type[A]', 'x: type[C]', '**xs', 'xs: dict[str, type[C]]', {'int', 'str'}),
+    ('x: str', 'x: type[C]', '*{key: C for key in ["x"]}', '', {'int'}),
+    ('x: type[A]', 'x: type[C]', '*xs', 'xs = [A]\nxs.append(C)', {'int', 'str'}),
+    ('*xs: type[A]', '*xs: type[C]', '*[item for item in xs]',
+     'xs: list[type[C]]', {'str'}),
+    ('x: type[A]', 'x: type[C]', '*[item for item in xs]',
+     'xs: list[type[C]]', {'int', 'str'}),
+    ('x: type[A]', 'x: type[C]', '*{C for _ in [1, 2]}', '', {'int', 'str'}),
+    ('x: type[A] = A', 'x: type[C]', '**{"x": A for _ in xs}',
+     'xs: list[int]', {'int'}),
+    ('*xs: type[A]', '*xs: type[C]', '*[C for _ in xs if False]',
+     'xs: list[int]', {'int'}),
+    ('x: type[A] = A', 'x: type[C]', '**{key: A for key in xs}',
+     'xs: list[str]', {'int', 'str'}),
+    ('*xs: Any', 'x: Any', '*None', '', {'int', 'str'}),
+    ('**xs: Any', 'x: Any', '**{[]: A}', '', {'int', 'str'}),
+])
+def test_overload_unpacking(Script, first, second, call, setup, expected):
+    assert _infer_overload(Script, first, second, call, setup) == expected
+
+
+@pytest.mark.parametrize(('annotation', 'argument', 'setup', 'expected'), [
+    ('list[type[A]]', '[A, B]', '', {'int'}),
+    ('list[type[A]]', '[A, C]', '', {'str'}),
+    ('list[type[A]]', '[]', '', {'int'}),
+    ('List[Type[A]]', 'xs', 'xs = [A]', {'int'}),
+    ('list[type[A]]', '[*xs]', 'xs = [A]', {'int'}),
+    ('list[type[A]]', '[*xs]', 'xs = [C]', {'str'}),
+    ('list[type[A]]', '[C for _ in []]', '', {'int'}),
+    ('tuple[type[A], type[C]]', '(A, C)', '', {'int'}),
+    ('tuple[type[A], type[C]]', '(C, A)', '', {'str'}),
+    ('Tuple[Type[A], ...]', '(A, B)', '', {'int'}),
+    ('Tuple[Type[A], ...]', '(A, C)', '', {'str'}),
+    ('dict[int, type[C]]', '{1: A, True: C}', '', {'int'}),
+    ('dict[int, type[C]]', '{1: C, True: A}', '', {'str'}),
+    ('dict[str, type[C]]', '{"k": A, "k": C}', '', {'int'}),
+    ('dict[str, type[C]]', '{"k": A, **xs}', 'xs = {"k": C}', {'int'}),
+    ('dict[str, type[C]]', '{**xs, "k": C}', 'xs = {"k": A}', {'int'}),
+    ('dict[str, type[C]]', '{"k": C, **xs}',
+     'xs = {"k": A} if condition else {}', {'str'}),
+    ('dict[str, type[A | C]]', '{"k": C, **xs}',
+     'xs = {"k": A} if condition else {}', {'int'}),
+    ('list[dict[str, type[C]]]', '[{"k": A, **xs}]', 'xs = {"k": C}', {'int'}),
+    ('dict[int, type[C]]', '{True: A, 1: C}', '', {'int'}),
+    ('dict[int, type[C]]', '{1: A, 1.0: C}', '', {'int'}),
+    ('dict[None, type[C]]', '{None: A, None: C}', '', {'int'}),
+    ('dict[tuple[int], type[C]]', '{(1,): A, (True,): C}', '', {'int'}),
+    ('dict[type[A], type[C]]', '{A: A, A: C}', '', {'int'}),
+    ('list[type[A]]', '[item for item in [A, B]]', '', {'int'}),
+    ('list[type[A]]', '[C for _ in [1] if False]', '', {'int'}),
+    ('dict[str, type[C]]', '{key: C for key in ["k"]}', '', {'int'}),
+    ('dict[str, type[C]]', '{"k": item for item in [A, C]}', '', {'int'}),
+    ('list[type[A]]', 'xs', 'xs = [A]\nxs.append(C)', {'str'}),
+    ('dict[bool, type[C]]', '{True: A, 1: C}', '', {'int'}),
+    ('list[type[A]]', 'xs', 'xs: list[type[B]]', {'str'}),
+    ('list[type[A]]', 'xs', 'xs: list[type[A]]', {'int'}),
+    ('list[type[A]]', '[item for item in [A, *xs]]',
+     'xs: list[type[C]]', {'str'}),
+    ('list[type[A]]', '[item for item in xs]', 'xs: list[type[A]]', {'int'}),
+    ('list[type[T]]', 'xs', 'xs: list[type[A]]', {'int'}),
+])
+def test_overload_literal_contents(Script, annotation, argument, setup, expected):
+    assert _infer_overload(Script, 'x: ' + annotation, 'x: object', argument, setup) == expected
+
+
+@pytest.mark.parametrize(('call', 'expected'), [
+    ('A', ['build_a']),
+    ('C', ['build_c']),
+    ('input=A', ['build_a']),
+    ('A if condition else C', ['build_a', 'build_c']),
+    ('*xs', ['build_a', 'build_c']),
+])
+def test_overload_completions(Script, call, expected):
+    source = _PREAMBLE + dedent('''\
+        class ABuilder:
+            def build_a(self): ...
+
+        class CBuilder:
+            def build_c(self): ...
+
+        @overload
+        def get_obj(input: type[A]) -> ABuilder: ...
+        @overload
+        def get_obj(input: type[C]) -> CBuilder: ...
+
+        xs: list[type[C]]
+        get_obj(%s).build_
+    ''') % call
+    assert [completion.name for completion in Script(source.rstrip()).complete()] == expected
+
+
+@pytest.mark.parametrize(('annotation', 'expected'), [
+    ('Callable[..., int]', {'int'}),
+    ('Callable[..., str]', {'str'}),
+    ('Callable[[int], int]', {'int'}),
+    ('Callable[[str], int]', {'str'}),
+    ('Callable', {'int'}),
+])
+@pytest.mark.parametrize('bound', [False, True])
+def test_overload_callable(Script, annotation, expected, bound):
+    if bound:
+        setup = 'class Owner:\n    def callback(self, value: int) -> int: ...'
+        argument = 'Owner().callback'
+    else:
+        setup = 'def callback(value: int) -> int: ...'
+        argument = 'callback'
+    assert _infer_overload(Script, 'callback: ' + annotation, 'callback: object',
+                           argument, setup) == expected
+
+
+@pytest.mark.parametrize(('receiver', 'decorator', 'parameter'), [
+    ('Factory()', '', 'self, '),
+    ('Factory', '@classmethod\n', 'cls, '),
+    ('Factory', '@staticmethod\n', ''),
+])
+def test_overload_methods(Script, receiver, decorator, parameter):
+    method = dedent('''\
+        @overload
+        %sdef f(%sx: type[A]) -> int: ...
+        @overload
+        %sdef f(%sx: type[C]) -> str: ...
+    ''') % (decorator, parameter, decorator, parameter)
+    source = _PREAMBLE + 'class Factory:\n' + ''.join(
+        '    ' + line + '\n' for line in method.splitlines()
+    )
+    source += receiver + '.f(C)'
+    assert {value.name for value in Script(source).infer()} == {'str'}
+
+
+def test_overload_stub(Script, tmpdir):
+    stub = tmpdir.join('overloaded.pyi')
+    stub.write(_PREAMBLE + dedent('''\
+        @overload
+        def f(x: type[A]) -> int: ...
+        @overload
+        def f(x: type[C]) -> str: ...
+    '''))
+    script = Script('from overloaded import f, C\nf(C)', path=str(tmpdir.join('caller.py')))
+    assert {value.name for value in script.infer()} == {'str'}
