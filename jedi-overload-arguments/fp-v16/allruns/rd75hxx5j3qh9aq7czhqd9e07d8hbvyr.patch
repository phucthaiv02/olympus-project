+
+# -------------------------
+# Classes as arguments
+# -------------------------
+
+class A: pass
+class B(A): pass
+class C: pass
+
+class ABuilder:
+    def a_method(self): ...
+
+class CBuilder:
+    def c_method(self): ...
+
+class AnyBuilder: pass
+
+c = bool()
+
+@overload
+def get_builder(x: type[A]) -> ABuilder: ...
+@overload
+def get_builder(x: type[C]) -> CBuilder: ...
+def get_builder(x): ...
+
+#? ABuilder()
+get_builder(A)
+#? ABuilder()
+get_builder(B)
+#? CBuilder()
+get_builder(x=C)
+#? ['a_method']
+get_builder(A).a_
+#? []
+get_builder(A).c_
+# The argument might be C, so no overload matches.
+#? ABuilder() CBuilder()
+get_builder(A if c else C)
+#? ABuilder() CBuilder()
+get_builder(A())
+
+@overload
+def get_builder2(x: type[A]) -> ABuilder: ...
+@overload
+def get_builder2(x: type[A] | type[C]) -> CBuilder: ...
+def get_builder2(x): ...
+
+#? CBuilder()
+get_builder2(A if c else C)
+
+# -------------------------
+# Star arguments
+# -------------------------
+
+@overload
+def one_or_many(x: type[C]) -> CBuilder: ...
+@overload
+def one_or_many(*args: type[A] | type[C]) -> AnyBuilder: ...
+def one_or_many(*args): ...
+
+types_of_c: list[type[C]]
+# Any number of arguments can be passed, even none.
+#? AnyBuilder()
+one_or_many(*types_of_c)
+#? CBuilder()
+one_or_many(C)
+#? CBuilder()
+one_or_many(*[C])
+#? CBuilder()
+one_or_many(*(C,))
+#? AnyBuilder()
+one_or_many(*[C, C])
+#? AnyBuilder()
+one_or_many(*[C for _ in []])
+#? CBuilder()
+one_or_many(*[C for _ in [1]])
+#? AnyBuilder()
+one_or_many(*[C for _ in [1, 2]])
+
+maybe_a = [A] if c else []
+# C can be the first or the second argument.
+#? AnyBuilder()
+one_or_many(*maybe_a, C)
+#? CBuilder()
+one_or_many(*[], C)
+
+@overload
+def two(x: type[A], y: type[A]) -> ABuilder: ...
+@overload
+def two(x: type[A], y: type[C]) -> CBuilder: ...
+def two(x, y): ...
+
+list_of_c = [C]
+#? CBuilder()
+two(*[A, *list_of_c])
+#? ABuilder()
+two(*[A, *[A]])
+a_and_c = A, C
+#? CBuilder()
+two(*a_and_c)
+#? ABuilder() CBuilder()
+two(*[A, *list_of_c, C])
+
+# -------------------------
+# Literals as arguments
+# -------------------------
+
+@overload
+def from_dict(x: dict[int, type[A]]) -> ABuilder: ...
+@overload
+def from_dict(x: dict[int, type[C]]) -> CBuilder: ...
+def from_dict(x): ...
+
+# 1 and True are the same key, the value is C.
+#? CBuilder()
+from_dict({1: A, True: C})
+#? ABuilder()
+from_dict({True: C, 1: A})
+
+@overload
+def from_list(x: list[type[A]]) -> ABuilder: ...
+@overload
+def from_list(x: list[type[C]]) -> CBuilder: ...
+def from_list(x): ...
+
+# The list is empty.
+#? ABuilder()
+from_list([C for _ in []])
+#? CBuilder()
+from_list([C, C])
+#? CBuilder()
+from_list([*list_of_c])
+
+@overload
+def keyword(k: type[C]) -> CBuilder: ...
+@overload
+def keyword(k: type[A]) -> ABuilder: ...
+def keyword(k): ...
+
+maybe_k = {"k": A} if c else {}
+#? ABuilder() CBuilder()
+keyword(**{"k": C, **maybe_k})
+#? CBuilder()
+keyword(**{"k": C})
+#? ABuilder()
+keyword(**{**{"k": C}, "k": A})
+
+# -------------------------
+# Literal
+# -------------------------
+
+from typing import Literal
+
+@overload
+def open_mode(mode: Literal["r", "w"]) -> str: ...
+@overload
+def open_mode(mode: Literal["rb"]) -> bytes: ...
+@overload
+def open_mode(mode: str) -> float: ...
+def open_mode(mode): ...
+
+#? str()
+open_mode("r")
+#? bytes()
+open_mode("rb")
+#? float()
+open_mode(str())
+
+@overload
+def bool_literal(x: Literal[1]) -> int: ...
+@overload
+def bool_literal(x: Literal[True]) -> str: ...
+def bool_literal(x): ...
+
+#? str()
+bool_literal(True)
+#? int()
+bool_literal(1)
+
+# -------------------------
+# Variance of generics
+# -------------------------
+
+from typing import Sequence
+
+list_bool: List[bool]
+
+@overload
+def variance(value: List[int]) -> int: ...
+@overload
+def variance(value: Sequence[int]) -> str: ...
+def variance(value): ...
+
+#? int()
+variance(list_int)
+# List is invariant, but Sequence is covariant.
+#? str()
+variance(list_bool)
+#? int()
+variance([True])
