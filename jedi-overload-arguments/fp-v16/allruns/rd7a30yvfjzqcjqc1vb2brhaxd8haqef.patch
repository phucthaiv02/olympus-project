diff --git a/jedi/inference/call_shapes.py b/jedi/inference/call_shapes.py
new file mode 100644
index 0000000..a2d283c
--- /dev/null
+++ b/jedi/inference/call_shapes.py
@@ -0,0 +1,539 @@
+"""
+To choose an overload, Jedi needs to know which arguments a call passes at
+runtime. A call like ``f(*xs, C)`` might pass ``C`` as the first or as the
+second argument, depending on the length of ``xs``. This module calculates the
+possible "shapes" of a call: All the alternatives of positional and keyword
+arguments that Python might create.
+
+Tuples, lists, sets and dicts that are written directly in the code (also if
+they are stored in a variable) are evaluated like Python would evaluate them:
+Nested ``*`` and ``**`` unpackings are resolved, equal dict keys are merged
+(``{1: A, True: C}`` is ``{1: C}``) and comprehensions get a known length if
+their sources have a known length (``[C for _ in []]`` is empty).
+
+If Jedi cannot know how many values an iterable contains, the shape contains an
+:class:`Item` with a minimum of 0 and an infinite maximum.
+"""
+from jedi.inference.base_value import ValueSet, NO_VALUES
+from jedi.inference.compiled import create_simple_object
+from jedi.inference.value import iterable
+from jedi.inference.value.dynamic_arrays import check_array_additions
+
+INFINITE = float('inf')
+# If there are more alternatives than this, they are merged into one
+# alternative that contains all of them.
+_MAX_ALTERNATIVES = 32
+_MAX_DEPTH = 10
+_UNKNOWN_KEY = object()
+
+
+class Item:
+    """
+    Between ``min`` and ``max`` values (e.g. positional arguments or the
+    elements of a list), each of them being one of ``values``. If ``values`` is
+    empty while ``max`` is not 0, the values are unknown.
+    """
+    def __init__(self, values, min=1, max=1):
+        self.values = values
+        self.min = min
+        self.max = max
+
+    def is_unknown(self):
+        return not self.values and self.max > 0
+
+    def __repr__(self):
+        return '<%s: %s {%s,%s}>' % (self.__class__.__name__, self.values, self.min, self.max)
+
+
+class MappingContent:
+    """
+    A possible content of a mapping. ``entries`` is a tuple of ``(key,
+    key_values, values)`` in insertion order, where ``key`` is the hashable
+    Python object of the key. ``unknown`` is ``None`` or a tuple of
+    ``(key_values, values)`` for any number of entries with unknown keys.
+    """
+    def __init__(self, entries=(), unknown=None):
+        self.entries = entries
+        self.unknown = unknown
+
+    def set_item(self, key, key_values, values):
+        if key is _UNKNOWN_KEY:
+            # The key might be equal to any of the existing keys.
+            return MappingContent(
+                tuple((k, kv, vs | values) for k, kv, vs in self.entries),
+                _merge_unknown(self.unknown, (key_values, values)),
+            )
+
+        entries = list(self.entries)
+        for i, (k, kv, vs) in enumerate(entries):
+            if _keys_equal(k, key):
+                # Like in Python, the first key stays, but the value changes.
+                entries[i] = k, kv, values
+                break
+        else:
+            entries.append((key, key_values, values))
+        return MappingContent(tuple(entries), self.unknown)
+
+    def update(self, other):
+        result = self
+        if other.unknown is not None:
+            result = result.set_item(_UNKNOWN_KEY, *other.unknown)
+        for entry in other.entries:
+            result = result.set_item(*entry)
+        return result
+
+    def __repr__(self):
+        return '<%s: %s, unknown=%s>' % (self.__class__.__name__, self.entries, self.unknown)
+
+
+class CallShape:
+    """
+    One possibility of the arguments a call passes. ``positional`` is a tuple
+    of :class:`Item`, ``keywords`` a tuple of ``(name, values)`` and
+    ``unknown_keywords`` is ``None`` or the values of any number of keyword
+    arguments with unknown names (e.g. ``**kwargs`` of an unknown dict).
+    """
+    def __init__(self, positional=(), keywords=(), unknown_keywords=None):
+        self.positional = positional
+        self.keywords = keywords
+        self.unknown_keywords = unknown_keywords
+
+    def with_positional(self, items, prepend=False):
+        if prepend:
+            positional = tuple(items) + self.positional
+        else:
+            positional = self.positional + tuple(items)
+        return CallShape(positional, self.keywords, self.unknown_keywords)
+
+    def with_keyword(self, name, values):
+        """Returns None if Python would raise a TypeError for this keyword."""
+        if not isinstance(name, str) or any(n == name for n, _ in self.keywords):
+            return None
+        return CallShape(self.positional, self.keywords + ((name, values),),
+                         self.unknown_keywords)
+
+    def with_mapping(self, content):
+        """Adds the keyword arguments of a ``**`` unpacking."""
+        shape = self
+        for key, key_values, values in content.entries:
+            shape = shape.with_keyword(key, values)
+            if shape is None:
+                return None
+        if content.unknown is not None:
+            unknown = content.unknown[1]
+            if shape.unknown_keywords is not None:
+                unknown |= shape.unknown_keywords
+            shape = CallShape(shape.positional, shape.keywords, unknown)
+        return shape
+
+    def __repr__(self):
+        return '<%s: %s, %s, unknown=%s>' % (
+            self.__class__.__name__, self.positional, self.keywords, self.unknown_keywords)
+
+
+def get_tree_call_shapes(context, argument_node):
+    """
+    Returns a list of :class:`CallShape` for the arguments in the tree or
+    ``None`` if there are too many possibilities. Possibilities where Python
+    raises an error before calling the function are left out.
+    """
+    from jedi.inference.arguments import unpack_arglist
+    shapes = [CallShape()]
+    for star_count, el in unpack_arglist(argument_node):
+        if star_count == 1:
+            alternatives = get_sequence_alternatives(context.infer_node(el))
+            shapes = [s.with_positional(a) for s in shapes for a in alternatives]
+        elif star_count == 2:
+            alternatives = get_mapping_alternatives(context.infer_node(el))
+            shapes = [s.with_mapping(a) for s in shapes for a in alternatives]
+        elif el.type == 'argument' and el.children[1] == '=':
+            values = context.infer_node(el.children[2])
+            shapes = [s.with_keyword(el.children[0].value, values) for s in shapes]
+        else:
+            if el.type != 'argument':
+                values = context.infer_node(el)
+            elif el.children[1] == ':=':
+                # A named expression like ``f(x := 1)``.
+                values = context.infer_node(el.children[2])
+            else:
+                # A generator comprehension like ``f(x for x in y)``.
+                from jedi.inference.arguments import create_generator_argument
+                values = ValueSet([create_generator_argument(context, el)])
+            shapes = [s.with_positional((Item(values),)) for s in shapes]
+
+        shapes = [s for s in shapes if s is not None]
+        if len(shapes) > _MAX_ALTERNATIVES:
+            return None
+    return shapes
+
+
+def get_unpacked_call_shapes(unpacked):
+    """
+    Creates the shape of the ``(key, lazy_value)`` pairs that
+    ``arguments.unpack()`` returns. They are not as precise as the tree.
+    """
+    shape = CallShape()
+    for key, lazy_value in unpacked:
+        if key is None:
+            item = Item(lazy_value.infer(), lazy_value.min, lazy_value.max)
+            shape = shape.with_positional((item,))
+        else:
+            shape = shape.with_keyword(key, lazy_value.infer())
+            if shape is None:
+                return []
+    return [shape]
+
+
+def get_sequence_alternatives(value_set, depth=0):
+    """
+    Returns the possible contents that iterating over one of the values
+    creates, as a list of tuples of :class:`Item`.
+    """
+    if not value_set:
+        return [(Item(NO_VALUES, 0, INFINITE),)]
+    alternatives = []
+    for value in value_set:
+        alternatives += _sequence_alternatives_of_value(value, depth)
+    return _limit_alternatives(alternatives)
+
+
+def get_mapping_alternatives(value_set, depth=0):
+    """
+    Returns the possible contents of the mappings in ``value_set`` as a list of
+    :class:`MappingContent`.
+    """
+    if not value_set:
+        return [MappingContent(unknown=(NO_VALUES, NO_VALUES))]
+    alternatives = []
+    for value in value_set:
+        alternatives += _mapping_alternatives_of_value(value, depth)
+    if len(alternatives) > _MAX_ALTERNATIVES:
+        return [_merge_mapping_alternatives(alternatives)]
+    return alternatives
+
+
+def get_container_type_arguments(value):
+    """
+    For containers with a content that Jedi knows (e.g. list literals),
+    returns the values of the type parameters of the container's class, like
+    ``(keys, values)`` for a dict. ``None`` instead of a value set means that
+    the values are unknown. Returns ``None`` if the value is not such a
+    container.
+    """
+    if _is_mapping_container(value):
+        keys = values = NO_VALUES
+        unknown_keys = unknown_values = False
+        for content in _mapping_alternatives_of_value(value, 0):
+            pairs = [(kv, vs) for _, kv, vs in content.entries]
+            if content.unknown is not None:
+                pairs.append(content.unknown)
+            for key_values, entry_values in pairs:
+                unknown_keys |= not key_values
+                unknown_values |= not entry_values
+                keys |= key_values
+                values |= entry_values
+        return (None if unknown_keys else keys, None if unknown_values else values)
+
+    if _is_sequence_container(value):
+        elements = NO_VALUES
+        for alternative in _sequence_alternatives_of_value(value, 0):
+            for item in alternative:
+                if item.is_unknown():
+                    return (None,)
+                elements |= item.values
+        return (elements,)
+    return None
+
+
+def _is_mapping_container(value):
+    return isinstance(value, (iterable.DictLiteralValue, iterable.DictComprehension,
+                              iterable.FakeDict))
+
+
+def _is_sequence_container(value):
+    from jedi.inference.gradual.typing import Tuple
+    if _is_mapping_container(value):
+        return False
+    return isinstance(value, (iterable.SequenceLiteralValue, iterable.ComprehensionMixin,
+                              iterable.FakeTuple, iterable.FakeList, iterable.MergedArray,
+                              Tuple))
+
+
+def _sequence_alternatives_of_value(value, depth):
+    from jedi.inference.gradual.typing import Tuple
+    if depth > _MAX_DEPTH:
+        return [(Item(NO_VALUES, 0, INFINITE),)]
+
+    if _is_mapping_container(value):
+        # Iterating over a dict returns its keys.
+        alternatives = []
+        for content in _mapping_alternatives_of_value(value, depth):
+            items = tuple(Item(key_values) for _, key_values, _ in content.entries)
+            if content.unknown is not None:
+                # The order of the keys is not known anymore.
+                items = _merge_items(items + (Item(content.unknown[0], 0, INFINITE),))
+            alternatives.append(items)
+        return alternatives
+
+    if isinstance(value, iterable.SequenceLiteralValue):
+        return _literal_sequence_alternatives(value, depth)
+
+    if isinstance(value, iterable.ComprehensionMixin):
+        min_, max_ = _comprehension_length(value, depth)
+        if max_ == 0:
+            return [()]
+        return [(Item(value.merge_types_of_iterate(), min_, max_),)]
+
+    if isinstance(value, (iterable.FakeTuple, iterable.FakeList)):
+        return [tuple(Item(lazy_value.infer(), lazy_value.min, lazy_value.max)
+                      for lazy_value in value.py__iter__())]
+
+    if isinstance(value, iterable.MergedArray):
+        alternatives = [()]
+        for array in value.get_arrays():
+            alternatives = _product(
+                alternatives,
+                _sequence_alternatives_of_value(array, depth + 1),
+            )
+        return alternatives
+
+    if isinstance(value, Tuple):
+        if value.is_homogenous_tuple():
+            return [tuple(Item(lazy_value.infer(), 0, INFINITE)
+                          for lazy_value in value.py__iter__())]
+        return [tuple(Item(lazy_value.infer()) for lazy_value in value.py__iter__())]
+
+    return [(Item(value.merge_types_of_iterate(), 0, INFINITE),)]
+
+
+def _literal_entries(sequence):
+    atom = sequence.atom
+    if atom.type in sequence._TUPLE_LIKE:
+        return atom.children[::2]
+
+    array_node = atom.children[1]
+    if array_node in (']', '}', ')'):
+        return []
+    if array_node.type in ('testlist_comp', 'dictorsetmaker'):
+        return array_node.children[::2]
+    return [array_node]
+
+
+def _literal_sequence_alternatives(sequence, depth):
+    context = sequence._defining_context
+    alternatives = [()]
+    for node in _literal_entries(sequence):
+        if node.type == 'star_expr':
+            alternatives = _product(
+                alternatives,
+                get_sequence_alternatives(context.infer_node(node.children[1]), depth + 1),
+            )
+        else:
+            if node == ':' or node.type == 'subscript':
+                item = Item(NO_VALUES)
+            else:
+                item = Item(context.infer_node(node))
+            alternatives = [a + (item,) for a in alternatives]
+
+    if sequence.array_type in ('list', 'set'):
+        additions = check_array_additions(context, sequence)
+        if additions:
+            # The list was modified, we do not know the order and count anymore.
+            added = ValueSet.from_sets(lazy_value.infer() for lazy_value in additions)
+            alternatives = [_merge_items(a + (Item(added, 0, INFINITE),))
+                            for a in alternatives]
+
+    if sequence.array_type == 'set':
+        alternatives = [_set_items(a) for a in alternatives]
+    return alternatives
+
+
+def _set_items(items):
+    """Sets have no order and equal values are merged."""
+    distinct = {}
+    for item in items:
+        if not (item.min == item.max == 1 and len(item.values) == 1):
+            break
+        value, = item.values
+        if value.is_class():
+            key = value
+        else:
+            key = _get_key(value)
+            if key is _UNKNOWN_KEY:
+                break
+        distinct.setdefault(key, value)
+    else:
+        count = len(distinct)
+        return _merge_items((Item(ValueSet(distinct.values()), count, count),))
+    return tuple(Item(item.values, min(item.min, 1), item.max) for item in _merge_items(items))
+
+
+def _comprehension_length(comprehension, depth):
+    """
+    Returns the minimum and maximum number of elements of a comprehension.
+    """
+    context = comprehension._defining_context
+    min_ = max_ = 1
+    bound_names = set()
+    node = comprehension._sync_comp_for_node
+    while node is not None:
+        if node.type == 'comp_if':
+            min_ = 0
+        else:
+            is_async = node.type == 'comp_for'
+            if is_async:
+                node = node.children[1]
+            source = node.children[3]
+            if is_async or bound_names & set(_iter_names(source)):
+                # The source depends on the variables of a previous `for`.
+                source_min, source_max = 0, INFINITE
+            else:
+                alternatives = get_sequence_alternatives(context.infer_node(source), depth + 1)
+                source_min = min(_min_length(a) for a in alternatives)
+                source_max = max(_max_length(a) for a in alternatives)
+            min_ = _multiply(min_, source_min)
+            max_ = _multiply(max_, source_max)
+            bound_names |= set(_iter_names(node.children[1]))
+
+        last = node.children[-1]
+        if last.type in ('comp_if', 'comp_for', 'sync_comp_for'):
+            node = last
+        else:
+            node = None
+    return min_, max_
+
+
+def _iter_names(node):
+    if node.type == 'name':
+        yield node.value
+    for child in getattr(node, 'children', ()):
+        yield from _iter_names(child)
+
+
+def _mapping_alternatives_of_value(value, depth):
+    if depth > _MAX_DEPTH:
+        return [MappingContent(unknown=(NO_VALUES, NO_VALUES))]
+
+    if isinstance(value, iterable.DictLiteralValue):
+        return _dict_literal_alternatives(value, depth)
+
+    if isinstance(value, iterable.DictComprehension):
+        if _comprehension_length(value, depth)[1] == 0:
+            return [MappingContent()]
+        return [MappingContent(unknown=value.get_mapping_item_values())]
+
+    if isinstance(value, iterable.FakeDict):
+        inference_state = value.inference_state
+        return [MappingContent(tuple(
+            (key, ValueSet([create_simple_object(inference_state, key)]), lazy_value.infer())
+            for key, lazy_value in value.exact_key_items()
+        ))]
+
+    # Some other mapping, the keys are not known.
+    values = ValueSet([value])
+    return [MappingContent(unknown=(
+        values.py__getattribute__('keys').execute_with_values().merge_types_of_iterate(),
+        values.py__getattribute__('values').execute_with_values().merge_types_of_iterate(),
+    ))]
+
+
+def _dict_literal_alternatives(dct, depth):
+    context = dct._defining_context
+    array_node = dct.atom.children[1]
+    alternatives = [MappingContent()]
+    if array_node == '}':
+        return alternatives
+
+    iterator = iter(array_node.children)
+    for child in iterator:
+        if child == ',':
+            continue
+        if child == '**':
+            others = get_mapping_alternatives(context.infer_node(next(iterator)), depth + 1)
+            alternatives = [a.update(o) for a in alternatives for o in others]
+        else:
+            next(iterator)  # The colon
+            values = context.infer_node(next(iterator))
+            keys = [(_get_key(k), ValueSet([k])) for k in context.infer_node(child)] \
+                or [(_UNKNOWN_KEY, NO_VALUES)]
+            alternatives = [a.set_item(key, key_values, values)
+                            for a in alternatives
+                            for key, key_values in keys]
+        if len(alternatives) > _MAX_ALTERNATIVES:
+            alternatives = [_merge_mapping_alternatives(alternatives)]
+    return alternatives
+
+
+def _get_key(value):
+    key = value.get_safe_value(default=_UNKNOWN_KEY)
+    if isinstance(key, slice):
+        return _UNKNOWN_KEY
+    try:
+        hash(key)
+    except TypeError:
+        return _UNKNOWN_KEY
+    return key
+
+
+def _keys_equal(key1, key2):
+    # Python uses the hash and equality to compare dict keys.
+    return key2 in {key1: None}
+
+
+def _merge_unknown(unknown1, unknown2):
+    if unknown1 is None:
+        return unknown2
+    return unknown1[0] | unknown2[0], unknown1[1] | unknown2[1]
+
+
+def _merge_mapping_alternatives(alternatives):
+    unknown = None
+    for content in alternatives:
+        for key, key_values, values in content.entries:
+            unknown = _merge_unknown(unknown, (key_values, values))
+        if content.unknown is not None:
+            unknown = _merge_unknown(unknown, content.unknown)
+    return MappingContent(unknown=unknown)
+
+
+def _min_length(items):
+    return sum(item.min for item in items)
+
+
+def _max_length(items):
+    return sum(item.max for item in items)
+
+
+def _multiply(a, b):
+    # Avoid 0 * inf, which is nan.
+    if a == 0 or b == 0:
+        return 0
+    return a * b
+
+
+def _merge_items(items):
+    """Merges all items into one, which loses the order of the values."""
+    max_ = _max_length(items)
+    if max_ == 0:
+        return ()
+    values = ValueSet.from_sets(item.values for item in items if item.max > 0)
+    if any(item.is_unknown() for item in items):
+        values = NO_VALUES
+    return (Item(values, _min_length(items), max_),)
+
+
+def _product(alternatives1, alternatives2):
+    return _limit_alternatives([a + b for a in alternatives1 for b in alternatives2])
+
+
+def _limit_alternatives(alternatives):
+    if len(alternatives) <= _MAX_ALTERNATIVES:
+        return alternatives
+    merged = [_merge_items(a) for a in alternatives]
+    max_ = max(_max_length(a) for a in merged)
+    if max_ == 0:
+        return [()]
+    values = ValueSet.from_sets(item.values for a in merged for item in a)
+    if any(item.is_unknown() for a in merged for item in a):
+        values = NO_VALUES
+    return [(Item(values, min(_min_length(a) for a in merged), max_),)]
