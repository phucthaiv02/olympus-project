index 0000000..1e71a88
--- /dev/null
+++ b/jedi/inference/gradual/matching.py
@@ -0,0 +1,496 @@
+"""
+Checks if the arguments of a call match a signature, which is used to choose
+an ``@overload``.
+
+A signature matches if it accepts every possible shape of the call (see
+:mod:`jedi.inference.call_shapes`) and if every possible value of an argument
+is valid for the annotation of the parameter it is passed to. For example
+``f(A if c else C)`` does not match ``def f(x: type[A])``, because the argument
+can be ``C``.
+"""
+from inspect import Parameter
+from itertools import product
+
+from jedi.cache import memoize_method
+from jedi.inference.base_value import ValueSet
+from jedi.inference.compiled import builtin_from_name
+from jedi.inference.call_shapes import get_sequence_alternatives, \
+    get_container_type_arguments
+from jedi.inference.gradual.annotation import infer_param
+from jedi.inference.gradual.base import DefineGenericBaseClass, GenericClass
+from jedi.inference.gradual.conversion import to_stub
+from jedi.inference.gradual.generics import _resolve_forward_references
+from jedi.inference.gradual.type_var import TypeVar
+from jedi.inference.gradual.typing import AnyClass, SelfClass, LiteralWithValues, \
+    ProxyWithGenerics, TypingClassWithGenerics, ProxyTypingValue, \
+    ProxyTypingClassValue, TypeAlias, NewType, Tuple
+from jedi.inference.names import AnonymousParamName
+
+# Expanding arguments of an unknown length can lead to a lot of combinations.
+_MAX_EXPANSIONS = 256
+_POSITIONAL_KINDS = (Parameter.POSITIONAL_ONLY, Parameter.POSITIONAL_OR_KEYWORD)
+_KEYWORD_KINDS = (Parameter.POSITIONAL_OR_KEYWORD, Parameter.KEYWORD_ONLY)
+# A function that accepts a float also accepts an int, see PEP 484.
+_PROMOTIONS = {'float': ('int',), 'complex': ('int', 'float')}
+_NOT_PROTOCOL_MEMBERS = {
+    '__slots__', '__doc__', '__module__', '__qualname__', '__annotations__',
+    '__init__', '__new__', '__class_getitem__', '__init_subclass__',
+    '__subclasshook__', '__abstractmethods__', '__parameters__',
+}
+_sentinel = object()
+
+
+def signature_matches(function_value, call_shapes):
+    if not call_shapes:
+        # Either there are too many possibilities or Python will raise an
+        # error before even calling the function.
+        return False
+    params = [_Param(function_value, param) for param in function_value.tree_node.get_params()]
+    return all(_shape_matches(params, shape) for shape in call_shapes)
+
+
+class _Param:
+    def __init__(self, function_value, tree_param):
+        self._function_value = function_value
+        self._tree_param = tree_param
+        self.name = tree_param.name.value
+        self.kind = AnonymousParamName(function_value, tree_param.name).get_kind()
+        self.has_default = tree_param.default is not None
+
+    @memoize_method
+    def _get_annotation(self):
+        annotation = infer_param(self._function_value, self._tree_param, ignore_stars=True)
+        if any(isinstance(a, SelfClass) for a in annotation):
+            # `Self` stands for the class of the method.
+            context = self._function_value.get_default_param_context()
+            if context.is_class():
+                cls = context.get_value()
+                annotation = ValueSet(cls if isinstance(a, SelfClass) else a for a in annotation)
+        return annotation
+
+    def accepts(self, values):
+        annotation = self._get_annotation()
+        if not annotation:
+            # If there is no annotation or Jedi cannot infer it, the
+            # parameter accepts everything.
+            return True
+        return _values_match(annotation, values)
+
+
+def _shape_matches(params, shape):
+    positional_count = sum(1 for p in params if p.kind in _POSITIONAL_KINDS)
+    expansions = _expand_items(shape.positional, positional_count + 1)
+    if expansions is None:
+        return False
+    return all(
+        _bind_and_check(params, positional, shape.keywords, shape.unknown_keywords)
+        for positional in expansions
+    )
+
+
+def _expand_items(items, limit):
+    """
+    Returns all the possible lists of values for the items. Counts higher than
+    ``limit`` are treated like ``limit``, which works if ``limit`` is higher
+    than the number of positional parameters: All the additional arguments end
+    up in ``*args``, no matter how many there are.
+    """
+    choices = []
+    for item in items:
+        min_ = min(item.min, limit)
+        max_ = min(item.max, limit)
+        choices.append([[item.values] * count for count in range(min_, max_ + 1)])
+
+    count = 1
+    for c in choices:
+        count *= len(c)
+    if count > _MAX_EXPANSIONS:
+        return None
+    return [[values for part in combination for values in part]
+            for combination in product(*choices)]
+
+
+def _bind_and_check(params, positional, keywords, unknown_keywords):
+    """
+    Binds the arguments to the parameters like Python does and checks the
+    types of the arguments.
+    """
+    positional_params = [p for p in params if p.kind in _POSITIONAL_KINDS]
+    var_positional = next((p for p in params if p.kind == Parameter.VAR_POSITIONAL), None)
+    var_keyword = next((p for p in params if p.kind == Parameter.VAR_KEYWORD), None)
+
+    checks = []
+    bound_by_position = set()
+    bound_by_keyword = set()
+    for i, values in enumerate(positional):
+        if i < len(positional_params):
+            bound_by_position.add(positional_params[i])
+            checks.append((positional_params[i], values))
+        elif var_positional is not None:
+            checks.append((var_positional, values))
+        else:
+            return False  # Too many arguments
+
+    for name, values in keywords:
+        param = next((p for p in params if p.name == name and p.kind in _KEYWORD_KINDS), None)
+        if param is None:
+            if var_keyword is None:
+                return False  # Unexpected keyword argument
+            checks.append((var_keyword, values))
+        elif param in bound_by_position:
+            return False  # Multiple values for an argument
+        else:
+            bound_by_keyword.add(param)
+            checks.append((param, values))
+
+    if unknown_keywords is not None:
+        # Any keywords might be passed (or none at all).
+        if var_keyword is None:
+            return False
+        checks.append((var_keyword, unknown_keywords))
+        for param in params:
+            if param.kind in _KEYWORD_KINDS:
+                if param in bound_by_position:
+                    return False  # Might get multiple values
+                if param not in bound_by_keyword:
+                    checks.append((param, unknown_keywords))
+
+    for param in params:
+        if param.kind in _POSITIONAL_KINDS + (Parameter.KEYWORD_ONLY,) \
+                and not param.has_default \
+                and param not in bound_by_position \
+                and param not in bound_by_keyword:
+            return False  # Missing argument
+
+    return all(param.accepts(values) for param, values in checks)
+
+
+def _values_match(annotation, values):
+    """
+    Checks if all values are valid for the annotation (a value set as given by
+    ``infer_annotation``). Empty values are unknown values.
+    """
+    if not values:
+        return _accepts_anything(annotation)
+    return all(value_matches_annotation(annotation, value) for value in values)
+
+
+def value_matches_annotation(annotation, value):
+    if not annotation:
+        return True
+    return any(_matches(a, value) for a in annotation)
+
+
+def _matches(annotation, value):
+    if isinstance(annotation, (AnyClass, SelfClass)):
+        return True
+    if isinstance(annotation, TypeVar):
+        return _matches_type_var(
+            annotation, lambda annotation: value_matches_annotation(annotation, value))
+    if isinstance(annotation, LiteralWithValues):
+        return _matches_literal(annotation, value)
+    if isinstance(annotation, NewType):
+        # At runtime this is the original type.
+        return value_matches_annotation(annotation.get_type_values(), value)
+
+    if isinstance(annotation, TypingClassWithGenerics):
+        name = annotation.py__name__()
+        generics = annotation.get_generics()
+        if name == 'Type':
+            return value.is_class() and bool(generics) and _class_matches(generics[0], value)
+        if name == 'Tuple':
+            return _matches_tuple(annotation, value)
+        if name == 'Callable':
+            return _matches_callable(generics, value)
+        return True
+    if isinstance(annotation, ProxyWithGenerics):
+        name = annotation.py__name__()
+        generics = annotation.get_generics()
+        if name == 'Union':
+            return any(value_matches_annotation(g, value) for g in generics)
+        if name == 'Optional':
+            return _is_none(value) or any(value_matches_annotation(g, value) for g in generics)
+        if generics and name in ('ClassVar', 'Annotated', 'Final'):
+            return value_matches_annotation(generics[0], value)
+        return False
+
+    if isinstance(annotation, ProxyTypingClassValue):
+        # Typing classes without generics like `Tuple`.
+        name = annotation.py__name__()
+        if name == 'Type':
+            return value.is_class()
+        if name == 'Tuple':
+            return _is_instance(value, _get_builtin(value, 'tuple'))
+        if name == 'Callable':
+            return _is_callable(value)
+        return True
+    if isinstance(annotation, ProxyTypingValue):
+        # Something like `Union` without generics.
+        return True
+
+    if isinstance(annotation, TypeAlias):
+        # Something like `List`
+        return any(_is_instance(value, cls) for cls in annotation.gather_annotation_classes())
+    if isinstance(annotation, GenericClass):
+        return _matches_generic_class(annotation, value)
+    if annotation.is_class():
+        return _is_instance(value, annotation)
+    if _is_none(annotation):
+        return _is_none(value)
+    return False
+
+
+def _accepts_anything(annotation):
+    if not annotation:
+        return True
+    for a in annotation:
+        if isinstance(a, (AnyClass, SelfClass)):
+            return True
+        if isinstance(a, TypeVar):
+            if _matches_type_var(a, _accepts_anything):
+                return True
+        elif isinstance(a, ProxyWithGenerics) and not isinstance(a, TypingClassWithGenerics):
+            name = a.py__name__()
+            generics = a.get_generics()
+            if name in ('Union', 'Optional') and any(_accepts_anything(g) for g in generics) \
+                    or generics and name in ('ClassVar', 'Annotated', 'Final') \
+                    and _accepts_anything(generics[0]):
+                return True
+        elif a.is_class() and _is_builtin_class(a, 'object'):
+            return True
+    return False
+
+
+def _matches_type_var(type_var, check):
+    """``check`` is called with the annotation that the type var stands for."""
+    context = type_var.parent_context
+    bound = type_var.bound
+    if bound:
+        return check(ValueSet(_resolve_forward_references(context, bound)))
+    constraints = type_var.constraints
+    if constraints:
+        return any(check(ValueSet([c]))
+                   for c in _resolve_forward_references(context, constraints))
+    return True
+
+
+def _matches_literal(annotation, value):
+    safe_value = value.get_safe_value(default=_sentinel)
+    for literal in annotation.get_literal_values():
+        if literal == value:
+            return True
+        literal_value = literal.get_safe_value(default=_sentinel)
+        if safe_value is not _sentinel and literal_value is not _sentinel \
+                and type(safe_value) is type(literal_value) and safe_value == literal_value:
+            return True
+    return False
+
+
+def _class_matches(annotation, cls):
+    """Checks if the class ``cls`` is valid for ``type[annotation]``."""
+    if not annotation:
+        return True
+    for a in annotation:
+        if isinstance(a, (AnyClass, SelfClass)):
+            return True
+        if isinstance(a, TypeVar):
+            if _matches_type_var(a, lambda annotation: _class_matches(annotation, cls)):
+                return True
+        elif isinstance(a, ProxyWithGenerics) and not isinstance(a, TypingClassWithGenerics):
+            if a.py__name__() in ('Union', 'Optional') \
+                    and any(_class_matches(g, cls) for g in a.get_generics()):
+                return True
+        elif isinstance(a, TypeAlias):
+            if any(_is_subclass(cls, c) for c in a.gather_annotation_classes()):
+                return True
+        elif a.is_class() and _is_subclass(cls, a):
+            return True
+    return False
+
+
+def _matches_tuple(annotation, value):
+    if not _is_instance(value, _get_builtin(value, 'tuple')):
+        return False
+    generics = annotation.get_generics()
+    alternatives = get_sequence_alternatives(ValueSet([value]))
+    if annotation.is_homogenous_tuple():
+        return all(_values_match(generics[0], item.values)
+                   for alternative in alternatives
+                   for item in alternative if item.max > 0)
+
+    for alternative in alternatives:
+        expansions = _expand_items(alternative, len(generics) + 1)
+        if expansions is None:
+            return False
+        for values_list in expansions:
+            if len(values_list) != len(generics):
+                return False
+            if not all(_values_match(g, values) for g, values in zip(generics, values_list)):
+                return False
+    return True
+
+
+def _matches_callable(generics, value):
+    """An annotation like `Callable[[int], str]`, the parameters are ignored."""
+    if not _is_callable(value):
+        return False
+    if len(generics) == 2 and not _accepts_anything(generics[1]):
+        return _values_match(generics[1], value.execute_with_values())
+    return True
+
+
+def _matches_generic_class(annotation, value):
+    """An annotation like `list[int]` or `Mapping[str, T]`."""
+    if not _is_instance(value, annotation):
+        return False
+
+    annotation_generics = annotation.get_generics()
+    if all(_accepts_anything(g) for g in annotation_generics):
+        return True
+
+    arguments = _get_type_arguments(value, annotation)
+    for i, generic in enumerate(annotation_generics):
+        values = arguments[i] if i < len(arguments) else None
+        if values is None:
+            if not _accepts_anything(generic):
+                return False
+        elif not all(value_matches_annotation(generic, v) for v in values):
+            return False
+    return True
+
+
+def _get_type_arguments(value, cls):
+    """
+    Returns the values of the type arguments of ``cls`` for the instance
+    ``value``, e.g. `(int(),)` for `list[int]`. ``None`` is used for unknown
+    values.
+    """
+    arguments = get_container_type_arguments(value)
+    if arguments is not None:
+        # For the builtin containers the type parameters of the base classes
+        # have the same order, e.g. `dict(Mapping[K, V])` and
+        # `Mapping(Collection[K])`.
+        return arguments
+
+    try:
+        value_class = value.get_annotated_class_object()
+    except AttributeError:
+        value_class = value.py__class__()
+    for c in value_class.py__mro__():
+        if _same_class(c, cls):
+            if isinstance(c, DefineGenericBaseClass):
+                return tuple(_get_generic_values(g) for g in c.get_generics())
+            break
+    return ()
+
+
+def _get_generic_values(generic):
+    """Returns example values for a generic or None if they are unknown."""
+    if _accepts_anything(generic):
+        return None
+    values = generic.execute_annotation(None)
+    return values or None
+
+
+def _is_instance(value, cls):
+    if _is_builtin_class(cls, 'object'):
+        return True
+    classes = _get_value_classes(value)
+    if any(_is_subclass(c, cls) for c in classes):
+        return True
+
+    name = _get_builtin_name(cls)
+    if name in _PROMOTIONS:
+        for promoted in _PROMOTIONS[name]:
+            if any(_is_subclass(c, _get_builtin(value, promoted)) for c in classes):
+                return True
+
+    return _is_protocol(cls) and _has_protocol_members(cls, value)
+
+
+def _get_value_classes(value):
+    if isinstance(value, Tuple):
+        # The class of the instance is the `Tuple` of typing.
+        return [_get_builtin(value, 'tuple')]
+    try:
+        cls = value.py__class__()
+    except AttributeError:
+        return []
+    return [cls]
+
+
+def _is_subclass(cls, base):
+    if _mro_contains(cls, [base]):
+        return True
+    if cls.is_compiled() or base.is_compiled() or cls.is_stub() != base.is_stub():
+        # Compare the stubs, e.g. for the class of `True`, which is compiled.
+        bases = _to_stubs(base)
+        return any(_mro_contains(c, bases) for c in _to_stubs(cls))
+    return False
+
+
+def _mro_contains(cls, bases):
+    return any(_same_class(parent, b) for parent in cls.py__mro__() for b in bases)
+
+
+def _to_stubs(cls):
+    if not cls.is_stub():
+        stubs = to_stub(cls)
+        if stubs:
+            return list(stubs)
+    return [cls]
+
+
+def _same_class(cls1, cls2):
+    if cls1 == cls2:
+        return True
+    node = cls1.tree_node
+    return node is not None and node == cls2.tree_node
+
+
+def _get_builtin(value, name):
+    return builtin_from_name(value.inference_state, name)
+
+
+def _get_builtin_name(cls):
+    if cls.get_root_context().is_builtins_module():
+        return cls.py__name__()
+    return None
+
+
+def _is_builtin_class(cls, name):
+    return cls.py__name__() == name and _get_builtin_name(cls) == name
+
+
+def _is_none(value):
+    return value.get_safe_value(default=_sentinel) is None
+
+
+def _is_callable(value):
+    if isinstance(value, Tuple):
+        return False
+    return value.is_function() or value.is_class() or value.is_bound_method() \
+        or bool(value.py__getattribute__('__call__'))
+
+
+def _is_protocol(cls):
+    if cls.is_compiled():
+        return False
+    try:
+        bases = cls.py__bases__()
+    except AttributeError:
+        return False
+    return any(
+        base.py__name__() == 'Protocol'
+        and base.get_root_context().py__name__() in ('typing', 'typing_extensions')
+        for lazy_base in bases
+        for base in lazy_base.infer()
+    )
+
+
+def _has_protocol_members(cls, value):
+    names = set()
+    for c in cls.py__mro__():
+        if (c == cls or _is_protocol(c)) and c.tree_node is not None:
+            names |= {name.string_name for name in c.as_context().get_global_filter().values()}
+    return all(value.goto(name, analysis_errors=False) for name in names - _NOT_PROTOCOL_MEMBERS)
