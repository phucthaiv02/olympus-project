diff --git a/test/completion/pep0484_overload.py b/test/completion/pep0484_overload.py
index 45edeb5..34e7986 100644
--- a/test/completion/pep0484_overload.py
+++ b/test/completion/pep0484_overload.py
@@ -111,3 +111,406 @@ def typing_direct(x: str) -> str: ...
 typing_direct(1)
 #? str()
 typing_direct("")
+
+# -------------------------
+# type[...]
+# -------------------------
+
+from typing import Type, Optional, Union, Any
+
+
+class Foo: ...
+class SubFoo(Foo): ...
+class Bar: ...
+
+
+class FooBuilder:
+    def foo_method(self): ...
+
+
+class BarBuilder:
+    def bar_method(self): ...
+
+
+@overload
+def get_obj(input: type[Foo]) -> FooBuilder: ...
+@overload
+def get_obj(input: type[Bar]) -> BarBuilder: ...
+def get_obj(input): ...
+
+#? ['foo_method']
+get_obj(Foo).foo_m
+#? []
+get_obj(Foo).bar_m
+#? FooBuilder()
+get_obj(Foo)
+#? BarBuilder()
+get_obj(Bar)
+#? FooBuilder()
+get_obj(SubFoo)
+#? BarBuilder()
+get_obj(input=Bar)
+# Instances are not types, no overload matches
+#? FooBuilder() BarBuilder()
+get_obj(Foo())
+
+
+@overload
+def get_typing_type(input: Type[Foo]) -> FooBuilder: ...
+@overload
+def get_typing_type(input: Type[Union[Bar, int]]) -> BarBuilder: ...
+
+#? FooBuilder()
+get_typing_type(Foo)
+#? BarBuilder()
+get_typing_type(int)
+
+# -------------------------
+# TypeVars
+# -------------------------
+
+TBound = TypeVar('TBound', bound=Foo)
+TForward = TypeVar('TForward', bound='Bar')
+TConstrained = TypeVar('TConstrained', int, str)
+
+
+@overload
+def bound(x: TBound) -> FooBuilder: ...
+@overload
+def bound(x: TForward) -> BarBuilder: ...
+@overload
+def bound(x: object) -> int: ...
+
+#? FooBuilder()
+bound(SubFoo())
+#? BarBuilder()
+bound(Bar())
+#? int()
+bound(1)
+
+
+@overload
+def bound_type(x: type[TBound]) -> FooBuilder: ...
+@overload
+def bound_type(x: object) -> BarBuilder: ...
+
+#? FooBuilder()
+bound_type(SubFoo)
+#? BarBuilder()
+bound_type(Bar)
+
+
+@overload
+def constrained(x: TConstrained, y: TConstrained) -> FooBuilder: ...
+@overload
+def constrained(x: object, y: object) -> BarBuilder: ...
+
+#? FooBuilder()
+constrained(1, 2)
+#? FooBuilder()
+constrained('', '')
+# The same constraint has to be used for all arguments.
+#? BarBuilder()
+constrained(1, '')
+#? BarBuilder()
+constrained(1.0, 1.0)
+
+# -------------------------
+# Optional / Union / Any
+# -------------------------
+
+@overload
+def optional(x: Optional[Foo]) -> FooBuilder: ...
+@overload
+def optional(x: Bar | None) -> BarBuilder: ...
+
+#? FooBuilder()
+optional(None)
+#? FooBuilder()
+optional(SubFoo())
+#? BarBuilder()
+optional(Bar())
+
+
+@overload
+def union(x: Foo) -> FooBuilder: ...
+@overload
+def union(x: Union[Foo, Bar]) -> BarBuilder: ...
+
+union_value = Foo() if int() else Bar()
+# All the possible values have to be accepted.
+#? BarBuilder()
+union(union_value)
+#? BarBuilder()
+union(Foo() if int() else Bar())
+#? FooBuilder()
+union(Foo() if int() else SubFoo())
+
+
+@overload
+def any_overload(x: Any) -> FooBuilder: ...
+@overload
+def any_overload(x: object) -> BarBuilder: ...
+
+#? FooBuilder()
+any_overload(undefined_name)
+
+
+@overload
+def float_overload(x: float) -> FooBuilder: ...
+@overload
+def float_overload(x: object) -> BarBuilder: ...
+
+#? FooBuilder()
+float_overload(1)
+#? BarBuilder()
+float_overload('')
+
+# -------------------------
+# Containers
+# -------------------------
+
+@overload
+def container_list(x: list[Foo]) -> FooBuilder: ...
+@overload
+def container_list(x: list[object]) -> BarBuilder: ...
+@overload
+def container_list(x: object) -> int: ...
+
+#? FooBuilder()
+container_list([Foo(), SubFoo()])
+#? BarBuilder()
+container_list([Foo(), Bar()])
+#? FooBuilder()
+container_list([])
+#? FooBuilder()
+container_list([x for x in []])
+#? BarBuilder()
+container_list([Bar() for x in [1]])
+#? int()
+container_list((Foo(),))
+bars = [Bar()]
+#? BarBuilder()
+container_list([Foo(), *bars])
+#? FooBuilder()
+container_list(list_of_foo := [Foo()])
+
+
+@overload
+def container_dict(x: dict[str, Foo]) -> FooBuilder: ...
+@overload
+def container_dict(x: dict[bool, Foo]) -> float: ...
+@overload
+def container_dict(x: dict[int, Foo]) -> BarBuilder: ...
+@overload
+def container_dict(x: object) -> int: ...
+
+#? FooBuilder()
+container_dict({'a': Foo()})
+#? int()
+container_dict({'a': Foo(), 'b': Bar()})
+#? FooBuilder()
+container_dict({'a': Bar(), 'a': Foo()})
+# 1 and True are the same key, the first key stays, the last value is used.
+#? BarBuilder()
+container_dict({1: Bar(), True: Foo()})
+#? float()
+container_dict({True: Bar(), 1: Foo()})
+replacement = {'a': Bar()}
+#? int()
+container_dict({'a': Foo(), **replacement})
+#? FooBuilder()
+container_dict({'a': Bar(), **{'a': Foo()}})
+#? FooBuilder()
+container_dict({k: Foo() for k in ['a']})
+
+
+@overload
+def container_tuple(x: tuple[Foo, Bar]) -> FooBuilder: ...
+@overload
+def container_tuple(x: Tuple[Foo, ...]) -> BarBuilder: ...
+@overload
+def container_tuple(x: object) -> int: ...
+
+#? FooBuilder()
+container_tuple((Foo(), Bar()))
+#? BarBuilder()
+container_tuple((Foo(), SubFoo(), Foo()))
+#? BarBuilder()
+container_tuple(())
+#? int()
+container_tuple((Foo(), Bar(), Bar()))
+#? int()
+container_tuple([Foo(), Bar()])
+typed_tuple: Tuple[Foo, Bar]
+#? FooBuilder()
+container_tuple(typed_tuple)
+maybe_bar = (Bar(),) if int() else ()
+#? int()
+container_tuple((Foo(), *maybe_bar))
+maybe_foo = (Foo(),) if int() else ()
+#? BarBuilder()
+container_tuple((Foo(), *maybe_foo))
+
+
+@overload
+def invariant_list(x: list[int]) -> FooBuilder: ...
+@overload
+def invariant_list(x: list[float]) -> BarBuilder: ...
+
+list_of_float: list[float]
+#? BarBuilder()
+invariant_list(list_of_float)
+
+# -------------------------
+# *args and **kwargs
+# -------------------------
+
+@overload
+def star_args(*args: Foo) -> FooBuilder: ...
+@overload
+def star_args(*args: object) -> BarBuilder: ...
+
+#? FooBuilder()
+star_args(Foo(), SubFoo())
+#? BarBuilder()
+star_args(Foo(), Bar())
+#? FooBuilder()
+star_args(*[Foo(), Foo()])
+
+
+@overload
+def star_kwargs(**kwargs: Foo) -> FooBuilder: ...
+@overload
+def star_kwargs(**kwargs: object) -> BarBuilder: ...
+
+#? FooBuilder()
+star_kwargs(a=Foo(), b=SubFoo())
+#? BarBuilder()
+star_kwargs(a=Foo(), b=Bar())
+#? BarBuilder()
+star_kwargs(**{'a': Foo(), 'b': Bar()})
+
+# -------------------------
+# Unpacking of literals
+# -------------------------
+
+@overload
+def two(a: Foo, b: Bar) -> FooBuilder: ...
+@overload
+def two(a: Bar, b: Foo) -> BarBuilder: ...
+
+#? FooBuilder()
+two(*[Foo(), Bar()])
+#? BarBuilder()
+two(*(Bar(), Foo()))
+foo_bar = [Foo(), Bar()]
+#? FooBuilder()
+two(*foo_bar)
+#? FooBuilder()
+two(*[Foo(), *bars])
+#? BarBuilder()
+two(Bar(), *[Foo()])
+#? FooBuilder()
+two(Foo(), *[x for x in []], Bar())
+#? FooBuilder()
+two(**{'a': Foo(), 'b': Bar()})
+#? BarBuilder()
+two(**{'a': Bar(), **{'b': Foo()}})
+#? BarBuilder()
+two(**{'a': Bar(), 'b': Bar(), 'b': Foo()})
+#? FooBuilder()
+two(Foo(), **{'b': Bar()})
+bar_foo_kwargs = {'a': Bar(), 'b': Foo()}
+#? BarBuilder()
+two(**bar_foo_kwargs)
+
+
+@overload
+def keyword_only(*, a: Foo) -> FooBuilder: ...
+@overload
+def keyword_only(*, a: object) -> BarBuilder: ...
+
+maybe_a = {'a': Bar()} if int() else {}
+# The entry might be absent, so a can be Foo or Bar.
+#? BarBuilder()
+keyword_only(**{'a': Foo(), **maybe_a})
+always_a = {'a': Foo()}
+#? FooBuilder()
+keyword_only(**{'a': Bar(), **always_a})
+
+
+@overload
+def maybe_two(a: Foo, b: Bar) -> FooBuilder: ...
+@overload
+def maybe_two(a: Bar) -> BarBuilder: ...
+@overload
+def maybe_two(a: object, b: object = None) -> int: ...
+
+maybe_foos = [Foo()] if int() else []
+# The Bar can be the first or the second argument.
+#? int()
+maybe_two(*maybe_foos, Bar())
+#? FooBuilder()
+maybe_two(*[Foo()], Bar())
+#? BarBuilder()
+maybe_two(*[], Bar())
+#? BarBuilder()
+maybe_two(*[x for x in []], Bar())
+
+# -------------------------
+# Methods and Self
+# -------------------------
+
+from typing import Self
+
+
+class WithMethods:
+    @overload
+    def method(self, x: type[Foo]) -> FooBuilder: ...
+    @overload
+    def method(self, x: type[Bar]) -> BarBuilder: ...
+
+    @overload
+    @classmethod
+    def class_method(cls, x: type[Foo]) -> FooBuilder: ...
+    @overload
+    @classmethod
+    def class_method(cls, x: type[Bar]) -> BarBuilder: ...
+
+    @overload
+    def with_self(self, x: Self) -> FooBuilder: ...
+    @overload
+    def with_self(self, x: object) -> BarBuilder: ...
+
+#? BarBuilder()
+WithMethods().method(Bar)
+#? BarBuilder()
+WithMethods.class_method(Bar)
+#? FooBuilder()
+WithMethods().with_self(WithMethods())
+#? BarBuilder()
+WithMethods().with_self(Foo())
+
+# -------------------------
+# Literal
+# -------------------------
+
+from typing import Literal
+
+
+@overload
+def literal(x: Literal['r', 'w']) -> FooBuilder: ...
+@overload
+def literal(x: Literal[1]) -> BarBuilder: ...
+@overload
+def literal(x: object) -> int: ...
+
+#? FooBuilder()
+literal('r')
+#? BarBuilder()
+literal(1)
+#? int()
+literal(True)
+#? int()
+literal('rb')
