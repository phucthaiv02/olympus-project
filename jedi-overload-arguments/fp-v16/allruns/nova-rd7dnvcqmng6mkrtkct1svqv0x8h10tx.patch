+                    if not _annotation_set_accepts_values(t_gen_set, obj_val, typevar_env, context, _depth + 1):
+                        return False
+                    continue
+                unbounded_tvs = [
+                    g for g in a_gen_set
+                    if isinstance(g, TypeVar)
+                    and g._bound_lazy_value is None
+                    and not g._constraints_lazy_values
+                ]
+                if unbounded_tvs:
+                    obj_val = compiled.builtin_from_name(
+                        candidate_cls.inference_state, 'object'
+                    ).execute_annotation(None)
+                    if not _annotation_set_accepts_values(t_gen_set, obj_val, typevar_env, context, _depth + 1):
+                        return False
+                actual_values = a_gen_set.execute_annotation(None)
+                if actual_values and not _annotation_set_accepts_values(
+                    t_gen_set, actual_values, typevar_env, context, _depth + 1
+                ):
+                    return False
+            return True
+    return False
