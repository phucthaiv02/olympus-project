+def _expand_pos_items(pos_items, max_var_len):
+    seqs = [((), True)]
+    for item in pos_items:
+        if isinstance(item, iterable.VarPositionalItem):
+            vs = item.value_set
+            choices = [(tuple([vs] * k), k >= 1) for k in range(max_var_len + 1)]
+            seqs = [(s + c, all_pos and c_pos) for s, all_pos in seqs for c, c_pos in choices][:64]
+        else:
+            seqs = [(s + (item,), all_pos) for s, all_pos in seqs]
+    return seqs
+
+
+def _bind_call_config_to_params(cfg, param_names, inference_state):
+    if cfg.invalid:
+        return None
+
+    pos_params = []
+    var_pos_param = None
+    kw_map = {}
+    var_kw_param = None
+    all_named_params = []
+
+    for p in param_names:
+        kind = p.get_kind()
+        if kind == Parameter.POSITIONAL_ONLY:
+            pos_params.append(p)
+            all_named_params.append(p)
+        elif kind == Parameter.POSITIONAL_OR_KEYWORD:
+            pos_params.append(p)
+            kw_map[p.string_name] = p
+            all_named_params.append(p)
+        elif kind == Parameter.VAR_POSITIONAL:
+            var_pos_param = p
+        elif kind == Parameter.KEYWORD_ONLY:
+            kw_map[p.string_name] = p
+            all_named_params.append(p)
+        elif kind == Parameter.VAR_KEYWORD:
+            var_kw_param = p
+
+    has_var_pos_items = any(isinstance(item, iterable.VarPositionalItem) for item in cfg.pos)
+    expanded_pos_seqs = _expand_pos_items(cfg.pos, len(pos_params) + 1)
+    bound_list = []
+    has_nonempty_var_expansion = not has_var_pos_items
+
+    for pos_seq, all_var_nonempty in expanded_pos_seqs:
+        if len(pos_seq) > len(pos_params) and var_pos_param is None:
+            if has_var_pos_items:
+                continue
+            return None
+
+        bound_args = defaultdict(list)
+        pos_bound_params = set()
+        for i, item in enumerate(pos_seq):
+            if i < len(pos_params):
+                p = pos_params[i]
+                bound_args[p].append(item)
+                pos_bound_params.add(p)
+            else:
+                bound_args[var_pos_param].append(item)
+
+        kw_conflict = False
+        for k_str, val_set in cfg.kw.items():
+            if k_str in kw_map:
+                p = kw_map[k_str]
+                if p in pos_bound_params:
+                    kw_conflict = True
+                    break
+                bound_args[p].append(val_set)
+            else:
+                if var_kw_param is None:
+                    return None
+                bound_args[var_kw_param].append(val_set)
+        if kw_conflict:
+            if has_var_pos_items:
+                continue
+            return None
+
+        if cfg.unknown_kw:
+            str_cls = _normalize_class(compiled.builtin_from_name(inference_state, 'str'))
+            unmatched_kw_params = [
+                p for p in kw_map.values()
+                if p not in pos_bound_params and p.string_name not in cfg.kw
+            ]
+            if var_kw_param is None and not unmatched_kw_params:
+                if has_var_pos_items:
+                    continue
+                return None
+            for k_vs, v_vs in cfg.unknown_kw:
+                if k_vs:
+                    for k in k_vs:
+                        if not (
+                            is_string(k)
+                            or (k.is_instance() and _is_subclass(k.py__class__(), str_cls))
+                        ):
+                            return None
+                for p in unmatched_kw_params:
+                    bound_args[p].append(v_vs)
+                if var_kw_param is not None:
+                    bound_args[var_kw_param].append(v_vs)
+
+        missing_required = False
+        for p in all_named_params:
+            if p not in bound_args and p.default_node is None:
+                missing_required = True
+                break
+        if missing_required:
+            if has_var_pos_items:
+                continue
+            return None
+
+        if all_var_nonempty:
+            has_nonempty_var_expansion = True
+        bound_list.append(bound_args)
+
+    if not bound_list or not has_nonempty_var_expansion:
+        return None
+    return bound_list
+
