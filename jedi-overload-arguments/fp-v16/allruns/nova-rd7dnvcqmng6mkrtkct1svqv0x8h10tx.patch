+def _build_call_configs(arguments, function_value):
+    from jedi.inference.arguments import TreeArguments, unpack_arglist
+    from jedi.inference.value.instance import InstanceArguments
+    from jedi.plugins.stdlib import ClassMethodArguments
+
+    is_ctor = function_value.name.string_name in ('__init__', '__new__')
+    initial_pos = []
+    raw_args = arguments
+    while isinstance(raw_args, (InstanceArguments, ClassMethodArguments)):
+        if is_ctor:
+            initial_pos.append(_IMPLICIT_RECEIVER)
+        elif isinstance(raw_args, InstanceArguments):
+            initial_pos.append(ValueSet([raw_args.instance]))
+        else:
+            initial_pos.append(ValueSet([raw_args._class]))
+        raw_args = raw_args._wrapped_arguments
+
+    if not isinstance(raw_args, TreeArguments):
+        cfg = _CallConfig(pos=initial_pos)
+        for key, lazy_val in raw_args.unpack():
+            if key is None:
+                cfg.pos.append(lazy_val.infer())
+            else:
+                if key in cfg.kw:
+                    cfg.invalid = True
+                else:
+                    cfg.kw[key] = lazy_val.infer()
+        return [cfg]
+
+    configs = [_CallConfig(pos=initial_pos)]
+    for star_count, el in unpack_arglist(raw_args.argument_node):
+        if star_count == 1:
+            unpacked_set = raw_args.context.infer_node(el)
+            if not unpacked_set:
+                for cfg in configs:
+                    cfg.pos.append(iterable.VarPositionalItem(NO_VALUES))
+            else:
+                next_configs = []
+                for u_val in unpacked_set:
+                    seq_poss = iterable.get_sequence_possibilities(u_val)
+                    if seq_poss is None:
+                        for cfg in configs:
+                            forked = cfg.copy()
+                            forked.invalid = True
+                            next_configs.append(forked)
+                    else:
+                        for cfg in configs:
+                            for seq in seq_poss:
+                                forked = cfg.copy()
+                                forked.pos.extend(seq)
+                                next_configs.append(forked)
+                                if len(next_configs) >= 64:
+                                    break
+                            if len(next_configs) >= 64:
+                                break
+                configs = next_configs
+        elif star_count == 2:
+            unpacked_set = raw_args.context.infer_node(el)
+            if not unpacked_set:
+                for cfg in configs:
+                    cfg.unknown_kw.append((NO_VALUES, NO_VALUES))
+            else:
+                next_configs = []
+                for u_val in unpacked_set:
+                    dict_poss = iterable.get_dict_possibilities(u_val)
+                    if dict_poss is None:
+                        for cfg in configs:
+                            forked = cfg.copy()
+                            forked.invalid = True
+                            next_configs.append(forked)
+                    else:
+                        for cfg in configs:
+                            for d_poss in dict_poss:
+                                forked = cfg.copy()
+                                for h_key, (k_vs, v_vs) in d_poss.known.items():
+                                    if not k_vs or any(not is_string(k) for k in k_vs):
+                                        forked.invalid = True
+                                    else:
+                                        k_str = next(iter(k_vs)).get_safe_value()
+                                        if k_str in forked.kw:
+                                            forked.invalid = True
+                                        else:
+                                            forked.kw[k_str] = v_vs
+                                forked.unknown_kw.extend(d_poss.unknown)
+                                next_states_entry = forked
+                                next_configs.append(next_states_entry)
+                                if len(next_configs) >= 64:
+                                    break
+                            if len(next_configs) >= 64:
+                                break
+                configs = next_configs
+        else:
+            if el.type == 'argument':
+                c = el.children
+                if len(c) == 3:
+                    key = c[0].value
+                    val_set = raw_args.context.infer_node(c[2])
+                    for cfg in configs:
+                        if key in cfg.kw:
+                            cfg.invalid = True
+                        else:
+                            cfg.kw[key] = val_set
+                else:
+                    sync_comp_for = c[1]
+                    if sync_comp_for.type == 'comp_for':
+                        sync_comp_for = sync_comp_for.children[1]
+                    comp = iterable.GeneratorComprehension(
+                        raw_args._inference_state,
+                        defining_context=raw_args.context,
+                        sync_comp_for_node=sync_comp_for,
+                        entry_node=c[0],
+                    )
+                    val_set = ValueSet([comp])
+                    for cfg in configs:
+                        cfg.pos.append(val_set)
+            else:
+                val_set = raw_args.context.infer_node(el)
+                for cfg in configs:
+                    cfg.pos.append(val_set)
+
+    return configs
+
+
+def matches_overload_signature(function_value, arguments):
+    configs = _build_call_configs(arguments, function_value)
+    if not configs or any(cfg.invalid for cfg in configs):
+        return False
+
+    param_names = function_value.get_param_names()
+    all_bound_configs = []
+    for cfg in configs:
+        bound_list = _bind_call_config_to_params(cfg, param_names, function_value.inference_state)
+        if bound_list is None:
+            return False
+        all_bound_configs.extend(bound_list)
+
+    param_annotations = {
+        p: p.infer_annotation(execute_annotation=False, ignore_stars=True)
+        for p in param_names
+    }
+
+    context = function_value.get_default_param_context()
+    for bound_cfg in all_bound_configs:
+        for p, val_sets in bound_cfg.items():
+            ann_set = param_annotations.get(p)
+            if not ann_set:
+                continue
+            for val_set in val_sets:
+                if not _annotation_set_accepts_values(ann_set, val_set, {}, context):
+                    return False
+    return True
+
