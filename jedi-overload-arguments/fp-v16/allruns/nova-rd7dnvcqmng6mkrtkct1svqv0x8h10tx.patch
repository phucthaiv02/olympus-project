+    def build_foo(self) -> Foo: ...
+
+class BarBuilder:
+    def build_bar(self) -> Bar: ...
+
+@overload
+def get_obj(input: type[Foo]) -> FooBuilder: ...
+@overload
+def get_obj(input: type[Bar]) -> BarBuilder: ...
+
+#? ['build_foo']
+get_obj(Foo).build_
+#? ['build_foo']
+get_obj(SubFoo).build_
+#? ['build_bar']
+get_obj(Bar).build_
+#? ['build_foo']
+get_obj(input=Foo).build_
+#? ['build_bar', 'build_foo']
+get_obj(Baz).build_
+#? ['build_bar', 'build_foo']
+get_obj(Foo()).build_
