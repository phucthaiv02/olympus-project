+def _generic_class_accepts_value(ann, val, typevar_env, context, _depth=0):
+    from jedi.inference.gradual.typing import Tuple
+
+    base_target = _unwrap_generic_class(ann._class_value)
+    if base_target.py__name__() == 'Callable':
+        return _callable_annotation_accepts_value(ann, val, typevar_env, context, _depth + 1)
+
+    if _is_none_value(val) or val.is_function() or val.is_module():
+        return False
+    if val.is_class():
+        if not any(_is_subclass(m, base_target) for m in val.get_metaclasses()):
+            return False
+        return True
+
+    if not val.is_instance():
+        return False
+
+    val_cls = val.py__class__()
+    if not _is_subclass(val_cls, base_target):
+        return False
+
+    target_generics = ann.get_generics()
+    if not target_generics:
+        return True
+
+    if isinstance(val, (iterable.DictLiteralValue, iterable.DictComprehension, iterable.FakeDict)):
+        dict_poss = iterable.get_dict_possibilities(val)
+        if dict_poss is None:
+            return False
+        if len(target_generics) >= 2:
+            key_ann_set, val_ann_set = target_generics[0], target_generics[1]
+            for poss in dict_poss:
+                for k_vs, v_vs in poss.iter_entries():
+                    if not _annotation_set_accepts_values(key_ann_set, k_vs, typevar_env, context, _depth + 1):
+                        return False
+                    if not _annotation_set_accepts_values(val_ann_set, v_vs, typevar_env, context, _depth + 1):
+                        return False
+            return True
+        else:
+            key_ann_set = target_generics[0]
+            for poss in dict_poss:
+                for k_vs, _ in poss.iter_entries():
+                    if not _annotation_set_accepts_values(key_ann_set, k_vs, typevar_env, context, _depth + 1):
+                        return False
+            return True
+
+    if isinstance(val, (
+        iterable.SequenceLiteralValue,
+        iterable._BaseComprehension,
+        iterable._FakeSequence,
+        iterable.MergedArray,
+        Tuple,
+    )):
+        seq_poss = iterable.get_sequence_possibilities(val)
+        if seq_poss is None:
+            return False
+        elem_ann_set = target_generics[0]
+        for seq in seq_poss:
+            for item in seq:
+                item_vs = item.value_set if isinstance(item, iterable.VarPositionalItem) else item
+                if not _annotation_set_accepts_values(elem_ann_set, item_vs, typevar_env, context, _depth + 1):
+                    return False
+        return True
+
+    try:
+        annotated_cls = _normalize_class(val.get_annotated_class_object())
+    except AttributeError:
+        annotated_cls = val_cls
+
+    return _class_matches_generic_class(annotated_cls, ann, typevar_env, context, _depth + 1)
+
+
+def _type_target_accepts_value(target, val, typevar_env, context, _depth=0):
+    from jedi.inference.gradual.typing import AnyClass, ProxyWithGenerics, \
+        ProxyTypingClassValue, TypeAlias, IGNORE_ANNOTATION_PARTS
+    from jedi.inference.gradual.base import GenericClass
+    from jedi.inference.gradual.type_var import TypeVar
+
+    if _depth > 20:
+        return True
+    if isinstance(target, AnyClass):
+        return _is_type_value(val)
+    if isinstance(target, TypeVar):
+        if target in typevar_env:
+            return any(
+                _type_target_accepts_value(t, val, typevar_env, context, _depth + 1)
+                for t in typevar_env[target]
+            )
+        if target._bound_lazy_value is not None:
+            bound_set = target.get_bound()
+            if not bound_set:
+                return _is_type_value(val)
+            return any(
+                _type_target_accepts_value(t, val, typevar_env, context, _depth + 1)
+                for t in bound_set
+            )
+        if target._constraints_lazy_values:
+            return any(
+                _type_target_accepts_value(t, val, typevar_env, context, _depth + 1)
+                for c_set in target.iter_constraints()
+                for t in c_set
+            )
+        return _is_type_value(val)
+    if isinstance(target, ProxyWithGenerics):
+        t_name = target._tree_name.value
+        if t_name == 'Union':
+            return any(
+                _type_target_accepts_value(t, val, typevar_env, context, _depth + 1)
+                for t in target.gather_annotation_classes()
+            )
+        if t_name == 'Optional':
+            if val.is_class() and val.py__name__() == 'NoneType':
+                return True
+            return any(
+                _type_target_accepts_value(t, val, typevar_env, context, _depth + 1)
+                for t in target.gather_annotation_classes()
+            )
+        if t_name in IGNORE_ANNOTATION_PARTS:
+            try:
+                inner = target._generics_manager[0]
+            except IndexError:
+                return _is_type_value(val)
+            return any(
+                _type_target_accepts_value(t, val, typevar_env, context, _depth + 1)
+                for t in inner
+            )
+    if isinstance(target, TypeAlias):
+        target = target._get_wrapped_value()
+    if _is_none_value(target):
+        return val.is_class() and val.py__name__() == 'NoneType'
+    if target.is_class():
+        norm_target = _normalize_class(target)
+        if norm_target.py__name__() == 'object' and norm_target.get_root_context().is_builtins_module():
+            return _is_type_value(val)
+        if not val.is_class() or isinstance(val, (ProxyWithGenerics, ProxyTypingClassValue)):
+            return False
+        norm_val = _normalize_class(val)
+        if isinstance(target, GenericClass):
+            if not _is_subclass(norm_val, target._class_value):
+                return False
+            return _class_matches_generic_class(norm_val, target, typevar_env, context, _depth + 1)
+        return _is_subclass(norm_val, norm_target)
+    return _is_type_value(val)
+
+
+def _single_annotation_accepts_value(ann, val, typevar_env, context, _depth=0):
+    from jedi.inference.gradual.typing import AnyClass, ProxyWithGenerics, \
+        ProxyTypingClassValue, TypeAlias, Tuple, IGNORE_ANNOTATION_PARTS
+    from jedi.inference.gradual.base import GenericClass
+    from jedi.inference.gradual.type_var import TypeVar
+
+    if _depth > 20:
+        return True
+    if isinstance(ann, AnyClass):
+        return True
+    if _is_none_value(ann):
+        return _is_none_value(val)
+    if isinstance(ann, TypeVar):
+        if ann in typevar_env:
+            return _annotation_set_accepts_values(
+                typevar_env[ann], ValueSet([val]), typevar_env, context, _depth + 1
+            )
+        if ann._bound_lazy_value is not None:
+            bound_set = ann.get_bound()
+            if not bound_set:
+                return True
+            return _annotation_set_accepts_values(
+                bound_set, ValueSet([val]), typevar_env, context, _depth + 1
+            )
+        if ann._constraints_lazy_values:
+            return any(
+                _annotation_set_accepts_values(
+                    c_set, ValueSet([val]), typevar_env, context, _depth + 1
+                )
+                for c_set in ann.iter_constraints()
+            )
+        return True
+    if isinstance(ann, ProxyWithGenerics):
+        ann_name = ann._tree_name.value
+        if ann_name == 'Union':
+            return _annotation_set_accepts_values(
+                ann.gather_annotation_classes(), ValueSet([val]), typevar_env, context, _depth + 1
+            )
+        if ann_name == 'Optional':
+            if _is_none_value(val):
+                return True
+            return _annotation_set_accepts_values(
+                ann.gather_annotation_classes(), ValueSet([val]), typevar_env, context, _depth + 1
+            )
+        if ann_name in IGNORE_ANNOTATION_PARTS:
+            try:
+                inner = ann._generics_manager[0]
+            except IndexError:
+                return True
+            return _annotation_set_accepts_values(
+                inner, ValueSet([val]), typevar_env, context, _depth + 1
+            )
+        if ann_name == 'Type':
+            try:
+                target_set = ann._generics_manager[0]
+            except IndexError:
+                return _is_type_value(val)
+            if not target_set:
+                return _is_type_value(val)
+            return any(
+                _type_target_accepts_value(target, val, typevar_env, context, _depth + 1)
+                for target in target_set
+            )
+        if ann_name == 'Tuple':
+            return _tuple_annotation_accepts_value(
+                ann._generics_manager, val, typevar_env, context, _depth + 1
+            )
+        if ann_name == 'Callable':
+            return _callable_annotation_accepts_value(ann, val, typevar_env, context, _depth + 1)
+        return True
+    if isinstance(ann, Tuple):
+        return _tuple_annotation_accepts_value(
+            ann._generics_manager, val, typevar_env, context, _depth + 1
+        )
+    if isinstance(ann, ProxyTypingClassValue):
+        ann_name = ann._tree_name.value
+        if ann_name == 'Type':
+            return _is_type_value(val)
+        if ann_name == 'Tuple':
+            return _is_tuple_instance(val)
+        if ann_name == 'Callable':
+            return _is_callable_value(val)
+        return True
+    if isinstance(ann, GenericClass):
+        return _generic_class_accepts_value(ann, val, typevar_env, context, _depth + 1)
+    if isinstance(ann, TypeAlias):
+        ann = ann._get_wrapped_value()
+    if ann.is_class():
+        norm_ann = _normalize_class(ann)
+        if norm_ann.py__name__() == 'object' and norm_ann.get_root_context().is_builtins_module():
+            return True
+        if norm_ann.py__name__() == 'type' and norm_ann.get_root_context().is_builtins_module():
+            return _is_type_value(val)
+        if _is_none_value(val):
+            return False
+        if val.is_class():
+            if isinstance(val, (ProxyTypingClassValue, ProxyWithGenerics)):
+                return False
+            return any(
+                _is_subclass(m, norm_ann)
+                for m in val.get_metaclasses()
+            )
+        if val.is_function() or val.is_bound_method():
+            if norm_ann.py__name__() in ('Callable', 'function', 'FunctionType', 'MethodType'):
+                return True
+            return _is_subclass(val.py__class__(), norm_ann)
+        if val.is_instance():
+            return _is_subclass(val.py__class__(), norm_ann)
+        return False
+    return False
+
+
+def _annotation_set_accepts_values(ann_set, val_set, typevar_env, context, _depth=0):
+    if _depth > 20:
+        return True
+    if not ann_set or val_set is _IMPLICIT_RECEIVER:
+        return True
+    if not val_set:
+        val_set = compiled.builtin_from_name(
+            context.inference_state, 'object'
+        ).execute_annotation(None)
+    return all(
+        any(
+            _single_annotation_accepts_value(ann, val, typevar_env, context, _depth + 1)
+            for ann in ann_set
+        )
+        for val in val_set
+    )
+
