diff --git a/test/completion/pep0484_overload.py b/test/completion/pep0484_overload.py
index 45edeb5..75a4868 100644
--- a/test/completion/pep0484_overload.py
+++ b/test/completion/pep0484_overload.py
@@ -111,3 +111,305 @@ def typing_direct(x: str) -> str: ...
 typing_direct(1)
 #? str()
 typing_direct("")
+
+# -------------------------
+# type[...]
+# -------------------------
+
+from typing import Any, Optional, Type, Union
+
+
+class Foo: ...
+class Bar: ...
+class SubFoo(Foo): ...
+class Other: ...
+class FooBuilder:
+    def foo_method(self): ...
+class BarBuilder:
+    def bar_method(self): ...
+
+
+@overload
+def get_obj(input: type[Foo]) -> FooBuilder: ...
+@overload
+def get_obj(input: type[Bar]) -> BarBuilder: ...
+def get_obj(input): ...
+
+#? FooBuilder()
+get_obj(Foo)
+#? BarBuilder()
+get_obj(Bar)
+#? FooBuilder()
+get_obj(SubFoo)
+#? BarBuilder()
+get_obj(input=Bar)
+#? ['foo_method']
+get_obj(Foo).foo_meth
+#? []
+get_obj(Foo).bar_meth
+#? FooBuilder() BarBuilder()
+get_obj(Foo())
+#? FooBuilder() BarBuilder()
+get_obj(Foo if UNDEFINED else Bar)
+
+type_bar: Type[Bar]
+#? BarBuilder()
+get_obj(type_bar)
+
+
+@overload
+def typing_type(input: Type[Foo]) -> FooBuilder: ...
+@overload
+def typing_type(input: Type[Bar]) -> BarBuilder: ...
+
+#? BarBuilder()
+typing_type(Bar)
+
+
+class WithMethods:
+    @overload
+    def get(self, input: type[Foo]) -> FooBuilder: ...
+    @overload
+    def get(self, input: type[Bar]) -> BarBuilder: ...
+    def get(self, input): ...
+
+    @overload
+    @classmethod
+    def class_get(cls, input: type[Foo]) -> FooBuilder: ...
+    @overload
+    @classmethod
+    def class_get(cls, input: type[Bar]) -> BarBuilder: ...
+    @classmethod
+    def class_get(cls, input): ...
+
+#? BarBuilder()
+WithMethods().get(Bar)
+#? FooBuilder()
+WithMethods().get(input=Foo)
+#? BarBuilder()
+WithMethods.class_get(Bar)
+
+# -------------------------
+# TypeVars
+# -------------------------
+
+BoundT = TypeVar('BoundT', bound=Foo)
+ConstrainedT = TypeVar('ConstrainedT', int, str)
+
+
+@overload
+def bound(x: BoundT) -> FooBuilder: ...
+@overload
+def bound(x: object) -> BarBuilder: ...
+
+#? FooBuilder()
+bound(SubFoo())
+#? BarBuilder()
+bound(Bar())
+
+
+@overload
+def bound_type(x: type[BoundT]) -> FooBuilder: ...
+@overload
+def bound_type(x: Any) -> BarBuilder: ...
+
+#? FooBuilder()
+bound_type(SubFoo)
+#? BarBuilder()
+bound_type(Bar)
+
+
+@overload
+def constrained(x: ConstrainedT, y: ConstrainedT) -> FooBuilder: ...
+@overload
+def constrained(x: object, y: object) -> BarBuilder: ...
+
+#? FooBuilder()
+constrained(1, 2)
+#? FooBuilder()
+constrained('', '')
+#? BarBuilder()
+constrained(1, '')
+#? BarBuilder()
+constrained(1.0, 1.0)
+
+# -------------------------
+# Optional and Union
+# -------------------------
+
+@overload
+def optional(x: Optional[Foo]) -> FooBuilder: ...
+@overload
+def optional(x: Bar) -> BarBuilder: ...
+
+#? FooBuilder()
+optional(None)
+#? FooBuilder()
+optional(Foo())
+#? BarBuilder()
+optional(Bar())
+#? FooBuilder()
+optional(Foo() if UNDEFINED else None)
+#? FooBuilder() BarBuilder()
+optional(Bar() if UNDEFINED else None)
+
+
+@overload
+def union(x: Foo) -> FooBuilder: ...
+@overload
+def union(x: Union[Foo, Bar]) -> BarBuilder: ...
+
+foo_or_bar: Union[Foo, Bar]
+#? BarBuilder()
+union(foo_or_bar)
+#? BarBuilder()
+union(Foo() if UNDEFINED else Bar())
+#? FooBuilder()
+union(Foo())
+
+# -------------------------
+# Containers
+# -------------------------
+
+@overload
+def container(x: list[Foo]) -> FooBuilder: ...
+@overload
+def container(x: list[Bar]) -> BarBuilder: ...
+@overload
+def container(x: dict[str, Foo]) -> str: ...
+@overload
+def container(x: tuple[Foo, Bar]) -> int: ...
+@overload
+def container(x: list[type[Foo]]) -> float: ...
+
+#? FooBuilder()
+container([Foo(), SubFoo()])
+#? BarBuilder()
+container([Bar()])
+#? FooBuilder() BarBuilder() str() int() float()
+container([Foo(), Bar()])
+#? str()
+container({'a': Foo()})
+#? FooBuilder() BarBuilder() str() int() float()
+container({'a': Foo(), 'b': Bar()})
+#? int()
+container((Foo(), Bar()))
+#? FooBuilder() BarBuilder() str() int() float()
+container((Bar(), Foo()))
+#? FooBuilder() BarBuilder() str() int() float()
+container((Foo(), Bar(), Bar()))
+#? float()
+container([Foo, SubFoo])
+list_bar: List[Bar]
+#? BarBuilder()
+container(list_bar)
+dict_foo: Dict[str, Foo]
+#? str()
+container(dict_foo)
+# The last value of a key wins.
+#? str()
+container({'a': Bar(), 'a': Foo()})
+#? FooBuilder() BarBuilder() str() int() float()
+container({'a': Foo(), 'a': Bar()})
+
+
+@overload
+def keys(x: dict[int, Foo]) -> FooBuilder: ...
+@overload
+def keys(x: dict[bool, Any]) -> BarBuilder: ...
+@overload
+def keys(x: object) -> str: ...
+
+# Python keeps the first key: {1: Foo()} and {True: Foo()}
+#? FooBuilder()
+keys({1: Bar(), True: Foo()})
+#? BarBuilder()
+keys({True: Bar(), 1: Bar()})
+#? str()
+keys({1: Bar(), True: Bar()})
+#? FooBuilder()
+keys({})
+# A comprehension over an empty literal has no elements.
+#? FooBuilder()
+keys({x: Bar() for x in []})
+
+# -------------------------
+# *args and **kwargs
+# -------------------------
+
+@overload
+def args(*args: Foo) -> FooBuilder: ...
+@overload
+def args(*args: Bar) -> BarBuilder: ...
+
+#? FooBuilder()
+args(Foo(), SubFoo())
+#? BarBuilder()
+args(Bar(), Bar())
+#? FooBuilder() BarBuilder()
+args(Foo(), Bar())
+
+
+@overload
+def kwargs(**kwargs: Foo) -> FooBuilder: ...
+@overload
+def kwargs(**kwargs: Bar) -> BarBuilder: ...
+
+#? FooBuilder()
+kwargs(a=Foo(), b=Foo())
+#? BarBuilder()
+kwargs(a=Bar())
+#? FooBuilder() BarBuilder()
+kwargs(a=Foo(), b=Bar())
+
+# -------------------------
+# Unpacking literals in calls
+# -------------------------
+
+@overload
+def unpack(a: Foo, b: Bar) -> FooBuilder: ...
+@overload
+def unpack(a: Bar, b: Foo) -> BarBuilder: ...
+@overload
+def unpack(a: Other, b: Other = ...) -> str: ...
+@overload
+def unpack(*args: Foo | Other) -> int: ...
+
+#? FooBuilder()
+unpack(*[Foo(), Bar()])
+#? BarBuilder()
+unpack(*(Bar(), Foo()))
+foo_bar_tuple = (Foo(), Bar())
+#? FooBuilder()
+unpack(*foo_bar_tuple)
+bar_list = [Bar()]
+#? BarBuilder()
+unpack(*bar_list, Foo())
+#? FooBuilder()
+unpack(*[Foo(), *bar_list])
+#? FooBuilder()
+unpack(**{'a': Foo(), 'b': Bar()})
+#? FooBuilder()
+unpack(**{'a': Bar(), 'b': Foo(), 'a': Foo(), 'b': Bar()})
+dict_a_bar = {'a': Bar()}
+#? BarBuilder()
+unpack(**{**dict_a_bar, 'b': Foo()})
+#? FooBuilder()
+unpack(**{'a': Bar(), **{'a': Foo()}}, b=Bar())
+
+# The Other() might be the first or the second argument.
+maybe_foo = [Foo()] if UNDEFINED else []
+#? int()
+unpack(*maybe_foo, Other())
+maybe_other = [Other()] if UNDEFINED else []
+#? str()
+unpack(*maybe_other, Other())
+#? str()
+unpack(*[Foo() for x in []], Other())
+
+# An entry that might be absent only replaces a value if it is there.
+maybe_b_bar = {'b': Bar()} if UNDEFINED else {}
+#? FooBuilder() BarBuilder() str() int()
+unpack(**{'a': Foo(), 'b': Foo(), **maybe_b_bar})
+#? FooBuilder()
+unpack(**{'a': Foo(), **maybe_b_bar, 'b': Bar()})
