+                entries = [e for alternative in alternatives for e in alternative]
+                roles = [
+                    [LazyKnownValues(e.infer_key(self._inference_state)) for e in entries],
+                    [lazy_value for e in entries for lazy_value in e.lazy_values],
+                ]
+            else:
+                alternatives = _sequence_alternatives(self._inference_state, value)
+                roles = [[item.lazy_value for alternative in alternatives
+                          for item in alternative]]
+
+            root_class = _strip_generics(self._get_class(value))
+            positions = _type_var_positions(root_class, cls)
+            result = []
+            for i in range(count):
+                position = positions[i] if i < len(positions) else None
+                if position is None or position >= len(roles):
+                    # Something like the send type of a generator, which is
+                    # not relevant for literals.
+                    result.append([])
+                else:
+                    result.append(roles[position])
+            return result
+
+        value_class = _get_annotated_class(value)
+        for c in value_class.py__mro__() if value_class is not None else []:
+            if _is_same_class(_strip_generics(c), cls):
+                if isinstance(c, DefineGenericBaseClass):
+                    generics = c.get_generics()
+                    return [
+                        [LazyKnownValues(generics[i].execute_annotation(None))]
+                        if i < len(generics) else None
+                        for i in range(count)
+                    ]
+                break
+        return [None] * count
+
+    def _accepts_tuple(self, annotation, generics, value):
+        if not self._is_instance(value, self._builtin('tuple')):
+            return False
+        if not generics:
+            return True
+
+        alternatives = _sequence_alternatives(self._inference_state, value)
+        if any(t.is_homogenous() for t in annotation.execute_annotation(None)
+               if isinstance(t, Tuple)):
+            return all(
+                self.check_lazy_value(generics[0], item.lazy_value)
+                for alternative in alternatives
+                for item in alternative
+            )
+
+        positions = list(range(len(generics)))
+        for alternative in alternatives:
+            pairs, filled = _bind_positional(alternative, positions, None)
+            if pairs is None or len(filled) < len(positions):
+                return False
+            for position, lazy_value in pairs:
+                if not self.check_lazy_value(generics[position], lazy_value):
+                    return False
+        return True
+
+
+def _matches_shape(function_value, param_names, shape):
+    pairs = _bind_arguments(param_names, shape)
+    if pairs is None:
+        return False
+
+    checker = _Checker(function_value.inference_state)
+    for param_name, lazy_value in pairs:
+        annotations = param_name.infer_annotation(execute_annotation=False, ignore_stars=True)
+        if not annotations:
+            # If we cannot infer annotations - or there aren't any - pretend
+            # that the argument matches.
+            continue
+        if not checker.check_lazy_value(annotations, lazy_value):
+            debug.dbg('Argument %s does not match %s: %s',
+                      lazy_value, param_name.string_name, annotations, color='BLUE')
+            return False
+    return True
+
