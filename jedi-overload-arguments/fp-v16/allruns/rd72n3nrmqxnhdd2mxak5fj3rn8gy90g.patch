+                        # A set
+                        yield 1, lazy(key.children[1])
+                    else:
+                        # A set
+                        yield 0, lazy(key)
+                return
+            else:
+                nodes = [array_node]
+
+        for node in nodes:
+            if node.type == 'star_expr':
+                yield 1, lazy(node.children[1])
+            elif node == ':' or node.type == 'subscript':
+                # TODO this should probably use at least part of the code
+                #      of infer_subscript_list.
+                yield 0, LazyKnownValue(Slice(self._defining_context, None, None, None))
+            else:
+                yield 0, lazy(node)
+
     def get_tree_entries(self):
         c = self.atom.children
 
