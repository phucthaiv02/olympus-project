+    def _get_type_argument_contents(self, cls, count, value):
+        """
+        Returns for each type parameter of ``cls`` the lazy values of the
+        value that need to be checked. For literals these are the elements
+        (or keys and values), for other values the type arguments of their
+        class. None means that it's not known.
