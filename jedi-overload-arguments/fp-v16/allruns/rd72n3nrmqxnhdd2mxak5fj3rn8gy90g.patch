index 0000000..d77edfd
--- /dev/null
+++ b/jedi/inference/gradual/signature_matching.py
@@ -0,0 +1,878 @@
+"""
+Checks if the arguments of a call are accepted by the parameters of a function
+the way a type checker would do it. This is used to choose the right overload
+(``typing.overload``) of a function.
+
+Every argument is assigned to a parameter (by position or by name) and checked
+against the annotation of that parameter. ``*args`` and ``**kwargs``
+parameters check each argument they receive. If an argument can have multiple
+values (e.g. a ``Union`` or ``a if x else b``), the annotation needs to accept
+all of them.
+
+Literals of tuples, lists and dicts (also if they are assigned to a variable)
+are checked according to the content Python creates from them. This is also
+the case if they are unpacked with ``*`` and ``**`` in a call, so
+``f(*[1, ""])`` is checked like ``f(1, "")``. A literal might have different
+contents (``x = [1] if y else []``), so a call might have different "shapes",
+which all need to be accepted.
+"""
+from inspect import Parameter
+
+from jedi import debug
+from jedi.inference.base_value import ValueSet, NO_VALUES
+from jedi.inference.lazy_value import LazyKnownValues, get_merged_lazy_value
+from jedi.inference.compiled import builtin_from_name, create_simple_object
+from jedi.inference.value import iterable
+from jedi.inference.gradual.base import DefineGenericBaseClass, GenericClass
+from jedi.inference.gradual.type_var import TypeVar
+from jedi.inference.gradual.typing import AnyClass, NewType, ProxyWithGenerics, \
+    ProxyTypingValue, TypeAlias, Tuple, Callable
+
+# Literals with different contents can lead to an exponential amount of
+# combinations. Above this limit the contents are merged, which is less
+# precise.
+_MAX_SHAPES = 64
+# Protection against literals that unpack themselves.
+_MAX_DEPTH = 10
+
+_DEFINITELY = 2
+_MAYBE = 1
+
+_sentinel = object()
+
+
+class _Item:
+    """
+    An element of a sequence or a positional argument. A variadic item stands
+    for an unknown number (zero or more) of elements, e.g. ``*args``.
+    """
+    def __init__(self, lazy_value, variadic=False):
+        self.lazy_value = lazy_value
+        self.variadic = variadic
+
+    def __repr__(self):
+        return '<%s: %s%s>' % (self.__class__.__name__,
+                               '*' if self.variadic else '', self.lazy_value)
+
+
+class _Entry:
+    """
+    An entry of a dict or a keyword argument. An entry with an unknown key
+    stands for an unknown number (zero or more) of entries, e.g.
+    ``**kwargs``.
+    """
+    def __init__(self, key, lazy_key, lazy_values, unknown_key=False):
+        self.key = key
+        # None for the keys of keyword arguments, which are strings.
+        self.lazy_key = lazy_key
+        # All the values the entry might have.
+        self.lazy_values = lazy_values
+        self.unknown_key = unknown_key
+
+    def infer_key(self, inference_state):
+        if self.lazy_key is None:
+            return ValueSet([create_simple_object(inference_state, self.key)])
+        return self.lazy_key.infer()
+
+    def __repr__(self):
+        return '<%s: %s=%s>' % (self.__class__.__name__,
+                                '?' if self.unknown_key else self.key, self.lazy_values)
+
+
+def _merge_options(inference_state, options):
+    """
+    Merges different contents into one. This is less precise, because
+    positions and keys are lost.
+    """
+    items = [x for option in options for x in option if isinstance(x, _Item)]
+    entries = [x for option in options for x in option if isinstance(x, _Entry)]
+    result = []
+    if items:
+        result.append(_Item(
+            get_merged_lazy_value([item.lazy_value for item in items]),
+            variadic=True,
+        ))
+    if entries:
+        keys = ValueSet.from_sets(e.infer_key(inference_state) for e in entries)
+        result.append(_Entry(
+            None,
+            LazyKnownValues(keys),
+            [lazy_value for e in entries for lazy_value in e.lazy_values],
+            unknown_key=True,
+        ))
+    return result
+
+
+def _combine(inference_state, alternatives, options):
+    """
+    Appends every option (a possible content) to every alternative.
+    """
+    if len(options) > 1 and len(alternatives) * len(options) > _MAX_SHAPES:
+        options = [_merge_options(inference_state, options)]
+    return [alternative + option for alternative in alternatives for option in options]
+
+
+def _unknown_items():
+    return [[_Item(LazyKnownValues(NO_VALUES), variadic=True)]]
+
+
+def _unpack_iterables(inference_state, values, depth):
+    """
+    Returns the possible contents of ``*values``.
+    """
+    if not values:
+        return _unknown_items()
+    alternatives = []
+    for value in values:
+        alternatives += _sequence_alternatives(inference_state, value, depth)
+    return alternatives
+
+
+def _unpack_mappings(inference_state, values, depth):
+    """
+    Returns the possible contents of ``**values``.
+    """
+    if not values:
+        return [[_Entry(None, LazyKnownValues(NO_VALUES), [LazyKnownValues(NO_VALUES)],
+                        unknown_key=True)]]
+    alternatives = []
+    for value in values:
+        alternatives += _mapping_alternatives(inference_state, value, depth)
+    return alternatives
+
+
+def _is_mapping_with_known_content(value):
+    return isinstance(value, (iterable.DictLiteralValue, iterable.FakeDict,
+                              iterable.DictComprehension))
+
+
+def _has_known_content(value):
+    return _is_mapping_with_known_content(value) or isinstance(
+        value,
+        (iterable.SequenceLiteralValue, iterable.FakeTuple, iterable.FakeList,
+         iterable.ComprehensionMixin, Tuple)
+    )
+
+
+def _is_empty_comprehension(comprehension):
+    # A comprehension over an empty literal does not have elements.
+    return not list(comprehension.py__iter__()) and not comprehension.has_unknown_input()
+
+
+def _sequence_alternatives(inference_state, value, depth=0):
+    """
+    Returns the possible contents of an iterable, a list of lists of
+    ``_Item``.
+    """
+    if depth > _MAX_DEPTH:
+        return _unknown_items()
+
+    if _is_mapping_with_known_content(value):
+        # Iterating over a dict returns the keys
+        return [
+            [_Item(LazyKnownValues(entry.infer_key(inference_state)),
+                   variadic=entry.unknown_key)
+             for entry in entries]
+            for entries in _mapping_alternatives(inference_state, value, depth)
+        ]
+
+    if isinstance(value, iterable.SequenceLiteralValue):
+        alternatives = [[]]
+        for star_count, lazy_value in value.unpack_entries():
+            if star_count:
+                options = _unpack_iterables(inference_state, lazy_value.infer(), depth + 1)
+            else:
+                options = [[_Item(lazy_value)]]
+            alternatives = _combine(inference_state, alternatives, options)
+
+        additions = list(value.get_array_additions())
+        if additions:
+            # Values might be added later on (e.g. list.append).
+            added = _Item(get_merged_lazy_value(additions), variadic=True)
+            alternatives = [alternative + [added] for alternative in alternatives]
+
+        if value.array_type == 'set':
+            # Sets are unordered and contain equal elements only once.
+            alternatives = [
+                [_Item(item.lazy_value, variadic=True) for item in alternative]
+                for alternative in alternatives
+            ]
+        return alternatives
+
+    if isinstance(value, iterable.FakeTuple) \
+            or isinstance(value, Tuple) and not value.is_homogenous():
+        return [[_Item(lazy_value) for lazy_value in value.py__iter__()]]
+
+    if isinstance(value, iterable.ComprehensionMixin):
+        if value.has_unknown_input():
+            return _unknown_items()
+        return [[_Item(lazy_value, variadic=True) for lazy_value in value.py__iter__()]]
+
+    # The number of elements is not known.
+    values = ValueSet.from_sets(lazy_value.infer() for lazy_value in value.py__iter__())
+    return [[_Item(LazyKnownValues(values), variadic=True)]]
+
+
+def _create_entry(lazy_key, lazy_value):
+    keys = lazy_key.infer()
+    if len(keys) == 1:
+        key = next(iter(keys)).get_safe_value(default=_sentinel)
+        if key is not _sentinel:
+            try:
+                hash(key)
+            except TypeError:
+                pass
+            else:
+                return _Entry(key, lazy_key, [lazy_value])
+    return _Entry(None, lazy_key, [lazy_value], unknown_key=True)
+
+
+def _merge_entries(entries):
+    """
+    Creates the entries of a dict the way Python does it: A later key replaces
+    the value of an equal earlier key (e.g. ``1`` and ``True``), but the
+    earlier key is kept.
+    """
+    result = []
+    positions = {}
+    for entry in entries:
+        if entry.unknown_key:
+            # The entry might not be there, so it only replaces values if it
+            # is present.
+            result = [
+                existing if existing.unknown_key else _Entry(
+                    existing.key,
+                    existing.lazy_key,
+                    existing.lazy_values + entry.lazy_values,
+                )
+                for existing in result
+            ]
+            result.append(entry)
+            continue
+
+        try:
+            index = positions[entry.key]
+        except KeyError:
+            positions[entry.key] = len(result)
+            result.append(entry)
+        else:
+            existing = result[index]
+            result[index] = _Entry(existing.key, existing.lazy_key, entry.lazy_values)
+    return result
+
+
+def _get_mapping_types(value):
+    """
+    Returns the key and value types of a mapping without known content, e.g.
+    of a variable annotated with ``Dict[str, int]``.
+    """
+    value_class = _get_annotated_class(value)
+    for cls in value_class.py__mro__() if value_class is not None else []:
+        if isinstance(cls, DefineGenericBaseClass) and cls.py__name__() == 'Mapping':
+            generics = cls.get_generics()
+            if len(generics) == 2:
+                return (generics[0].execute_annotation(None),
+                        generics[1].execute_annotation(None))
+    return NO_VALUES, NO_VALUES
+
+
+def _mapping_alternatives(inference_state, value, depth=0):
+    """
+    Returns the possible contents of a mapping, a list of lists of ``_Entry``.
+    """
+    if depth > _MAX_DEPTH:
+        return _unpack_mappings(inference_state, NO_VALUES, depth)
+
+    if isinstance(value, iterable.DictLiteralValue):
+        alternatives = [[]]
+        for star_count, data in value.unpack_entries():
+            if star_count:
+                options = _unpack_mappings(inference_state, data.infer(), depth + 1)
+            else:
+                options = [[_create_entry(*data)]]
+            alternatives = _combine(inference_state, alternatives, options)
+        return [_merge_entries(alternative) for alternative in alternatives]
+
+    if isinstance(value, iterable.FakeDict):
+        return [[_Entry(key, None, [lazy_value])
+                 for key, lazy_value in value.exact_key_items()]]
+
+    if isinstance(value, iterable.DictComprehension):
+        if _is_empty_comprehension(value):
+            return [[]]
+        keys, values = value.get_mapping_item_values()
+    else:
+        keys, values = _get_mapping_types(value)
+    return [[_Entry(None, LazyKnownValues(keys), [LazyKnownValues(values)],
+                    unknown_key=True)]]
+
+
+def _get_call_shapes(inference_state, arguments):
+    """
+    Returns all the possible shapes of a call, each a list of ``_Item``
+    (positional arguments) and ``_Entry`` (keyword arguments).
+    """
+    shapes = [[]]
+    for star_count, key, lazy_value in arguments.unpack_with_stars():
+        if star_count == 1:
+            options = _unpack_iterables(inference_state, lazy_value.infer(), 0)
+        elif star_count == 2:
+            options = _unpack_mappings(inference_state, lazy_value.infer(), 0)
+        elif key is None:
+            options = [[_Item(lazy_value)]]
+        else:
+            options = [[_Entry(key, None, [lazy_value])]]
+        shapes = _combine(inference_state, shapes, options)
+    return shapes
+
+
+def _bind_positional(items, params, var_positional):
+    """
+    Assigns positional items to the parameters ``params`` (and the
+    ``var_positional`` parameter if given).
+
+    Returns a tuple of a list of ``(param, lazy_value)`` pairs and a dict that
+    says whether a param is filled (definitely or maybe). Returns ``(None,
+    None)`` if there are too many items.
+
+    If there are variadic items, the positions of the following items are not
+    known exactly, so they are assigned to all parameters they might end up
+    in.
+    """
+    pairs = []
+    filled = {}
+    # The minimum number of elements before the current item.
+    count = 0
+    unknown_position = False
+    for item in items:
+        if item.variadic or unknown_position:
+            targets = params[count:]
+            if not item.variadic and not targets and var_positional is None:
+                return None, None
+            for param in targets:
+                pairs.append((param, item.lazy_value))
+                filled.setdefault(param, _MAYBE)
+            if var_positional is not None:
+                pairs.append((var_positional, item.lazy_value))
+            if item.variadic:
+                unknown_position = True
+            else:
+                count += 1
+        else:
+            if count < len(params):
+                param = params[count]
+                pairs.append((param, item.lazy_value))
+                filled[param] = _DEFINITELY
+            elif var_positional is not None:
+                pairs.append((var_positional, item.lazy_value))
+            else:
+                return None, None
+            count += 1
+    return pairs, filled
+
+
+def _bind_arguments(param_names, shape):
+    """
+    Assigns the arguments of a call shape to the parameters, like Python does
+    it. Returns a list of ``(param_name, lazy_value)`` pairs or None if the
+    call is not valid (e.g. missing arguments).
+    """
+    positional_params = []
+    keyword_params = {}
+    var_positional = None
+    var_keyword = None
+    for param_name in param_names:
+        kind = param_name.get_kind()
+        if kind == Parameter.VAR_POSITIONAL:
+            var_positional = param_name
+        elif kind == Parameter.VAR_KEYWORD:
+            var_keyword = param_name
+        else:
+            if kind != Parameter.KEYWORD_ONLY:
+                positional_params.append(param_name)
+            if kind != Parameter.POSITIONAL_ONLY:
+                keyword_params[param_name.string_name] = param_name
+
+    items = [x for x in shape if isinstance(x, _Item)]
+    pairs, filled = _bind_positional(items, positional_params, var_positional)
+    if pairs is None:
+        return None
+
+    entries = [x for x in shape if isinstance(x, _Entry)]
+    used_keys = set()
+    for entry in entries:
+        if entry.unknown_key:
+            continue
+        key = entry.key
+        if not isinstance(key, str) or key in used_keys:
+            # Keywords have to be strings and can only be given once.
+            return None
+        used_keys.add(key)
+
+        param_name = keyword_params.get(key)
+        if param_name is None:
+            if var_keyword is None:
+                return None
+            param_name = var_keyword
+        elif filled.get(param_name) == _DEFINITELY:
+            return None
+        else:
+            filled[param_name] = _DEFINITELY
+        pairs += [(param_name, lazy_value) for lazy_value in entry.lazy_values]
+
+    for entry in entries:
+        if not entry.unknown_key:
+            continue
+        # These might be assigned to any parameter that is not given yet.
+        targets = [p for p in keyword_params.values() if filled.get(p) != _DEFINITELY]
+        if var_keyword is not None:
+            targets.append(var_keyword)
+        for param_name in targets:
+            filled.setdefault(param_name, _MAYBE)
+            pairs += [(param_name, lazy_value) for lazy_value in entry.lazy_values]
+
+    for param_name in param_names:
+        if param_name.get_kind() in (Parameter.VAR_POSITIONAL, Parameter.VAR_KEYWORD):
+            continue
+        if param_name not in filled and param_name.default_node is None:
+            return None
+    return pairs
+
+
+def _strip_generics(cls):
+    """
+    Returns the actual class of e.g. ``List[int]`` (``list``).
+    """
+    while isinstance(cls, (GenericClass, TypeAlias)):
+        cls = cls._wrapped_value
+    return cls
+
+
+def _class_key(cls):
+    names = cls.get_qualified_names()
+    if names is None:
+        return None
+    module_name = cls.get_root_context().py__name__()
+    if module_name is None:
+        return None
+    return module_name, tuple(names)
+
+
+def _is_same_class(cls1, cls2):
+    if cls1 == cls2:
+        return True
+    node1 = cls1.tree_node
+    node2 = cls2.tree_node
+    if node1 is not None and node2 is not None:
+        if node1 == node2:
+            return True
+        if node1.get_root_node() == node2.get_root_node():
+            return False
+    # Compiled classes and stubs are compared by their names, e.g. the class
+    # of True (a compiled bool) is a subclass of int (from the stubs).
+    key = _class_key(cls1)
+    return key is not None and key == _class_key(cls2)
+
+
+def _is_builtin(cls, *names):
+    key = _class_key(cls)
+    return key is not None and key[0] == 'builtins' and len(key[1]) == 1 \
+        and key[1][0] in names
+
+
+# PEP 484: int is accepted where float is expected, int and float where
+# complex is expected.
+_PROMOTIONS = {
+    'float': ('int',),
+    'complex': ('float', 'int'),
+}
+
+
+def _is_subclass(cls, base):
+    """
+    ``cls`` and ``base`` are both classes (without generics).
+    """
+    if _is_builtin(base, 'object'):
+        return True
+    mro = list(cls.py__mro__())
+    if any(_is_same_class(_strip_generics(c), base) for c in mro):
+        return True
+    for name, promoted in _PROMOTIONS.items():
+        if _is_builtin(base, name):
+            return any(_is_builtin(_strip_generics(c), *promoted) for c in mro)
+    return False
+
+
+def _is_protocol(cls):
+    # Only classes that have Protocol as a direct base class are protocols.
+    try:
+        lazy_bases = cls.py__bases__()
+    except AttributeError:
+        return False
+    return any(base.py__name__() == 'Protocol'
+               for lazy_base in lazy_bases for base in lazy_base.infer())
+
+
+def _iter_protocol_member_names(cls):
+    for c in cls.py__mro__():
+        c = _strip_generics(c)
+        if c.tree_node is None or c.tree_node.type != 'classdef' or not _is_protocol(c):
+            continue
+        classdef = c.tree_node
+        for funcdef in classdef.iter_funcdefs():
+            yield funcdef.name.value
+        for stmt in classdef.get_suite().children:
+            if stmt.type == 'simple_stmt':
+                stmt = stmt.children[0]
+            if stmt.type == 'expr_stmt' and stmt.children[0].type == 'name':
+                yield stmt.children[0].value
+
+
+def _is_none(value):
+    return value.is_compiled() and not value.is_class() \
+        and value.get_safe_value(default=_sentinel) is None
+
+
+def _is_callable(value):
+    if value.is_class() or value.is_function() or value.api_type == 'function':
+        return True
+    if isinstance(value, Callable):
+        return True
+    return value.is_instance() and bool(value.py__getattribute__('__call__'))
+
+
+def _get_class(value):
+    try:
+        method = value.py__class__
+    except AttributeError:
+        # Not all values have classes.
+        return None
+    return method()
+
+
+def _get_annotated_class(value):
+    try:
+        method = value.get_annotated_class_object
+    except AttributeError:
+        return _get_class(value)
+    return method()
+
+
+def _accepts_anything(annotations):
+    for annotation in annotations:
+        if isinstance(annotation, AnyClass):
+            return True
+        if isinstance(annotation, TypeVar):
+            if not annotation.bound and not annotation.constraints:
+                return True
+        elif annotation.is_class() and _is_builtin(_strip_generics(annotation), 'object'):
+            return True
+    return False
+
+
+def _type_var_positions(root_class, cls):
+    """
+    Returns for each generic parameter of ``cls`` (a super class of
+    ``root_class``) the index of the type var of ``root_class`` that is used
+    for it.
