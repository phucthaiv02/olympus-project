+def signature_matches(function_value, arguments):
+    """
+    Returns True if the arguments are accepted by the parameters of the
+    function. All the different possible shapes of a call need to be
+    accepted.
+    """
+    shapes = _get_call_shapes(function_value.inference_state, arguments)
+    param_names = function_value.get_param_names()
+    return bool(shapes) and all(
+        _matches_shape(function_value, param_names, shape) for shape in shapes
+    )
