+    ``Iterable[_KT]``, which leads to [0, 1] and [0].
+    """
+    try:
+        type_vars = root_class.list_type_vars()
+    except AttributeError:
+        return []
+    names = [type_var.py__name__() for type_var in type_vars]
+    for c in root_class.py__mro__():
+        if not _is_same_class(_strip_generics(c), cls):
+            continue
+        if not isinstance(c, DefineGenericBaseClass):
+            return list(range(len(names)))
+        positions = []
+        for generic_set in c.get_generics():
+            position = None
+            for generic in generic_set:
+                if isinstance(generic, TypeVar) and generic.py__name__() in names:
+                    position = names.index(generic.py__name__())
+            positions.append(position)
+        return positions
+    return []
