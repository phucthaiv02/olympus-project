+class _Checker:
+    """
+    Checks if values are accepted by annotations. The checker remembers which
+    constraints of constrained type vars are still possible, because they need
+    to be the same for all arguments.
+    """
+    def __init__(self, inference_state):
+        self._inference_state = inference_state
+        self._type_vars = {}
+
+    def _builtin(self, name):
+        return builtin_from_name(self._inference_state, name)
+
+    def check_lazy_value(self, annotations, lazy_value):
+        values = lazy_value.infer()
+        if not values:
+            # We don't know what the value is.
+            return _accepts_anything(annotations)
+        return all(self.accepts(annotations, value) for value in values)
+
+    def accepts(self, annotations, value):
+        """
+        Returns True if the value is an instance of one of the annotations.
+        """
+        return self._any(annotations, lambda a: self._accepts(a, value))
+
+    def accepts_class(self, annotations, cls):
+        """
+        Returns True if the class is a subclass of one of the annotations
+        (like ``Type[annotation]``).
+        """
+        return self._any(annotations, lambda a: self._accepts_class(a, cls))
+
+    def _any(self, annotations, check):
+        for annotation in annotations:
+            saved = dict(self._type_vars)
+            if check(annotation):
+                return True
+            self._type_vars = saved
+        return False
+
+    def _accepts_type_var(self, type_var, value, accepts):
+        constraints = type_var.constraints
+        if constraints:
+            possible = {c for c in constraints if accepts(ValueSet([c]), value)}
+            name = type_var.py__name__()
+            if name in self._type_vars:
+                possible &= self._type_vars[name]
+            if not possible:
+                return False
+            self._type_vars[name] = possible
+            return True
+
+        bound = type_var.bound
+        return not bound or accepts(bound, value)
+
+    def _accepts(self, annotation, value):
+        if isinstance(annotation, (AnyClass, NewType)):
+            return True
+        if isinstance(annotation, TypeVar):
+            return self._accepts_type_var(annotation, value, self.accepts)
+        if isinstance(annotation, ProxyWithGenerics):
+            return self._accepts_special_form(annotation, value)
+        if isinstance(annotation, ProxyTypingValue):
+            # Things like `Type`, `Tuple` or `Callable` without generics.
+            name = annotation.py__name__()
+            if name == 'Type':
+                return value.is_class()
+            if name == 'Tuple':
+                return self._is_instance(value, self._builtin('tuple'))
+            if name == 'Callable':
+                return _is_callable(value)
+            return True
+        if _is_none(annotation):
+            return _is_none(value)
+        if annotation.is_class():
+            return self._accepts_instance(annotation, value)
+        # Not a valid annotation (or not understood by Jedi).
+        return False
+
+    def _accepts_special_form(self, annotation, value):
+        name = annotation.py__name__()
+        generics = annotation.get_generics()
+        if name == 'Union':
+            return self.accepts(ValueSet.from_sets(generics), value)
+        if name == 'Optional':
+            return _is_none(value) or self.accepts(ValueSet.from_sets(generics), value)
+        if name in ('ClassVar', 'Annotated', 'Final'):
+            return not generics or self.accepts(generics[0], value)
+        if name == 'Type':
+            return value.is_class() and (not generics or self.accepts_class(generics[0], value))
+        if name == 'Tuple':
+            return self._accepts_tuple(annotation, generics, value)
+        if name == 'Callable':
+            return self._accepts_callable(generics, value)
+        return True
+
+    def _accepts_callable(self, generics, value):
+        if not _is_callable(value):
+            return False
+        if len(generics) != 2 or _accepts_anything(generics[1]):
+            return True
+        # The parameters are not checked, but the return type is.
+        returns = value.execute_with_values()
+        # If the return type cannot be inferred, it's like Any.
+        return not returns or all(self.accepts(generics[1], v) for v in returns)
+
+    def _accepts_class(self, annotation, cls):
+        if isinstance(annotation, (AnyClass, NewType)):
+            return True
+        if isinstance(annotation, TypeVar):
+            return self._accepts_type_var(annotation, cls, self.accepts_class)
+        if isinstance(annotation, (ProxyWithGenerics, ProxyTypingValue)):
+            name = annotation.py__name__()
+            generics = annotation.get_generics() \
+                if isinstance(annotation, ProxyWithGenerics) else ()
+            if name in ('Union', 'Optional'):
+                return name == 'Optional' and cls.py__name__() == 'NoneType' \
+                    or self.accepts_class(ValueSet.from_sets(generics), cls)
+            if name in ('ClassVar', 'Annotated', 'Final'):
+                return not generics or self.accepts_class(generics[0], cls)
+            if name == 'Tuple':
+                return _is_subclass(cls, self._builtin('tuple'))
+            return True
+        if _is_none(annotation):
