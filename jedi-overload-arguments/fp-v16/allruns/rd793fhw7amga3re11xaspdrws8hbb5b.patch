+    return tuple(ValueSet([type_var]) for type_var in _list_type_vars(cls))
+
+
+def _list_type_vars(cls):
+    try:
+        return list(_unwrap(cls).list_type_vars())
+    except AttributeError:
+        return []
+
+
+def _tuple_class(value):
+    return compiled.builtin_from_name(value.inference_state, 'tuple')
+
+
+def _class_of(value):
+    if _call(value, 'is_instance', False):
+        try:
+            return value.get_annotated_class_object()
+        except AttributeError:
+            pass
+    try:
+        return value.py__class__()
+    except AttributeError:
+        return None
+
+
+def _call(value, method_name, default):
+    # Some values (e.g. arguments for list/set instances) don't implement
+    # everything.
+    try:
+        method = getattr(value, method_name)
+    except AttributeError:
+        return default
+    return method()
+
+
+def _is_class(value):
+    return _call(value, 'is_class', False)
+
+
+def _is_none(value):
+    return _call(value, 'is_compiled', False) \
+        and value.get_safe_value(default=_sentinel) is None
+
+
+def _is_same_literal(value, literal):
+    if not _call(value, 'is_compiled', False) and not _call(value, 'is_instance', False):
+        return False
+    safe_value = value.get_safe_value(default=_sentinel)
+    literal_safe_value = literal.get_safe_value(default=_sentinel)
+    if safe_value is not _sentinel and literal_safe_value is not _sentinel:
+        return type(safe_value) is type(literal_safe_value) \
+            and safe_value == literal_safe_value
+    if safe_value is _sentinel and literal_safe_value is _sentinel \
+            and value.is_instance() and literal.is_instance():
+        # Enums
+        return value.name.string_name == literal.name.string_name \
+            and _same_class(value.py__class__(), literal.py__class__())
+    return False
+
+
+def _is_callable(value):
+    if _is_class(value) or _call(value, 'is_function', False) \
+            or _call(value, 'is_bound_method', False) \
+            or isinstance(value, Callable):
+        return True
+    if getattr(value, 'api_type', None) == 'function':
+        return True
+    return _call(value, 'is_instance', False) and bool(value.goto('__call__'))
+
+
+def _is_protocol_class(cls):
+    try:
+        lazy_bases = cls.py__bases__()
+    except AttributeError:
+        return False
+    for lazy_base in lazy_bases:
+        # Compiled classes return values instead of lazy values.
+        bases = lazy_base.infer() if hasattr(lazy_base, 'infer') else [lazy_base]
+        for base in bases:
+            if base.py__name__() == 'Protocol' \
+                    and base.get_root_context().py__name__() in ('typing', 'typing_extensions'):
+                return True
+    return False
+
+
+@inference_state_method_cache(default=())
+def _get_protocol_members(protocol):
+    from jedi.inference.value.klass import ClassFilter
+    members = set()
+    for cls in _mro(protocol):
+        cls = _unwrap(cls)
+        if not _is_protocol_class(cls):
+            continue
+        class_filter = ClassFilter(cls, node_context=cls.as_context(), is_instance=True)
+        members |= {
+            name.string_name for name in class_filter.values()
+            if name.string_name not in _NON_PROTOCOL_MEMBERS
+            and not name.string_name.startswith('_abc_')
+        }
+    return tuple(sorted(members))
