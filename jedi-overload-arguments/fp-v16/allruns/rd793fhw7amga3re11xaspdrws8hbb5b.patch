+
+def _get_content_slots(array_type, alternative):
+    """Returns a list of value sets for every type var of the container."""
+    if array_type == 'dict':
+        keys = [ValueSet([key_value]) for key_value, _ in alternative.known.values()]
+        values = [v for _, v in alternative.known.values()]
+        if alternative.unknown is not None:
+            keys.append(alternative.unknown[0])
+            values.append(alternative.unknown[1])
+        return [keys, values]
+    return [[item.values for item in alternative if item.max > 0]]
+
+
+def _find_base(cls, annotation):
+    """
+    Finds the class in the MRO of ``cls`` that is the same class as the
+    annotation (ignoring generics).
+    """
+    if cls is None:
+        return None
+    mro = _mro(cls)
+    for base in mro:
+        if _same_class(base, annotation):
+            return base
+    promoted_from = _PROMOTIONS.get(_class_key(annotation), ())
+    if any(_class_key(base) in promoted_from for base in mro):
+        return _PROMOTED
+    return None
+
+
+def _mro(cls):
+    try:
+        return list(cls.py__mro__())
+    except AttributeError:
+        return [cls]
+
+
+def _unwrap(cls):
+    from jedi.inference.base_value import _ValueWrapperBase
+    while isinstance(cls, _ValueWrapperBase):
+        cls = cls._wrapped_value
