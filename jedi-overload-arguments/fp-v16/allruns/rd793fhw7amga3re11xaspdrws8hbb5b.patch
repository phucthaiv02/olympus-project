diff --git a/test/completion/pep0484_overload.py b/test/completion/pep0484_overload.py
index 45edeb5..b4223e4 100644
--- a/test/completion/pep0484_overload.py
+++ b/test/completion/pep0484_overload.py
@@ -111,3 +111,240 @@ def typing_direct(x: str) -> str: ...
 typing_direct(1)
 #? str()
 typing_direct("")
+
+# -------------------------
+# Choosing the first matching overload
+# -------------------------
+
+class Foo: pass
+class Bar: pass
+class FooBuilder:
+    def foo_method(self): pass
+class BarBuilder:
+    def bar_method(self): pass
+
+@overload
+def get_obj(input: type[Foo]) -> FooBuilder: ...
+@overload
+def get_obj(input: type[Bar]) -> BarBuilder: ...
+def get_obj(input): ...
+
+#? ['foo_method']
+get_obj(Foo).foo_m
+#? []
+get_obj(Foo).bar_m
+#? FooBuilder()
+get_obj(Foo)
+#? BarBuilder()
+get_obj(Bar)
+#? BarBuilder()
+get_obj(input=Bar)
+
+class SubFoo(Foo): pass
+
+#? FooBuilder()
+get_obj(SubFoo)
+#? FooBuilder() BarBuilder()
+get_obj(Foo())
+
+cond = bool()
+
+# The argument can be both, no overload matches.
+#? FooBuilder() BarBuilder()
+get_obj(Foo if cond else Bar)
+
+@overload
+def get_obj_union(input: type[Foo]) -> FooBuilder: ...
+@overload
+def get_obj_union(input: type[Foo] | type[Bar]) -> BarBuilder: ...
+def get_obj_union(input): ...
+
+#? BarBuilder()
+get_obj_union(Foo if cond else Bar)
+
+# Arity and names
+@overload
+def arity(x: type[Foo]) -> FooBuilder: ...
+@overload
+def arity(x: type[Foo], y: type[Bar]) -> BarBuilder: ...
+@overload
+def arity(*args: type[Bar]) -> str: ...
+def arity(*args): ...
+
+#? FooBuilder()
+arity(Foo)
+#? BarBuilder()
+arity(Foo, Bar)
+#? BarBuilder()
+arity(y=Bar, x=Foo)
+#? str()
+arity(Bar, Bar, Bar)
+#? str()
+arity()
+
+foos: list[type[Foo]]
+bars: list[type[Bar]]
+# Any number of arguments can be passed, even none.
+#? FooBuilder() BarBuilder() str()
+arity(*foos)
+#? str()
+arity(*bars)
+
+@overload
+def keyword_only(*, x: type[Foo]) -> FooBuilder: ...
+@overload
+def keyword_only(x: type[Foo], /) -> BarBuilder: ...
+def keyword_only(x): ...
+
+#? FooBuilder()
+keyword_only(x=Foo)
+#? BarBuilder()
+keyword_only(Foo)
+
+bar_kwargs: dict[str, type[Bar]]
+
+@overload
+def kwargs_func(x: type[Bar]) -> FooBuilder: ...
+@overload
+def kwargs_func(**kwargs: type[Bar]) -> BarBuilder: ...
+def kwargs_func(**kwargs): ...
+
+#? BarBuilder()
+kwargs_func(**bar_kwargs)
+#? FooBuilder()
+kwargs_func(**{'x': Bar})
+
+# -------------------------
+# Literals are checked by their content
+# -------------------------
+
+#? BarBuilder()
+arity(*(Foo, Bar))
+foo_bar = (Foo, Bar)
+#? BarBuilder()
+arity(*foo_bar)
+bar_list = [Bar]
+#? BarBuilder()
+arity(*[Foo, *bar_list])
+#? BarBuilder()
+arity(*[Foo] + [Bar])
+#? str()
+arity(*[Bar for _ in []])
+#? str()
+arity(*[Bar for _ in [1, 2] if cond])
+#? FooBuilder() BarBuilder() str()
+arity(*[Foo for _ in [1, 2] if cond])
+
+maybe_foo = [Foo] if cond else []
+# Bar can be the first or the second argument
+#? FooBuilder() BarBuilder() str()
+arity(*maybe_foo, Bar)
+
+@overload
+def first_or_second(x: type[Bar]) -> FooBuilder: ...
+@overload
+def first_or_second(x: type[Foo] | type[Bar], y: type[Bar] = Bar) -> BarBuilder: ...
+def first_or_second(x, y=Bar): ...
+
+#? BarBuilder()
+first_or_second(*maybe_foo, Bar)
+
+@overload
+def containers(x: tuple[type[Foo], type[Bar]]) -> FooBuilder: ...
+@overload
+def containers(x: list[type[Foo]]) -> BarBuilder: ...
+@overload
+def containers(x: dict[int, type[Bar]]) -> str: ...
+@overload
+def containers(x: dict[str, type[Foo] | type[Bar]]) -> bytes: ...
+def containers(x): ...
+
+#? FooBuilder()
+containers((Foo, Bar))
+#? FooBuilder()
+containers(foo_bar)
+#? BarBuilder()
+containers([Foo, Foo])
+#? FooBuilder() BarBuilder() str() bytes()
+containers([Foo, Bar])
+#? BarBuilder()
+containers([Bar for _ in []])
+# Equal keys only keep the last value
+#? str()
+containers({1: Foo, True: Bar})
+maybe_dict = {'k': Foo} if cond else {}
+#? bytes()
+containers({'k': Bar, **maybe_dict})
+
+@overload
+def keyword_k(k: type[Bar]) -> FooBuilder: ...
+@overload
+def keyword_k(k: type[Foo] | type[Bar]) -> BarBuilder: ...
+def keyword_k(k): ...
+
+#? BarBuilder()
+keyword_k(**{'k': Bar, **maybe_dict})
+#? FooBuilder()
+keyword_k(**{'k': Foo, **{'k': Bar}})
+
+# -------------------------
+# Typing rules
+# -------------------------
+
+from typing import Literal, Callable, Sequence, Self
+
+@overload
+def literal(mode: Literal['r']) -> str: ...
+@overload
+def literal(mode: Literal['rb']) -> bytes: ...
+def literal(mode): ...
+
+#? bytes()
+literal('rb')
+#? str() bytes()
+literal(str())
+
+@overload
+def promotion(x: float) -> str: ...
+@overload
+def promotion(x: object) -> bytes: ...
+def promotion(x): ...
+
+#? str()
+promotion(1)
+#? bytes()
+promotion('')
+
+bools: list[bool]
+
+@overload
+def variance(x: list[int]) -> str: ...
+@overload
+def variance(x: Sequence[int]) -> bytes: ...
+def variance(x): ...
+
+#? bytes()
+variance(bools)
+#? str()
+variance([True])
+
+@overload
+def callback(cb: Callable[[], int]) -> str: ...
+@overload
+def callback(cb: Callable[[], str]) -> bytes: ...
+def callback(cb): ...
+
+#? bytes()
+callback(lambda: '')
+
+class WithSelf:
+    @overload
+    def method(self, other: Self) -> str: ...
+    @overload
+    def method(self, other: int) -> bytes: ...
+    def method(self, other): ...
+
+#? str()
+WithSelf().method(WithSelf())
+#? bytes()
+WithSelf().method(1)
