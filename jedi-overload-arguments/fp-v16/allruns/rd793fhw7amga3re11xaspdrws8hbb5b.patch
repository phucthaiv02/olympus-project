new file mode 100644
index 0000000..77bf086
--- /dev/null
+++ b/jedi/inference/signature_matching.py
@@ -0,0 +1,276 @@
+"""
+Matches calls against signatures, which is used to choose overloads.
+
+A signature matches a call if it accepts every way the call can happen at
+runtime: The arguments must bind to the parameters (whether they are passed by
+position or by name) and every argument value must be compatible with the
+annotation of its parameter.
+
+For example ``f(*xs)`` with ``xs: list[int]`` can pass any number of
+arguments, even none, so ``def f(x: int)`` does not match it. With
+``xs = [1] if c else []``, ``f(*xs, 2)`` passes either one or two arguments.
+"""
+import itertools
+from inspect import Parameter
+
+from jedi.inference.base_value import ValueSet, NO_VALUES
+from jedi.inference.contents import ContentItem, INFINITY, \
+    get_sequence_alternatives, get_dict_alternatives
+from jedi.inference.gradual.matching import values_match
+
+_MAX_CALL_ALTERNATIVES = 64
+_MAX_POSITIONAL_EXPANSIONS = 256
+
+_POSITIONAL_KINDS = (Parameter.POSITIONAL_ONLY, Parameter.POSITIONAL_OR_KEYWORD)
+_KEYWORD_KINDS = (Parameter.POSITIONAL_OR_KEYWORD, Parameter.KEYWORD_ONLY)
+
+
+class _Call:
+    """
+    One way a call can happen at runtime.
+
+    ``positional`` is a tuple of :class:`ContentItem`, ``keywords`` a tuple of
+    ``(name, values)``. ``unknown_keywords`` are the values of keyword
+    arguments with unknown names (from ``**mapping``), which may or may not
+    be there. If ``has_error`` is set, the call always raises a ``TypeError``.
+    """
+    def __init__(self, positional=(), keywords=(), unknown_keywords=None,
+                 has_error=False):
+        self.positional = positional
+        self.keywords = keywords
+        self.unknown_keywords = unknown_keywords
+        self.has_error = has_error
+
+    def merge(self, other):
+        names = {name for name, _ in self.keywords}
+        unknown_keywords = self.unknown_keywords
+        if other.unknown_keywords is not None:
+            unknown_keywords = other.unknown_keywords if unknown_keywords is None \
+                else unknown_keywords | other.unknown_keywords
+        return _Call(
+            self.positional + other.positional,
+            self.keywords + other.keywords,
+            unknown_keywords,
+            # Passing a keyword multiple times raises a TypeError.
+            self.has_error or other.has_error
+            or any(name in names for name, _ in other.keywords),
+        )
+
+    def __repr__(self):
+        return '<%s: %s %s %s%s>' % (
+            self.__class__.__name__, self.positional, self.keywords,
+            self.unknown_keywords, ' error' if self.has_error else '')
+
+
+def _collapse_calls(calls):
+    """Creates one call that describes all of the calls."""
+    values = NO_VALUES
+    minimum = INFINITY
+    maximum = 0
+    keyword_values = NO_VALUES
+    has_keywords = False
+    for call in calls:
+        values = ValueSet.from_sets([values] + [item.values for item in call.positional])
+        minimum = min(minimum, sum(item.min for item in call.positional))
+        maximum = max(maximum, sum(item.max for item in call.positional))
+        for _, v in call.keywords:
+            keyword_values |= v
+            has_keywords = True
+        if call.unknown_keywords is not None:
+            keyword_values |= call.unknown_keywords
+            has_keywords = True
+    return _Call(
+        (ContentItem(values, minimum, maximum),) if maximum else (),
+        unknown_keywords=keyword_values if has_keywords else None,
+        has_error=any(call.has_error for call in calls),
+    )
+
+
+def _call_from_dict_content(content):
+    keywords = []
+    has_error = False
+    for safe_value, (_, values) in content.known.items():
+        if isinstance(safe_value, str):
+            keywords.append((safe_value, values))
+        else:
+            # Keywords must be strings.
+            has_error = True
+    unknown_keywords = None if content.unknown is None else content.unknown[1]
+    return _Call(keywords=tuple(keywords), unknown_keywords=unknown_keywords,
+                 has_error=has_error)
+
+
+def _get_call_alternatives(arguments):
+    calls = [_Call()]
+    for star_count, key, lazy_value in arguments.unpack_with_stars():
+        if star_count == 1:
+            alternatives = [
+                _Call(positional=alternative)
+                for value in lazy_value.infer()
+                for alternative in get_sequence_alternatives(value)
+            ] or [_Call(positional=(ContentItem(NO_VALUES, 0, INFINITY),))]
+        elif star_count == 2:
+            alternatives = [
+                _call_from_dict_content(content)
+                for value in lazy_value.infer()
+                for content in get_dict_alternatives(value)
+            ] or [_Call(unknown_keywords=NO_VALUES)]
+        elif key is None:
+            alternatives = [_Call(positional=(
+                ContentItem(lazy_value.infer(), lazy_value.min, lazy_value.max),
+            ))]
+        else:
+            alternatives = [_Call(keywords=((key, lazy_value.infer()),))]
+
+        calls = [call.merge(alternative) for call in calls for alternative in alternatives]
+        if len(calls) > _MAX_CALL_ALTERNATIVES:
+            calls = [_collapse_calls(calls)]
+    return calls
+
+
+def _iter_positional_expansions(items, positional_param_count):
+    """
+    Yields lists of value sets, one for every length the positional arguments
+    can have. Lengths that exceed the amount of positional parameters by more
+    than one behave all the same, so they are not generated.
+    """
+    cap = positional_param_count + 1
+    ranges = [range(item.min, max(item.min, min(item.max, cap)) + 1) for item in items]
+    for counts in itertools.product(*ranges):
+        positional = []
+        for item, count in zip(items, counts):
+            positional += [item.values] * count
+        yield positional
+
+
+def _count_positional_expansions(items, positional_param_count):
+    cap = positional_param_count + 1
+    count = 1
+    for item in items:
+        count *= max(item.min, min(item.max, cap)) - item.min + 1
+    return count
+
+
+def bind_arguments(params, positional, keywords=(), unknown_keywords=None):
+    """
+    Binds arguments to parameters like Python does. Returns a list of
+    ``(param, values)`` or ``None`` if the call would raise a ``TypeError``.
+    """
+    positional_params = [p for p in params if p.get_kind() in _POSITIONAL_KINDS]
+    keyword_params = {p.string_name: p for p in params if p.get_kind() in _KEYWORD_KINDS}
+    var_positional = next(
+        (p for p in params if p.get_kind() == Parameter.VAR_POSITIONAL), None)
+    var_keyword = next(
+        (p for p in params if p.get_kind() == Parameter.VAR_KEYWORD), None)
+
+    result = []
+    assigned = set()
+    for i, values in enumerate(positional):
+        if i < len(positional_params):
+            param = positional_params[i]
+            assigned.add(param.string_name)
+        elif var_positional is not None:
+            param = var_positional
+        else:
+            return None  # Too many arguments
+        result.append((param, values))
+
+    for name, values in keywords:
+        param = keyword_params.get(name)
+        if param is not None:
+            if name in assigned:
+                return None  # Multiple values for an argument
+            assigned.add(name)
+        elif var_keyword is not None:
+            param = var_keyword
+        else:
+            return None  # Unexpected keyword argument
+        result.append((param, values))
+
+    if unknown_keywords is not None:
+        # Any name might be passed, including names of parameters.
+        if var_keyword is None:
+            return None
+        result.append((var_keyword, unknown_keywords))
+        for name, param in keyword_params.items():
+            if name not in assigned:
+                result.append((param, unknown_keywords))
+
+    for param in params:
+        if param.get_kind() not in (Parameter.VAR_POSITIONAL, Parameter.VAR_KEYWORD) \
+                and param.string_name not in assigned and param.default_node is None:
+            # Missing argument (the unknown keywords may not contain it).
+            return None
+    return result
+
+
+class CallMatcher:
+    """
+    Checks if functions match the arguments of a call. A single instance can be
+    used for multiple functions (e.g. overloads), then the arguments are only
+    analyzed once.
+    """
+    def __init__(self, arguments, constructed_instance=None):
+        self._arguments = arguments
+        # The annotation of `self` in `__init__` defines type vars of the
+        # instance that is created. It's not a restriction.
+        self._constructed_instance = constructed_instance
+        self._calls = None
+        self._match_cache = {}
+
+    def _get_calls(self):
+        if self._calls is None:
+            self._calls = _get_call_alternatives(self._arguments)
+        return self._calls
+
+    def matches(self, function_value):
+        return self._matches(function_value, check_types=True)
+
+    def binds(self, function_value):
+        """Checks if the arguments can be passed to the function, ignoring types."""
+        return self._matches(function_value, check_types=False)
+
+    def _matches(self, function_value, check_types):
+        params = function_value.get_param_names()
+        positional_param_count = sum(1 for p in params if p.get_kind() in _POSITIONAL_KINDS)
+        for call in self._get_calls():
+            if call.has_error:
+                return False
+            count = _count_positional_expansions(call.positional, positional_param_count)
+            if count > _MAX_POSITIONAL_EXPANSIONS:
+                return False
+            for positional in _iter_positional_expansions(call.positional,
+                                                          positional_param_count):
+                bound = bind_arguments(params, positional, call.keywords,
+                                       call.unknown_keywords)
+                if bound is None:
+                    return False
+                if check_types and not all(self._matches_param(param, values)
+                                           for param, values in bound):
+                    return False
+        return True
+
+    def _matches_param(self, param, values):
+        if self._constructed_instance is not None \
+                and values == ValueSet([self._constructed_instance]):
+            return True
+        annotation = param.infer_annotation(execute_annotation=False, ignore_stars=True)
+        if not annotation:
+            # Without annotation, everything matches. If there is an
+            # annotation that cannot be inferred, we cannot know.
+            return param.annotation_node is None
+        self_class = _get_self_class(param.function_value)
+        key = annotation, values, self_class
+        try:
+            return self._match_cache[key]
+        except KeyError:
+            result = self._match_cache[key] = values_match(
+                values, annotation, self_class=self_class)
+            return result
+
+
+def _get_self_class(function_value):
+    context = function_value.get_default_param_context()
+    if context.is_class():
+        return context.get_value()
+    return None
