index 0000000..b6dcd1e
--- /dev/null
+++ b/jedi/inference/gradual/matching.py
@@ -0,0 +1,568 @@
+"""
+Checks if values are compatible with type annotations, following the typing
+rules (subclasses, unions, ``type[...]``, generics and their variance, numeric
+promotions, protocols, ...). This is used to find the overload that matches a
+call.
+
+The checks are strict: Values that could not be inferred only match
+annotations that accept everything (``Any``, ``object`` and type vars without
+a bound). The same applies to unknown generics, e.g. a ``list`` without
+parameters is not known to be a ``list[str]``.
+
+Containers whose content is known exactly (e.g. literals) are checked by their
+content: ``[A]`` matches ``list[type[A]]``.
+"""
+from jedi import debug
+from jedi.inference import compiled
+from jedi.inference.base_value import ValueSet
+from jedi.inference.cache import inference_state_method_cache
+from jedi.inference.contents import get_known_contents, is_homogenous_tuple
+from jedi.inference.gradual.base import DefineGenericBaseClass
+from jedi.inference.gradual.type_var import TypeVar
+from jedi.inference.gradual.typing import AnyClass, SelfClass, ProxyWithGenerics, \
+    TypingClassWithGenerics, ProxyTypingClassValue, LiteralWithValues, NewType, \
+    Callable
+
+_MAX_DEPTH = 12
+_sentinel = object()
+
+_OBJECT = (('builtins',), ('object',))
+_TYPE = (('builtins',), ('type',))
+_INT = (('builtins',), ('int',))
+_FLOAT = (('builtins',), ('float',))
+_COMPLEX = (('builtins',), ('complex',))
+# PEP 484: int is acceptable where a float is expected, int and float where a
+# complex is expected.
+_PROMOTIONS = {_FLOAT: (_INT,), _COMPLEX: (_INT, _FLOAT)}
+_PROMOTED = object()
+
+# Taken from typing.py, these are not protocol members.
+_NON_PROTOCOL_MEMBERS = frozenset((
+    '__abstractmethods__', '__annotations__', '__dict__', '__doc__',
+    '__init__', '__module__', '__new__', '__slots__', '__subclasshook__',
+    '__weakref__', '__class_getitem__', '__match_args__', '__parameters__',
+    '__orig_bases__', '__orig_class__', '__qualname__', '__type_params__',
+    '__protocol_attrs__', '__non_callable_proto_members__', '_is_protocol',
+    '_is_runtime_protocol', '__static_attributes__', '__firstlineno__',
+))
+
+
+def values_match(value_set, annotation_values, self_class=None):
+    """
+    Checks if every value in ``value_set`` is compatible with the (not
+    executed) annotation ``annotation_values``, which is a union.
+    ``self_class`` is the class that ``Self`` refers to.
+    """
+    return _AnnotationMatcher(self_class).values_match(value_set, annotation_values)
+
+
+class _AnnotationMatcher:
+    def __init__(self, self_class):
+        self._self_class = self_class
+
+    def values_match(self, value_set, annotation_values, depth=0):
+        atoms = list(self._flatten(annotation_values))
+        if any(_accepts_anything(atom) for atom in atoms):
+            return True
+        if not value_set or depth > _MAX_DEPTH:
+            return False
+        return all(self._value_matches(value, atoms, depth) for value in value_set)
+
+    def _flatten(self, annotation_values):
+        """
+        Yields the members of unions and resolves other wrappers like
+        ``Optional``, ``Annotated``, ``NewType``, ``Self`` and type vars with
+        bounds.
+        """
+        for annotation in annotation_values:
+            if isinstance(annotation, ProxyWithGenerics) \
+                    and not isinstance(annotation, TypingClassWithGenerics):
+                generics = annotation.get_generics()
+                if not generics:
+                    continue
+                name = annotation.py__name__()
+                if name == 'Union':
+                    for g in generics:
+                        yield from self._flatten(g)
+                else:
+                    # Optional, ClassVar, Final, Annotated
+                    yield from self._flatten(generics[0])
+                    if name == 'Optional':
+                        yield compiled.builtin_from_name(annotation.inference_state, 'None')
+            elif isinstance(annotation, NewType):
+                yield from self._flatten(annotation.get_wrapped_type_values())
+            elif isinstance(annotation, TypeVar) and not _accepts_anything(annotation):
+                bound = annotation.bound
+                yield from self._flatten(annotation.constraints if bound is None else bound)
+            elif isinstance(annotation, SelfClass):
+                if self._self_class is not None:
+                    yield self._self_class
+            else:
+                yield annotation
+
+    def _accepts_anything_set(self, annotation_values):
+        return any(_accepts_anything(atom) for atom in self._flatten(annotation_values))
+
+    def _value_matches(self, value, atoms, depth):
+        known = get_known_contents(value)
+        if known is not None:
+            array_type, alternatives = known
+            return all(
+                any(self._content_matches(value, array_type, alternative, atom, depth)
+                    for atom in atoms)
+                for alternative in alternatives
+            )
+        return any(self._atom_matches(value, atom, depth) for atom in atoms)
+
+    def _atom_matches(self, value, atom, depth):
+        if _is_none(atom):
+            return _is_none(value)
+        if isinstance(atom, LiteralWithValues):
+            return any(_is_same_literal(value, literal)
+                       for literal in atom.get_literal_values())
+        if isinstance(atom, TypingClassWithGenerics):
+            name = atom.py__name__()
+            generics = atom.get_generics()
+            if name == 'Type':
+                return _is_class(value) and (not generics or any(
+                    self._is_subclass(value, cls) for cls in self._flatten(generics[0])))
+            if name == 'Tuple':
+                return self._tuple_instance_matches(value, generics, depth)
+            if name == 'Callable':
+                return self._callable_matches(value, generics, depth)
+            return False
+        if isinstance(atom, ProxyTypingClassValue):
+            name = atom.py__name__()
+            if name == 'Type':
+                return _is_class(value)
+            if name == 'Tuple':
+                return _find_base(_class_of(value), _tuple_class(atom)) is not None
+            if name == 'Callable':
+                return _is_callable(value)
+            return False
+        if _is_class(atom):
+            key = _class_key(atom)
+            if key == _TYPE and _is_class(value):
+                return True
+            entry = _find_base(_class_of(value), atom)
+            if entry is None:
+                return self._matches_protocol(value, atom)
+            return entry is _PROMOTED or self._generics_match(entry, atom, depth)
+        return False
+
+    def _content_matches(self, value, array_type, alternative, atom, depth):
+        """Matches a container with known contents (e.g. a literal)."""
+        if isinstance(atom, TypingClassWithGenerics):
+            if atom.py__name__() == 'Tuple' and array_type == 'tuple':
+                return self._tuple_content_matches(alternative, atom.get_generics(), depth)
+            return False
+        if isinstance(atom, ProxyTypingClassValue):
+            return atom.py__name__() == 'Tuple' and array_type == 'tuple'
+        if not _is_class(atom):
+            return False
+
+        container_class = compiled.builtin_from_name(value.inference_state, array_type)
+        entry = _find_base(container_class, atom)
+        if entry is None:
+            return self._matches_protocol(value, atom)
+
+        expected_generics = _get_annotation_generics(atom)
+        if not expected_generics:
+            return True
+        actual_generics = _get_generics(entry)
+        container_type_vars = [tv.py__name__() for tv in _list_type_vars(container_class)]
+        slots = _get_content_slots(array_type, alternative)
+        for i, expected in enumerate(expected_generics):
+            if self._accepts_anything_set(expected):
+                continue
+            if i >= len(actual_generics):
+                return False
+            actual = actual_generics[i]
+            type_var, = list(actual) if len(actual) == 1 else [None]
+            if isinstance(type_var, TypeVar) \
+                    and type_var.py__name__() in container_type_vars:
+                # The generic is defined by the content, e.g. the elements of a
+                # list. Since the content is known, there's no need to care about
+                # variance.
+                slot = slots[container_type_vars.index(type_var.py__name__())]
+                if not all(self.values_match(v, expected, depth + 1) for v in slot):
+                    return False
+            elif not self._annotation_is_subtype(actual, expected, depth):
+                return False
+        return True
+
+    def _tuple_content_matches(self, alternative, generics, depth):
+        if is_homogenous_tuple(generics):
+            return all(self.values_match(item.values, generics[0], depth + 1)
+                       for item in alternative if item.max > 0)
+
+        elements = []
+        for item in alternative:
+            if item.min != item.max:
+                # The length of the tuple is not fixed.
+                return False
+            elements += [item.values] * item.min
+        return len(elements) == len(generics) and all(
+            self.values_match(v, g, depth + 1) for v, g in zip(elements, generics)
+        )
+
+    def _tuple_instance_matches(self, value, generics, depth):
+        """For tuples that are not literals, e.g. ``tuple(x)``."""
+        entry = _find_base(_class_of(value), _tuple_class(value))
+        if entry is None or not is_homogenous_tuple(generics):
+            # Without a literal, the length is unknown.
+            return False
+        if self._accepts_anything_set(generics[0]):
+            return True
+        actual_generics = _get_generics(entry)
+        return bool(actual_generics) \
+            and self._annotation_is_subtype(actual_generics[0], generics[0], depth)
+
+    def _generics_match(self, entry, annotation, depth):
+        """
+        Compares the generics of a class in the MRO of a value with the generics
+        of an annotation, e.g. ``list[int]`` with ``Sequence[int]``.
+        """
+        expected_generics = _get_annotation_generics(annotation)
+        if not expected_generics:
+            return True
+        actual_generics = _get_generics(entry)
+        type_vars = _list_type_vars(annotation)
+        for i, expected in enumerate(expected_generics):
+            if self._accepts_anything_set(expected):
+                continue
+            if i >= len(actual_generics):
+                return False
+            actual = actual_generics[i]
+            variance = type_vars[i].variance if i < len(type_vars) else 'invariant'
+            if variance != 'contravariant' \
+                    and not self._annotation_is_subtype(actual, expected, depth):
+                return False
+            if variance != 'covariant' \
+                    and not self._annotation_is_subtype(expected, actual, depth):
+                return False
+        return True
+
+    def _annotation_is_subtype(self, sub, sup, depth):
+        """Checks if all values that the annotation ``sub`` describes match ``sup``."""
+        if self._accepts_anything_set(sup):
+            return True
+        values = []
+        for atom in self._flatten(sub):
+            if _accepts_anything(atom):
+                return False
+            executed = atom.execute_annotation(None)
+            if not executed:
+                return False
+            values.append(executed)
+        return bool(values) and self.values_match(ValueSet.from_sets(values), sup, depth + 1)
+
+    def _is_subclass(self, cls, annotation):
+        """For ``type[annotation]``."""
+        if _accepts_anything(annotation):
+            return True
+        if not _is_class(annotation) or isinstance(
+                annotation, (TypingClassWithGenerics, ProxyTypingClassValue)):
+            return False
+        return _find_base(cls, annotation) is not None
+
+    def _callable_matches(self, value, generics, depth):
+        """For ``Callable[[A, B], R]``"""
+        if not _is_callable(value):
+            return False
+        if len(generics) != 2:
+            return True
+        params, return_annotation = generics
+        if isinstance(value, Callable):
+            actual_generics = value.py__class__().get_generics()
+            if len(actual_generics) != 2:
+                return False
+            actual_params, actual_return = actual_generics
+            expected_params = _get_callable_params(params)
+            if expected_params is not None:
+                actual_params = _get_callable_params(actual_params)
+                if actual_params is None or len(actual_params) != len(expected_params) \
+                        or not all(self._annotation_is_subtype(e, a, depth)
+                                   for e, a in zip(expected_params, actual_params)):
+                    return False
+            return self._annotation_is_subtype(actual_return, return_annotation, depth)
+
+        signatures = value.get_signatures()
+        if not signatures:
+            return self._accepts_anything_set(return_annotation) \
+                and _get_callable_params(params) is None
+        return any(
+            self._signature_matches_callable(signature, params, return_annotation, depth)
+            for signature in signatures
+        )
+
+    def _signature_matches_callable(self, signature, params, return_annotation, depth):
+        from jedi.inference.gradual.annotation import infer_annotation
+        from jedi.inference.signature_matching import bind_arguments
+
+        if not self._accepts_anything_set(return_annotation):
+            function = signature.value
+            if function.is_class():
+                returned = function.execute_annotation(None)
+            elif function.tree_node is None \
+                    or function.tree_node.type not in ('funcdef', 'lambdef'):
+                return False
+            else:
+                annotation_node = function.tree_node.annotation
+                if annotation_node is not None:
+                    returned_annotation = infer_annotation(
+                        function.get_default_param_context(), annotation_node)
+                    if not self._annotation_is_subtype(
+                            returned_annotation, return_annotation, depth):
+                        return False
+                    returned = None
+                else:
+                    returned = function.as_context().infer()
+            if returned is not None \
+                    and not self.values_match(returned, return_annotation, depth + 1):
+                return False
+
+        expected_params = _get_callable_params(params)
+        if expected_params is None:
+            return True
+        # The callable is called with arguments of the expected types, so the
+        # parameters must accept them.
+        param_names = signature.get_param_names()
+        if not all(hasattr(p, 'default_node') for p in param_names):
+            # Compiled signatures are not precise enough.
+            return False
+        bound = bind_arguments(param_names, expected_params)
+        if bound is None:
+            return False
+        for param, expected in bound:
+            try:
+                annotation = param.infer_annotation(execute_annotation=False,
+                                                    ignore_stars=True)
+            except AttributeError:
+                continue
+            if not annotation:
+                if param.annotation_node is not None:
+                    return False
+            elif not self._annotation_is_subtype(expected, annotation, depth):
+                return False
+        return True
+
+    def _matches_protocol(self, value, annotation):
+        """
+        A structural check: Protocols match classes with the same members, even
+        if they don't inherit from them. Members are only checked by name.
+        """
+        protocol = _unwrap(annotation)
+        if not _is_protocol_class(protocol):
+            return False
+        if not all(self._accepts_anything_set(g)
+                   for g in _get_annotation_generics(annotation)):
+            # Generic members are not checked, so we can't know if this matches.
+            return False
+        try:
+            goto = value.goto
+        except AttributeError:
+            return False
+        matches = all(goto(name) for name in _get_protocol_members(protocol))
+        debug.dbg('Protocol %s matches %s: %s', protocol, value, matches, color='BLUE')
+        return matches
+
+
+def _accepts_anything(atom):
+    if isinstance(atom, AnyClass):
+        return True
+    if isinstance(atom, TypeVar):
+        return atom.bound is None and not atom.constraints
+    return _is_class(atom) and _class_key(atom) == _OBJECT
