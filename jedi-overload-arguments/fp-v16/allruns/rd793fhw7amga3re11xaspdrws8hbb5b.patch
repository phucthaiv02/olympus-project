diff --git a/jedi/inference/contents.py b/jedi/inference/contents.py
new file mode 100644
index 0000000..6c9e3e9
--- /dev/null
+++ b/jedi/inference/contents.py
@@ -0,0 +1,463 @@
+"""
+The exact contents of containers.
+
+Most of Jedi merges the contents of containers: For ``[1, ""]`` it's usually
+enough to know that the elements are ``int`` or ``str``. To match a call
+against a signature (e.g. to choose an overload), Jedi needs to know the
+content Python creates at runtime: How many elements there are, in which order
+they appear, which value wins if dict keys are equal and how ``*`` and ``**``
+unpackings expand.
+
+A container can be created in different ways (``[A] if c else []``), so the
+contents are a list of alternatives. For sequences, an alternative is a tuple
+of :class:`ContentItem` objects, for mappings it's a :class:`DictContent`.
+If the contents of a value are unknown, the result still describes what is
+known (e.g. the element types), but with an unknown number of elements.
+"""
+from jedi.inference import compiled
+from jedi.inference.base_value import ValueSet, NO_VALUES
+from jedi.inference.value import iterable
+from jedi.inference.value.dynamic_arrays import check_array_additions
+from jedi.parser_utils import get_sync_comp_fors
+
+INFINITY = float('inf')
+
+# Limits to avoid combinatorial explosions and endless recursions.
+_MAX_ALTERNATIVES = 32
+_MAX_DEPTH = 8
+_MAX_STRING_LENGTH = 64
+
+_NO_SAFE_VALUE = object()
+
+
+class ContentItem:
+    """
+    Between ``min`` and ``max`` elements of a sequence. Every element is one
+    of ``values``.
+    """
+    def __init__(self, values, min=1, max=1):
+        self.values = values
+        self.min = min
+        self.max = max
+
+    def __repr__(self):
+        return '<%s: %s (%s-%s)>' % (self.__class__.__name__, self.values, self.min, self.max)
+
+
+class DictContent:
+    """
+    The entries of a dict.
+
+    ``known`` maps the safe values of keys to ``(key_value, values)`` in
+    insertion order. ``unknown`` is either ``None`` or ``(keys, values)`` for
+    entries with keys whose values are not known. Those entries may or may not
+    exist.
+    """
+    def __init__(self, known=None, unknown=None):
+        self.known = known or {}
+        self.unknown = unknown
+
+    def copy(self):
+        return DictContent(dict(self.known), self.unknown)
+
+    def set_item(self, key_value, values):
+        safe_value = _get_hashable_safe_value(key_value)
+        if safe_value is _NO_SAFE_VALUE:
+            self.add_unknown(ValueSet([key_value]), values)
+            return
+        if safe_value in self.known:
+            # Like in Python, a dict keeps the first key if keys are equal,
+            # e.g. {1: a, True: b} == {1: b}.
+            key_value = self.known[safe_value][0]
+        self.known[safe_value] = (key_value, values)
+
+    def add_unknown(self, keys, values):
+        # A key we don't know might be equal to any key that is already there.
+        self.known = {
+            safe_value: (key_value, old_values | values)
+            for safe_value, (key_value, old_values) in self.known.items()
+        }
+        if self.unknown is not None:
+            keys = keys | self.unknown[0]
+            values = values | self.unknown[1]
+        self.unknown = (keys, values)
+
+    def update(self, other):
+        for key_value, values in other.known.values():
+            self.set_item(key_value, values)
+        if other.unknown is not None:
+            self.add_unknown(*other.unknown)
+
+    def get_key_items(self):
+        """The keys as an alternative of a sequence (iterating a dict)."""
+        items = tuple(
+            ContentItem(ValueSet([key_value]))
+            for key_value, _ in self.known.values()
+        )
+        if self.unknown is not None:
+            items += (ContentItem(self.unknown[0], 0, INFINITY),)
+        return items
+
+    def __repr__(self):
+        return '<%s: %s, unknown=%s>' % (
+            self.__class__.__name__,
+            list(self.known.values()),
+            self.unknown,
+        )
+
+
+def _get_hashable_safe_value(value):
+    safe_value = value.get_safe_value(default=_NO_SAFE_VALUE)
+    try:
+        hash(safe_value)
+    except TypeError:
+        return _NO_SAFE_VALUE
+    return safe_value
+
+
+def get_length_range(alternative):
+    """Returns the minimal and maximal length of a sequence alternative."""
+    return (sum(item.min for item in alternative),
+            sum(item.max for item in alternative))
+
+
+def is_ellipsis(value):
+    try:
+        cls = value.py__class__()
+    except AttributeError:
+        return False
+    return cls.py__name__() in ('ellipsis', 'EllipsisType')
+
+
+def is_homogenous_tuple(generics):
+    """Checks if the generics of a ``Tuple`` are like ``Tuple[int, ...]``."""
+    return len(generics) == 2 and bool(generics[1]) \
+        and all(is_ellipsis(v) for v in generics[1])
+
+
+def get_known_contents(value):
+    """
+    Returns ``(array_type, alternatives)`` for containers with contents that
+    are known exactly (literals, comprehensions and typed tuples), otherwise
+    ``None``. ``array_type`` is one of ``tuple``, ``list``, ``set`` or
+    ``dict``.
+    """
+    from jedi.inference.gradual.typing import Tuple
+    if not getattr(value, 'contents_known', True):
+        return None
+    if isinstance(value, (iterable.DictLiteralValue, iterable.DictComprehension,
+                          iterable.FakeDict)):
+        return 'dict', get_dict_alternatives(value)
+    if isinstance(value, iterable.SequenceLiteralValue):
+        array_type = value.array_type
+    elif isinstance(value, iterable.ListComprehension):
+        array_type = 'list'
+    elif isinstance(value, iterable.SetComprehension):
+        array_type = 'set'
+    elif isinstance(value, iterable.FakeList):
+        array_type = 'list'
+    elif isinstance(value, (iterable.FakeTuple, Tuple)):
+        array_type = 'tuple'
+    elif isinstance(value, iterable.MergedArray) \
+            and value.array_type in ('list', 'tuple'):
+        array_type = value.array_type
+    else:
+        return None
+    return array_type, get_sequence_alternatives(value)
+
+
+def get_sequence_alternatives(value):
+    """
+    The alternatives of the elements that iterating ``value`` produces, e.g.
+    what ``*value`` passes to a function.
+    """
+    return _sequence_alternatives(value, depth=0)
+
+
+def get_dict_alternatives(value):
+    """
+    The alternatives of the entries of a mapping, e.g. what ``**value`` passes
+    to a function.
+    """
+    return _dict_alternatives(value, depth=0)
+
+
+def _sequence_alternatives(value, depth):
+    from jedi.inference.gradual.typing import Tuple
+    if depth > _MAX_DEPTH or not getattr(value, 'contents_known', True):
+        return [_unknown_sequence(value)]
+
+    if isinstance(value, (iterable.DictLiteralValue, iterable.DictComprehension,
+                          iterable.FakeDict)):
+        return [d.get_key_items() for d in _dict_alternatives(value, depth)]
+    if isinstance(value, iterable.SequenceLiteralValue):
+        return _literal_sequence_alternatives(value, depth)
+    if isinstance(value, iterable.ComprehensionMixin):
+        return [_comprehension_items(value, depth)]
+    if isinstance(value, (iterable.FakeList, iterable.FakeTuple)):
+        return [tuple(
+            ContentItem(lazy_value.infer(), lazy_value.min, lazy_value.max)
+            for lazy_value in value.py__iter__()
+        )]
+    if isinstance(value, iterable.MergedArray):
+        alternatives = [[]]
+        for array in value._arrays:
+            alternatives = _combine_sequences(
+                alternatives, _sequence_alternatives(array, depth + 1))
+        return [tuple(alternative) for alternative in alternatives]
+    if isinstance(value, Tuple):
+        generics = value.py__class__().get_generics()
+        if is_homogenous_tuple(generics):
+            return [(ContentItem(generics[0].execute_annotation(None), 0, INFINITY),)]
+        return [tuple(ContentItem(g.execute_annotation(None)) for g in generics)]
+
+    string = value.get_safe_value(default=None) \
+        if getattr(value, 'is_compiled', lambda: False)() else None
+    if isinstance(string, (str, bytes)):
+        if len(string) > _MAX_STRING_LENGTH:
+            elements = value.merge_types_of_iterate()
+            return [(ContentItem(elements, len(string), len(string)),)]
+        return [tuple(
+            ContentItem(ValueSet([compiled.create_simple_object(value.inference_state, e)]))
+            for e in string
+        )]
+    return [_unknown_sequence(value)]
+
+
+def _unknown_sequence(value):
+    return (ContentItem(value.merge_types_of_iterate(), 0, INFINITY),)
+
+
+def _iter_literal_nodes(value):
+    atom = value.atom
+    if atom.type in iterable.SequenceLiteralValue._TUPLE_LIKE:
+        return atom.children[::2]
+    array_node = atom.children[1]
+    if array_node in (')', ']', '}'):
+        return []
+    if array_node.type in ('testlist_comp', 'dictorsetmaker'):
+        return array_node.children[::2]
+    return [array_node]
+
+
+def _literal_sequence_alternatives(value, depth):
+    context = value._defining_context
+    alternatives = [[]]
+    for node in _iter_literal_nodes(value):
+        if node == ':' or node.type == 'subscript':
+            # Slices in subscripts are not relevant here.
+            return [_unknown_sequence(value)]
+        if node.type == 'star_expr':
+            new = _star_alternatives(context, node.children[1], depth)
+        else:
+            new = [(ContentItem(context.infer_node(node)),)]
+        alternatives = _combine_sequences(alternatives, new)
+    alternatives = [tuple(alternative) for alternative in alternatives]
+
+    additions = check_array_additions(context, value)
+    if additions:
+        # Things like `.append()` are executed in a random order and an unknown
+        # amount of times, so the exact content is unknown.
+        alternatives = [_collapse_sequences(alternatives) + (ContentItem(
+            ValueSet.from_sets(lazy_value.infer() for lazy_value in additions),
+            0, INFINITY
+        ),)]
+
+    if value.array_type == 'set':
+        # The order of sets is unknown and equal elements only appear once.
+        alternatives = [_collapse_sequences([alternative], min_one=True)
+                        for alternative in alternatives]
+    return alternatives
+
+
+def _star_alternatives(context, node, depth):
+    values = context.infer_node(node)
+    alternatives = []
+    for v in values:
+        alternatives += _sequence_alternatives(v, depth + 1)
+    if not alternatives:
+        return [(ContentItem(NO_VALUES, 0, INFINITY),)]
+    return alternatives
+
+
+def _collapse_sequences(alternatives, min_one=False):
+    """Merges alternatives to one alternative that describes them all."""
+    values = ValueSet.from_sets(
+        item.values for alternative in alternatives for item in alternative)
+    ranges = [get_length_range(alternative) for alternative in alternatives]
+    minimum = min(r[0] for r in ranges)
+    maximum = max(r[1] for r in ranges)
+    if maximum == 0:
+        return ()
+    if min_one:
+        minimum = min(minimum, 1)
+    return (ContentItem(values, minimum, maximum),)
+
+
+def _combine(alternatives, options, apply, copy, collapse):
+    """
+    Applies every option to every alternative. To avoid quadratic behavior for
+    big literals, alternatives are only copied if there are multiple options.
+    """
+    if len(options) == 1:
+        option, = options
+        for alternative in alternatives:
+            apply(alternative, option)
+        return alternatives
+
+    result = []
+    for alternative in alternatives:
+        for option in options:
+            new = copy(alternative)
+            apply(new, option)
+            result.append(new)
+    if len(result) > _MAX_ALTERNATIVES:
+        return [collapse(result)]
+    return result
+
+
+def _combine_sequences(alternatives, new_alternatives):
+    return _combine(alternatives, new_alternatives, list.extend, list,
+                    lambda result: list(_collapse_sequences(result)))
+
+
+def _comprehension_items(comprehension, depth):
+    minimum, maximum = _comprehension_length_range(comprehension, depth)
+    if maximum == 0:
+        return ()
+    if isinstance(comprehension, iterable.SetComprehension):
+        # Equal elements only appear once.
+        minimum = min(minimum, 1)
+    return (ContentItem(comprehension.merge_types_of_iterate(), minimum, maximum),)
+
+
+def _comprehension_length_range(comprehension, depth):
+    sync_comp_for = comprehension._sync_comp_for_node
+    comp_fors = list(get_sync_comp_fors(sync_comp_for))
+    first = comp_fors[0]
+    if first.parent.type == 'comp_for':
+        # async for
+        return 0, INFINITY
+
+    input_values = comprehension._defining_context.infer_node(first.children[3])
+    ranges = [
+        get_length_range(alternative)
+        for v in input_values
+        for alternative in _sequence_alternatives(v, depth + 1)
+    ]
+    if not ranges:
+        return 0, INFINITY
+    minimum = min(r[0] for r in ranges)
+    maximum = max(r[1] for r in ranges)
+    if maximum == 0:
+        return 0, 0
+    if len(comp_fors) > 1 or _has_comp_if(sync_comp_for):
+        # The other loops depend on the first one, we don't know how often
+        # they are executed. Ifs may filter any element.
+        minimum = 0
+        if len(comp_fors) > 1:
+            maximum = INFINITY
+    return minimum, maximum
+
+
+def _has_comp_if(sync_comp_for):
+    node = sync_comp_for
+    while True:
+        last = node.children[-1]
+        if last.type == 'comp_if':
+            return True
+        elif last.type == 'comp_for':
+            node = last.children[1]
+        elif last.type == 'sync_comp_for':
+            node = last
+        else:
+            return False
+
+
+def _dict_alternatives(value, depth):
+    if depth > _MAX_DEPTH or not getattr(value, 'contents_known', True):
+        return [_unknown_dict(value)]
+
+    if isinstance(value, iterable.DictLiteralValue):
+        return _literal_dict_alternatives(value, depth)
+    if isinstance(value, iterable.FakeDict):
+        content = DictContent()
+        for key, lazy_value in value.exact_key_items():
+            key_value = compiled.create_simple_object(value.inference_state, key)
+            content.set_item(key_value, lazy_value.infer())
+        return [content]
+    if isinstance(value, iterable.DictComprehension):
+        keys, values = value.get_mapping_item_values()
+        minimum, maximum = _comprehension_length_range(value, depth)
+        if maximum == 0:
+            return [DictContent()]
+        return [DictContent(unknown=(keys, values))]
+    return [_unknown_dict(value)]
+
+
+def _unknown_dict(value):
+    keys = value.merge_types_of_iterate()
+    values = value.py__getattribute__('values', analysis_errors=False) \
+        .execute_with_values().merge_types_of_iterate()
+    return DictContent(unknown=(keys, values))
+
+
+def _iter_dict_literal_entries(value):
+    """Yields ``(key_node, value_node)`` and ``(None, node)`` for ``**node``."""
+    array_node = value.atom.children[1]
+    if array_node == '}':
+        return
+    iterator = iter(array_node.children)
+    for child in iterator:
+        if child == '**':
+            yield None, next(iterator)
+        else:
+            next(iterator)  # The colon
+            yield child, next(iterator)
+        next(iterator, None)  # A possible comma
+
+
+def _literal_dict_alternatives(value, depth):
+    context = value._defining_context
+    alternatives = [DictContent()]
+    for key_node, value_node in _iter_dict_literal_entries(value):
+        if key_node is None:
+            mappings = context.infer_node(value_node)
+            new = []
+            for mapping in mappings:
+                new += _dict_alternatives(mapping, depth + 1)
+            if not new:
+                new = [DictContent(unknown=(NO_VALUES, NO_VALUES))]
+            alternatives = _combine(alternatives, new, DictContent.update,
+                                    DictContent.copy, _collapse_dicts)
+            continue
+
+        keys = context.infer_node(key_node)
+        values = context.infer_node(value_node)
+        known_keys = [k for k in keys
+                      if _get_hashable_safe_value(k) is not _NO_SAFE_VALUE]
+        unknown_keys = keys.filter(lambda k: k not in known_keys)
+
+        def set_key(content, key_value):
+            if key_value is None:
+                content.add_unknown(unknown_keys, values)
+            else:
+                content.set_item(key_value, values)
+
+        options = known_keys + ([None] if unknown_keys or not keys else [])
+        alternatives = _combine(alternatives, options, set_key, DictContent.copy,
+                                _collapse_dicts)
+    return alternatives
+
+
+def _collapse_dicts(alternatives):
+    keys = NO_VALUES
+    values = NO_VALUES
+    for d in alternatives:
+        for key_value, v in d.known.values():
+            keys |= ValueSet([key_value])
+            values |= v
+        if d.unknown is not None:
+            keys |= d.unknown[0]
+            values |= d.unknown[1]
+    return DictContent(unknown=(keys, values))
