+
+def _get_callable_params(params):
+    """
+    Returns the annotations of the parameters of a ``Callable``, ``None`` if
+    they are not given as a list (e.g. ``...``).
+    """
+    from jedi.inference.value.iterable import SequenceLiteralValue
+    if len(params) != 1:
+        return None
+    param_list, = params
+    if not isinstance(param_list, SequenceLiteralValue) or param_list.array_type != 'list':
+        return None
+    return [lazy_value.infer() for lazy_value in param_list.py__iter__()]
