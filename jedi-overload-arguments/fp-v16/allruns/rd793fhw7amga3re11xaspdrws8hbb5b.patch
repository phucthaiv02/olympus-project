+    cls1 = _unwrap(cls1)
+    cls2 = _unwrap(cls2)
+    return cls1 == cls2 or cls1.tree_node is not None and cls1.tree_node == cls2.tree_node
+
+
+def _get_annotation_generics(annotation):
+    if isinstance(annotation, DefineGenericBaseClass):
+        return annotation.get_generics()
+    return ()
+
+
+def _get_generics(cls):
+    if isinstance(cls, DefineGenericBaseClass):
+        return cls.get_generics()
