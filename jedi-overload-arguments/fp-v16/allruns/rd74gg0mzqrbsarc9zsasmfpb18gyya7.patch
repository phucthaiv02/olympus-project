+++ b/jedi/inference/gradual/matching.py
@@ -0,0 +1,548 @@
+"""Match annotations while preserving literal contents and argument alternatives."""
+
+from inspect import Parameter
+from itertools import product
+
+from jedi.inference.arguments import TreeArguments, TreeArgumentsWrapper, ValuesArguments, \
+    unpack_arglist
+from jedi.inference.base_value import NO_VALUES, ValueSet
+from jedi.inference.compiled import builtin_from_name, create_simple_object
+from jedi.inference.gradual.base import GenericClass
+from jedi.inference.gradual.conversion import convert_values
+from jedi.inference.gradual.generics import _resolve_forward_references
+from jedi.inference.gradual.type_var import TypeVar
+from jedi.inference.gradual.typing import AnyClass, ProxyTypingClassValue, ProxyWithGenerics, Tuple
+from jedi.inference.lazy_value import LazyKnownValue, LazyKnownValues, LazyTreeValue, \
+    get_merged_lazy_value
+from jedi.inference.value import iterable
+from jedi.inference.value.dynamic_arrays import check_array_additions
+from jedi.parser_utils import get_sync_comp_fors
+
+
+_UNKNOWN = object()
+
+
+class _UnpackError(Exception):
+    pass
+
+
+class _UnknownKey:
+    """An arbitrary key, excluding keys overwritten by later literal entries."""
+
+    def __init__(self, excluded=()):
+        self.excluded = frozenset(excluded)
+
+
+class _UnpackedArguments(TreeArgumentsWrapper):
+    def __init__(self, arguments, unpacked):
+        super().__init__(arguments)
+        self._unpacked = unpacked
+
+    def unpack(self, func=None):
+        return iter(self._unpacked)
+
+
+def _valid_binding(parameters, unpacked):
+    positional_count = sum(key is None for key, lazy in unpacked)
+    keyword_list = [key for key, lazy in unpacked if key is not None]
+    if len(keyword_list) != len(set(keyword_list)) \
+            or any(not isinstance(key, str) for key in keyword_list):
+        return False
+    keywords = set(keyword_list)
+    for parameter in parameters:
+        kind = parameter.get_kind()
+        name = parameter.string_name
+        if kind == Parameter.VAR_POSITIONAL:
+            positional_count = 0
+        elif kind == Parameter.VAR_KEYWORD:
+            keywords.clear()
+        elif kind != Parameter.KEYWORD_ONLY and positional_count:
+            positional_count -= 1
+            if kind != Parameter.POSITIONAL_ONLY and name in keywords:
+                return False
+        elif kind != Parameter.POSITIONAL_ONLY and name in keywords:
+            keywords.remove(name)
+        elif parameter.default_node is None:
+            return False
+    return not positional_count and not keywords
+
+
+class AnnotationMatcher:
+    def __init__(self):
+        self._literals = _LiteralEvaluator()
+        self._active = set()
+
+    def matches_arguments(self, function_value, arguments):
+        from jedi.inference.param import get_executed_param_names_and_issues
+
+        parameters = function_value.get_param_names()
+        self._keyword_names = [parameter.string_name for parameter in parameters
+                               if parameter.get_kind() not in (Parameter.VAR_POSITIONAL,
+                                                               Parameter.VAR_KEYWORD)]
+        self._literals.max_length = 1 + sum(
+            parameter.get_kind() in (Parameter.POSITIONAL_ONLY, Parameter.POSITIONAL_OR_KEYWORD)
+            for parameter in parameters)
+        try:
+            for unpacked in self._argument_variants(arguments):
+                if not _valid_binding(parameters, unpacked):
+                    return False
+                executed, issues = get_executed_param_names_and_issues(
+                    function_value, _UnpackedArguments(arguments, unpacked))
+                if issues or not all(parameter.matches_signature(self) for parameter in executed):
+                    return False
+        except _UnpackError:
+            return False
+        return True
+
+    def _argument_variants(self, arguments):
+        from jedi.inference.value.instance import InstanceArguments
+        from jedi.plugins.stdlib import ClassMethodArguments
+
+        if isinstance(arguments, (InstanceArguments, ClassMethodArguments)):
+            receiver = arguments.instance if isinstance(arguments, InstanceArguments) \
+                else arguments._class
+            for variant in self._argument_variants(arguments._wrapped_arguments):
+                yield ((None, LazyKnownValue(receiver)),) + variant
+            return
+        if not isinstance(arguments, TreeArguments):
+            yield tuple(arguments.unpack())
+            return
+
+        variants = [()]
+        for star_count, node in unpack_arglist(arguments.argument_node):
+            context = arguments.context
+            if star_count == 1:
+                additions = [tuple((None, lazy) for lazy in variant)
+                             for variant in self._literals.iterate(context.infer_node(node))]
+            elif star_count == 2:
+                additions = []
+                for value in context.infer_node(node):
+                    mappings = self._literals.mapping(value)
+                    if mappings is None:
+                        mappings = [self._literals.unknown_mapping(value)]
+                    for mapping in mappings:
+                        known = {}
+                        unknown = []
+                        for key, (lazy_key, lazy_value) in mapping.items():
+                            if isinstance(key, _UnknownKey):
+                                string = builtin_from_name(context.inference_state, 'str')
+                                if not self.matches_values(lazy_key.infer(), ValueSet([string])):
+                                    raise _UnpackError
+                                unknown.append((key, lazy_value))
+                            else:
+                                if not isinstance(key, str):
+                                    raise _UnpackError
+                                known[key] = lazy_value
+                        choices = [known]
+                        for key, lazy_value in unknown:
+                            extra = '\0'
+                            while extra in known:
+                                extra += '\0'
+                            entries = {name: lazy_value for name in self._keyword_names + [extra]
+                                       if name not in key.excluded}
+                            choices += [dict(before, **entries) for before in choices]
+                        additions.extend(tuple(choice.items()) for choice in choices)
+            elif node.type == 'argument' and len(node.children) == 3:
+                additions = [((node.children[0].value,
+                               LazyTreeValue(context, node.children[2])),)]
+            elif node.type == 'argument':
+                sync_comp_for = node.children[1]
+                if sync_comp_for.type == 'comp_for':
+                    sync_comp_for = sync_comp_for.children[1]
+                generator = iterable.GeneratorComprehension(
+                    context.inference_state, context, sync_comp_for, node.children[0])
+                additions = [((None, LazyKnownValue(generator)),)]
+            else:
+                additions = [((None, LazyTreeValue(context, node)),)]
+            variants = [before + after for before, after in product(variants, additions or [()])]
+
+        for variant in variants:
+            yield tuple(item for item in variant if item[0] is None) \
+                + tuple(item for item in variant if item[0] is not None)
+
+    def matches_values(self, values, annotations):
+        if not annotations:
+            return True
+        return all(any(self._matches(value, annotation) for annotation in annotations)
+                   for value in values)
+
+    def _matches(self, value, annotation):
+        pair = value, annotation
+        if pair in self._active:
+            return True
+        self._active.add(pair)
+        try:
+            return self._matches_annotation(value, annotation)
+        finally:
+            self._active.remove(pair)
+
+    def _matches_annotation(self, value, annotation):
+        if isinstance(annotation, AnyClass):
+            return True
+        if isinstance(annotation, TypeVar):
+            classes = ValueSet(_resolve_forward_references(
+                annotation.parent_context, annotation._get_classes()))
+            return not classes or self.matches_values(ValueSet([value]), classes)
+        if isinstance(annotation, ProxyTypingClassValue):
+            if annotation.py__name__() == 'Type':
+                return value.is_class()
+            if annotation.py__name__() == 'Tuple':
+                return isinstance(value, Tuple) or self._is_subclass(
+                    self._value_class(value), builtin_from_name(value.inference_state, 'tuple'))
+            if annotation.py__name__() == 'Callable':
+                return self._matches_callable(value, ())
+        if isinstance(annotation, ProxyWithGenerics):
+            name = annotation.py__name__()
+            generics = annotation.get_generics()
+            if name in ('Union', 'Optional'):
+                if name == 'Optional' and value.get_safe_value(default=_UNKNOWN) is None:
+                    return True
+                return any(self.matches_values(ValueSet([value]), generic) for generic in generics)
+            if name == 'Type':
+                return value.is_class() and (not generics or all(
+                    any(self._matches_class(value, expected) for expected in generic)
+                    for generic in generics))
+            if name == 'Tuple':
+                return self._matches_tuple(value, annotation)
+            if name == 'Callable':
+                return self._matches_callable(value, generics)
+            if name in ('ClassVar', 'Annotated', 'Final') and generics:
+                return self.matches_values(ValueSet([value]), generics[0])
+        if annotation.get_safe_value(default=_UNKNOWN) is None:
+            return value.get_safe_value(default=_UNKNOWN) is None
+        if isinstance(annotation, GenericClass):
+            if not self._is_subclass(self._value_class(value), annotation._class_value):
+                return False
+            generics = annotation.get_generics()
+            name = annotation.py__name__()
+            if name in ('dict', 'Mapping', 'MutableMapping') and len(generics) == 2:
+                mappings = self._literals.mapping(value)
+                if mappings is not None:
+                    return all(self.matches_values(key.infer(), generics[0])
+                               and self.matches_values(item.infer(), generics[1])
+                               for mapping in mappings for key, item in mapping.values())
+            elif name in ('list', 'set', 'frozenset') and len(generics) == 1:
+                variants = self._literals.sequence(value)
+                if variants is not None:
+                    return all(self.matches_values(item.infer(), generics[0])
+                               for variant in variants for item in variant)
+            elif name in ('Iterable', 'Iterator', 'Sequence', 'Collection', 'Reversible',
+                          'MutableSequence', 'AbstractSet', 'Set') and len(generics) == 1:
+                variants = self._literals.sequence(value)
+                items = value.iterate() if variants is None else (
+                    item for variant in variants for item in variant)
+                return all(self.matches_values(item.infer(), generics[0])
+                           for item in items)
+            return self._matches_generics(value, annotation)
+        if not annotation.is_class():
+            return False
+        return self._is_subclass(self._value_class(value), annotation)
+
+    @staticmethod
+    def _is_subclass(value, annotation):
+        values = convert_values(ValueSet([value]), prefer_stubs=True)
+        annotations = convert_values(ValueSet([annotation]), prefer_stubs=True)
+        return any(parent.is_same_class(expected)
+                   or parent.tree_node is not None and parent.tree_node is expected.tree_node
+                   for actual in values for parent in actual.py__mro__()
+                   for expected in annotations)
+
+    def _value_class(self, value):
+        if isinstance(value, iterable.Sequence):
+            return builtin_from_name(value.inference_state, value.array_type)
+        return value.py__class__()
+
+    def _matches_class(self, value, annotation):
+        if isinstance(annotation, AnyClass):
+            return True
+        if isinstance(annotation, TypeVar):
+            classes = ValueSet(_resolve_forward_references(
+                annotation.parent_context, annotation._get_classes()))
+            return not classes or any(self._matches_class(value, expected) for expected in classes)
+        if isinstance(annotation, ProxyWithGenerics) and annotation.py__name__() in (
+                'Union', 'Optional'):
+            if annotation.py__name__() == 'Optional' and self._is_subclass(
+                    value, builtin_from_name(value.inference_state, 'None').py__class__()):
+                return True
+            return any(self._matches_class(value, expected)
+                       for generic in annotation.get_generics() for expected in generic)
+        if annotation.get_safe_value(default=_UNKNOWN) is None:
+            return self._is_subclass(value, annotation.py__class__())
+        if isinstance(annotation, (GenericClass, ProxyWithGenerics)):
+            return self.matches_values(value.execute_annotation(None), ValueSet([annotation]))
+        return annotation.is_class() and self._is_subclass(value, annotation)
+
+    def _matches_generics(self, value, annotation):
+        method = getattr(value, 'get_annotated_class_object', value.py__class__)
+        actual_class = method()
+        expected = annotation.get_generics()
+        for parent in actual_class.py__mro__():
+            if not isinstance(parent, GenericClass):
+                continue
+            origin = parent._class_value
+            if not origin.is_same_class(annotation._class_value) and (
+                    origin.tree_node is None or origin.tree_node is not annotation.tree_node):
+                continue
+            actual = parent.get_generics()
+            if len(actual) == len(expected) and all(
+                    self.matches_values(given.execute_annotation(None), required)
+                    for given, required in zip(actual, expected)):
+                return True
+        return False
+
+    def _matches_tuple(self, value, annotation):
+        if not isinstance(value, Tuple) and not self._is_subclass(
+                self._value_class(value), builtin_from_name(value.inference_state, 'tuple')):
+            return False
+        generics = annotation.get_generics()
+        homogeneous = annotation._generics_manager.is_homogenous_tuple()
+        if isinstance(value, Tuple):
+            if value._is_homogenous() and not homogeneous:
+                return False
+            variants = [tuple(value.py__iter__())]
+        else:
+            variants = self._literals.sequence(value)
+            if variants is None:
+                return False
+        if homogeneous:
+            return all(self.matches_values(item.infer(), generics[0])
+                       for variant in variants for item in variant)
+        return all(len(variant) == len(generics) and all(
+            self.matches_values(item.infer(), generic)
+            for item, generic in zip(variant, generics)) for variant in variants)
+
+    def _matches_callable(self, value, generics):
+        from jedi.inference.value.instance import InstanceArguments
+
+        if not value.is_function() and not value.is_class() \
+                and not value.py__getattribute__('__call__', analysis_errors=False):
+            return False
+        if len(generics) != 2:
+            return True
+        parameters = next(iter(generics[0]), None)
+        if isinstance(parameters, iterable.SequenceLiteralValue):
+            variants = self._literals.sequence(parameters)
+            for variant in variants:
+                arguments = ValuesArguments([item.infer().execute_annotation(None)
+                                             for item in variant])
+                checking_arguments = arguments
+                method = getattr(value, '_get_arguments', None)
+                if value.is_bound_method() and method is not None:
+                    checking_arguments = method(arguments)
+                elif not value.is_function() and not value.is_class():
+                    checking_arguments = InstanceArguments(value, arguments)
+                signatures = value.get_signatures()
+                if not value.is_class() and signatures and not any(
+                        signature.matches_signature(checking_arguments)
+                        for signature in signatures):
+                    return False
+                if not self.matches_values(value.execute(arguments), generics[1]):
+                    return False
+            return True
+        return self.matches_values(value.execute_annotation(None), generics[1])
+
+
+class _LiteralEvaluator:
+    def __init__(self):
+        self._sequences = {}
+        self._mappings = {}
+        self.max_length = 1
+
+    def iterate(self, values):
+        """Keep exact lengths, or sample through the last fixed positional slot."""
+        for value in values:
+            variants = self.sequence(value)
+            if variants is None:
+                if not isinstance(value, Tuple) and not value.py__getattribute__(
+                        '__iter__', analysis_errors=False):
+                    raise _UnpackError
+                items = tuple(value.iterate())
+                if value.is_compiled():
+                    yield items
+                else:
+                    item = get_merged_lazy_value(items) if items else LazyKnownValues(NO_VALUES)
+                    for length in range(self.max_length + 1):
+                        yield (item,) * length
+            else:
+                yield from variants
+
+    def sequence(self, value):
+        if value in self._sequences:
+            return self._sequences[value]
+        self._sequences[value] = None
+        result = None
+        if isinstance(value, (iterable.DictLiteralValue, iterable.DictComprehension,
+                              iterable.FakeDict)):
+            mappings = self.mapping(value)
+            if mappings is not None:
+                result = [tuple(key for key, item in mapping.values()) for mapping in mappings]
+        elif isinstance(value, iterable.SequenceLiteralValue):
+            context = value._defining_context
+            if value.atom.type in value._TUPLE_LIKE:
+                entries = value.atom.children[::2]
+            else:
+                inner = value.atom.children[1]
+                if inner in (']', '}', ')'):
+                    entries = []
+                elif inner.type in ('testlist_comp', 'dictorsetmaker'):
+                    entries = inner.children[::2]
+                else:
+                    entries = [inner]
+            result = [()]
+            for entry in entries:
+                if entry.type == 'star_expr':
+                    additions = list(self.iterate(context.infer_node(entry.children[1])))
+                else:
+                    additions = [(LazyTreeValue(context, entry),)]
+                result = [before + after for before, after in product(result, additions or [()])]
+            added = tuple(check_array_additions(context, value))
+            result = [variant + added for variant in result]
+        elif isinstance(value, iterable.ComprehensionMixin):
+            result = self._comprehension(value)
+        elif isinstance(value, iterable._FakeSequence):
+            result = [tuple(value.py__iter__())]
+        elif isinstance(value, Tuple) and not value._is_homogenous():
+            result = [tuple(value.py__iter__())]
+        else:
+            method = getattr(value, 'get_safe_value', None)
+            safe = _UNKNOWN if method is None else method(default=_UNKNOWN)
+            if isinstance(safe, (str, bytes)):
+                result = [tuple(LazyKnownValue(create_simple_object(value.inference_state, item))
+                                for item in safe)]
+        self._sequences[value] = result
+        return result
+
+    def mapping(self, value):
+        if value in self._mappings:
+            return self._mappings[value]
+        self._mappings[value] = None
+        result = None
+        if isinstance(value, iterable.DictLiteralValue):
+            context = value._defining_context
+            inner = value.atom.children[1]
+            children = [] if inner == '}' else inner.children
+            result = [{}]
+            iterator = iter(children)
+            for node in iterator:
+                if node == ',':
+                    continue
+                if node == '**':
+                    additions = []
+                    for mapping in context.infer_node(next(iterator)):
+                        found = self.mapping(mapping)
+                        additions.extend(found if found is not None
+                                         else [self.unknown_mapping(mapping)])
+                else:
+                    next(iterator)
+                    lazy_value = LazyTreeValue(context, next(iterator))
+                    additions = self._mapping_entry(context.infer_node(node), lazy_value)
+                result = [self._merge(before, after)
+                          for before, after in product(result, additions or [{}])]
+        elif isinstance(value, iterable.FakeDict):
+            result = [{key: (LazyKnownValue(create_simple_object(value.inference_state, key)), item)
+                       for key, item in value._dct.items()}]
+        elif isinstance(value, iterable.DictComprehension):
+            result = []
+            for variant in self._comprehension(value):
+                mappings = [{}]
+                for keys, item in variant:
+                    additions = self._mapping_entry(keys.infer(), item)
+                    mappings = [self._merge(before, after)
+                                for before, after in product(mappings, additions)]
+                result.extend(mappings)
+        elif value.array_type == 'dict':
+            actual_class = value.get_annotated_class_object()
+            if isinstance(actual_class, GenericClass) and len(actual_class.get_generics()) == 2:
+                result = [self.unknown_mapping(value)]
+        self._mappings[value] = result
+        return result
+
+    def unknown_mapping(self, value):
+        if not value.py__getattribute__('keys', analysis_errors=False) \
+                or not value.py__getattribute__('__getitem__', analysis_errors=False):
+            raise _UnpackError
+        keys = items = NO_VALUES
+        method = getattr(value, 'get_annotated_class_object', value.py__class__)
+        actual_class = method()
+        if isinstance(actual_class, GenericClass):
+            generics = actual_class.get_generics()
+            if len(generics) == 2:
+                keys, items = (generic.execute_annotation(None) for generic in generics)
+        return {_UnknownKey(): (LazyKnownValues(keys), LazyKnownValues(items))}
+
+    def _mapping_entry(self, keys, item):
+        return [{self._safe_key(key): (LazyKnownValue(key), item)} for key in keys]
+
+    def _safe_key(self, value):
+        safe = value.get_safe_value(default=_UNKNOWN)
+        if safe is not _UNKNOWN:
+            return safe
+        if value.is_class():
+            return value
+        if isinstance(value, iterable.SequenceLiteralValue) and value.array_type == 'tuple':
+            variants = self.sequence(value)
+            if variants is not None and len(variants) == 1:
+                keys = [item.infer() for item in variants[0]]
+                if all(len(key) == 1 for key in keys):
+                    return tuple(self._safe_key(next(iter(key))) for key in keys)
+        return _UnknownKey()
+
+    @staticmethod
+    def _merge(before, after):
+        """Apply updates without discarding values that survive optional keys."""
+        result = dict(before)
+        for key, (lazy_key, item) in after.items():
+            if isinstance(key, _UnknownKey):
+                excluded = set(key.excluded)
+                for existing, (existing_key, existing_item) in list(result.items()):
+                    if not isinstance(existing, _UnknownKey):
+                        if existing not in excluded:
+                            result[existing] = existing_key, get_merged_lazy_value(
+                                [existing_item, item])
+                        excluded.add(existing)
+                key = _UnknownKey(excluded)
+            else:
+                for existing in list(result):
+                    if isinstance(existing, _UnknownKey) and key not in existing.excluded:
+                        result[_UnknownKey(existing.excluded | {key})] = result.pop(existing)
+            if key in result:
+                lazy_key = result[key][0]
+            result[key] = lazy_key, item
+        return result
+
+    def _comprehension(self, value):
+        comp_fors = tuple(get_sync_comp_fors(value._sync_comp_for_node))
+
+        def nested(index, parent_context):
+            comp_for = comp_fors[index]
+            result = []
+            inputs = parent_context.infer_node(comp_for.children[3])
+            for variant in self.iterate(inputs):
+                variants = [()]
+                for item in variant:
+                    names = iterable.unpack_tuple_to_dict(
+                        parent_context, item.infer(), comp_for.children[1])
+                    context = value._get_comp_for_context(parent_context, comp_for)
+                    with context.predefine_names(comp_for, names):
+                        if index + 1 < len(comp_fors):
+                            additions = nested(index + 1, context)
+                        elif value.array_type == 'dict':
+                            keys = LazyKnownValues(context.infer_node(value._entry_node))
+                            items = LazyKnownValues(context.infer_node(value._value_node))
+                            additions = [((keys, items),)]
+                        else:
+                            additions = [(LazyKnownValues(context.infer_node(value._entry_node)),)]
+                        condition = comp_for.children[-1]
+                        while condition.type == 'comp_if':
+                            possibilities = {part.py__bool__()
+                                             for part in context.infer_node(condition.children[1])}
+                            if possibilities == {False}:
+                                additions = [()]
+                            elif possibilities != {True}:
+                                additions = additions + [()]
+                            condition = condition.children[-1]
+                    variants = [before + after for before, after in product(variants, additions)]
+                result.extend(variants)
+            return result
+
+        return nested(0, value._defining_context)
