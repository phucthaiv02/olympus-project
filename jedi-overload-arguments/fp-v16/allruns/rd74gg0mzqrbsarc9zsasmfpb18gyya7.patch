+
+@pytest.mark.parametrize('annotation, argument, expected', [
+    ('Callable', 'make_foo', 'First'),
+    ('Callable', 'Foo()', 'Second'),
+    ('Callable[..., Foo]', 'make_foo', 'First'),
+    ('Callable[..., Foo]', 'make_bar', 'Second'),
+    ('Callable[[Foo], Foo]', 'make_foo', 'First'),
+    ('Callable[[Bar], Foo]', 'make_foo', 'Second'),
+    ('Callable[[Foo], Foo]', 'make_bar', 'Second'),
+    ('Callable[[Foo], Foo]', 'CallableObject()', 'First'),
+    ('Callable[[Foo], Foo]', 'CallableObject().method', 'First'),
+])
+def test_callable_annotations(Script, annotation, argument, expected):
+    setup = '''\
+        def make_foo(value: Foo = Foo()) -> Foo: ...
+        def make_bar(value: Foo = Foo()) -> Bar: ...
+        class CallableObject:
+            def __call__(self, value: Foo) -> Foo: ...
+            def method(self, value: Foo) -> Foo: ...
+    '''
+    assert_overload(Script, 'value: ' + annotation,
+                    'choose(%s)' % argument, expected, setup)
+
+
+@pytest.mark.parametrize('kind, expected', [
+    ('Foo', {'int'}),
+    ('Bar', {'str'}),
+    ('int', {'int', 'str'}),
+])
+def test_constructor_overloads(Script, kind, expected):
+    source = PRELUDE + dedent('''\
+        class Holder(Generic[Unbounded]):
+            @overload
+            def __init__(self, left: Unbounded, right: object, kind: type[Foo]): ...
+            @overload
+            def __init__(self, left: object, right: Unbounded, kind: type[Bar]): ...
+            def get(self) -> Unbounded: ...
+        Holder(1, '', %s).get()
+    ''' % kind)
+    assert {result.name for result in Script(source.rstrip()).infer()} == expected
