+from textwrap import dedent
+
+import pytest
+
+
+PRELUDE = dedent('''\
+    from typing import Any, Callable, Dict, Generic, Iterable, List, Mapping, Optional, Sequence
+    from typing import Tuple, Type, TypeVar, Union, overload
+
+    class Foo:
+        pass
+
+    class Bar:
+        pass
+
+    class Child(Foo):
+        pass
+
+    class First:
+        def first(self):
+            pass
+
+    class Second:
+        def second(self):
+            pass
+
+    Bounded = TypeVar('Bounded', bound=Foo)
+    Constrained = TypeVar('Constrained', Foo, Bar)
+    Unbounded = TypeVar('Unbounded')
+''')
+
+
+def assert_overload(Script, first, call, expected, setup='', second='value: object'):
+    source = PRELUDE + dedent(setup) + dedent('''\
+        @overload
+        def choose(%s) -> First: ...
+        @overload
+        def choose(%s) -> Second: ...
+        %s
+    ''' % (first, second, call))
+    assert {result.name for result in Script(source.rstrip()).infer()} == set(expected.split())
+
+
+@pytest.mark.parametrize('annotation, argument, expected', [
+    ('type[Foo]', 'Foo', 'First'),
