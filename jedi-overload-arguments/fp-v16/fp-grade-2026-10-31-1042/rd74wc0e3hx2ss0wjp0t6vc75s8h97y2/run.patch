+def test_interpreter_mapping():
+    code = dedent('''\
+        from typing import overload
+        @overload
+        def target(x: int) -> str: ...
+        @overload
+        def target(x: str) -> int: ...
+        target(**kwargs)
+    ''')
+    script = Interpreter(code.rstrip(), [{'kwargs': {'x': 1}}])
+    assert {value.name for value in script.infer()} == {'str', 'int'}
