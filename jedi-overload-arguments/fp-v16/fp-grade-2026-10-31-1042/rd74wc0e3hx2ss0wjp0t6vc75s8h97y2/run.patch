@@ -0,0 +1,697 @@
+"""Match every possible argument binding before selecting an overload."""
+
+from inspect import Parameter
+
+from jedi.common import monkeypatch
+from jedi.inference.arguments import TreeArguments, ValuesArguments, unpack_arglist
+from jedi.inference.base_value import NO_VALUES, ValueSet, ValueWrapper
+from jedi.inference.compiled import builtin_from_name, create_simple_object
+from jedi.inference.gradual.base import GenericClass
+from jedi.inference.gradual.type_var import TypeVar
+from jedi.inference.gradual.typing import AnyClass, ProxyTypingClassValue, ProxyWithGenerics, Tuple
+from jedi.inference.lazy_value import LazyKnownValue, LazyKnownValues, LazyTreeValue
+from jedi.inference.value import iterable
+from jedi.parser_utils import get_sync_comp_fors
+
+
+_UNKNOWN = object()
+_MAX_ALTERNATIVES = 64
+_LITERAL_TYPES = iterable.SequenceLiteralValue, iterable.ComprehensionMixin
+
+
+def _infer_node(context, node, seen=()):
+    values = context.infer_node(node)
+    if node.type != 'name' or values and all(isinstance(value, _LITERAL_TYPES) for value in values):
+        return values
+    key = context, node
+    if key in seen or len(seen) >= 20:
+        return values
+    names = context.goto(node, position=node.start_pos)
+    if not names:
+        return values
+    literals = NO_VALUES
+    for name in names:
+        tree_name = name.tree_name
+        if tree_name is None:
+            return values
+        definition = tree_name.get_definition()
+        if definition is None or definition.type != 'expr_stmt':
+            return values
+        if next(definition.yield_operators(), None) != '=':
+            return values
+        rhs = definition.get_rhs()
+        inferred = _infer_node(name.parent_context, rhs, seen + (key,))
+        if not inferred or not all(isinstance(value, _LITERAL_TYPES) for value in inferred):
+            return values
+        literals |= inferred
+    return literals
+
+
+class _LazyMatchValue(LazyTreeValue):
+    def __init__(self, matcher, context, node):
+        super().__init__(context, node)
+        self._matcher = matcher
+
+    def infer(self):
+        with monkeypatch(self.context, 'predefined_names', self._predefined_names):
+            values = _infer_node(self.context, self.data)
+            self._matcher._capture_literals(values)
+            return values
+
+
+def _is_class_key(context, node, seen=()):
+    if node.type == 'test' and len(node.children) == 5:
+        return all(_is_class_key(context, branch, seen) for branch in node.children[::4])
+    key = context, node
+    if node.type != 'name' or key in seen or len(seen) >= 20:
+        return False
+    names = context.goto(node, position=node.start_pos)
+    for name in names:
+        if name.tree_name is None:
+            return False
+        definition = name.tree_name.get_definition()
+        if definition is not None and definition.type == 'classdef':
+            continue
+        if definition is None or definition.type != 'expr_stmt' \
+                or next(definition.yield_operators(), None) != '=':
+            return False
+        if not _is_class_key(name.parent_context, definition.get_rhs(), seen + (key,)):
+            return False
+    return bool(names)
+
+
+class _CannotMatch(Exception):
+    pass
+
+
+def _concatenate(alternatives, additions):
+    if not additions or len(alternatives) * len(additions) > _MAX_ALTERNATIVES:
+        raise _CannotMatch
+    return [left + right for left in alternatives for right in additions]
+
+
+def _repeated(values):
+    """Represent an iterable that can supply zero or more arguments."""
+    return LazyKnownValues(values, min=0, max=float('inf'))
+
+
+def _erase_class(value):
+    while isinstance(value, (GenericClass, ValueWrapper)):
+        value = value._wrapped_value
+    return value
+
+
+class _MappingShape:
+    """A possible mapping after evaluating its entries from left to right."""
+
+    def __init__(self, entries=None, unknown_items=(), min_length=None, max_length=None):
+        self.entries = {} if entries is None else entries
+        self.unknown_items = unknown_items
+        self.min_length = len(self.entries) if min_length is None else min_length
+        if max_length is None:
+            max_length = float('inf') if unknown_items else len(self.entries)
+        self.max_length = max_length
+
+    def with_item(self, key, key_values, value):
+        entries = dict(self.entries)
+        max_length = self.max_length
+        if key in entries:
+            key_values = entries[key][0]
+        else:
+            max_length += 1
+        entries[key] = key_values, value
+        return _MappingShape(entries, self.unknown_items,
+                             max(self.min_length, len(entries)), max_length)
+
+    def update(self, other):
+        entries = dict(self.entries)
+        for key_values, values in other.unknown_items:
+            for key, (original_keys, value) in entries.items():
+                entries[key] = original_keys, LazyKnownValues(value.infer() | values)
+        for key, (key_values, value) in other.entries.items():
+            if key in entries:
+                key_values = entries[key][0]
+            entries[key] = key_values, value
+        common_keys = len(self.entries.keys() & other.entries.keys())
+        return _MappingShape(
+            entries, self.unknown_items + other.unknown_items,
+            max(self.min_length, other.min_length, len(entries)),
+            self.max_length + other.max_length - common_keys,
+        )
+
+
+def matches_signature(function_value, arguments):
+    try:
+        return _Matcher().matches_signature(function_value, arguments)
+    except _CannotMatch:
+        return False
+
+
+class _Matcher:
+    def __init__(self):
+        self._sequence_cache = {}
+        self._mapping_cache = {}
+        self._match_cache = {}
+
+    def _capture_literals(self, values):
+        for value in values:
+            try:
+                if isinstance(value, (iterable.DictLiteralValue, iterable.DictComprehension)):
+                    self._mapping_shapes(value)
+                elif isinstance(value, _LITERAL_TYPES):
+                    self._sequence_shapes(value)
+            except _CannotMatch:
+                pass
+
+    def matches_signature(self, function_value, arguments):
+        return self._matches_parameters(function_value.get_param_names(), arguments)
+
+    def _matches_parameters(self, params, arguments):
+        if any(not hasattr(param, 'infer_annotation') for param in params):
+            raise _CannotMatch
+        annotations = {
+            param: param.infer_annotation(execute_annotation=False, ignore_stars=True)
+            for param in params
+        }
+        return all(self._matches_call(params, annotations, positional, keywords)
+                   for positional, keywords in self._argument_alternatives(arguments))
+
+    def _matches_call(self, params, annotations, positional, keywords):
+        positional_params = []
+        keyword_params = {}
+        var_positional = var_keyword = None
+        for param in params:
+            kind = param.get_kind()
+            if kind in (Parameter.POSITIONAL_ONLY, Parameter.POSITIONAL_OR_KEYWORD):
+                positional_params.append(param)
+            if kind in (Parameter.POSITIONAL_OR_KEYWORD, Parameter.KEYWORD_ONLY):
+                keyword_params[param.string_name] = param
+            elif kind == Parameter.VAR_POSITIONAL:
+                var_positional = param
+            elif kind == Parameter.VAR_KEYWORD:
+                var_keyword = param
+
+        def matches(param, values):
+            return param is not None and self.matches_annotation(values, annotations[param])
+
+        positions = {0}
+        positional_count = len(positional_params)
+        for argument in positional:
+            values = argument.infer()
+            next_positions = set()
+            for position in positions:
+                if argument.max > positional_count - position \
+                        and not matches(var_positional, values):
+                    return False
+                last_position = min(positional_count, position + argument.max)
+                if not all(matches(param, values)
+                           for param in positional_params[position:last_position]):
+                    return False
+                first_position = min(positional_count, position + argument.min)
+                next_positions.update(range(first_position, last_position + 1))
+            positions = next_positions
+
+        for position in positions:
+            bound = {param.string_name for param in positional_params[:position]}
+            for key, (key_values, argument) in keywords.entries.items():
+                if not isinstance(key, str):
+                    return False
+                param = keyword_params.get(key, var_keyword)
+                if key in keyword_params and key in bound:
+                    return False
+                if not matches(param, argument.infer()):
+                    return False
+
+            for param in params:
+                if param.get_kind() in (Parameter.VAR_POSITIONAL, Parameter.VAR_KEYWORD):
+                    continue
+                supplied_by_keyword = param.string_name in keyword_params \
+                    and param.string_name in keywords.entries
+                if param.string_name not in bound and not supplied_by_keyword \
+                        and param.default_node is None:
+                    return False
+
+            for key_values, values in keywords.unknown_items:
+                if var_keyword is None or bound.intersection(keyword_params):
+                    return False
+                str_class = builtin_from_name(var_keyword.parent_context.inference_state, 'str')
+                if not self.matches_annotation(key_values, ValueSet([str_class])):
+                    return False
+                if not matches(var_keyword, values) or not all(
+                    matches(param, values) for name, param in keyword_params.items()
+                    if name not in keywords.entries
+                ):
+                    return False
+        return True
+
+    def _argument_alternatives(self, arguments):
+        from jedi.inference.value.instance import InstanceArguments
+
+        if isinstance(arguments, InstanceArguments):
+            return [((LazyKnownValue(arguments.instance),) + positional, keywords)
+                    for positional, keywords
+                    in self._argument_alternatives(arguments._wrapped_arguments)]
+
+        alternatives = [((), _MappingShape())]
+        if not isinstance(arguments, TreeArguments):
+            for key, argument in arguments.unpack():
+                if key is None:
+                    alternatives = [(positional + (argument,), keywords)
+                                    for positional, keywords in alternatives]
+                else:
+                    alternatives = self._add_keywords(
+                        alternatives, [_MappingShape().with_item(key, NO_VALUES, argument)]
+                    )
+            return alternatives
+
+        context = arguments.context
+        for star_count, node in unpack_arglist(arguments.argument_node):
+            if star_count == 1:
+                shapes = self._sequences(_infer_node(context, node))
+                if len(alternatives) * len(shapes) > _MAX_ALTERNATIVES:
+                    raise _CannotMatch
+                alternatives = [(positional + shape, keywords)
+                                for positional, keywords in alternatives for shape in shapes]
+            elif star_count == 2:
+                alternatives = self._add_keywords(
+                    alternatives, self._mappings(_infer_node(context, node))
+                )
+            elif node.type == 'argument' and len(node.children) == 3:
+                key = node.children[0].value
+                argument = _LazyMatchValue(self, context, node.children[2])
+                alternatives = self._add_keywords(
+                    alternatives, [_MappingShape().with_item(key, NO_VALUES, argument)]
+                )
+            else:
+                if node.type == 'argument':
+                    argument, = TreeArguments(context.inference_state, context, node).unpack()
+                    argument = argument[1]
+                else:
+                    argument = _LazyMatchValue(self, context, node)
+                alternatives = [(positional + (argument,), keywords)
+                                for positional, keywords in alternatives]
+        return alternatives
+
+    def _add_keywords(self, alternatives, mappings):
+        if len(alternatives) * len(mappings) > _MAX_ALTERNATIVES:
+            raise _CannotMatch
+        result = []
+        for positional, keywords in alternatives:
+            for mapping in mappings:
+                if keywords.entries.keys() & mapping.entries.keys():
+                    raise _CannotMatch
+                if keywords.unknown_items and (mapping.entries or mapping.unknown_items) \
+                        or mapping.unknown_items and keywords.entries:
+                    raise _CannotMatch
+                result.append((positional, keywords.update(mapping)))
+        return result
+
+    def matches_annotation(self, values, annotations):
+        if not annotations:
+            return True
+        if any(isinstance(annotation, AnyClass) for annotation in annotations):
+            return True
+        return bool(values) and all(
+            any(self._matches_value(value, annotation) for annotation in annotations)
+            for value in values
+        )
+
+    def _matches_value(self, value, annotation):
+        key = value, annotation
+        if key not in self._match_cache:
+            self._match_cache[key] = False
+            try:
+                self._match_cache[key] = self._matches_value_uncached(value, annotation)
+            except _CannotMatch:
+                pass
+        return self._match_cache[key]
+
+    def _matches_value_uncached(self, value, annotation):
+        if isinstance(annotation, AnyClass):
+            return True
+        if isinstance(annotation, TypeVar):
+            classes = annotation._get_classes()
+            return not classes or self.matches_annotation(ValueSet([value]), classes)
+        if isinstance(annotation, ProxyWithGenerics):
+            name = annotation.py__name__()
+            generics = annotation.get_generics()
+            if name == 'Union':
+                return any(self.matches_annotation(ValueSet([value]), generic)
+                           for generic in generics)
+            if name == 'Optional':
+                return bool(generics) and (
+                    value.get_safe_value(default=_UNKNOWN) is None
+                    or self.matches_annotation(ValueSet([value]), generics[0])
+                )
+            if name in ('ClassVar', 'Annotated', 'Final'):
+                return bool(generics) and self.matches_annotation(ValueSet([value]), generics[0])
+            if name == 'Type':
+                return value.is_class() and all(
+                    any(self._matches_class(value, cls) for cls in generic)
+                    for generic in generics
+                )
+            if name == 'Tuple':
+                tuple_class = builtin_from_name(value.inference_state, 'tuple')
+                return self._matches_base(value, tuple_class) and self._matches_tuple(
+                    value, generics, annotation._generics_manager.is_homogenous_tuple()
+                )
+            if name == 'Callable':
+                return self._matches_callable(value, generics)
+
+        if isinstance(annotation, ProxyTypingClassValue):
+            if annotation.py__name__() == 'Type':
+                return value.is_class()
+            if annotation.py__name__() == 'Tuple':
+                return self._matches_base(value, builtin_from_name(value.inference_state, 'tuple'))
+
+        if isinstance(annotation, GenericClass):
+            if not self._matches_base(value, annotation._class_value):
+                return False
+            name = annotation.py__name__()
+            generics = annotation.get_generics()
+            if not generics:
+                return True
+            if name in ('dict', 'Mapping', 'MutableMapping') and len(generics) == 2:
+                return all(
+                    self.matches_annotation(keys, generics[0])
+                    and self.matches_annotation(argument.infer(), generics[1])
+                    for mapping in self._mapping_shapes(value)
+                    for keys, argument in mapping.entries.values()
+                ) and all(
+                    self.matches_annotation(keys, generics[0])
+                    and self.matches_annotation(values, generics[1])
+                    for mapping in self._mapping_shapes(value)
+                    for keys, values in mapping.unknown_items
+                )
+            if name in ('list', 'set', 'frozenset', 'Iterable', 'Iterator', 'Sequence',
+                        'MutableSequence', 'Collection', 'Container', 'Reversible'):
+                return all(self.matches_annotation(argument.infer(), generics[0])
+                           for shape in self._sequence_shapes(value) for argument in shape)
+            if name == 'tuple':
+                return self._matches_tuple(value, generics, False)
+
+        return any(self._matches_class(self._value_class(value), cls)
+                   for cls in annotation.gather_annotation_classes())
+
+    def _matches_class(self, value, annotation):
+        value = self._stub_class(value)
+        if isinstance(annotation, AnyClass):
+            return True
+        if isinstance(annotation, TypeVar):
+            classes = annotation._get_classes()
+            return not classes or any(self._matches_class(value, cls) for cls in classes)
+        if isinstance(annotation, ProxyWithGenerics):
+            name = annotation.py__name__()
+            if name in ('Union', 'Optional'):
+                if name == 'Optional':
+                    none_class = builtin_from_name(value.inference_state, 'None').py__class__()
+                    if self._matches_class(value, none_class):
+                        return True
+                return any(self._matches_class(value, cls)
+                           for generic in annotation.get_generics() for cls in generic)
+        if annotation.get_safe_value(default=_UNKNOWN) is None:
+            annotation = annotation.py__class__()
+        if isinstance(annotation, GenericClass):
+            return value.is_sub_class_of(annotation)
+        return any(_erase_class(base).is_same_class(_erase_class(annotation))
+                   for base in value.py__mro__())
+
+    def _value_class(self, value):
+        if isinstance(value, Tuple):
+            return builtin_from_name(value.inference_state, 'tuple')
+        if isinstance(value, iterable.Sequence):
+            return builtin_from_name(value.inference_state, value.array_type)
+        return self._stub_class(value.py__class__())
+
+    def _stub_class(self, value):
+        if value.is_compiled():
+            from jedi.inference.gradual.conversion import to_stub
+            stubs = to_stub(value)
+            if len(stubs) == 1:
+                return next(iter(stubs))
+        return value
+
+    def _matches_base(self, value, annotation):
+        return any(_erase_class(base).is_same_class(_erase_class(annotation))
+                   for base in self._value_class(value).py__mro__())
+
+    def _matches_tuple(self, value, generics, homogeneous):
+        for shape in self._sequence_shapes(value):
+            if homogeneous:
+                if not all(self.matches_annotation(argument.infer(), generics[0])
+                           for argument in shape):
+                    return False
+            elif len(shape) != len(generics) \
+                    or any(argument.min != 1 or argument.max != 1 for argument in shape) \
+                    or not all(self.matches_annotation(argument.infer(), generic)
+                               for argument, generic in zip(shape, generics)):
+                return False
+        return True
+
+    def _matches_callable(self, value, generics):
+        if not value.py__getattribute__('__call__') or len(generics) != 2:
+            return False
+        parameters, returns = generics
+        parameter_list = next(iter(parameters), None)
+        if isinstance(parameter_list, iterable.SequenceLiteralValue):
+            for shape in self._sequence_shapes(parameter_list):
+                if any(argument.min != 1 or argument.max != 1 for argument in shape):
+                    return False
+                arguments = ValuesArguments([argument.infer().execute_annotation(None)
+                                             for argument in shape])
+                if not any(self._matches_parameters(signature.get_param_names(), arguments)
+                           for signature in value.get_signatures()):
+                    return False
+                if not self.matches_annotation(value.execute(arguments), returns):
+                    return False
+            return True
+        return self.matches_annotation(value.execute_with_values(), returns)
+
+    def _sequences(self, values):
+        if not values:
+            raise _CannotMatch
+        return [shape for value in values for shape in self._sequence_shapes(value)]
+
+    def _sequence_shapes(self, value):
+        if value not in self._sequence_cache:
+            self._sequence_cache[value] = [(_repeated(NO_VALUES),)]
+            self._sequence_cache[value] = self._sequence_shapes_uncached(value)
+        return self._sequence_cache[value]
+
+    def _sequence_shapes_uncached(self, value):
+        if isinstance(value, (iterable.DictLiteralValue, iterable.DictComprehension,
+                              iterable.FakeDict)):
+            shapes = []
+            for mapping in self._mapping_shapes(value):
+                if mapping.unknown_items:
+                    if any(not keys for keys, values in mapping.unknown_items):
+                        raise _CannotMatch
+                    keys = ValueSet.from_sets(keys for keys, argument in mapping.entries.values())
+                    keys |= ValueSet.from_sets(keys for keys, values in mapping.unknown_items)
+                    shape = tuple(LazyKnownValues(keys) for index in range(mapping.min_length))
+                    remaining = mapping.max_length - mapping.min_length
+                    if remaining:
+                        shape += (LazyKnownValues(keys, min=0, max=remaining),)
+                else:
+                    shape = tuple(LazyKnownValues(keys)
+                                  for keys, argument in mapping.entries.values())
+                shapes.append(shape)
+            return shapes
+        if isinstance(value, iterable.SequenceLiteralValue):
+            alternatives = [()]
+            context = value._defining_context
+            for node in value.get_tree_entries(include_unpacking=True):
+                if node.type == 'star_expr':
+                    additions = self._sequences(_infer_node(context, node.children[1]))
+                else:
+                    additions = [(_LazyMatchValue(self, context, node),)]
+                alternatives = _concatenate(alternatives, additions)
+            additions = iterable.check_array_additions(context, value)
+            if additions or value.array_type == 'set' and any(alternatives):
+                values = ValueSet.from_sets(argument.infer()
+                                            for shape in alternatives for argument in shape)
+                values |= ValueSet.from_sets(argument.infer() for argument in additions)
+                return [(_repeated(values),)]
+            return alternatives
+        if isinstance(value, iterable._FakeSequence):
+            return [tuple(value.py__iter__())]
+        if isinstance(value, Tuple):
+            if not value._is_homogenous():
+                return [tuple(value.py__iter__())]
+        if isinstance(value, iterable.ComprehensionMixin):
+            shapes = [tuple(_repeated(values) if repeated else LazyKnownValues(values)
+                            for values, repeated in shape)
+                      for shape in self._comprehension_shapes(value)]
+            if isinstance(value, iterable.SetComprehension):
+                return [(_repeated(ValueSet.from_sets(argument.infer() for argument in shape)),)
+                        if shape else () for shape in shapes]
+            return shapes
+        if hasattr(value, 'get_filters') and not value.py__getattribute__('__iter__'):
+            raise _CannotMatch
+        return [(_repeated(value.merge_types_of_iterate()),)]
+
+    def _comprehension_shapes(self, value):
+        comp_fors = list(get_sync_comp_fors(value._sync_comp_for_node))
+
+        def iterate(index, parent_context):
+            comp_for = comp_fors[index]
+            inputs = _infer_node(parent_context, comp_for.children[3])
+            result = []
+            for shape in self._sequences(inputs):
+                alternatives = [()]
+                for argument in shape:
+                    context = value._get_comp_for_context(parent_context, comp_for)
+                    names = iterable.unpack_tuple_to_dict(
+                        parent_context, argument.infer(), comp_for.children[1]
+                    )
+                    with context.predefine_names(comp_for, names):
+                        optional = False
+                        condition = comp_for.children[-1]
+                        include = True
+                        while condition.type == 'comp_if':
+                            booleans = [item.py__bool__()
+                                        for item in context.infer_node(condition.children[1])]
+                            if booleans and all(boolean is False for boolean in booleans):
+                                include = False
+                                break
+                            optional |= not booleans or any(boolean is not True
+                                                            for boolean in booleans)
+                            condition = condition.children[-1]
+                        if not include:
+                            additions = [()]
+                        elif index + 1 < len(comp_fors):
+                            additions = iterate(index + 1, context)
+                        else:
+                            entry = _infer_node(context, value._entry_node)
+                            self._capture_literals(entry)
+                            if value.array_type == 'dict':
+                                values = _infer_node(context, value._value_node)
+                                self._capture_literals(values)
+                                entry = entry, values
+                            additions = [((entry, False),)]
+                        if optional and any(additions):
+                            additions = [()] + additions
+                    if argument.min != 1 or argument.max != 1:
+                        entries = [entry for addition in additions for entry, repeated in addition]
+                        if not entries:
+                            additions = [()]
+                        else:
+                            if value.array_type == 'dict':
+                                entry = tuple(ValueSet.from_sets(items)
+                                              for items in zip(*entries))
+                            else:
+                                entry = ValueSet.from_sets(entries)
+                            additions = [((entry, True),)]
+                    alternatives = _concatenate(alternatives, additions)
+                result.extend(alternatives)
+                if len(result) > _MAX_ALTERNATIVES:
+                    raise _CannotMatch
+            return result
+
+        return iterate(0, value._defining_context)
+
+    def _mappings(self, values):
+        if not values:
+            raise _CannotMatch
