+from textwrap import dedent
+
+import pytest
+
+from jedi import Interpreter
+
+
+_PRELUDE = dedent('''\
+    from typing import Any, Callable, Dict, Iterable, List, Mapping, Optional, Sequence, Tuple
+    from typing import Type, Union
+    from typing import overload
+
+    class A: pass
+    class B(A): pass
+    class C: pass
+    condition: bool
+''')
+
+
+@pytest.mark.parametrize('annotation', ['type', 'Type'])
+@pytest.mark.parametrize('argument, expected', [
+    ('A', 'only_a'),
+    ('B', 'only_a'),
+    ('input=A', 'only_a'),
+    ('*[A]', 'only_a'),
+    ('**{"input": A}', 'only_a'),
+    ('C', 'only_c'),
+    ('input=C', 'only_c'),
+    ('*[C]', 'only_c'),
+    ('**{"input": C}', 'only_c'),
+])
+def test_class_overload_completion(Script, annotation, argument, expected):
+    code = _PRELUDE + dedent('''\
+        class ABuilder:
+            def only_a(self): pass
+        class CBuilder:
+            def only_c(self): pass
+        @overload
+        def get_obj(input: {annotation}[A]) -> ABuilder: ...
+        @overload
+        def get_obj(input: {annotation}[C]) -> CBuilder: ...
+        get_obj({argument}).only_
+    ''').format(annotation=annotation, argument=argument)
+    assert [completion.name for completion in Script(code.rstrip()).complete()] == [expected]
+
+
