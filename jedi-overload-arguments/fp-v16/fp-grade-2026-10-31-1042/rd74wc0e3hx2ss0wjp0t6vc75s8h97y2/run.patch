+     'def callback(item: type[C]) -> type[C]: ...', 'callback', False),
+    ('x: Callable[[type[A]], type[C]]',
+     'def callback() -> type[C]: ...', 'callback', False),
+    ('x: Callable[[type[A]], type[C]]',
+     'def callback(item: type[A], *, required) -> type[C]: ...', 'callback', False),
+])
+def test_overload_matching(Script, parameters, setup, arguments, matches):
+    code = _PRELUDE + dedent('''\
+        @overload
+        def f({parameters}) -> str: ...
+        @overload
+        def f(*args, **kwargs) -> int: ...
+        {setup}
+        f({arguments})
+    ''').format(parameters=parameters, setup=setup, arguments=arguments)
+    assert {value.name for value in Script(code.rstrip()).infer()} == {'str' if matches else 'int'}
+
+
+@pytest.mark.parametrize('arguments', [
+    'C()',
+    'A if condition else C',
+    '*xs',
+    '*([A] if condition else [])',
+])
+def test_overload_no_match(Script, arguments):
+    code = _PRELUDE + dedent('''\
+        @overload
+        def f(x: type[A]) -> str: ...
+        @overload
+        def f(x: type[C]) -> int: ...
+        xs: list[type[C]]
+        f({arguments})
+    ''').format(arguments=arguments)
+    assert {value.name for value in Script(code.rstrip()).infer()} == {'str', 'int'}
+
+
+def test_first_matching_overload(Script):
+    code = _PRELUDE + dedent('''\
+        @overload
+        def f(x: type[A]) -> str: ...
+        @overload
+        def f(x: type[B]) -> int: ...
+        f(B)
+    ''')
+    assert {value.name for value in Script(code.rstrip()).infer()} == {'str'}
+
+
+@pytest.mark.parametrize('decorator, first_param, call', [
+    ('', 'self, ', 'Factory().f(A)'),
+    ('', 'self, ', 'Factory.f(Factory(), A)'),
+    ('@classmethod', 'cls, ', 'Factory.f(A)'),
+    ('@classmethod', 'cls, ', 'Factory().f(A)'),
+    ('@staticmethod', '', 'Factory.f(A)'),
+    ('@staticmethod', '', 'Factory().f(A)'),
+])
+def test_overloaded_method(Script, decorator, first_param, call):
+    code = _PRELUDE + dedent('''\
+        class Factory:
+            @overload
+            {decorator}
+            def f({first_param}x: type[A]) -> str: ...
+            @overload
+            {decorator}
+            def f({first_param}x: type[C]) -> int: ...
+            {decorator}
+            def f({first_param}x): pass
+        {call}
+    ''').format(decorator=decorator, first_param=first_param, call=call)
+    assert {value.name for value in Script(code.rstrip()).infer()} == {'str'}
+
+
+def test_overloaded_constructor(Script):
+    code = _PRELUDE + dedent('''\
+        from typing import Generic, TypeVar
+        T = TypeVar('T')
+        class Box(Generic[T]):
+            @overload
+            def __init__(self, selector: type[A], one: T, two: int): ...
+            @overload
+            def __init__(self, selector: type[C], one: str, two: T): ...
+            def value(self) -> T: ...
+        Box(C, '', 1.0).value()
+    ''')
+    assert {value.name for value in Script(code.rstrip()).infer()} == {'float'}
+
