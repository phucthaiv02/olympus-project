+def values_match_annotations(value_set, annotations):
+    """
+    Checks (like a type checker) if an argument is accepted by the given
+    annotations of a param. The annotations are not executed. If the argument
+    has multiple values (e.g. a Union), all of them need to be accepted.
+    """
+    if not value_set:
+        # If we cannot infer the argument, it doesn't match.
+        return False
+    return all(
+        any(_value_matches_annotation(value, annotation) for annotation in annotations)
+        for value in value_set
+    )
+
+
+def _value_matches_annotation(value, annotation):
+    from jedi.inference.gradual.typing import AnyClass, ProxyWithGenerics, \
+        ProxyTypingClassValue, IGNORE_ANNOTATION_PARTS
+
+    if isinstance(annotation, AnyClass) \
+            or annotation == builtin_from_name(annotation.inference_state, 'object'):
+        return True
+    if _is_none(annotation):
+        return _is_none(value)
+    if isinstance(annotation, ProxyWithGenerics):
+        name = annotation.py__name__()
+        generics = annotation.get_generics()
+        if name == 'Type':
+            # Type[X] accepts the class X and its subclasses, but no instances.
+            if not value.is_class():
+                return False
+            return not generics or any(
+                _class_matches_type_annotation(value, a) for a in generics[0]
+            )
+        if name == 'Optional' and _is_none(value):
+            return True
+        if name in IGNORE_ANNOTATION_PARTS:
+            generics = generics[:1]
+        if name in ('Optional', 'Union') or name in IGNORE_ANNOTATION_PARTS:
+            return any(
+                _value_matches_annotation(value, a)
+                for generic_set in generics
+                for a in generic_set
+            )
+    elif isinstance(annotation, ProxyTypingClassValue) and annotation.py__name__() == 'Type':
+        # Type without generics accepts all classes.
+        return value.is_class()
+
+    return any(
+        value.py__class__().is_sub_class_of(cls)
+        for cls in annotation.gather_annotation_classes()
+    )
+
+
+def _class_matches_type_annotation(cls, annotation):
+    """
+    Checks if the class `cls` is accepted by `Type[annotation]`.
+    """
+    from jedi.inference.gradual.typing import AnyClass, ProxyWithGenerics
+
+    if isinstance(annotation, AnyClass):
+        return True
+    if isinstance(annotation, TypeVar):
+        # The class needs to satisfy the bound or one of the constraints. If
+        # there are none, all classes are accepted.
+        classes = annotation.bound or annotation.constraints
+        return not classes or any(
+            _class_matches_type_annotation(cls, c) for c in classes
+        )
+    if isinstance(annotation, ProxyWithGenerics) \
+            and annotation.py__name__() in ('Optional', 'Union'):
+        return any(
+            _class_matches_type_annotation(cls, a)
+            for a in annotation.gather_annotation_classes()
+        )
+    if isinstance(annotation, GenericClass):
+        # Type[List[int]] accepts list.
+        annotation = annotation._wrapped_value
+    return any(cls.is_sub_class_of(c) for c in annotation.gather_annotation_classes())
+
+
+def _is_none(value):
+    return value == builtin_from_name(value.inference_state, 'None')
+
