+optional(Foo())
+#? float()
+optional(Bar())
+#? str() float()
+optional(Bar)
+
+@overload
+def union(input: int) -> str: ...
+@overload
+def union(input: Union[int, str]) -> float: ...
+
+int_or_str: Union[int, str]
+#? str()
+union(1)
+#? float()
+union('')
+#? float()
+union(int_or_str)
+
+# -------------------------
+# *args and **kwargs
+# -------------------------
+
+@overload
+def star_args(*args: int) -> str: ...
+@overload
+def star_args(*args: str) -> float: ...
+
+#? str()
+star_args()
+#? str()
+star_args(1, 2)
+#? float()
+star_args('', '')
+#? str() float()
+star_args(1, '')
+#? float()
+star_args(*('', ''))
+#? float()
+star_args(*['', ''])
+#? str() float()
+star_args(*(1, ''))
+
+@overload
+def star_kwargs(**kwargs: int) -> str: ...
+@overload
+def star_kwargs(**kwargs: str) -> float: ...
+
+#? str()
+star_kwargs()
+#? str()
+star_kwargs(a=1)
+#? float()
+star_kwargs(a='')
+#? str() float()
+star_kwargs(a=1, b='')
+#? float()
+star_kwargs(**{'a': ''})
+#? float()
+star_kwargs(**dict(a=''))
+#? float()
+star_kwargs(**dict({'a': ''}))
+
+@overload
+def mixed(a: int, *args: int, b: str, **kwargs: type[Foo]) -> str: ...
+@overload
+def mixed(a: int, *args: Any, b: Any, **kwargs: Any) -> float: ...
+
+#? str()
+mixed(1, b='')
+#? str()
+mixed(1, 2, 3, b='', c=Foo)
+#? float()
+mixed(1, 2, 3, b='', c=Bar)
+#? float()
+mixed(1, '', b='')
+
+# -------------------------
+# No overloads
+# -------------------------
+
+def no_overload(input: type[Foo], *args: int) -> FooBuilder: ...
+
+#? FooBuilder()
+no_overload(Bar, '')
