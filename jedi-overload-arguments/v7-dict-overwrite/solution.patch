+class _EntryKey:
+    """
+    A special key of the entries of a mapping. It is not a string, so it can
+    neither be the key of an actual entry nor the name of a parameter.
+    """
+    def __init__(self, name):
+        self._name = name
+
+    def __repr__(self):
+        return '<%s>' % self._name
+
+
+# The key of an entry standing for entries that are not known. No overload is
+# chosen because of such entries.
+_UNKNOWN_DICT_ENTRY = _EntryKey('unknown entries')
+# The key of entries whose values are known but whose keys are not, like
+# ``{make_key(): C}``. Their values are checked against ``**kwargs``.
+_UNKNOWN_KEY_ENTRY = _EntryKey('unknown key')
+
+
+def _mapping_node(value):
+    """
+    Identifies a mapping written in the code by its node: a dict literal or
+    the arguments of a ``dict(...)`` call, which may be a dict literal as well.
+    """
+    if isinstance(value, iterable.DictLiteralValue):
+        return value.atom
+    if _is_dict_call(value):
+        node = getattr(value._arguments, 'argument_node', None)
+        if node is not None:
+            return 'dict', node
+    return None
+
+
+def _mapping_entries(value, expanded):
+    """
+    Returns the entries of a mapping that is unpacked with ``**`` or passed to
+    ``dict(...)``. Entries that cannot be inferred, like the ones of a mapping
+    that contains itself, are represented by an entry with the key
+    ``_UNKNOWN_DICT_ENTRY``.
+    """
+    node = _mapping_node(value)
+    if node is not None:
+        if node in expanded:
+            return {_UNKNOWN_DICT_ENTRY: LazyKnownValues(NO_VALUES)}
+        expanded = expanded | {node}
+    if isinstance(value, iterable.DictLiteralValue):
+        return _dict_literal_entries(value, expanded)
+    if _is_dict_call(value):
+        return _dict_call_entries(value._arguments, expanded)
+    # Any other mapping, like a dict comprehension or a value annotated as
+    # ``Dict[str, X]``: only the values are known.
+    return _value_entries(value)
+
+
+def _value_entries(value):
+    """
+    Returns the entries of a mapping that is not written in the code.
+    """
+    from jedi.inference.gradual.base import is_empty_comprehension
+    if is_empty_comprehension(value):
+        return {}
+    items = _keys_and_getitem_items(value)
+    if items is not None:
+        lazy_items, exact = items
+        entries = {}
+        for key, lazy_value in lazy_items:
+            entry_key = _UNKNOWN_DICT_ENTRY if key is None else _entry_key(key)
+            _update_entries(entries, {entry_key: lazy_value})
+        if not exact:
+            entries = {key: _possibly_missing(lazy_value)
+                       for key, lazy_value in entries.items()}
+        return entries
+    # The keys of a dict are not known, only its values.
+    values = ValueSet.from_sets(
+        lazy_value.infer()
+        for dict_values in value.py__getattribute__('values').execute_with_values()
+        for lazy_value in dict_values.py__iter__()
+    )
+    if not values:
+        return {_UNKNOWN_DICT_ENTRY: LazyKnownValues(NO_VALUES)}
+    return {_UNKNOWN_KEY_ENTRY: PossiblyMissingLazyValue(LazyKnownValues(values))}
+
+
+def _keys_and_getitem_items(value):
+    """
+    Like ``dict(...)``, reads a mapping that is not a dict with ``keys()`` and
+    ``__getitem__``. Returns the items as ``(key, lazy value)`` pairs, where
+    ``key`` is ``None`` if it is not known, and whether these are all the
+    items. Returns ``None`` for a dict or a value without these methods.
+    """
+    from jedi.inference.gradual.base import iterate_elements
+    if isinstance(value, iterable.Sequence) or _is_dict_call(value):
+        return None
+    keys_method = value.py__getattribute__('keys')
+    getitem = value.py__getattribute__('__getitem__')
+    if not keys_method or not getitem:
+        return None
+    key_containers = keys_method.execute_with_values()
+    if not key_containers:
+        return [(None, LazyKnownValues(NO_VALUES))], False
+    items = []
+    # Only a single literal of keys gives every item.
+    exact = len(key_containers) == 1
+    for keys in key_containers:
+        lazy_keys, keys_exact = iterate_elements(keys)
+        exact = exact and keys_exact
+        for lazy_key in lazy_keys:
+            key_values = lazy_key.infer()
+            if len(key_values) != 1:
+                exact = False
+            if not key_values:
+                items.append((None, LazyKnownValues(NO_VALUES)))
+            for key in key_values:
+                items.append((key, LazyKnownValues(getitem.execute_with_values(key))))
+    return items, exact
+
+
+def _dict_literal_entries(dct, expanded):
+    """
+    Returns the entries of a dict literal, including the entries of mappings
+    unpacked in it with ``**``.
+    """
+    context = dct._defining_context
+    entries = {}
+    array_node = dct.atom.children[1]
+    if array_node.type != 'dictorsetmaker':
+        return dict(dct.exact_key_items())
+    if array_node.children[-1].type in ('comp_for', 'sync_comp_for'):
+        # A comprehension, the keys are not known.
+        return _value_entries(dct)
+    iterator = iter(array_node.children)
+    for node in iterator:
+        if node == ',':
+            continue
+        if node == '**':
+            mappings = context.infer_node(next(iterator))
+            alternatives = [_mapping_entries(mapping, expanded) for mapping in mappings]
+            if not alternatives:
+                alternatives = [{_UNKNOWN_DICT_ENTRY: LazyKnownValues(NO_VALUES)}]
+        else:
+            next(iterator)  # The colon.
+            lazy_value = LazyTreeValue(context, next(iterator))
+            alternatives = [{_entry_key(key): lazy_value}
+                            for key in context.infer_node(node)]
+            if not alternatives:
+                alternatives = [{_UNKNOWN_DICT_ENTRY: LazyKnownValues(NO_VALUES)}]
+        _update_entries(entries, _merge_alternative_entries(alternatives))
+    return entries
+
+
+def _entry_key(key):
+    """
+    The key of an entry for the inferred value of a key: the string itself,
+    ``_UNKNOWN_KEY_ENTRY`` for a string that is not known statically and
+    ``_UNKNOWN_DICT_ENTRY`` for anything else.
+    """
+    from jedi.inference.helpers import is_string
+    if is_string(key):
+        return key.get_safe_value()
+    if key.is_instance() and key.py__class__().py__name__() == 'str':
+        return _UNKNOWN_KEY_ENTRY
+    return _UNKNOWN_DICT_ENTRY
+
+
+def _dict_call_entries(arguments, expanded):
+    """
+    Returns the entries of a ``dict(...)`` call: the entries of a positional
+    mapping or iterable of pairs and the keyword arguments. Like
+    ``dict(...)``, a later entry replaces an earlier one with the same key, so
+    keyword arguments win.
+    """
+    entries = {}
+    # ``dict(**dict(...))`` is expanded as well.
+    for key, lazy_value in arguments.with_dict_calls_expanded(expanded).unpack():
+        if key is not None:
+            _update_entries(entries, {key: lazy_value})
+            continue
+        alternatives = []
+        for value in lazy_value.infer():
+            # Like ``dict(...)``, anything with ``keys`` is a mapping.
+            if value.py__getattribute__('keys'):
+                alternatives.append(_mapping_entries(value, expanded))
+            else:
+                alternatives.append(_pair_entries(value))
+        if not alternatives:
+            alternatives = [{_UNKNOWN_DICT_ENTRY: LazyKnownValues(NO_VALUES)}]
+        _update_entries(entries, _merge_alternative_entries(alternatives))
+    return entries
+
+
+def _pair_entries(value):
+    """
+    Returns the entries of an iterable of ``(key, value)`` pairs. If the
+    number of pairs is not known, like for a generator, every entry is
+    possibly missing.
+    """
+    if not value.py__getattribute__('__iter__'):
+        return {_UNKNOWN_DICT_ENTRY: LazyKnownValues(NO_VALUES)}
+    entries = {}
+    for lazy_pair in value.py__iter__():
+        alternatives = []
+        for pair in lazy_pair.infer():
+            # A pair is anything that has two items, like a tuple, a list or
+            # ``Tuple[str, X]``.
+            items = list(pair.py__iter__())
+            keys = items[0].infer() if len(items) == 2 else NO_VALUES
+            if not keys:
+                alternatives.append({_UNKNOWN_DICT_ENTRY: LazyKnownValues(NO_VALUES)})
+                continue
+            alternatives += [{_entry_key(key): items[1]} for key in keys]
+        if not alternatives:
+            alternatives = [{_UNKNOWN_DICT_ENTRY: LazyKnownValues(NO_VALUES)}]
+        _update_entries(entries, _merge_alternative_entries(alternatives))
+    if not isinstance(value, (iterable.SequenceLiteralValue, iterable.FakeTuple,
+                              iterable.FakeList)):
+        entries = {key: _possibly_missing(lazy_value) for key, lazy_value in entries.items()}
+    return entries
+
+
+def _is_possibly_missing(lazy_value):
+    return isinstance(lazy_value, PossiblyMissingLazyValue)
+
+
+def _possibly_missing(lazy_value):
+    if _is_possibly_missing(lazy_value):
+        return lazy_value
+    return PossiblyMissingLazyValue(lazy_value)
+
+
+def _merge_alternative_entries(alternatives):
+    """
+    Merges the entries of mappings that are possible values of the same
+    argument, so that every possible value of a key is kept. A key that some
+    of the mappings do not have is marked as possibly missing.
+    """
+    merged = {}
+    for entries in alternatives:
+        for key, lazy_value in entries.items():
+            merged.setdefault(key, []).append(lazy_value)
+    result = {}
+    for key, lazy_values in merged.items():
+        lazy_value = get_merged_lazy_value(lazy_values)
+        if any(key not in entries for entries in alternatives) \
+                or any(_is_possibly_missing(v) for v in lazy_values):
+            lazy_value = PossiblyMissingLazyValue(lazy_value)
+        result[key] = lazy_value
+    return result
+
+
+def _update_entries(entries, new_entries):
+    """
+    Adds entries that come after the existing ones. A later entry replaces an
+    earlier one with the same key, unless the later one is possibly missing
+    or its key is not known. Then the key keeps the values of both.
+    """
+    unknown = new_entries.get(_UNKNOWN_KEY_ENTRY)
+    if unknown is not None:
+        # An entry whose key is not known may replace any earlier entry.
+        for key, lazy_value in entries.items():
+            if not isinstance(key, _EntryKey):
+                merged = get_merged_lazy_value([lazy_value, unknown])
+                if _is_possibly_missing(lazy_value):
+                    merged = PossiblyMissingLazyValue(merged)
+                entries[key] = merged
+    for key, lazy_value in new_entries.items():
+        if key in entries and (_is_possibly_missing(lazy_value)
+                               or isinstance(key, _EntryKey)):
+            data = lazy_value.data if _is_possibly_missing(lazy_value) else lazy_value
+            merged = get_merged_lazy_value([entries[key], data])
+            if _is_possibly_missing(entries[key]) and _is_possibly_missing(lazy_value):
+                merged = PossiblyMissingLazyValue(merged)
+            lazy_value = merged
+        entries[key] = lazy_value
+
+
+def mapping_items(value):
+    """
+    Returns the keys and the values of a mapping as lists of lazy values. The
+    entries of a dict literal, including the ones unpacked in it with ``**``,
+    and of a dict created with ``dict(...)`` are taken from the code.
+    """
+    pairs = _mapping_pairs(value, frozenset()).values()
+    return ([key for key, _ in pairs if key is not None],
+            [lazy_value for _, lazy_value in pairs if lazy_value is not None])
+
+
+def _mapping_pairs(value, expanded):
+    """
+    Returns the ``(key, value)`` pairs of a mapping as lazy values in a dict.
+    A pair is stored under its key if the key is known statically, so that
+    a later entry with the same key replaces it like in the actual mapping.
+    Otherwise its key is a unique ``object()``. If keys and values cannot be
+    paired, ``None`` takes the place of the other one. ``expanded`` holds the
+    nodes of the mappings being read, like for ``_mapping_entries``.
+    """
+    from jedi.inference.gradual.base import is_empty_comprehension
+    unknown_pair = (LazyKnownValues(NO_VALUES), LazyKnownValues(NO_VALUES))
+    node = _mapping_node(value)
+    if node is not None:
+        if node in expanded:
+            # A mapping that contains itself.
+            return {object(): unknown_pair}
+        expanded = expanded | {node}
+    if isinstance(value, iterable.DictLiteralValue):
+        pairs = _dict_literal_pairs(value, expanded)
+        if pairs is not None:
+            return pairs
+    if _is_dict_call(value):
+        return _dict_call_pairs(value, expanded)
+    if is_empty_comprehension(value):
+        return {}
+    items = _keys_and_getitem_items(value)
+    if items is not None:
+        lazy_items, exact = items
+        pairs = {}
+        for key, lazy_value in lazy_items:
+            key_set = NO_VALUES if key is None else ValueSet([key])
+            pair_key = _static_key(key_set) if exact else object()
+            pairs[pair_key] = (LazyKnownValues(key_set), lazy_value)
+        return pairs
+    keys = list(value.py__iter__())
+    values = [
+        lazy_value
+        for dict_values in value.py__getattribute__('values').execute_with_values()
+        for lazy_value in dict_values.py__iter__()
+    ]
+    if not keys and not values:
+        # Nothing is known about the items.
+        return {object(): unknown_pair}
+    pairs = {}
+    for lazy_key in keys:
+        pairs[object()] = (lazy_key, None)
+    for lazy_value in values:
+        pairs[object()] = (None, lazy_value)
+    return pairs
+
+
+def _merge_pairs(pairs):
+    if len(pairs) == 1:
+        return pairs[0]
+    return (get_merged_lazy_value([lazy_key for lazy_key, _ in pairs]),
+            get_merged_lazy_value([lazy_value for _, lazy_value in pairs]))
+
+
+def _update_with_alternative_pairs(pairs, alternatives):
+    """
+    Adds the pairs of mappings that are possible values of the same argument,
+    like ``**d`` in a dict literal, after the existing pairs. The pairs with
+    the same statically known key are merged and stay under this key, so that
+    a later entry with the key replaces all of them. A key that only some of
+    the mappings have may be missing, so it does not replace an earlier pair
+    with this key but is merged with it. Otherwise its value is marked as
+    possibly missing, so that a mapping containing this one knows it as well.
+    """
+    merged: dict[Any, list[Any]] = {}
+    for alternative in alternatives:
+        for key, pair in alternative.items():
+            merged.setdefault(key, []).append(pair)
+    for key, new_pairs in merged.items():
+        possibly_missing = any(key not in alternative for alternative in alternatives) \
+            or any(_is_possibly_missing(lazy_value) for _, lazy_value in new_pairs)
+        if not possibly_missing:
+            pairs[key] = _merge_pairs(new_pairs)
+        elif key in pairs:
+            pairs[key] = _merge_pairs([pairs[key]] + new_pairs)
+        else:
+            lazy_key, lazy_value = _merge_pairs(new_pairs)
+            pairs[key] = (lazy_key, _possibly_missing(lazy_value))
+
+
+def _dict_literal_pairs(dct, expanded):
+    """
+    Returns the pairs of a dict literal like ``_mapping_pairs``, or ``None``
+    for a dict comprehension.
+    """
+    array_node = dct.atom.children[1]
+    if array_node.type != 'dictorsetmaker':
+        # An empty dict or a dict with a single ``**`` entry.
+        if array_node == '}':
+            return {}
+        array_node = dct.atom
+    elif array_node.children[-1].type in ('comp_for', 'sync_comp_for'):
+        return None
+    context = dct._defining_context
+    pairs: dict[Any, tuple[Any, Any]] = {}
+    iterator = iter(array_node.children)
+    for node in iterator:
+        if node in (',', '{', '}'):
+            continue
+        if node == '**':
+            mappings = context.infer_node(next(iterator))
+            if not mappings:
+                # The entries are not known.
+                pairs[object()] = (LazyKnownValues(NO_VALUES), LazyKnownValues(NO_VALUES))
+            _update_with_alternative_pairs(
+                pairs, [_mapping_pairs(mapping, expanded) for mapping in mappings])
+        else:
+            next(iterator)  # The colon.
+            pairs[_static_key(context.infer_node(node))] = (
+                LazyTreeValue(context, node),
+                LazyTreeValue(context, next(iterator)),
+            )
+    return pairs
+
+
+def _dict_call_pairs(dct, expanded):
+    """
+    Returns the pairs of a dict created with ``dict(...)`` like
+    ``_mapping_pairs``. Keyword arguments come last and replace the entries of
+    the positional argument with the same key.
+    """
+    from jedi.inference.compiled import builtin_from_name
+    str_ = builtin_from_name(dct.inference_state, 'str')
+    str_key = LazyKnownValues(str_.execute_annotation(None))
+    unknown_pair = (LazyKnownValues(NO_VALUES), LazyKnownValues(NO_VALUES))
+    pairs: dict[Any, tuple[Any, Any]] = {}
+    for key, lazy_value in dct._arguments.with_dict_calls_expanded(expanded).unpack():
+        if key is None:
+            arguments = lazy_value.infer()
+            if not arguments:
+                pairs[object()] = unknown_pair
+            _update_with_alternative_pairs(
+                pairs, [_positional_dict_pairs(argument, expanded) for argument in arguments])
+        elif key is _UNKNOWN_DICT_ENTRY:
+            pairs[object()] = unknown_pair
+        elif isinstance(key, _EntryKey):
+            # Keyword arguments are strings, but one whose name is not known
+            # replaces no entry.
+            pairs[object()] = (str_key, lazy_value)
+        else:
+            # A keyword argument that may be missing is merged with an earlier
+            # entry of the same key.
+            _update_with_alternative_pairs(pairs, [{key: (str_key, lazy_value)}])
+    return pairs
+
+
+def _positional_dict_pairs(argument, expanded):
+    """
+    Returns the pairs of the positional argument of ``dict(...)``, which is a
+    mapping or an iterable of ``(key, value)`` pairs.
+    """
+    if argument.py__getattribute__('keys'):
+        return _mapping_pairs(argument, expanded)
+    if not argument.py__getattribute__('__iter__'):
+        return {object(): (LazyKnownValues(NO_VALUES), LazyKnownValues(NO_VALUES))}
+    pairs = {}
+    for lazy_pair in argument.py__iter__():
+        possible_pairs = []
+        for pair in lazy_pair.infer():
+            items = list(pair.py__iter__())
+            if len(items) != 2:
+                items = [LazyKnownValues(NO_VALUES)] * 2
+            possible_pairs.append(items)
+        if not possible_pairs:
+            possible_pairs = [[LazyKnownValues(NO_VALUES)] * 2]
+        if len(possible_pairs) == 1:
+            key, value = possible_pairs[0]
+            pairs[_static_key(key.infer())] = (key, value)
+            continue
+        for key, value in possible_pairs:
+            pairs[object()] = (key, value)
+    return pairs
+
