+def _mapping_entries(value, depth):
+    """
+    Returns the entries of a mapping that is unpacked with ``**`` or passed to
+    ``dict(...)``, through at most ``depth`` nested mappings. Entries that
+    cannot be inferred are represented by an entry with the key
+    ``_UNKNOWN_DICT_ENTRY``.
+    """
