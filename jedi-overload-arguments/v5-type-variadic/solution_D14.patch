+    """
+    Returns the pairs of a dict literal like ``_mapping_pairs``, or ``None``
+    for a dict comprehension.
+    """
+    array_node = dct.atom.children[1]
+    if array_node.type != 'dictorsetmaker':
+        # An empty dict or a dict with a single ``**`` entry.
+        if array_node == '}':
+            return {}
+        array_node = dct.atom
+    elif array_node.children[-1].type in ('comp_for', 'sync_comp_for'):
+        return None
+    context = dct._defining_context
+    pairs = {}
+    iterator = iter(array_node.children)
+    for node in iterator:
+        if node in (',', '{', '}'):
+            continue
+        if node == '**':
+            mappings = context.infer_node(next(iterator))
+            if not mappings:
+                # The entries are not known.
+                pairs[object()] = (LazyKnownValues(NO_VALUES), LazyKnownValues(NO_VALUES))
