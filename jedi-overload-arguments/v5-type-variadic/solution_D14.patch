+def elements_accepted(annotations, lazy_values):
+    """
+    Whether every possible value of the elements is accepted by one of the
+    annotations. Like for arguments, elements without a known value are not.
+    """
+    for lazy_value in lazy_values:
+        values = lazy_value.infer()
+        if not values or not all(
+                any(annotation.annotation_accepts(value) for annotation in annotations)
+                for value in values):
+            return False
+    return True
+
+
+def iterate_elements(value):
+    """
+    Returns the elements of a container as lazy values and whether their
+    number is known. Unlike ``py__iter__``, the elements unpacked with ``*``
+    in a literal like ``[*a, b]`` are included.
+    """
+    from jedi.inference.lazy_value import LazyKnownValues, LazyTreeValue
+    from jedi.inference.value.iterable import SequenceLiteralValue
+    from jedi.inference.value.dynamic_arrays import check_array_additions
+    if not isinstance(value, SequenceLiteralValue) or value.array_type == 'dict':
+        return list(value.py__iter__()), True
+    children = value.atom.children
+    if value.atom.type in SequenceLiteralValue._TUPLE_LIKE:
+        nodes = children[::2]
+    elif children[1] in (']', '}', ')'):
+        nodes = []
+    elif children[1].type in ('testlist_comp', 'dictorsetmaker'):
+        nodes = children[1].children[::2]
+    else:
+        nodes = [children[1]]
+    context = value._defining_context
+    lazy_values = []
+    exact = True
+    for node in nodes:
+        if node.type != 'star_expr':
+            lazy_values.append(LazyTreeValue(context, node))
+            continue
+        unpacked = context.infer_node(node.children[1])
+        if not unpacked:
+            # The unpacked elements are not known.
+            lazy_values.append(LazyKnownValues(NO_VALUES))
+            exact = False
+        for unpacked_value in unpacked:
+            elements, unpacked_exact = iterate_elements(unpacked_value)
+            lazy_values += elements
+            # Only a single literal has a known number of elements.
+            exact = exact and unpacked_exact and len(unpacked) == 1 \
+                and isinstance(unpacked_value, SequenceLiteralValue)
+    lazy_values += check_array_additions(context, value)
+    return lazy_values, exact
+
+
