+    if isinstance(value, Tuple):
+        # Instances of ``Tuple[...]`` are not created from the ``tuple`` class.
+        tuple_class = builtin_from_name(value.inference_state, 'tuple')
+        return any(class_value.annotation_accepts(instance)
+                   for instance in tuple_class.execute_annotation(None))
+    return class_value.annotation_accepts(value)
