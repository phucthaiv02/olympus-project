+    """
+    Whether the member ``name`` of an argument has a type compatible with the
+    member ``protocol_name`` declared by a protocol. Members whose types are
+    not annotated or not known are compatible.
+    """
+    protocol_definition = _member_definition(protocol_name)
+    if protocol_definition is None:
+        return True
