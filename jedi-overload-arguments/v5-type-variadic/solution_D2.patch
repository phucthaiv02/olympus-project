@@ -667,6 +667,39 @@ class ClassValue(ClassMixin, FunctionAndClassBase, metaclass=CachedMetaClass):
             return arguments.TreeArguments(self.inference_state, self.parent_context, arglist)
         return None
 
+    def annotation_accepts(self, value):
+        # Protocols are matched structurally: the argument's class has to
+        # provide every public member the protocol declares.
+        if self.is_protocol():
+            return self._provides_protocol_members(value)
+        return super().annotation_accepts(value)
+
+    def _provides_protocol_members(self, value):
+        # The members of a protocol are the names defined in the bodies of
+        # the protocol classes it is made of.
+        members = set()
+        for cls in self.py__mro__():
+            if isinstance(cls, ClassValue) and cls.is_protocol():
+                filter_ = ClassFilter(self, node_context=cls.as_context(), is_instance=True)
+                members |= {name.string_name for name in filter_.values()}
+        members -= {'__init__', '__new__', '__slots__'}
+        if hasattr(value, 'get_filters'):
+            # Instances also have the attributes assigned to ``self``.
+            filters = list(value.get_filters())
+        else:
+            filters = list(value.py__class__().get_filters(is_instance=True))
+        return all(any(f.get(member) for f in filters) for member in members)
+
+    def is_protocol(self):
+        from jedi.inference.gradual.base import BaseTypingValue, \
+            BaseTypingClassWithGenerics
+        for lazy_cls in self.py__bases__():
+            for cls in lazy_cls.infer():
+                if isinstance(cls, (BaseTypingValue, BaseTypingClassWithGenerics)) \
+                        and cls.py__name__() == 'Protocol':
+                    return True
+        return False
+
