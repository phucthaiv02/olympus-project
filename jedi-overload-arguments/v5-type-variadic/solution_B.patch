diff --git a/jedi/inference/value/klass.py b/jedi/inference/value/klass.py
index 034fe3e5..4a53ff80 100644
--- a/jedi/inference/value/klass.py
+++ b/jedi/inference/value/klass.py
@@ -667,6 +667,37 @@ class ClassValue(ClassMixin, FunctionAndClassBase, metaclass=CachedMetaClass):
             return arguments.TreeArguments(self.inference_state, self.parent_context, arglist)
         return None
 
+    def annotation_accepts(self, value):
+        # Protocols are matched structurally: the argument's class has to
+        # provide every public member the protocol declares.
+        if self.is_protocol():
+            return self._provides_protocol_members(value)
+        return super().annotation_accepts(value)
+
+    def _provides_protocol_members(self, value):
+        members = {
+            name for filter_ in self.get_filters(is_instance=True)
+            for name in filter_.values()
+            if not name.string_name.startswith('_')
+        }
+        arg_class = value.py__class__()
+        return all(
+            any(filter_.get(name.string_name) for filter_ in
+                arg_class.get_filters(is_instance=True))
+            for name in members
+            if name.string_name not in ('Protocol', 'Generic')
+        )
+
+    def is_protocol(self):
+        from jedi.inference.gradual.base import BaseTypingValue, \
+            BaseTypingClassWithGenerics
+        for lazy_cls in self.py__bases__():
+            for cls in lazy_cls.infer():
+                if isinstance(cls, (BaseTypingValue, BaseTypingClassWithGenerics)) \
+                        and cls.py__name__() == 'Protocol':
+                    return True
+        return False
+
     @inference_state_method_cache(default=())
     def py__bases__(self):
         args = self._get_bases_arguments()
