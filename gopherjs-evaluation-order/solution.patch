+// isHoisted reports whether translating the expression emits statements that
+// are evaluated ahead of the expression it is a part of. This is the case for
+// blocking calls and for calls whose arguments are the results of a
+// multi-value call.
+func (fc *funcContext) isHoisted(expr ast.Expr) bool {
+	hoisted := false
+	ast.Inspect(expr, func(n ast.Node) bool {
+		switch n := n.(type) {
+		case nil:
+			return false
+		case *ast.FuncLit:
+			return false
+		case *ast.CallExpr:
+			if len(n.Args) == 1 {
+				if _, isTuple := fc.typeOf(n.Args[0]).(*types.Tuple); isTuple {
+					hoisted = true
+				}
+			}
+		}
+		if e, ok := n.(ast.Expr); ok && fc.Blocking[e] {
+			hoisted = true
+		}
+		return !hoisted
+	})
+	return hoisted
+}
