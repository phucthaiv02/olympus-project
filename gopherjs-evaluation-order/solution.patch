+// evaluateAssignOperands evaluates the operands of index expressions and
+// pointer indirections of an assignment's left-hand side into temporary
+// variables and returns an equivalent expression that refers to them.
+//
+// The Go spec requires an assignment to take place in two phases: first all
+// such operands on the left and the expressions on the right are evaluated in
+// the usual order, then the assignments are carried out left to right. For
+// example, in `i, x[i] = 1, 2` the element is chosen with the old value of i.
+func (fc *funcContext) evaluateAssignOperands(lhs ast.Expr) ast.Expr {
+	lhs = astutil.RemoveParens(lhs)
+	capture := func(e ast.Expr) ast.Expr {
+		if fc.pkgCtx.Types[e].Value != nil {
+			return e // Constants can't change.
+		}
+		v := fc.newLocalVariable("_operand")
+		// Map keys are values, so a struct or array key must be copied.
+		fc.Printf("%s = %s;", v, fc.translateImplicitConversionWithCloning(e, fc.typeOf(e)))
+		return fc.newIdent(v, fc.typeOf(e))
+	}
+
+	switch l := lhs.(type) {
+	case *ast.IndexExpr:
+		var x ast.Expr
+		if _, isArray := fc.typeOf(l.X).Underlying().(*types.Array); isArray {
+			// The array is itself a variable, which may only have operands of its own.
+			x = fc.evaluateAssignOperands(l.X)
+		} else {
+			x = capture(l.X)
+		}
+		return fc.setType(&ast.IndexExpr{X: x, Index: capture(l.Index)}, fc.typeOf(l))
+	case *ast.StarExpr:
+		return fc.setType(&ast.StarExpr{X: capture(l.X)}, fc.typeOf(l))
+	case *ast.SelectorExpr:
+		sel, ok := fc.selectionOf(l)
+		if !ok || sel.Kind() != types.FieldVal {
+			return l // Qualified identifier.
+		}
+		if _, jsTag := fc.translateSelection(sel, l.Pos()); jsTag != "" {
+			return l
+		}
+		var x ast.Expr
+		if _, isPtr := fc.typeOf(l.X).Underlying().(*types.Pointer); isPtr {
+			x = capture(l.X)
+		} else {
+			x = fc.evaluateAssignOperands(l.X)
+		}
+		newSel := &ast.SelectorExpr{X: x, Sel: l.Sel}
+		fc.setType(newSel, fc.typeOf(l))
+		fc.pkgCtx.additionalSelections[newSel] = sel
+		return newSel
+	default:
+		return lhs
+	}
+}
+
+// evaluateRangeValueOperands returns the value expression of a range
+// statement, with its operands evaluated before the key is assigned when the
+// statement assigns to existing variables.
+func (fc *funcContext) evaluateRangeValueOperands(s *ast.RangeStmt) ast.Expr {
+	if s.Tok == token.DEFINE || isBlank(s.Key) || isBlank(s.Value) {
+		return s.Value
+	}
+	return fc.evaluateAssignOperands(s.Value)
+}
