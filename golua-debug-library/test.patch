+#!/usr/bin/env bash
+# Usage: ./test.sh [--output_path <junit.xml>] <base|new>
+#
+#   base  the existing tests.
+#   new   the debug library tests.
+set -uo pipefail
+
+cd /app
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+fi
+
+MODE="${1:-new}"
+
+TEST_LOG="$(mktemp)"
+
+# go vet's tests analyzer rejects doc_test.go (an Example with arguments and
+# results), so it is turned off.
+case "$MODE" in
+  base)
+    go test -count=1 -vet=off -v -skip '_a2959f$' ./... 2>&1 | tee "$TEST_LOG"
+    STATUS=${PIPESTATUS[0]}
+    ;;
+  new)
+    go test -count=1 -vet=off -v -run '_a2959f$' . 2>&1 | tee "$TEST_LOG"
+    STATUS=${PIPESTATUS[0]}
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$OUTPUT_PATH" || true
+fi
+
+exit "$STATUS"
