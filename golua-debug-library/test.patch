+package lua
+
+import "testing"
+
+// debugPrelude_a2959f defines run(f), which calls f in protected mode and
+// renders its results. Tables are rendered with sorted keys, func fields as
+// their type and activelines as a sorted list of lines.
+const debugPrelude_a2959f = `local function show(v)
+  if type(v) ~= "table" then return tostring(v) end
+  local keys = {}
+  for k in pairs(v) do keys[#keys + 1] = k end
+  table.sort(keys)
+  local out = {}
+  for _, k in ipairs(keys) do
+    local x = v[k]
+    if k == "func" then
+      x = type(x)
+    elseif k == "activelines" then
+      local lines = {}
+      for line in pairs(x) do lines[#lines + 1] = line end
+      table.sort(lines)
+      x = "{" .. table.concat(lines, ",") .. "}"
+    elseif type(x) == "table" then
+      x = "table"
+    end
+    out[#out + 1] = k .. "=" .. tostring(x)
+  end
+  return "{" .. table.concat(out, " ") .. "}"
+end
+
+function run(f)
+  local function pack(...) return select("#", ...), {...} end
+  local n, results = pack(pcall(f))
+  local out = {}
+  for i = 1, n do out[i] = show(results[i]) end
+  return table.concat(out, " | ")
+end
+`
+
+type debugCase_a2959f struct {
+	name string
+	code string
+	want string
+}
+
+func runDebugCases_a2959f(t *testing.T, cases []debugCase_a2959f) {
+	t.Helper()
+	for _, c := range cases {
+		c := c
+		t.Run(c.name, func(t *testing.T) {
+			l := NewState()
+			OpenLibraries(l)
+			if err := DoString(l, debugPrelude_a2959f); err != nil {
+				t.Fatalf("prelude: %v", err)
+			}
+			l.Global("run")
+			if err := LoadBuffer(l, c.code, "=case", "t"); err != nil {
+				t.Fatalf("load: %v", err)
+			}
+			if err := l.ProtectedCall(1, 1, 0); err != nil {
+				t.Fatalf("run: %v", err)
+			}
+			got, _ := l.ToString(-1)
+			if got != c.want {
+				t.Errorf("got  %s\nwant %s\ncode:\n%s", got, c.want, c.code)
+			}
+		})
+	}
+}
