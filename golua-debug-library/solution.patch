+func (l *State) findLocal(ci *callInfo, n int) (string, int) {
+	var name string
+	var base int
+	if ci.isLua() {
+		if n < 0 { // access to vararg values?
+			return l.findVarArg(ci, -n)
+		}
+		base = ci.base()
+		name, _ = l.prototype(ci).localName(n, l.currentPC(ci))
+	} else {
+		base = ci.function + 1
+	}
+	if name == "" { // no 'standard' name?
+		limit := l.top
+		if ci != l.callInfo {
+			limit = ci.next.function
+		}
+		if limit-base >= n && n > 0 { // is 'n' inside 'ci' stack?
+			name = "(*temporary)" // generic name for any valid slot
+		} else {
+			return "", 0 // no name
+		}
+	}
+	return name, base + (n - 1)
+}
+
+// Local gets information about a local variable of a given activation record
+// or function.
+//
+// In the first case, the parameter where must be a valid activation record that
+// was filled by a previous call to Stack or given as an argument to a hook. The
+// index n selects which local variable to inspect. Local pushes the variable's
+// value onto the stack and returns its name.
+//
+// In the second case, where must be nil and the function to be inspected must
+// be at the top of the stack. In this case, only parameters of Lua functions
+// are visible (as there is no information about what variables are active) and
+// no values are pushed onto the stack.
+//
+// Local returns false (and pushes nothing) when the index is greater than the
+// number of active local variables.
+//
+// http://www.lua.org/manual/5.2/manual.html#lua_getlocal
+func Local(l *State, where Frame, n int) (name string, ok bool) {
+	if where == nil { // information about non-active function?
+		if f, isLua := l.stack[l.top-1].(*luaClosure); isLua { // consider live variables at function start (parameters)
+			return f.prototype.localName(n, 0)
+		}
+		return
+	}
+	name, pos := l.findLocal(where, n)
+	if name != "" {
+		l.apiPush(l.stack[pos])
+	}
+	return name, name != ""
+}
+
+// SetLocal sets the value of a local variable of a given activation record.
+// Parameters where and n are as in Local. SetLocal assigns the value at the top
+// of the stack to the variable and returns its name. It also pops the value
+// from the stack.
+//
+// It returns false (and pops nothing) when the index is greater than the
+// number of active local variables.
+//
+// http://www.lua.org/manual/5.2/manual.html#lua_setlocal
+func SetLocal(l *State, where Frame, n int) (name string, ok bool) {
+	name, pos := l.findLocal(where, n)
+	if name != "" {
+		l.stack[pos] = l.stack[l.top-1]
+	}
+	l.top-- // pop value
+	return name, name != ""
+}
