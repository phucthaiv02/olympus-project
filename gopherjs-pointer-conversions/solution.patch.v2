diff --git a/compiler/prelude/prelude.js b/compiler/prelude/prelude.js
index 9e158d29..f0122237 100644
--- a/compiler/prelude/prelude.js
+++ b/compiler/prelude/prelude.js
@@ -506,8 +506,85 @@ var $clone = (src, type) => {
     return clone;
 };
 
+// Reports whether obj is a nil pointer of its own type or the zero
+// unsafe.Pointer value.
+var $isNilPointer = obj => {
+    return obj === 0 || obj === (obj.constructor && obj.constructor.nil);
+};
+
+// Convert a pointer to a different pointer type with the same element
+// representation. Nil pointers become the nil value of the target type, and
+// converting the same pointer to the same type always yields the same object,
+// so that the converted pointers compare equal. makeProxy creates the pointer
+// object of the target type when the source can't be reused as is; it may be
+// omitted when the source representation is shared by both types, which is
+// the case for pointers to arrays.
+var $pointerConversion = (obj, type, makeProxy) => {
+    if ($isNilPointer(obj)) {
+        return type.nil;
+    }
+    if (makeProxy === undefined || obj.constructor === type) {
+        return obj;
+    }
+    if (obj.$proxies === undefined) {
+        obj.$proxies = {};
+        obj.$proxies[obj.constructor.id] = obj;
+    }
+    var proxy = obj.$proxies[type.id];
+    if (proxy === undefined) {
+        proxy = makeProxy(obj);
+        obj.$proxies[type.id] = proxy;
+        proxy.$proxies = obj.$proxies;
+    }
+    return proxy;
+};
+
+// Convert a pointer to unsafe.Pointer, which represents nil as 0.
+var $pointerToUnsafe = obj => {
+    return $isNilPointer(obj) ? 0 : obj;
+};
+
+// Convert an unsafe.Pointer to the pointer type type. Nil becomes the nil
+// value of type and a pointer that already has type is returned as is, so a
+// round trip through unsafe.Pointer gives back the original pointer. A pointer
+// of another pointer type is accessed through a cached proxy of type, as in
+// $pointerConversion. Other values, such as byte arrays or pointers to
+// structs, keep their representation.
+var $unsafeToPointer = (obj, type) => {
+    if ($isNilPointer(obj)) {
+        return type.nil;
+    }
+    if (obj.$get === undefined || obj.constructor.elem === undefined) {
+        return obj;
+    }
+    return $pointerConversion(obj, type, ptr => new type(
+        () => $reinterpretPointee(ptr.$get(), type.elem),
+        v => { ptr.$set($reinterpretPointee(v, ptr.constructor.elem)); },
+        ptr.$target, ptr.$index));
+};
+
+// Give a value read or written through a pointer converted via unsafe.Pointer
+// the representation of the element type elem. Only values that carry their
+// own type need to change.
+var $reinterpretPointee = (v, elem) => {
+    if (v === null || v === undefined || v.constructor === elem) {
+        return v;
+    }
+    switch (elem.kind) {
+        case $kindInt64:
+        case $kindUint64:
+            return v.$high === undefined ? v : new elem(v.$high, v.$low);
+        case $kindComplex64:
+        case $kindComplex128:
+            return v.$real === undefined ? v : new elem(v.$real, v.$imag);
+        case $kindPtr:
+            return $unsafeToPointer(v, elem);
+    }
+    return v;
+};
+
 var $pointerOfStructConversion = (obj, type) => {
-    if (obj === (obj.constructor && obj.constructor.nil)) {
+    if ($isNilPointer(obj)) {
         return type.nil;
     }
     if (obj.$proxies === undefined) {
