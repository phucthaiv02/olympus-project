-	offsets := sizes32.Offsetsof(fields)
+	return fields, sizes32.Offsetsof(fields)
+}
+
+// storeStruct writes the fields of the struct target into the byte array, in
+// the layout that loadStruct reads them from.
+func (fc *funcContext) storeStruct(array, target string, s *types.Struct) string {
+	view := fc.newLocalVariable("_view")
+	code := fmt.Sprintf("%s = new DataView(%s.buffer, %s.byteOffset)", view, array, array)
+	fields, offsets := fc.structFields(target, s)
+	for i, field := range fields {
+		switch t := field.Type().Underlying().(type) {
+		case *types.Basic:
+			if isNumeric(t) {
+				if is64Bit(t) {
+					code += fmt.Sprintf(", %s.setUint32(%d, %s.$high, true), %s.setUint32(%d, %s.$low, true)", view, offsets[i]+4, field.Name(), view, offsets[i], field.Name())
+					break
+				}
+				code += fmt.Sprintf(", %s.set%s(%d, %s, true)", view, toJavaScriptType(t), offsets[i], field.Name())
+			}
+		case *types.Array:
+			if elem, ok := t.Elem().Underlying().(*types.Basic); ok && isNumeric(elem) && !is64Bit(elem) {
+				size := sizes32.Sizeof(t)
+				code += fmt.Sprintf(", new Uint8Array(%s.buffer, %s.byteOffset + %d, %d).set(new Uint8Array(%s.buffer, %s.byteOffset, %d))", array, array, offsets[i], size, field.Name(), field.Name(), size)
+			}
+		}
+	}
+	return code
+}
+
+// loadStruct reads the fields of the struct target from the byte array. Array
+// fields become views of the byte array, unless inPlace is set, in which case
+// their contents are copied into the struct's existing arrays, as storeStruct
+// copies them out.
+func (fc *funcContext) loadStruct(array, target string, s *types.Struct, inPlace bool) string {
+	view := fc.newLocalVariable("_view")
+	code := fmt.Sprintf("%s = new DataView(%s.buffer, %s.byteOffset)", view, array, array)
+	fields, offsets := fc.structFields(target, s)
 	for i, field := range fields {
 		switch t := field.Type().Underlying().(type) {
 		case *types.Basic:
@@ -1455,6 +1531,13 @@ func (fc *funcContext) loadStruct(array, target string, s *types.Struct) string
 				code += fmt.Sprintf(", %s = %s.get%s(%d, true)", field.Name(), view, toJavaScriptType(t), offsets[i])
 			}
 		case *types.Array:
+			if inPlace {
+				if elem, ok := t.Elem().Underlying().(*types.Basic); ok && isNumeric(elem) && !is64Bit(elem) {
+					size := sizes32.Sizeof(t)
+					code += fmt.Sprintf(", new Uint8Array(%s.buffer, %s.byteOffset, %d).set(new Uint8Array(%s.buffer, %s.byteOffset + %d, %d))", field.Name(), field.Name(), size, array, array, offsets[i], size)
+				}
+				break
+			}
 			code += fmt.Sprintf(`, %s = new ($nativeArray(%s))(%s.buffer, $min(%s.byteOffset + %d, %s.buffer.byteLength))`, field.Name(), typeKind(t.Elem()), array, array, offsets[i], array)
 		}
 		// TODO(nevkontakte): Explicitly panic if unsupported field type is encountered?
