diff --git a/compiler/prelude/prelude.js b/compiler/prelude/prelude.js
index 9e158d29..91953b48 100644
--- a/compiler/prelude/prelude.js
+++ b/compiler/prelude/prelude.js
@@ -506,29 +506,349 @@ var $clone = (src, type) => {
     return clone;
 };
 
-var $pointerOfStructConversion = (obj, type) => {
-    if (obj === (obj.constructor && obj.constructor.nil)) {
+// Reports whether obj is a nil pointer of its own type or the zero
+// unsafe.Pointer value.
+var $isNilPointer = obj => {
+    return obj === 0 || obj === (obj.constructor && obj.constructor.nil);
+};
+
+// Return the map from type ids to the pointers of those types that refer to
+// the same variable as the pointer obj, creating it on first use. All of these
+// pointers share the map, and its $original entry is the pointer the others
+// were converted from, which is what they all become as unsafe.Pointer values.
+var $pointerProxies = obj => {
+    if (obj.$proxies === undefined) {
+        obj.$proxies = { $original: obj };
+        if (obj.constructor !== undefined && obj.constructor.id !== undefined) {
+            obj.$proxies[obj.constructor.id] = obj;
+        }
+    }
+    return obj.$proxies;
+};
+
+// Convert a pointer to a different pointer type with the same element
+// representation. Nil pointers become the nil value of the target type, and
+// converting the same pointer to the same type always yields the same object,
+// so that the converted pointers compare equal. makeProxy creates the pointer
+// object of the target type when the source can't be reused as is; it may be
+// omitted when the source representation is shared by both types, which is
+// the case for pointers to arrays.
+var $pointerConversion = (obj, type, makeProxy) => {
+    if ($isNilPointer(obj)) {
         return type.nil;
     }
-    if (obj.$proxies === undefined) {
-        obj.$proxies = {};
-        obj.$proxies[obj.constructor.id] = obj;
+    if (makeProxy === undefined || obj.constructor === type) {
+        return obj;
+    }
+    var proxies = $pointerProxies(obj);
+    var proxy = proxies[type.id];
+    if (proxy === undefined) {
+        proxy = makeProxy(obj);
+        proxies[type.id] = proxy;
+        proxy.$proxies = proxies;
+    }
+    return proxy;
