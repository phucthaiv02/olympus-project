+// unsafeDerefAsIs reports whether *(*T)(unsafe.Pointer(&x)), where x is of
+// type from and T is to, can be translated as x itself. That is the case when
+// the types are the same, and in packages that reinterpret values on purpose.
+// Otherwise the value must take the representation of T.
+func (fc *funcContext) unsafeDerefAsIs(from, to types.Type) bool {
+	return types.Identical(from, to) || fc.packageAllowsKindTypeConversion() || fc.pkgCtx.Pkg.Path() == "syscall"
+}
