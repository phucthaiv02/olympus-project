+// structFields returns the non-struct fields of the struct target, including
+// those of nested structs, named by their JavaScript expressions, and their
+// offsets in the struct's memory layout.
+func (fc *funcContext) structFields(target string, s *types.Struct) ([]*types.Var, []int64) {
 	var fields []*types.Var
 	var collectFields func(s *types.Struct, path string)
 	collectFields = func(s *types.Struct, path string) {
