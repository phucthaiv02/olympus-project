diff --git a/parser/strict.go b/parser/strict.go
new file mode 100644
index 0000000..a1f8e92
--- /dev/null
+++ b/parser/strict.go
@@ -0,0 +1,129 @@
+package parser
+
+import (
+	"github.com/robertkrimen/otto/ast"
+	"github.com/robertkrimen/otto/file"
+	"github.com/robertkrimen/otto/token"
+)
+
+// isUseStrictDirective reports whether stmt is a "use strict" directive:
+// an expression statement made of nothing but the string literal "use strict"
+// or 'use strict', written without escape sequences or line continuations.
+func isUseStrictDirective(stmt ast.Statement) bool {
+	literal, ok := directiveLiteral(stmt)
+	return ok && len(literal) == 12 && literal[1:11] == "use strict"
+}
+
+// directiveLiteral returns the source of the string literal that makes up the
+// whole of stmt, if stmt is such an expression statement.
+func directiveLiteral(stmt ast.Statement) (string, bool) {
+	expr, ok := stmt.(*ast.ExpressionStatement)
+	if !ok {
+		return "", false
+	}
+	str, ok := expr.Expression.(*ast.StringLiteral)
+	if !ok {
+		return "", false
+	}
+	return str.Literal, true
+}
+
+// directive updates the directive prologue state of the current scope after
+// stmt has been parsed: a "use strict" directive makes the rest of the code
+// strict, and the first statement that isn't a directive ends the prologue.
+func (p *parser) directive(stmt ast.Statement) {
+	if !p.scope.inPrologue {
+		return
+	}
+	if _, ok := directiveLiteral(stmt); !ok {
+		p.scope.inPrologue = false
+		return
+	}
+	if isUseStrictDirective(stmt) {
+		p.scope.strict = true
+	}
+}
+
+// isStrictReservedWord reports whether name is a future reserved word in
+// strict mode code (ECMA-262 5.1, 7.6.1.2).
+func isStrictReservedWord(name string) bool {
+	if name == "yield" {
+		return true
+	}
+	tkn, strict := token.IsKeyword(name)
+	return tkn == token.KEYWORD && strict
+}
+
+// checkStrictBinding reports an error if name may not be bound, as a variable,
+// function, parameter or catch clause name, in strict mode code.
+func (p *parser) checkStrictBinding(idx file.Idx, name string) {
+	if !p.scope.strict {
+		return
+	}
+	switch {
+	case name == "eval" || name == "arguments":
