+#!/usr/bin/env bash
+# Usage: ./test.sh [--output_path <junit.xml>] <base|new>
+#
+#   base  the existing tests of the otto, parser and ast packages.
+#   new   the strict mode tests.
+set -uo pipefail
+
+cd /app
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+fi
+
+MODE="${1:-new}"
+
+TEST_LOG="$(mktemp)"
+
+# go vet's tests analyzer rejects documentation_test.go (examples that refer
+# to unknown identifiers) with current Go versions, so it is turned off.
+case "$MODE" in
+  base)
+    go test -count=1 -vet=off -v -skip '^TestStrictMode_d193ed_' . ./parser ./ast 2>&1 | tee "$TEST_LOG"
+    STATUS=${PIPESTATUS[0]}
+    ;;
+  new)
+    go test -count=1 -vet=off -v -run '^TestStrictMode_d193ed_' . 2>&1 | tee "$TEST_LOG"
+    STATUS=${PIPESTATUS[0]}
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$OUTPUT_PATH" || true
+fi
+
+exit "$STATUS"
